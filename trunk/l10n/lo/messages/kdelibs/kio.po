msgstr ""
"ການສື່ສານແບບເຄືອຂ່າຍ ອາດຈະຍັງບໍ່ໄດ້ຖືກປັບແຕ່ງຢ່າງຖືກຕ້ອງ "
"ຫລືອຸປະກອນເຄືອຂ່າຍອາດຈະຍັງບໍ່ເປີດໃຊ້ງານ"

#: kio/global.cpp:842
msgid "Connection to Server Refused"
msgstr "ການເຊື່ອມຕໍ່ໄປຍັງເຊີບເວີຖືກປະຕິເສດ"

#: kio/global.cpp:843
msgid ""
"The server <strong>%1</strong> refused to allow this computer to make a "
"connection."
msgstr ""
"ເຊີບເວີ <strong>%1</strong> ປະຕິເສດການຂໍອະນຸຍາດເຂົ້າໃຊ້ງານຂອງຄອມພິວເຕີນີ້"

#: kio/global.cpp:845
msgid ""
"The server, while currently connected to the Internet, may not be configured to "
"allow requests."
msgstr ""
"ເຊີບເວີ ເຊິ່ງເຊື່ອມຕໍ່ຢູ່ກັບລະບົບອິນເຕີເນຕໃນປັດຈຸບັນ "
"ອາດຈະຍັງບໍ່ໄດ້ປັບແຕ່ງໃຫ້ຮັບການເຊື່ອມຕໍ່ທີ່ຮ້ອງຂໍໄປ"

#: kio/global.cpp:847
msgid ""
"The server, while currently connected to the Internet, may not be running the "
"requested service (%1)."
msgstr ""
"ເຊີບເວີ ເຊິ່ງເຊື່ອມຕໍ່ຢູ່ກັບລະບົບອິນເຕີເນຕໃນປັດຈຸບັນ "
"ອາດຈະຍັງບໍ່ໄດ້ປັບແຕ່ງໃຫ້ຮັບການເຊື່ອມຕໍ່ບໍລິການທີ່ຮ້ອງຂໍໄປ (%1)"

#: kio/global.cpp:849
msgid ""
"A network firewall (a device which restricts Internet requests), either "
"protecting your network or the network of the server, may have intervened, "
"preventing this request."
msgstr ""
"ໄຟຣ໌ວອລລ໌ຂອງລະບົບເຄືອຂ່າຍ (ອຸປະກອນທີ່ທຳຫນ້າທີ່ປ້ອງກັນການເຂົ້າໃຊ້ງານຈາກເຄືອຂ່າຍ) "
"ອາດຈະບໍ່ອະນຸຍາດໃຫ້ມີການເຊື່ອມຕໍ່ທີ່ຮ້ອງຂໍໄປ"

#: kio/global.cpp:856
msgid "Connection to Server Closed Unexpectedly"
msgstr "ການເຊື່ອມຕໍ່ໄປຍັງເຊີບເວີຢຸດຕິຢ່າງບໍ່ຄາດຄິດ"

#: kio/global.cpp:857
msgid ""
"Although a connection was established to <strong>%1</strong>"
", the connection was closed at an unexpected point in the communication."
msgstr ""
"ເຖິ່ງວ່າການເຊື່ອມຕໍ່ໄປຍັງ<strong>%1</strong> "
"ຈະເກີດຂື້ນແລ້ວແຕ່ກໍ່ເກີດການຍຸຕິການເຊື່ອມຕໍ່ໃນາງຈຸດຂອງການສື່ສາມຢ່າງບໍ່ຄາດຄິດ"

#: kio/global.cpp:860
msgid ""
"A protocol error may have occurred, causing the server to close the connection "
"as a response to the error."
msgstr ""
"ເກີດຂໍ້ຜິດພາດຂອງໂປຣໂຕຄອນເນື່ອງຈາກເຊີບເວີປິດການເຊື່ອມຕໍ່ຈາກການໂຕ້ຕອບທີ່ຜິດພາດ"

#: kio/global.cpp:866
#, fuzzy
msgid "URL Resource Invalid"
msgstr "ແຫລ່ງ URL ບໍ່ຖືກຕອ້ງ"

#: kio/global.cpp:867
msgid "Protocol %1 is not a Filter Protocol"
msgstr "ໂປໂຕຄອນ %1 ບໍ່ແມ່ນໃຊ້ໂປຣໂຄດຄອນແບບຕົວກອງ"

#: kio/global.cpp:868
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource <strong>L</strong>"
"ocator (URL) that you entered did not refer to a valid mechanism of accessing "
"the specific resource, <strong>%1%2</strong>."
msgstr ""
"ຕຳແຫນ່ງ <strong>U</strong>niversal <strong>R</strong>esource <strong>L</strong>"
"ocation (URL) ບໍ່ໄດ້ອ້າງຖືງສ່ວນຂອງການເຂົ້າຖືງສັບພະຍາກອນທີ່ກຳນົດ<strong>"
"%1%2</strong>"

#: kio/global.cpp:873
msgid ""
"KDE is able to communicate through a protocol within a protocol. This request "
"specified a protocol be used as such, however this protocol is not capable of "
"such an action. This is a rare event, and is likely to indicate a programming "
"error."
msgstr ""
"KDE "
"ສາມາດສືສາມຫວ່າງໂປໂຕຄອນແລະພາຍໃນໂປໂຄຄອນສື່ງທີ່ຮ້ອງຂໍມານີ້ໄດ້ກຳນົດໂປໂຄຄອນທີ່ຈະໃຊ້ດ້"
"ວຍແຕ່ວ່າ ໂປໂຄອນນີ້ບໍ່ມີຄວາມສາມາດໃນການກະທຳນັ້ນ "
"ຊື່ງນີ້ເປັນເຫດການຈິ່ງແລະເບິ່ງວ່າຈະເປັນຂໍ້ຜິດພາດຈາກການຂຽນໂປຣແກຣມ"

#: kio/global.cpp:881
msgid "Unable to Initialize Input/Output Device"
msgstr "ບໍ່ສາມາດເລີ່ມການໃຊ້ອຸປະກອນນຳເຂົ້າ/ສົ່ງອອກ"

#: kio/global.cpp:882
msgid "Could Not Mount Device"
msgstr "ບໍ່ສາມາດເມາອຸປະກອນໄດ້"

#: kio/global.cpp:883
msgid ""
"The requested device could not be initialized (\"mounted\"). The reported error "
"was: <strong>%1</strong>"
msgstr ""
"ບໍ່ສາມາດເລີ່ມໃຊ້ງານ(\"ເມານ\") "
"ອຸປະກອນທີ່ຮ້ອງຂໍມາໄດ້ຊື່ງລາຍງານຄວາມຜິດພາດຄື:<strong>%1</strong>"

#: kio/global.cpp:886
msgid ""
"The device may not be ready, for example there may be no media in a removable "
"media device (i.e. no CD-ROM in a CD drive), or in the case of a "
"peripheral/portable device, the device may not be correctly connected."
msgstr ""
"ອຸປະກອນອາດຈະຍັງບໍ່ພ້ອມໃຊ້ງານ ຕົວຢ່າງເຊັ່ນ "
"ອາດຈະບໍ່ມີສື່ຢູ່ໃນອຸປະກອນແບບຍ້າຍສື່ໄດ້ (ເຊັ່ນ ບໍ່ມີແຜ່ນຊີດີຣອມ ຢູ່ໃນໄດຣຟຊີດີ "
"ເປັນຕົ້ນ) ຫລືໃນກໍລະນີຂອງອຸປະກອນຕໍ່ພ່ວງ / ອຸປະກອນແບບພົກພາ ກໍອາດຈະເກີດຈາກ "
"ອຸປະກອນດັ່ງກ່າວຍັງບໍ່ໄດ້ທຳການເຊື່ອມຕໍ່"

#: kio/global.cpp:890
msgid ""
"You may not have permissions to initialize (\"mount\") the device. On UNIX "
"systems, often system administrator privileges are required to initialize a "
"device."
msgstr ""
"ທ່ານອາດຈະບໍ່ໄດ້ຮັບສິດໃຫ້ເລີ້ມໃຊ້ງານ (\"ເມົານທ໌\") ອຸປະກອນໄດ້ ເທິງລະບົບຢູນິກນັ້ນ "
"ບາງຄັ້ງຜູ້ເບິ່ງແຍງລະບົບກໍອາດຈະຫວງຫ້າມການເຂົ້າໃຊ້ງານອະປະກອນບາງຕົວ"

#: kio/global.cpp:894
msgid ""
"Check that the device is ready; removable drives must contain media, and "
"portable devices must be connected and powered on.; and try again."
msgstr ""
"ກະລຸນາກວດສອບວ່າ ອຸປະກອນພ້ອມໃ່ຊ້ງານແລ້ວ ຫາກເປັນໄດຣຟທີ່ຍ້າຍສື່ໄດ້ "
"ກໍ່ຕ້ອງມີສື່ຢູ່ໃນໄດຣຟກ່ອນ ແລະອຸປະກອນແບບພົກພາ ກໍຕ້ອງເຊື່ອມຕໍ່ແລະເປີດແລ້ວ "
"ຈາກນັ້ນລອງໃຫມ່ອີກຄັ້ງ"

#: kio/global.cpp:900
msgid "Unable to Uninitialize Input/Output Device"
msgstr "ບໍ່ສາມາດຍົກເລີກການເອີ້ນໃຊ້ອຸປະກອນນຳເຂົ້າ/ສົ່ງອອກໄດ້"

#: kio/global.cpp:901
msgid "Could Not Unmount Device"
msgstr "ບໍ່ສາມາດຍົກເລີກການເມົານທ໌ອຸປະກອນໄດ້"

#: kio/global.cpp:902
msgid ""
"The requested device could not be uninitialized (\"unmounted\"). The reported "
"error was: <strong>%1</strong>"
msgstr ""
"ບໍ່ສາມາດຍົກເລີກການໃຊ້ງານ "
"(\"ຍົກເລີກການເມົານທ໌\")ອຸປະກອນທີ່ຮ້ອງຂໍມາໄດ້ຊື່ງລາຍງານຄວາມຜິດພາດຄື: <strong>"
"%1</strong>"

#: kio/global.cpp:905
msgid ""
"The device may be busy, that is, still in use by another application or user. "
"Even such things as having an open browser window on a location on this device "
"may cause the device to remain in use."
msgstr ""
"ອຸປະກອນຈະບໍ່ວ່າງ(ຖືກໃຊ້ງານຢູ່) ຄືອາດຈະຖືກໃຊ້ຢູ່ໂດຍແອບພິເຄຊັ້ນຫລືຜູ້ໃຊ້ອື່ນຯ "
"ເຊັ່ນມີຫ້ນາຕ່າງບາວເຊີທີ່ຮຽກ "
"ໃຊ້ງານເທີງຕຳແຫນ່ງຊື່ງຢູ່ເທີງອຸປະກອນນີ້ກໍຈະເຮັດໃຫ້ອຸປະກອນຢູ່ໃນສະຖານະຖືກໃຊ້ງານຢູ່"

#: kio/global.cpp:909
msgid ""
"You may not have permissions to uninitialize (\"unmount\") the device. On UNIX "
"systems, system administrator privileges are often required to uninitialize a "
"device."
msgstr ""
"ທ່ານອາດຈະບໍ່ມີສິດໃນການຍົກເລີກການໃຊ້ງານ(\"ຍົກເລີກການເມາ\") "
"ອຸປະກອນຊື່ງເທີງລະບົບຍູນິກນັ້ນຜູ້ດູແລລະບົບອາດຈະບໍ່ຕ້ອງການໃຫ້ມີການຍົກເລີກການໃຊ້ງານ"
"ອຸປະກອນ"

#: kio/global.cpp:913
msgid "Check that no applications are accessing the device, and try again."
msgstr ""
"ກະລຸນາກວດສອບວ່າບໍ່ມີແອບພິເຄຊັ້ນຫລືຜູ້ໃຊ້ໃດກຳລັງໃຊ້ງານອຸປະກອນຢູ່ແລ້ວລອງໃຫມ່ອີກຄັ້"
"ງ"

#: kio/global.cpp:918
msgid "Cannot Read From Resource"
msgstr "ບໍ່ສາມາດອ່ານຈາກສັບພະຍາກອນໄດ້"

#: kio/global.cpp:919
msgid ""
"This means that although the resource, <strong>%1</strong>"
", was able to be opened, an error occurred while reading the contents of the "
"resource."
msgstr ""
"ເຖືງວ່າສັບພະຍາກອນ <strong>%1</strong> "
"ຈະສາມາດເປີດໃຊ້ໄດ້ແຕ່ກໍເກີດຄວາມຜິດພາດຂື້ນເມື່ອມີການພະຍາຍາມອ່ານເນື້ອຫາພາຍໃນສັບພະຍາ"
"ກອນນັ້ນ"

#: kio/global.cpp:922
msgid "You may not have permissions to read from the resource."
msgstr "ທ່ານອາດຈະຍັງບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ອ່ານຈາກສັບພະຍາກອນນິ້"

#: kio/global.cpp:931
msgid "Cannot Write to Resource"
msgstr "ບໍ່ສາມາດຂຽນໄປຍັງສັບພະຍາກອນໄດ້"

#: kio/global.cpp:932
msgid ""
"This means that although the resource, <strong>%1</strong>"
", was able to be opened, an error occurred while writing to the resource."
msgstr ""
"ເຖີ່ງວ່າຈະສາມາດເປີດໃຊ້ງານສັບພະຍາກອນ <strong>%1</strong> "
"ໄດ້ແຕ່ກໍເກີດຄວາມຜິດພາດຂື້ນເມື່ອມີການຂຽນໄປຍັງສັບພະຍາກອນນັ້ນ"

#: kio/global.cpp:935
msgid "You may not have permissions to write to the resource."
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ຂຽນໄປຍັງສັບພະຍາກອນ"

#: kio/global.cpp:944 kio/global.cpp:955
msgid "Could Not Listen for Network Connections"
msgstr "ບໍ່ສາມາດຖ້າຮັບການເຊື່ອມຕໍ່ຂອງເຄືອຂ່າຍໄດ້"

#: kio/global.cpp:945
