#: kasaboutdlg.cpp:87 kasaboutdlg.cpp:153
msgid "About Kasbar"
msgstr "ກ່ງວກັບຄາດບາລ໌"

#: kasaboutdlg.cpp:156
#, fuzzy
msgid "<qt><body><h2>Kasbar Version: %1</h2><b>KDE Version:</b> %2</body></qt>"
msgstr "<qt><body><h2>ຄາດບາລ໌ %1</h2><b>ຫມາຍເລກCVS:</b> %2</body></qt>"

#: kasaboutdlg.cpp:164
#, fuzzy
msgid ""
"<html><body><p>Kasbar TNG began as a port of the original Kasbar applet to the "
"(then new) extension API, but ended up as a complete rewrite because of the "
"range of features needed by different groups of users. In the process of the "
"rewrite all the standard features provided by the default taskbar were added, "
"along with some more original ones such as thumbnails.</p><p>"
"You can find information about the latest developments in Kasbar at <a "
"href=\"%3\">%4</a>, the Kasbar homepage.</p></body></html>"
msgstr ""
"<html><body><p>ຄາບາລຸ້ນ TNG "
"ເລີ່ມທຳການພອດແອັບເພລດຄາດບາລ໌ດັ້ງເດີມ.ມາເປັນສ່ວນຂະຫຍາຍຂອງ API "
"(ຂອງໃຫມ່)ແຕ່ສຸດທ້າຍຕ້ອງທຳການຂງນຂຶ້ນໃຫມ່ເນື່ອງຈາກຄວາມຕ້ອງການຄວາມສາມາດຕ່າງໆເພີ່ມຂຶ"
"້ນຫລາຍຢ່າງຈາກຜູ້ໃຊ້ຫລາຍກຸ່ມ ຊຶ່ງໃນການເຮັດວງກຂອງຕົວທີຂງນຂຶ້ນໃຫມ "
"່ນີ້ກໍ່ຍັງຄົງຄວາມສາມາພື້ນຖານຕ່າງໆທີ່ທາດບາລ໌ມີໄວ້ຢ່າງຄົບຖ້ວນແລະເພີ່ມຄວາມສາມາດຢ່າງ"
"ອື່ນໆເຂົ້າໄປດ້ວຍເຊັ່ນສະແດງພາບຕົວຢ່າງ</p><p>ທ່ານສາມາດຫາຂໍ້ມູນກ່ງວກັບການພັດທະນາຄາດ"
"ບາລ໌ລຸ້ນລ່າສຸດໄດ້ທີ່ <a href=\"%3\">%4</a>ໂຮມເພດຈ໌ຂອງKasbar</p></body></html>"

