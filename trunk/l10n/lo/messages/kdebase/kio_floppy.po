#: kio_floppy.cpp:200
#, fuzzy
msgid ""
"Could not access drive %1.\n"
"The drive is still busy.\n"
"Wait until it is inactive and then try again."
msgstr ""
"ໄດຣຟ໌ %1\n"
"ໄດຣຟ໌ນີ້ຍັງມີການທຳງານຄ້າງຢູ່\n"
"ກະລຸນາຖ້າຈົນກວ່າມັນຈະຢຸດທຳງານຫລັງຈາກນັ້ນໃຫ້ລອງອີກຄັ້ງ"

#: kio_floppy.cpp:204 kio_floppy.cpp:1146
#, fuzzy
msgid ""
"Could not write to file %1.\n"
"The disk in drive %2 is probably full."
msgstr ""
"\n"
"ແຜ່ນດີສ໌ກໍ່ໃນໄດຣຟ໌ %1 ເບິ່ງຄືຈະເຕັມ"

#: kio_floppy.cpp:214
#, fuzzy
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2"
msgstr ""
"\n"
"ເບິ່ງຄຶວ່າ ຈະເບິ່ງມີແຜ່ນດິສ໌ຢຸ່ໃນໄດຣຟ໌%1"

#: kio_floppy.cpp:218
msgid ""
"Could not access %1.\n"
"There is probably no disk in the drive %2 or you do not have enough permissions "
"to access the drive."
msgstr ""

#: kio_floppy.cpp:222
#, fuzzy
msgid ""
"Could not access %1.\n"
"The drive %2 is not supported."
msgstr ""
"\n"
"ບໍ່ສະຫນັບສະຫນຸນໄດຣຟ໌%1"

#: kio_floppy.cpp:227
#, fuzzy
msgid ""
"Could not access %1.\n"
"Make sure the floppy in drive %2 is a DOS-formatted floppy disk \n"
"and that the permissions of the device file (e.g. /dev/fd0) are set correctly "
"(e.g. rwxrwxrwx)."
msgstr ""
"\n"
"ກະລຸນາກວດສອບໃຫ້ແນ່ໃຈວ່າ ແຜ່ນຟລັອປປີ້ດິສ໌ໃນໄດຣຟ໌์ %1 \n"
"ເປັນແຜ່ນທີ່ເປັນແບບ DOS ແລະສິດໃນການໃຊ້ງານອຸປະກອນ\n"
"(ເຊັ່ນ/dev/fd0) ຖຶກຕັ້ງຢ່າງຖຶກຕ້ອງແລ້ວ(ເຊັ່ນ rwxrwxrwx)"

#: kio_floppy.cpp:231
#, fuzzy
msgid ""
"Could not access %1.\n"
"The disk in drive %2 is probably not a DOS-formatted floppy disk."
msgstr ""
"\n"
"ແຜ່ນຟລັອປປີ້້ດິສໃນໄດຣຟ໌%1 ເບິ່ງຄືຈະບໍ່ແມ່ນແຜ່ນແບບ DOS"

#: kio_floppy.cpp:235
#, fuzzy
msgid ""
"Access denied.\n"
"Could not write to %1.\n"
"The disk in drive %2 is probably write-protected."
msgstr ""
"\n"
"ແຜ່ນຟລັອປປີ້ດິສ໌ໃນໄດຣຟ໌%1 ເບິ່ງຄຶຈະມີການປ້ອງກັນຂງນໄວ້"

#: kio_floppy.cpp:244
#, fuzzy
msgid ""
"Could not read boot sector for %1.\n"
"There is probably not any disk in drive %2."
msgstr ""
"\n"
"ເບິ່ງຄຶວ່າ ຈະເບິ່ງມີແຜ່ນດິສ໌ຢຸ່ໃນໄດຣຟ໌%1"

