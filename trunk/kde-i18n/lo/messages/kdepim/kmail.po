msgid "Save as &Encoded..."
msgstr "ບ&ັນທືກະເປັນການເຂົ້າລະຫັດ..."

#: kmmimeparttree.cpp:137 kmmimeparttree.cpp:200
msgid "A file with this name already exists. Do you want to overwrite it?"
msgstr "ມີແຟ້ມຊື່ນີ້ຢູ່ແລ້ວທ່ານຕ້ອງການຂຽນທັບມັນຫລືບໍ່ ?"

#: kmmimeparttree.cpp:138 kmmimeparttree.cpp:201
msgid "KMail Warning"
msgstr "ຄຳເຕື່ອນຂອງ KMail"

#: kmmimeparttree.cpp:147
msgid ""
"This part of the message is encrypted. Do you want to keep the encryption "
"when saving?"
msgstr ""
"ສ່ວນນີ້ຂອງຂໍ້ຄວາມຖືກເຂົ້າລະຫັດໄວ້ທ່ານຕ້ອງການຮັກ "
"ສາການເຂົ້າລະຫັດນີ້ເມື່ອມີການບັນທືກຫລືບໍ່? "

#: kmmimeparttree.cpp:148 kmmimeparttree.cpp:156
msgid "KMail Question"
msgstr "ຄຳຖາມຂອງKMail"

#: kmmimeparttree.cpp:155
msgid ""
"This part of the message is signed. Do you want to keep the signature when "
"saving?"
msgstr ""
"ສ່ວນນີ້ຂອງຈົດໝາຍມີການເຊັນໄວ້ "
"ທ່ານຕ້ອງການຮັບສາລາຍເຊັ່ນໄວ້ເມື່ອມີການບັນທືກຫລືບໍ່?"

#: kmmimeparttree.cpp:179 kmmimeparttree.cpp:217
