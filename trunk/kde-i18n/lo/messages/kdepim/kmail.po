#: kmreaderwin.cpp:222
msgid ""
"Problem: %1 plug-in was not specified.\n"
"Use the 'Settings->Configure KMail->Security' dialog to specify the plug-in "
"or ask your system administrator to do that for you."
msgstr ""
"ບັນຫາ: %1 ຕົວເພີ່ມ ແມ່ນບໍ່ໄດ້ລະບຸ \n"
"ໃຊ້ 'ຕັ້ງຄ່າ->ແກ້ໄຂ KMail ->ປ້ອງກັນ' ໄດອະລອກທີ່ລະບຸ ຫລື ຖາມຈາກລະບົບທີ່ຈະດຳເນີນການທີ່ "
"ຈະໃຫ້ສຳລັບທ່ານ"

#: kmreaderwin.cpp:477
msgid ""
"<b>Note:</b> This is an HTML message. For security reasons, only the raw "
"HTML code is shown. If you trust the sender of this message then you can "
"activate formatted HTML display for this message by clicking <a "
"href=\"kmail:showHTML\">here</a>."
msgstr ""
"<b>ບັນທືກ:</b> ນີ້ແມ່ນຂໍ້ຄວາມ HTML .ສຳລັບການປົກກັນ, ພຽງກົດລະບຽບຂອງ HTML ລະຫັດແມ່ນຈະສະແດງ.ຖ້າທ່ານຕ້ອງການສົ່ງຂໍ້ຄວາມຂະນະທີ່ທ່ານສາມາດໃຊ້ງານ HTML ຈະສະແດງສຳລັບຂໍ້ຄວາມຈາກການກົດ <a "
"href=\"kmail:ສະແດງHTML\">ທີ່ນີ້</a>."
"1112 Kmail ແມ່ນ KPart ແລະສາມາດຝັ່ງໃນ Kontact ບັນຈຸໃນແອບພິເຄຊັ້ນຫລືກັນ KDE PIM ອື່ນ ຯຂອງ ແອບພິເຄຊັ້ນ."

#: kmreaderwin.cpp:2314
msgid ""
"KMail is now a KPart and can be embedded in the Kontact container "
"application along with other KDE PIM applications."
msgstr ""
"KMail ແມ່ນ KPart ແລະສາມາດຢ່ງໃນKontact "
"ບັນຈຸໃນແອບພິເຄຊັ້ນຫລືກັບKDE PIMອື່ນຯຂອງ "
"ແອບພິເຄຊັ້ນ"

#: kmreaderwin.cpp:2315
msgid "Remove duplicates function for removing duplicate messages in a folder."
msgstr "ຍ້າຍວິທີ່ທີ່ຄືກັນສຳບັບຍ້າຍຂໍ້ຄວາມຄືກນັໃນໂຟເດີ"

#: kmreaderwin.cpp:2316
msgid ""
"Messages can be dragged and dropped on a composer window to add those "
"messages as attachments."
msgstr ""
"ຂໍ້ຄວາມສາມາດດື່ງຫລືລາກເທີ່ງການຂຽນຈົດໝາຍໃນວ "
"ວິນໂດ້ໄປຕື່ມຕົວແນບອື່ນ"

#: kmreaderwin.cpp:2317
msgid ""
"Deletion in threaded mode is improved, child messages will no longer be "
"scattered when a parent is deleted."
msgstr ""
"ລືບໃນເທດໂຫມດ ຈົດໝາຍຂອງລູກທ່ານຈະບໍ່ຍາວປານໃດຂະນະ "
"ທີ່ພໍ່ແມ່ທຳການລືບ"

#: kmreaderwin.cpp:2318
msgid "Multiple messages can now be selected in the search dialog."
msgstr "ທຳເຄືອງໝາຍຈົດໝາຍໃນໂຟເດີນີ້"

#: kmreaderwin.cpp:2319
msgid ""
"New context menu in the search dialog with Move, Copy, Reply etc. actions "
"for operating on selected messages."
msgstr ""
"ຫນ້າຕົວເລືອກມເນູໃຫມ່ໃນໄດອະລອກການຫາກັບກາາຍ້າຍ ສຳເນົາ "
"ຕອບ ອື່ນຯ ການກະທຳຂອງຕົວຄວບຄຸມເທີງການເລືອກ "
"ຈົດໝາຍ"

#: kmreaderwin.cpp:2320
msgid ""
"Search criteria in the search dialog now supports more types of rules and a "
"variable number of rules."
msgstr "ຫາໄດອະລອກຊອກຫາດ່ຽວນີ້ແມ່ນສະນັບສະນຸນການພິມແບບມີກົດເກນ"

#: kmreaderwin.cpp:2321
msgid "Faster searching of large messsages."
msgstr "ຫາໂດຍໄວໃນຈົດໝາຍທີ່ຍາວ"

#: kmreaderwin.cpp:2322
msgid ""
"'Search Folders' which are a KMail folder that stores a search expression "
"and is dynamically updated (also known as virtual folders)."
msgstr ""
"ຫາໂຟເດີ ກັບແມ່ນ KMail ໂຟເດີທີ່ບັນທືການຫາແລະ "
"ແມ່ນທີ່ປ່ຽນໃຫມ່"

#: kmreaderwin.cpp:2323
msgid ""
"The separate window for reading mail has a context menu with Reply, Copy "
"etc. actions for operating on the message displayed."
msgstr "ແບ່ງຫນ້າຕ່າງສຳລັບການຄວບຄຸມຂອງການສະແດງຈົດໝາຍ"

#: kmreaderwin.cpp:2324
msgid "The separate window for reading mail has a tool bar."
msgstr ""
"ແບ່ງຫນ້າຕ່າງສຳລັບການອ່ານຈົດໝາຍແມ່ນາຕົວແຖບ "
"ເມນູແລະແມ່ນປ່ຽນໃຫມ່"

#: kmreaderwin.cpp:2325
msgid "Startup of KMail is faster."
msgstr "ເລີ່ມຂື້ນ ຈາກ Kmail ແມ່ນໄວຫລາຍ"

#: kmreaderwin.cpp:2326
msgid "Switching between folders is faster."
msgstr "ສະວິສລະຫວ່າງໂຟເດີແມ່ນໄວຫລາຍ"

#: kmreaderwin.cpp:2327
msgid ""
"The contents of all composer windows are saved to disk on composer window "
"creation and then periodically saved to prevent mail loss in the result of a "
"system crash."
msgstr ""
"ຫນ້າຊອກຫາຂອງທັງໝົດຂອງການຕອບຈົດໝາຍໃນ "
"ຫນ້າຕ່າງແມ່ນບັນທືກໄວ້ໃນດີສຕອບຈົດໝາຍບາງເວລາກນັນ "
"ທືກຈະເຮັດໃຫ້ເມລນັ້ນເສຍຫາຍໄປຖ້າລະບົບຖືກຕໍ່ກັນ"

#: kmreaderwin.cpp:2328
msgid ""
"The state of KMail folders is saved to disk periodically to prevent status "
"information loss in the result of a system crash."
msgstr "ຂັ້ນນີ້ KMail ໂຟເດີຈະບັນທືກໃນໄລຍະເວລາທີ່ຖືກການປະທະ"

#: kmreaderwin.cpp:2348
msgid ""
"_: %1: KMail version; %2: help:// URL; %3: homepage URL; %4: prior KMail "
