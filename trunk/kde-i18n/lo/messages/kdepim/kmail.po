#: kmmsgpartdlg.cpp:59
msgid "Message Part Properties"
msgstr "ຄຸນສົມບັດສ່ວນຈົດໝາຍ"

#: kmmsgpartdlg.cpp:100
msgid ""
"<qt>"
"<p>The <em>MIME type</em> of the file.</p>"
"<p>Normally, you don't need to touch this setting, since the type of the "
"file is automatically checked. But sometimes, %1 may not detect the type "
"correctly. Here's where you can fix that.</p></qt>"
msgstr ""
"<qt>"
"<p>The <em>MIME type</em>ຂອງແຟ້ມ.</p>"
"<p>ທົ່ວຯໄປ,ທ່ານບໍ່ຕ້ອງການແຕະຕ້ອງໄປທຕິດຕັ້ງໄວ້ນີ້,ີ່"
"ຕັ້ງແຕ່ການກວດກາຊະນິດຂອງແຟ້ມແມ່ນໂອໂຕ້ມາຕິກ."
"ແຕ່ບາງຄັ້ງ,%1ອາດຈະບໍ່ຄົ້ນພົບຢ່າງຖືກຕ້ອງ."
"ທ່ານສາມາດກຳນັ້ນຢູ່ໃສຢູ່ທີ່ນີ້.</p></qt>"

#: kmmsgpartdlg.cpp:112
msgid ""
"<qt>"
"<p>The size of the part.</p>"
"<p>Sometimes, %1 will only give an estimated size here, because calculating "
"the exact size would take too much time. When this is the case, it will be "
"made visible by adding \"(est.)\" to the size displayed.</p></qt>"
msgstr ""
" <qt>"
"<p>ຂະໜາດຂອງສ່ວນຕອນ.</p>"
"<p>ບາງຄັ້ງ,%1ພຽງຈະໃຫ້ຂະໜາດຂອງ an estimated ຢູ່ທີ່ນີ້,"
"ເພາະກຳລັງຊອກຂະໜາດທີ່ແນ່ນອນທີ່ຈະໃຊ້ເວລາຫລາຍ"
"ເມື່ອອັນນີ້ແມ່ນcase,ມັນຈະຖືກສ້າງຂຶ້ນທີ່ປະກົດໃຫ້ເຫັນ"
"ດ້ວຍການປະສົມ\"(est.)\"ໄປທີ່ຂະໜາດຈະສະແດງໃຫ້ເຫັນ</p></qt>"

#: kmmsgpartdlg.cpp:126
msgid ""
"<qt>"
"<p>The file name of the part.</p>"
"<p>Although this defaults to the name of the attached file, it doesn't "
"specify the file to be attached. Rather, it suggests a file name to be used "
"by the recipient's mail agent when saving the part to disk.</p></qt>"
msgstr ""
" <qt>"
"<p>ສ່ວນຕອນຂອງຊື່ແຟ້ມ.</p>"
"<p>ເຖິງວ່າລົບໜີຊື່ຂອງແຟ້ມattached,ມັນບໍ່ລະບຸແຟ້ມໄປທີ່attached"
"ເລືອກທີ່ຈະສະເໜີຊື່ແຟ້ມທີ່ຖືກໃຊ້ດ້ວຍເມວລຂອງຕົວແທນຜູ້ຮັບ"
"ເມື່ອຮັກສາສ່ວນຕອນໄປ disk.</p></qt>"

#: kmmsgpartdlg.cpp:136 rc.cpp:18
msgid "&Description:"
msgstr "&ລາຍລະອຽດ:"

#: kmmsgpartdlg.cpp:140
msgid ""
"<qt>"
"<p>A description of the part.</p>"
"<p>This is just an informational description of the part, much like the "
"Subject is for the whole message. Most mail agents will show this "
"information in their message previews, alongside the attachment's "
"icon.</p></qt>"
msgstr ""
"<qt>"
"<p>ປະເພດຂອງສ່ວນຕອນ</p>"
"<p>ອັນນີ້ແມ່ນປະເພດຂ່າວສານທີ່ເມາະສົມ,ມັກໃຊ້ຫລາຍແມ່ນຂໍ້ຄວາມທັ້ງໝົດ"
"ຕົວແທນເມວລສ່ວນຫລາຍຈະພິສູດຂ່າວສານໃນການສະແດງຈົດໝາຍ"
"alongsideທີ່ຕິດມາດ້ວຍicon.</p></qt>"

#: kmmsgpartdlg.cpp:151
msgid "&Encoding:"
msgstr "ຊ&ຸດລະຫັດອັກຂະລະ:"

#: kmmsgpartdlg.cpp:155
msgid ""
"<qt>"
"<p>The transport encoding of this part.</p>"
"<p>Normally, you don't need to change this, since %1 will use a decent "
"default encoding, depending on the MIME type. Yet sometimes, you can "
"significantly reduce the size of the resulting message, e.g. if a PostScript "
"file doesn't contain binary data, but consists of pure text. In this case, "
"choosing \"quoted-printable\" over the default \"base64\" will save up to "
"25% in resulting message size.</p></qt>"
msgstr ""
"<qt>"
"<p>ກວດສອບການເລືອກນີ້,ຖ້າທ່ານຕ້ອງການສະເໜີກ່ຽວກັບໂອໂຕ້ມາຕິກ"
"(inline)ການສະແດງຂອງສ່ວນຕອນນີ້ຢູ່ໃນການສະແດງຂອງຈົດໝາຍ"
"ແທນການລະເລີຍຂອງicon view.</p>"
"<p>ກ່ຽວກັບເທັກນິກ,ອັນນີ້ແມ່ນການສົ່ງອອກທີ່ກຳລັງຕິດຕັ້ງສ່ວນຕົວຂອງ"
"<em>ໂຕ້ຕອບໃຈຄວາມ</em>ສ່ວນຫົວແຟ້ມໄປ\"inline\""
"ການແທນຂອງການລະເລີຍ\"ກ່ຽວພັນກັບ\".</p></qt>"

#: kmmsgpartdlg.cpp:168
msgid "Suggest &automatic display"
msgstr "&ສະແດງຄຳແນະນຳອັດຕະໂນມັດ"

#: kmmsgpartdlg.cpp:171
msgid ""
"<qt>"
"<p>Check this option if you want to suggest to the recipient the automatic "
"(inline) display of this part in the message preview, instead of the default "
"icon view.</p>"
"<p>Technically, this is carried out by setting this part's "
"<em>Content-Disposition</em> header field to \"inline\" instead of the "
"default \"attachment\".</p></qt>"
msgstr ""
"<qt> "
"<p> ກວດສອບການຄັດເລືອກນີ້ ຖ້າທ່ານຕອ້ການຈົດ "
"ໝາຍສ່ວນນີ້ ໄປທີ່ສັນຍາລັກ</p> "
"ຂະນະນີ້ຄັດເລືອກການພິສູດ</p></qt>"

#: kmmsgpartdlg.cpp:181
msgid "&Sign this part"
msgstr "ເຊນັ່ສ&່ວນນີ້"

#: kmmsgpartdlg.cpp:184
msgid ""
"<qt>"
"<p>Check this option if you want this message part to be signed.</p>"
"<p>The signature will be made with the key that you associated with the "
"currently selected identity.</p></qt>"
msgstr ""
"<qt> "
"<p> ກວດສອບການຄັດເລືອກຖ້າທ່ານຕອ້ງການຈົດໝາຍ "
"ສ່ວນນີ້ໄປທີ່ ບໍ່ມີລະຫັດ "
"</p> "
"<p> "
"</p> "
"</qt>"

#: kmmsgpartdlg.cpp:191
msgid "Encr&ypt this part"
msgstr "ເຂົ້າລະຫັດຈົດໝ&າຍສ່ວນນີ້"

#: kmmsgpartdlg.cpp:194
msgid ""
"<qt>"
"<p>Check this option if you want this message part to be "
"encrypted.</p>"
"<p>The part will be encrypted for the recipients of this message</p></qt>"
msgstr ""
"<qt> "
"<p>ກວດສອບການຄູັດເລືອກຖ້າທ່ານຕ້ອງການຈົດໝາຍ "
"ນີ້ໄປທີ່ສ່ວນ ບໍ່ມີລະຫັດ</p> "
"</qt>"

#: kmmsgpartdlg.cpp:240
msgid ""
"_: %1: a filesize incl. unit (e.g. \"1.3 KB\")\n"
"%1 (est.)"
msgstr "%1 (ໂດຍປະມານ)"

#: kmpopfiltercnfrmdlg.cpp:293
msgid "KMail POP Filter"
msgstr "ຕົວກັນຕອງ POP ຂອງ Kmail"

#: kmpopfiltercnfrmdlg.cpp:305
msgid ""
"Messages to filter found on POP Account: <b>%1</b>"
"<p>The messages shown exceed the maximum size limit you defined for this "
"account."
"<br>"
"You can select what you want to do with them by checking the appropriate "
"button."
msgstr ""
"ຈົດໝາຍທີ່ຖືກກັນຕອງຈາກ POP <b> %1 </b>"
"<p> ຈົດໝາຍຈະສະແດງຂະຫນາດໃຫຍ່ສຸດເຫັນຈາກສະມາຊິກຂອງທ່ານ"
"<br>"
"ທ່ານສາມາດເລືອກວ່າທ່ານຕ້ອງການເຮັດຫຍັງຈາກປຸ່່ມນີ້"

#: kmpopfiltercnfrmdlg.cpp:310
msgid "Messages Exceeding Size"
msgstr "ຈົດໝາຍມີຂະໜາດໃຫຍ່ກວ່າ"

#: kmpopfiltercnfrmdlg.cpp:315
msgid "Ruleset Filtered Messages: none"
msgstr "ກົດການກອງຈົດໝາຍ: ບໍ່ມີ"

#: kmpopfiltercnfrmdlg.cpp:317
msgid "Show messages matched by a ruleset and tagged 'Download' or 'Delete'"
msgstr ""
"ສະແດງຈົດໝາຍທີ່ເຂົ້າ "
"ຄູ່ກັບກົດທີ່ຕັ້ແບະທີແຖກ"
"'ດາວໂຫລດ' ຫລື 'ລືບ'"

#: kmpopfiltercnfrmdlg.cpp:318
msgid "Show messages matched by a filter ruleset"
msgstr "ສະແດງຈົດໝາຍທີ່ເຂົ້າຄູ່ກັບທີ່ຕັ້ງໄວ້"

#: kmpopfiltercnfrmdlg.cpp:375 kmpopfiltercnfrmdlg.cpp:448
msgid "no subject"
msgstr "ບໍ່ມີຊື່ເລື່ອງ"

