#: kmfilterdlg.cpp:39
msgid ""
"<qt>"
"<p>This is the list of defined filters. They are processed "
"top-to-bottom.</p>"
"<p>Click on any filter to edit it using the controls in the right-hand half "
"of the dialog.</p></qt>"
msgstr ""
"<qt>"
"     <p>ນີ້ເປັນລາຍການຕົວຕອງທີ່ກຳນົດໄວ້ຊື່ງຈະຖືກປະມວນຜົນ''ຈາກເທິງລົງລຸ່ມ''</p>"
"     <p>ກົດທີ່ຕົວກັ່ນຕອງຕົວໃດຕົວໜຶ່ງເພື່ອແກ້ໄຂມັນ ໂດຍໃຊ້ການຄວບຄຸມທີຢູ່່່່່ດ້ານຂວາຂອງໄດອາລອກສ໌</p>/qt>"

#: kmfilterdlg.cpp:45
msgid ""
"<qt>"
"<p>Click this button to create a new filter.</p>"
"<p>The filter will be inserted just before the currently selected one, but "
"you can always change that later on.</p>"
"<p>If you have clicked this button accidentally, you can undo this by "
"clicking on the <em>Delete</em> button (to the right).</p></qt>"
msgstr ""
"<qt> "
"<p>ກົດທີ່ປຸ່ມນີ້ເພື່ອສ້າງຕົວກັ່ນຕອງໃໝ່</p>"
"     <p>ໂດຍມັນຈະແຊກຕົວເລືອກໄວ້ໃນປະຈຸບັນແຕ່ທ່ານກໍສາມາດປ່ຽນມັນໄດ້ພາຍຫລັງ </p>"
"  <p>ຫາກສາມາດຍົກເລີກໄດ້ໂດຍກົດທີ່່ປຸ່ມ <em>ລືບ</em> ຊື່ງຢູ່ດ້ານຂວາ </p></qt>"

#: kmfilterdlg.cpp:52
msgid ""
"<qt>"
"<p>Click this button to <em>delete</em> the currently selected filter from "
"the list above.</p>"
"<p>There is no way to get the filter back once it is deleted, but you can "
"always leave the dialog by clicking <em>Cancel</em> to discard the changes "
"made.</p></qt>"
msgstr ""
"<qt>"
"<p>ກົດປຸ່ມນີ້ເພື່ອໃຫ້ລາຍການຕົວຕອງທີ່ເລືອກໄວ້ <em>ເລືອນຂື້ນ</em> ໄປຫນື່ງລະດັບໃນລາຍການດ້ວຍ</p>"
"<p>ໃຊ້ເພື່ອຈັດລຳດັບຕົວຕອງຂອງລາຍການໃນການເລືອກລຳດັບຂອງການຈັດການຂໍ້ຄວາມທີ່ໄດ້ຮັບ:ຕົວຕອງເທີງສຸດຈະຖືກຮຽ"
"ກໃຊ້ກ່ອນ</p>"
"<p>ຫາກທ່ານລືມກົດທີ່ປຸ່ມນີ້ທ່ານສາມາດຮຽກຄືນໄດ້ໂດຍກົດທີ່ປຸ່ມ<em>ເລືອ່ນລົງ</em>ຢູ່ດ້ານຂວາ</p></qt>"

#: kmfilterdlg.cpp:59
msgid ""
"<qt>"
"<p>Click this button to move the currently selected filter <em>up</em> one "
"in the list above.</p>"
"<p>This is useful since the order of the filters in the list determines the "
"order in which they are tried on messages: The topmost filter gets tried "
"first.</p>"
"<p>If you have clicked this button accidentally, you can undo this by "
"clicking on the <em>down</em> button (to the right).</p></qt>"
msgstr ""
"<qt>"
"<p>ກົດປຸ່ມນີ້ເພື່ອໃຫ້ລາຍການຕົວຕອງທີ່ເລືອກໄວ້<em>ເລື່ອນລົງ</em>ຫນື່ງລະດັບໃນລາຍການດ້ານເທີງ</p>"
"<p>ໃຊ້ເພື່ອຈັດລຳດັບຕົວຕອງໃນລາຍການໃນການເລືອກລຳດັບຂອງການຈັດການຂໍ້ຄວາມທີ່ໄດ້ຮັບ:ຕົວຕອງເທີງສຸດຈະຖືກຮຽກໃຊ້ກອ່ນ </p>"
"<p>ຫາກທ່ານລື່ກກົດທີ່ປຸ່ມນີ້ທ່ານສາມາດຮຽກຄື່ນໄດ້ໂດຍກົດທີ່ປຸ່ມ<em>ເລືອ່ນລົງ</em>ຢູ່ດ້ານຂວາ</p></qt>"

#: kmfilterdlg.cpp:67
msgid ""
"<qt>"
"<p>Click this button to move the currently selected filter <em>down</em>"
" one in the list above.</p>"
"<p>This is useful since the order of the filters in the list determines the "
"order in which they are tried on messages: The topmost filter gets tried "
"first.</p>"
"<p>If you have clicked this button accidentally, you can undo this by "
"clicking on the <em>up</em> button (to the left)</p></qt>"
msgstr ""
"<qt>"
"<p>ກົົດປຸ່ມນີ້ເພື່ອໃຫ້ລາຍການຕົວກອງທີ່ເລືອກໄວ້ "
"<em>ເລືອນລົງ</em> "
"ຫນື່ງລະດັບໃນລາຍການດ້ານເທີ່ງ</p>"
"<p>ໃຊ້ເພື່ອຈັດລຳດັບຕົວກອງລາຍການ"
"ໃນການເລືອກລຳດັບຂອງຂອງການຈັດຂໍ້ຄວາມທີ່ໄດ້ຮັບ: "
"ຕົວກອງເທີງສຸດ"
"ຈະຖືກຮຽກໃຊ້ກ່ອນ</p>"
"<p>ຫາກທ່ານລືມກົດທີ່ປຸ່ມນີ້ທ່ານສາມາດຮຽກຄືນໄດ້ໂດຍກົດທີ່ປຸ່ມ"
"<em>ເລື່ອນຂື້ນ</em> "
"(ຢູ່ທາງດ້ານຊ້າຍ)</p></qt>"

#: kmfilterdlg.cpp:75
msgid ""
"<qt>"
"<p>Click this button to rename the currently selected filter.</p>"
"<p>Filters are named automatically, as long as they start with "
"\"<<\".</p>"
"<p>"
"If you have renamed a filter accidentally and want automatic naming back, "
"click this button and select <em>Clear</em> followed by <em>OK</em> in the "
"appearing dialog.</p></qt>"
msgstr ""
"<p>ກົດທີ່ປຸ່ມນີ້ເພື່ອປ່ຽນຊື່ຕົວກອງທີ່ເລືອກໄວ້ໃນປະຣຸບັນ</p>"
"<p>ປົກກະຕິແລ້ວຕົວຕອງຈະຖືກກຳນົດຊື່ໂດຍອັດຕະໂນມັດຫາກມັນເລີ່ມດ້ວຍ \" << \" </p>"
"<p>ຫາກທ່ານລື່ກກົດທີ່ປຸ່ມນີ້ທ່ານສາມາດຮຽກຄື່ນໄດ້ໂດຍກົດທີ່ປຸ່ມ<em>ເລືອ່ນລົງ</em>ຢູ່ດ້ານຂວາ</p></qt>"

#: kmfilterdlg.cpp:82
msgid ""
"<qt>"
"<p>Check this button to force the confirmation dialog to show up.</p>"
"<p>This is useful if you have defined a ruleset that tags messages to be "
"downloaded later. Without the possibility to force the dialog popup, these "
"messages could never be downloaded if no other large messages were waiting "
"on the server, or if you wanted to change the ruleset to tag the messages "
"differently.</p></qt>"
msgstr ""
"<qt> "
"<p>ກວດປຸ່ມນີ້ຈະທຳໃຫ້ໄດອະລອກຂອງການຢືນຢັນສະແດງຂື້ນມາ</p> "
"<p>ນີ້ແມ່ນຜົນປະໂຫຍດຖ້າທ່ານຈະກຳນົດຕັ້ງກົດເຊີງແຖກຂໍ້ຄວາມເປັນການດາວໂຫລດທີ່ຫລັງ,ປະສະຈາກ "
"ຄວາມເປັນໄປໄດ້ທີ່ຈະໃຫ້ໄດອະລອກຂື້ນມາ,ຂໍ້ຄວາມເຫລົ່ານີ້ບໍ່ສາມາດດາວໂຫລດ ຖ້າຂໍ້ຄວາມບໍ່ຍາວ ຈະໄດ້ "
"ລໍຖ້າເທີ່ງເຊີບເວີ ຫລື ຖ້າທ່ານຕອ້ງການປ່ຽນການຕັ້ງຂໍ້ກຳນົດແກ່ແຖັກຂໍ້ຄວາມທີ່ຕ່າງໄປ</p> "
"</qt>"

