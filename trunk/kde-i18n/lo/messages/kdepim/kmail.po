msgstr "ບໍ່ສາມາດຂຽນໄປຍັງແຟ້ມໄ້້ດ້"

#: kmmsgpartdlg.cpp:48
msgid "none (7-bit text)"
msgstr "ບໍ່ມີ(ຂໍ້ຄວາມ 7ບິດ)"

#: kmmsgpartdlg.cpp:49
msgid "none (8-bit text)"
msgstr "ບໍ່ມີ (ຂໍ້ຄວາມ 8ບິດ)"

#: kmmsgpartdlg.cpp:50
msgid "quoted printable"
msgstr "ສາມາດພິມໄດ້"

#: kmmsgpartdlg.cpp:51
