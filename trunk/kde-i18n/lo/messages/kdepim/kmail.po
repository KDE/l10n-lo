#: rc.cpp:64
msgid "Select Directory Services to Use Here"
msgstr "ເລືອກບໍລິການໄດເລັກເທີລີທີ່ຈະໄຊ້ທີ່ີນີ້"

#: rc.cpp:65
msgid ""
"<qt>\n"
"<h1>X.500 Directory Services</h1>\n"
"You can use X.500 directory services to retrieve certificates and "
"certificate revocation lists that are not saved locally. Ask your local "
"administrator if you want to make use of this feature and are unsure which "
"directory service you can use.\n"
"<p>\n"
"If you do not use a directory service, you can still use local "
"certificates.\n"
"</qt>"
msgstr ""
"<pt>\n"
"<h1>X.500.ຜູ້ອຳນວຍການບໍລິການ<h1>\n"
"ທ່ານສາມາດໃຊ້ X.500 ໄດຣເລັກເທີລີຣໃຊ້ບໍ່ລິການ ກູ້ໃບຮັບຮອງ ແລະ ຍົກເລີກ "
"ໃບຮັບຮອງ ທີ່ບໍ່ໄດ້ບັນທຶກໄວ້. ຖາມຜູ້ບໍ່ລິຫານຂອງເຈັ້າ ຖ້າຕ້ອງການໃຊ້ລັກສະນະນີ້ ແລະ "
"ບໍ່ແ່ນໃຈວ່າ ໄດຣເລັກເທີລີຣໃຊ້ບໍ່ລິການ ອັນໃດ ທີ່ ທ່ານສາມາດໃຊ້ໄດ້.\n"
"<p>\n"
"ຖ້າທ່ານບໍ່ໃຊ້ໄດຣເລັກເທີລີຣໃຊ້ບໍ່ລິການ, ທ່ານຈະຍັງຄົງຢູ່ທີ່ຕຳແໜ່ງທີ່ຮັບຮອງ.\n"
"</pt>"

#: rc.cpp:66
msgid "&Add Service..."
msgstr "ເ&ພີ່ມບໍລິການ...."

#: rc.cpp:67
msgid "Click to add a service"
msgstr "ຄຣິກເພື່ອເພີ່ມບໍລິການ"

#: rc.cpp:68
msgid ""
"<qt>\n"
"<h1>Add a Directory Service</h1>\n"
"By clicking this button, you can select a new directory service to be used "
"for retrieving certificates and CRLs. You will be asked for the server name "
"and an optional description.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ເພີ່ມDirectory ບໍລິການ</h1>\n"
"ໂດຍການກົດປຸ່ມນີທາ່ນເສາມາດເລືອກເອົາdirectoryໃໝ່ໄດ້ໂດຍການໃຊ້ບໍລິການ "
"ສໍາລັບການຮັບຮອງແກ້ ໄຂແລະCRLs.ທາ່ນຕອ້ງຖາມຊື່ຂອງ server ແລະທີ່ຂື້ນກັບຊະນິດ.\n"
"<pt>"

#: rc.cpp:69
msgid "&Remove Service"
msgstr "&ບໍ່ລິການລຶບ"

#: rc.cpp:70
msgid "Click to remove the currently selected service"
msgstr "ຄຣິກເພື່ອລົບບໍລິການທີ່ເລືອກໄວ້ໃນປະຈຸບັນ"

#: rc.cpp:71
msgid ""
"<qt>\n"
"<h1>Remove Directory Service</h1>\n"
"By clicking this button, you can remove the currently selected directory "
"service in the list above. You will have a chance to rethink your decision "
"before the entry is deleted from the list.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ບໍລິການຍາ້ຍDirectory</h1>\n"
"ໂດຍການຄີກປຸ່ມນີ້ທາ່ນສາມາດຍາ້ຍdirectoryທີ່ເລືອກຕາມລາຍການຂາ້ງເທີງນີ້ທາ່ນມີໂອກາດຄິດແລະຕັດສິນໃຈໃໝ່ກອ່ນຈະ"
"ລືບລາຍການ.\n</qt>"

#: rc.cpp:72
msgid "Local/Remote Certificates"
msgstr "ໃບຮັບຮອງພາຍໃນ/ໄລຍະໄກ"

#: rc.cpp:73 rc.cpp:83
msgid "&First local, then directory services"
msgstr "&ພາຍໃນກອ່ນ ຕາມດ້ວຍບໍລິການໄດເລັກເທີລີ"

#: rc.cpp:74
msgid "Click to use both local and remote certificates"
msgstr "ຄຣິກເພື່ອໄຊ້ທັງໃບຮັບຮອງພາຍໃນແລະໃບຮັບຮອງໄລຍະໄກ"

#: rc.cpp:75
msgid ""
"<qt>\n"
"<h1>First Local, Then Directory Services</h1>\n"
"When this option is selected, the email client will first try to find the "
"necessary certificates on your local computer. If they cannot be found "
"there, it will query the directory services specified in the list above in "
"the order given there.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ທີ່ຢູ່ປະຈຸບັນທໍາອິດຂະນະທີ່ບໍລິການdirectory</h1>\n"
"ເມື່ອຕົວປຽ່ນແປງຖືກເລືອກ emil client ຈະພະຍາຍາມຫາໃນຄອມພິວເຕີໃນປະຈຸບັນຖ້າມັນບໍເຫັນມັນຈະໃຫ້ທາ່ນເລືອກຕາມລາຍການຂາ້ງເທີງ"

#: rc.cpp:76 rc.cpp:86
msgid "&Local only, don't use directory services"
msgstr "&ພາຍໃນເທັ່ານັ້ນ ບໍ່ໄຊ້ຈາກບໍລິການໄດເລັກເທີລີ"

#: rc.cpp:77
msgid "Click to use only local certificates"
msgstr "ຄຣິກເພື່ອໄຊ້ໃບຮັບຮອງພາຍໃນເທົ່ານັ້ນ"

#: rc.cpp:78
msgid ""
"<qt>\n"
"<h1>Local Only, Don't Use Directory Services</h1>\n"
"When this option is selected, the email client will only try to find the "
"necessary certificates on your local computer. If they cannot be found "
"there, they are not available for the operation in question.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ພຽງແຕ່ໃຊ້ຕົວປະຈຸບັນບໍໃຊ້directoryອື່ນ"
"ເມື່ອຕົວປຽ່ນແປງຖືກເລືອກemil client ຈະພະຍາຍາມຫາໃນຄອມພິວເຕີໃນປະຈຸບັນຖ້າມັນບໍເຫັນມັນຈະໃຫ້ແລະຈະໃຫ້ຄໍາຖາມ"

#: rc.cpp:79 rc.cpp:89
msgid "&Directory services only, don't use locally saved information"
msgstr "&ຈາກບໍລິການໄດເລັກເທີລີເທົ່ານ້້ັ້ນ ບໍ່ໄຊ້ຂໍ້ມູນທີ່ບັນທືກໄວ້ພາຍໃນ"

#: rc.cpp:80
msgid "Click to use remote certificates only"
msgstr "ຄຣິກເພື່ອໄຊ້ໃບຮັບຮອງໄລຍະໄກເທົ່ານັ້ນ"

#: rc.cpp:81
msgid ""
"<qt>\n"
"<h1>Directory Services Only</h1>\n"
"When this option is selected, the email client will not use the certificates "
"on your local computer. Instead, it will query the directory services "
"specified in the list above in the order given there. If none of the "
"services has the certificate in question, it cannot be used for the "
"operation.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ບໍລິການໄຣເຣັກຕໍຣີເທົ່ານັ້ນ</h1>\n"
"ເມື່ືອສິດທີ່ການເລືອກນີ້ໄດ້ຖືເລືອກໄວ້,ຜູ້ໃຊ້ອິເມລຈະບ່ໃຊ້ການຢັ້ງຢືນພາຍໃນຄອມ"
"ພິວເຕີຂອງທ່ານ.ແທນທີ່ວ່າ,ມັນຈະຖາມເຈາະຈົງສະ"
"ເພາະການໃຊ້ໄດເຣັກຕໍຣີທີ່ຢູ່ໃນລາຍຂ້າງເທິງໃນຄຳສັ່ງທີ່ໃຫ້ໄວ້ນະທີ່ນັ້ນ."
"ຖ້າບໍ່ມີຄຳສັ່ງການນຳໃຊ້ທີ່ແນ່ນອນໃນຄຳຖາມ,ມັນກໍ່ບໍ່ສາມາດຖຶກໃຊເປັນລະບົບປະຕິ"
"ບັດການໄດ້.\n"
"</qt>"

#: rc.cpp:82
msgid "Local/Remote CRLs"
msgstr "CRL ພາຍໃນ/ໄລຍະໄກ"

#: rc.cpp:84
msgid "Click to use both local and remote CRLs"
msgstr ""
"ຄລິກເພື່ອໃຊ້ທັ່ງ CRL"
"ພາຍໃນແລະໄລຍະໄກ"

#: rc.cpp:85
msgid ""
"<qt>\n"
"<h1>First Local, Then Directory Services</h1>\n"
"When this option is selected, the email client will first try to find the "
"necessary certificate revocation lists (CRLs) on your local computer. If "
"they cannot be found there, it will query the directory services specified "
"in the list above in the order given there.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ທີ່ພັກທຳອິດ,ຫລັງຈາກນັ້ນໄດເຣັກຕໍຣີຈະໃຊ້</h1>\n"
"ເມື່ອສິດທິການເລືອກນີ້ໄດ້ຖືກເລືອກແລ້ວ,ຜູ້ຊົມໃຊ້ອິເມລຈະພະຍາຍາມທີ່ຈະຊອກຫາ"
"ລາຍການບັນຊີຍ້ຶອນຄືນກ່ຽວກັບການຢັ້ງຢືນທີ່ຈຳເປັນຫລື(CRLs)ພາຍໃນຄອມພິວເຕີ"
"ຂອງທ່ານ.ຖ້າຊີອາຣແອລດັ່ງກ່າວຫາກບໍ່ສາມາດຄົ້ນພົບທີ່ນັ້ນ,ມັນກໍ່ຈະຖາມຫາສະເພາະ"
"ການນຳໃຊ້ໄດເຣັກຕໍຣີທີ່ຢູ່ໃນບັນຊີຂ້າງເທິງທີ່ໃຫ້ໄວ້ຢູ່ແລ້ວເທົ່ານັ້ນ\n"
"</qt>"

#: rc.cpp:87
msgid "Click to use only local CRLs"
msgstr "ຄລິກເພືອໃຊ້CRLພາຍໃນເທົ່ານັ້ນ"

#: rc.cpp:88
msgid ""
"<qt>\n"
"<h1>Local Only, Don't Use Directory Services</h1>\n"
"When this option is selected, the email client will only try to find the "
"necessary certificate revocation lists (CRLs) on your local computer. If "
"they cannot be found there, they are not available for the operation in "
"question.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ພາຍໃນຄອມພິວເຕີເທົ່ານັ້ນ,ຢ່າໃຊ້ການບໍລິການໄດເຣັກຕໍຣີ</h1>\n"
"ເມື່ອສິດທິການເລືອກນີ້ໄດ້ຖືກເລືອກແລ້ວ,ຜູ່້ຊົມໃຊ້ອິເມລຈະພະຍາຍາມທີ່ຈະຊອກຫາ"
"ລາຍການບັນຊີຍ້ຶອນຄືນກ່ຽວກັບການຢັ້ງຢືນທີ່ຈຳເປັນຫລື(CRLs)ພາຍໃນຄອມພິວເຕີ"
"ຂອງທ່ານ.ຖ້າຊີອາຣແອລດັ່ງກ່າວຫາກບໍ່ສາມາດຄົ້ນພົບທີ່ນັ້ນ,ພວກມັນກໍ່ບໍ່ສາມາດ"
"ນຳໃຊ້ລະບົບປະຕິບັດການພາຍໃນຄຳຖາມໄດ້.\n"
"</qt>"

#: rc.cpp:90
msgid "Click to use remote CRLs only"
msgstr ""
"ຄລິກເພື່ອໃຊ້ CRL"
"ລະຍະໄກເທົ່ານັ້ນ"

#: rc.cpp:91
msgid ""
"<qt>\n"
"<h1>Directory Services Only</h1>\n"
"When this option is selected, the email client will not use the certificate "
"revocation lists (CRLs) on your local computer. Instead, it will query the "
"directory services specified in the list above in the order given there. If "
"none of the services has the certificate in question, it cannot be used for "
"the operation.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ໄດເຣັກຕໍຣີຈະໃຊ້ພຽງແຕ່</h1>\nເທົ່ານັ້ນ"
"ເມື່ືອສິດທີ່ການເລືອກນີ້ໄດ້ຖືເລືອກໄວ້,ຜູ້ໃຊ້ອິເມລຈະບ່ໃຊ້ການຢັ້ງຢືນພາຍໃນຄອມ"
"ພິວເຕີຂອງທ່ານ.ແທນທີ່ວ່າ,ມັນຈະຖາມເຈາະຈົງສະ"
"ເພາະການໃຊ້ໄດເຣັກຕໍຣີທີ່ຢູ່ໃນລາຍຂ້າງເທິງໃນຄຳສັ່ງທີ່ໃຫ້ໄວ້ນະທີ່ນັ້ນ."
"ຖ້າບໍ່ມີຄຳສັ່ງການນຳໃຊ້ທີ່ແນ່ນອນໃນຄຳຖາມ,ມັນກໍ່ບໍ່ສາມາດຖຶກໃຊເປັນລະບົບປະຕິ"
"ບັດການໄດ້.\n"
"</qt>"

#: rc.cpp:92
msgid "Encryption Configuration"
msgstr "ປັບແຕ່ງການເຂົ້າລະຫັດ"

#: rc.cpp:94
msgid "Encryption &algorithm:"
msgstr "ການຈັດຜິດ&ອັນກໍຣີດທມ໌:"

#: rc.cpp:95
msgid "Store saved messages &encrypted"
msgstr "ເກັບຈົດໝາຍທີ່ເຂົ້າລະຫັດໄວ້&ການຈັດຜິດ"

#: rc.cpp:96
msgid "Check to store messages encrypted "
msgstr "ກວດກາເພື່ອໃຫ້ເກັບຈົດໝາຍທີ່ເຂົ້າລະຫັດໄວ້"

#: rc.cpp:97
msgid ""
"<qt>\n"
"<h1>Store Messages Encrypted</h1>\n"
"When this box is checked, sent messages are stored encrypted like they were "
"sent. This is not recommended, as you will not be able to read the messages "
"any longer if a necessary certificate expires.\n"
"<p>\n"
"However, there may be local rules that require you to turn this option on. "
"When in doubt, check with your local administrator.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ຈົດໝາຍທີເກັບໄວ້ມີລະຫັດ</h1>\n"
"ໃນເມື່ອກ່ອງນີ້ແມ່ນກວດ ສົ່ງຈົດໝາຍແມ່ນໃສ່ລະຫັດໄວ້"
"ນີ່ີ້ບໍ່ມີຂໍ້ຄວາມ ຖ້າວ່າບໍ່ສາມາດອ່ານໄດ້.\n"
"<p>\n"
"ລອງກັບໄປເບີ່ງບ່ອນແກ້ໄຂ. "
".\n"
"</qt>"

#: rc.cpp:98
msgid "Encr&ypt all message parts"
msgstr "ເຂົ້າ&ລະຫັດຈົດໝາຍທຸກສວ່ນ"

#: rc.cpp:99
msgid "Check to have all message parts encrypted by default"
msgstr "ກົດເພື່ອໃຫ້ມີສ່ວນຂອງຈົດໝາຍທັງໝົດຖືກເຂົ້າລະຫັດໄວ້ເປັນຄ່າປະລີຍາຍ"

#: rc.cpp:100
msgid ""
"<qt>\n"
"<h1>Encrypt All Message Parts By Default</h1>\n"
"If this option is selected, all parts of a message (i.e. the main message "
"body and all attachments) are encrypted by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"message.\n"
"</qt>"
msgstr ""
"ພາກຂອງລະຫັດຂໍ້ຄວາມທັງໝົດດ້ວຍການປະລິຍາຍ</h1>\n"
"ຖ້າຮູບແບບແມ່ນຖືກເລືອກ,ທຸກພາກຂອງຂໍ້ຄວາມ(ຕົວຢ່າງແມ່ນຮ່າງຂອງຂໍ້ຄວາມຫຼັກແລະການຜູກມັດທັງໝົດ)ແມ່ນຖືກເຂົ້າ"
"ລະຫັດໂດຍປະລິຍາຍ\n"
"<p>\n"
"ການຕັ້ງຄ່າປະລິຍາຍນີ້,ເຈົ້າຢັງຄົງສາມາດຄວບຄຸມແຕ່ລະຂໍ້ຄວາມສ່ວນຕົວໄດ້\n"
"</qt>"

#: rc.cpp:101
msgid "Ask &before encrypting each part"
msgstr "ຖາມ&ກ່ອນເຮັດການເຂົ້າລະຫັດແຕ່ລະສ່ວນ"

#: rc.cpp:102
msgid "Check to be asked for each part whether to encrypt"
msgstr "ກົດເພື່ອໃຫ້ມີການຖາມກ່ອນທຳການເຂົ້າລະຫັດແຕ່ລະຫສ່ວນ"

#: rc.cpp:103
msgid ""
"<qt>\n"
"<h1>Ask Before Encrypting Each Part</h1>\n"
"When this option is selected, you will be asked for each part of the message "
"(i.e. the main message body as well as all attachments) individually whether "
"you want the part to be encrypted.\n"
"</qt>"
msgstr ""
" <qt>\n"
"<h1>ຖາມລາຍລະອຽດກ່ອນການຖອດລະຫັດແຕ່ລະພາກ</h1>\n"
"ເມື່ອຕົວເລືອກໄດ້ຖືກເລືອກ,ເຈົ້າຈະຖືກຖາມຫາຂໍ້ຄວາມແຕ່ລະພາກວ່າພາກໃດທີ່ເຈົ້າຕ້ອງການຖອດລະຫັດ.\n"
"</qt>"
"່"

#: rc.cpp:104
msgid "&Don't encrypt messages"
msgstr " &ບໍ່ເຂົ້າລະຫັດຈົດໝາຍ"

#: rc.cpp:105
msgid "Check for not encrypting a message by default"
msgstr "ກວດເບີ່ງບໍ່ໃຫ້ມີການເຂົາລະຫັດຈົດໝາຍເປັນຄ່າປະລີຍາຍ"

#: rc.cpp:106
msgid ""
"<qt>\n"
"<h1>Don't Encrypt Messages</h1>\n"
"If this option is selected, messages are not encrypted by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"setting.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ຢ່າຖອດລະຫັດຂໍ້ຄວາມ<h1>\n"
"ຖ້າຕົວເລືອກນີ້ໄດ້ຖືກເລືອກ,ຂໍ້ຄວາມກໍ່ບໍ່ຖືກຖອດລະຫັດໂດຍປະລິຍາຍ.\n"
"<p>\n"
"ນີ້ແມ່ນການຕິດຕັ້ງໂດຍປະລິຍາຍ,ເຈົ້າຢັງຄົງສາມາດຄວບຄຸມແຕ່ລະການຕິດຕັ້ງສ່ວນຕົວໄດ້\n"
"</qt>"

#: rc.cpp:107
msgid "Triple-DES"
msgstr "DESສາມເທື່ອ"

#: rc.cpp:108
msgid "Selects the encryption algorithm"
msgstr "ເລືອກອັກກໍລີທືມການເຂົ້່າລະຫັດ"

#: rc.cpp:109
msgid ""
"<qt>\n"
"<h1>Encryption Algorithm</h1>\n"
"An algorithm is a description for the computer on how it should perform a "
"certain task. The encryption algorithm describes how the computer applies "
"your recipient's key to your message so that only the intended receiver can "
"read the message.\n"
"<p>\n"
"The selection of a certain encryption algorithm determines how easy or how "
"difficult it is to intercept and read a message. However, all algorithms "
"provided in the SPHINX environment are considered to be very safe. "
"Generally, the default will work just fine here.\n"
"<p>\n"
"This setting is a default, you can override it for each individual message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ການຄຳນວນການຖອດລະຫັດ</h1>\n"
"ການຄຳນວນກໍ່ແມ່ນການເວົ້າເຖິງຄອມພິວເຕີວ່າມັນຄວນຈະທຳງານໃນວຽກງານຫຼັກຂອງມັນ.ການຄຳນວນການຖອດລະຫັດ"
"ແມ່ນເວົ້າເຖິງຄອມພີວເຕີວ່າມັນຕອບສະໜອງແນວໃດຕໍ່ກັບຄີຣທີ່ໄດ້ຮັບຂອງເຈົ້າໃນຂໍ້ຄວາມສະນັ້ນມີພຽງແຕ່ຜູ້ຮັບທີ່ໄດ້ລະບຸ"
"ໄວ້ແລ້ວຈິ່ງສາມາດອ່ານຂໍ້ຄວາມໄດ້.\n"
"<p>\n"
"ການເລືອກຂອງການຄຳນວນຖອດລະຫັດຖືກກຳນົດວ່າມັນງ່າຍຫຼືມັນຢາກແນວໃດເມື່ອມັນຖືກກີດກັ້ນແລະການອ່ານຂໍ້ຄວາມ."
"ເເນວໃດກໍ່ຕາມ,ການຄຳນວນທັງໝົດແມ່ນຖືກຈັດໄວ້ໃນSPHINXສະພາບແວດລ້ອມຂອງມັນແມ່ນອີງໃສ່ຄວາມປອດໄພ."
"ໂດຍທົ່ວໄປແລ້ວ,ການປະລິຢ່າງຈະເຮັດວຽກດີເມື່ອຢູ່ໃນທີ່ນີ້.\n"
"<p>\n"
"ການຕິດຕັ້ງນີ້ແມ່ນເປັນຢ່່າງປະລິຍາຍ,ເຈົ້າຢັງຄົງສາມາດຄວບຄຸມແຕ່ລະຂໍ້ຄວາມສ່ວນຕົວໄດ້\n"
"</qt>"

#: rc.cpp:110
msgid "Certificates"
msgstr "ໃບຮັບຮອງ"

#: rc.cpp:112
msgid "Check can end with locally sa&ved certificate"
msgstr "ກວດສອບໃບຮັບຮອງສາ&ມາດຈັບໄດ້ດ້ວຍໃບຮັບຮອງພາຍໃນທີ່ບັນທືກໄວ้"

#: rc.cpp:113
msgid "Check to end with locally saved certificate."
msgstr "ກວດສອບເບິ່ງຕອນຈົບຂອງການບັນທຶກໃບຮັບຮອງ"

#: rc.cpp:114
msgid ""
"<qt>\n"
"<h1>Certificate Check Can End With Locally Saved Certificate</h1>\n"
"If this option is checked, the check of the certificate chain can end with a "
"locally saved certificate.\n"
"<p>\n"
"Locally saved certificates are your own certificates as well as the "
"certificates of communication partners and certification authorities (CAs).\n"
"</h1>"
msgstr ""
"<qt>\n"
"<h1>ການກວດຊອບໃບຮັບຣອງແມ່ນສາມາດຈົບດ້ວຍການບັນທຶກໃບຮັບຮອງ</h1>\n"
"ຖ້າຕົວເລກແມ່ນຖືກກວດສອບ,ຕ່ອງໂສ້ຂອງການກວດຊອບຂອງບົດຮັບຮອງແມ່ນສາມາດຈົບດ້ວຍການບັນຖຶກໃບຮັບຮອງ.\n"
"<p>\n"
"ການບັນຖຶກບົດຮັບຮອງທົ່ວໄປແມ່ນຈະເຮັດບົດທີ່ຈະເປັນເຈົ້າໃຫ້ດີເທົ່າທີດີໄດ້ໃນການຕິດຕໍ່ຂອງຄູ່ແລະຂອງຄະນະໃບຮັບຮອງ"
"(CAs).\n"
"</h1>"

#: rc.cpp:115
msgid "Always c&heck to root certificate"
msgstr "ກວດ&ສອບເສັ້ນທາງຂອງໃບຮັບຮອງໄປຍັງໃບຮັບຮອງລູດສະເໝີ"

#: rc.cpp:116
msgid "Check here to check up to the root certificate"
msgstr "ກວດສອບທີ່ນີ້ເພື່ອກວດສອບໃບຢັ້ງຢືນລູບທ໌ "

#: rc.cpp:117
msgid ""
"<qt>\n"
"<h1>Always Check Certificate Path To Root Certificate</h1>\n"
"If this option is turned on, the certificate path belonging to the "
"receiver's certificate will always be checked all the way to the root "
"certificate.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ກວດສອບໃບເດີນທາງແມ່ນໃບຢັ້ງຢືນລູບທ໌ຂອງ</h1>\n ຖ້າເປີດຕົວເລືອກ,ໃບຫນັງສືການເດີນທາງທີ່ຍາວມີຜູ້ຮັບໃບສະເຫນີເລື້ອຍໆທີ່ເປັນການກວດທຸກວິທີຂອງຫນັງສືລູບທ໌\n <qt>"

#: rc.cpp:118
msgid "Check certificate &path"
msgstr "ກວດສອບ&ພາດຂອງໃບຮັບຮອງ"

#: rc.cpp:119
msgid "Check here to have the whole certificate path checked"
msgstr "ເຊັກທີ່ນີ້ເພື່ອໃຫ້ມີການກວດສອບເສັ້ນທາງໄປຍັງໃບຮັບຮອງ"

#: rc.cpp:120
msgid ""
"<qt>\n"
"<h1>Check Certificate Path</h1>\n"
"If this option is turned on, the whole path of the receiver's certificate up "
"to the root will be checked.\n"
"<p>\n"
"Note that it is not possible to turn off checking the receiver's certificate "
"itself.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1> ກວດສອບໃບຫນັງສືການເດີນທາງຂອງ</h1>\n ຖ້າຕົວເລືອກເປີດ, ສຳລັບຜູ້ເປີດຂື້ນໄປກວດສອບໃບຫນັງສື"
"ເດີນທາງລູບທ໌ທັງຫມົດຈະເປັນ\n"
"<p>\n ບັນຫາຂອງການຂຽນແມ່ນບໍ່ໄດ້ປິດການກວດສອບຂອງຜູ້ກວດໃບສະເຫນີກ່ຽວກັບມັນ.\n"
"</qt>"

#: rc.cpp:122
msgid "&Use certificate revocation lists (CRLs)"
msgstr "&ລາຍການໃຊ້ໃບສະເຫນີແມ່ນຍົກເລີກ(CRLs)"

#: rc.cpp:123
msgid "Check to use CRLs"
msgstr "ກວດເບິ່ງການໃຊ້ລະຫັດ CRLs "

#: rc.cpp:124
msgid ""
"<qt>\n"
"<h1>Use Certificate Revocation Lists (CRLs)</h1>\n"
"A certificate revocation list contains certificates that have been withdrawn "
"and should not be used for encryption purposes any longer. A user may wish "
"to have his or her certificate revoked because he or she suspects that the "
"certificate's integrity has been compromised (e.g. somebody has guessed the "
"PIN).\n"
"<p>\n"
"It is recommended to use CRLs for maximum security. In the configuration "
"dialog for certificate and CRL management, you can select where to retrieve "
"the CRLs from.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ໃຊ້ລາຍຊື່ຢັ້ງຢືນການຮຽກຄືນ (CRLs)</h1>\n"
"ມັນເປັນການຢັ້ງຢືນລາຍຊື່ການຄວບຄຸມຂອງການຮຽກຮ້ອງ\n"
"</qt> "

#: rc.cpp:125
msgid "Warn if CRL e&xpires in less than"
msgstr "ແຈ້ງເຕືອນ ຖ້າ CRL ໝົດ&ອາຍຸນ້ອຍກວ່າ"

#: rc.cpp:126
msgid "Check to be warned if a CRL expires in the near future"
msgstr "ກວດຄຳເຕື່ອນຖ້າ CRL ສີ້ນສຸດໃນອານາຄົດ"

#: rc.cpp:127
msgid ""
"<qt>\n"
"<h1>Warn If CRL Expires In The Near Future</h1>\n"
"If this box is checked, you will be warned if one of the CRLs you are using "
"is about to expire in the near future.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1> ຖ້າCRL ເຕືອນໃຫ້ຮູ້ວ່າໄດ້ຈະສີ້ນສຸດໃນອານາຄົດ</h1>\n"
"ເຈົ້າໃຊ້ CRLs ,ມັນຈະເຕືອນໃຫ້ເຈົ້າຮູ້ເພື່ອກວດເບີ່ງກັບ ຈຸດໃນອະນາຄົດ </qt>"

#: rc.cpp:128 rc.cpp:138 rc.cpp:144 rc.cpp:246 rc.cpp:255 rc.cpp:258
#: vacationdialog.cpp:58
msgid " days"
msgstr "ມື້"

#: rc.cpp:129
msgid "Number of days before warning"
msgstr "ຈຳນວນວັນກອ່ນທຳການແຈ້ງເຕືອນ"

#: rc.cpp:130
msgid ""
"<qt>\n"
"<h1>Warn If CRL Expires In The Near Future</h1>\n"
"In this field you can specify how soon before a CRL expires you are warned "
"about this expiry.\n"
"<p>\n"
"The recommended setting for the SPHINX environment is 7 days.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ຄຳເຕືອນ  ຖ້າຈຸດສິ້ນສຸດຈະໃກ້ໃນອະນາຄົດ</h1>\n"
"ໃນນີ້ທ່ານສາມາດລະບຸການໃກ້ເຂົ້າຂອງ CRL ຈຸດສິ້ນສຸດແມ່ນຈະເຕືອນໃຫ້ຮູ້ຂອງການສິ້ນສຸດ.\n"
"<p>\n"
"ແນະນຳການຕັ້ງທົ່ວໄປຂອງ SPHINX ແມ່ນ 7ມື້.\n"
"</qt>"

#: rc.cpp:131
msgid "Always encrypt &to self"
msgstr " ລະຫັດ&ດ້ວຍຕົວເອງເລືອຍຯ"

#: rc.cpp:132
msgid "Check to have encrypted messages also encrypted using your own key."
msgstr "ກົດເພື່ອໃຫ້ມີສ່ວນຂອງຈົດໝາຍທັງໝົດຖືກເຂົ້າລະຫັດໄວ້ເປັນຄ່າປະລີຍາຍ"

#: rc.cpp:133
msgid ""
"<qt>\n"
"<h1>Always encrypt to self</h1>\n"
"If this box is checked, encrypted messages sent by you will also be "
"encrypted using your own key.\n"
"<p>\n"
"It is recommended to leave this option turned on to enable you to read the "
"messages you have sent.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ມີລະຫັດດ້ວຍຕົວມັນເອງ</h1>\n"
"ຖ້າກັບນີ່ແມ່ນຖືກກວດ,ລະຫັດຈົດໝາຍສົ່ງໂດຍທ່ານ ໂດຍທ່ານຈະໃຊ້ລະຫັດໂດຍການກົດດ້ວຍຕົວທ່ານເອງ.\n"
"<p>\n"
"ມັນແມ່ນການແນະນຳການອອກຈາກຕົວປ່ຽນແປງທີ່ຈະກັບຄືນເທີ່ງຂອງການທຳງານຂອງການອ່ານຈົດໝາຍທີ່ສົ່ງ.\n"
"</qt>"

#: rc.cpp:134 rc.cpp:239
msgid "Warnings"
msgstr "ຄຳເຕືອນຂອງ KMail"

#: rc.cpp:135
msgid "&Warn when trying to send unencrypted messages"
msgstr "&ແຈ້ງເຕືອນເມື່ອພະຍາຍາມສົ່ງຈົດໝາຍທີ່ບໍ່ໄດ້ເຂົ້າລະຫັດໄວ້"

#: rc.cpp:136
msgid "Check to be warned when sending unencrypted messages."
msgstr "ກວດເພື່ອໃຫ້ມີການເຕືອນເມືອມີການສົ່ງຈົດໝາຍທີ່ບໍ່ໄດ້ເຂົ້າລະຫັດໄວ້"

#: rc.cpp:137
msgid ""
"<qt>\n"
"<h1>Warn When Trying To Send Unencrypted Messages</h1>\n"
"If this box is checked, you will be warned when you try to send parts of or "
"the whole message unencrypted.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum integrity.\n"
"</qt>"
msgstr ""
"qt>\n"
"<h1>ເຕືອນວ່າຂະນະທີ່ທ່ານສ່ົງຈົດໝາຍບໍ່ມີລະຫັດ</h1>\n"
"ຖ້າກັບນີ້ຖື່ກກວດ, ທ່ານຈະຖືກເຕືອນຂະນະທີ່ທ່ານພະຍາຍາມສົ່ງສ່ວນຫນື່ງຂອງຈົດໝາຍໂດຍບໍ່ໄດ້ໃຊ້ລະຫັດ.\n"
"<p>\n"
"ແມ່ນແມ່ນການແນະນຳການອອກຈາກຕົວປ່ຽນແປງທີ່ກັບໄປເປັນຄ່າໃຫຍ່ສຸດພຽງອັນດ່ຽວ.\n"
"</qt>"

#: rc.cpp:139 rc.cpp:145 rc.cpp:247 rc.cpp:256 rc.cpp:259
msgid "Select the number of days here"
msgstr "ເລືອກຈຳນວນຂອງວັ້ນທີ່ນີ້"

#: rc.cpp:140
msgid ""
"<qt>\n"
"<h1>Warn If A Certificate In The Chain Expires</h1>\n"
"Select the minimum number of days all certificates in the chain should be "
"valid without issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ເຕືອນຖ້າໃບຮັບຮອງໃນຈົດໝາຍລູກຕໍ່ເນື່ອງ</h1>\n"
"ເລືອກຄ່ານອ້ຍສຸດຂອງຕົວເລກທັງໝົດຂອງໃບຮັບຮອງໃນຂອງຈົດໝາຍຕໍເນື່ອງເຊີ່ງປາດສະຈາກຫົວຂໍ້ເຕືອນ.\n"
"<p>\n"
"ການແນະນຳ ຕັ້ງຄ່າ SPHINX ແມ່ນ 14 ມື້.\n"
"</qt>"

#: rc.cpp:141
msgid "Warn if a certificate in &the chain expires in less than"
msgstr "&ກວອການເຕືອນຖ້າວ່າປາຍທາງແມ່ນໃກ້"

#: rc.cpp:142 rc.cpp:148 rc.cpp:244 rc.cpp:250 rc.cpp:253
msgid "Check to be warned if the certificate expires soon"
msgstr "ກວອການເຕືອນຖ້າວ່າປາຍທາງແມ່ນໃກ້"

#: rc.cpp:143 rc.cpp:149
msgid ""
"<qt>\n"
"<h1>Warn If Certificate Expires</h1>\n"
"If this option is checked, then you will be warned when trying to use a "
"certificate for encrypting that expires within the specified amount of "
"days.\n"
"<p>\n"
"It is recommended to keep this option turned on to avoid using certificates "
"that expire in the near future.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ເຕືອນຖ້າໃບຮັບຮອງໝົດອາຍຸ</h1>\n"
"ຖ້າຕົວເລືອກນີ້ມກວດ, ທ່ານຈະໄດ້ຮັບການເຕືອນຂະນະທີ່ກຳລັງພິມໃຊ້ລະໃບຮັບຮອງສຳລັບລະຫັດ ການໝົດອາຍຸ ກັບລຸບຸມື້ຫົມດອາຍຸ.\n"
"<p>\n"
"ມັນຈະແນະນຳໃຫ້ຕົວເລືອກນີ້ກັບຄືນໄປຫາໃບຮັບຮອງທີ່ໃກ້ຈະໝົດອາຍຸໃນອະນາຄົດ.\n"
"</qt>"

#: rc.cpp:146
msgid ""
"<qt>\n"
"<h1>Warn If Encryption Certificate Expires</h1>\n"
"Select the minimum number of days the encryption certificate should be valid "
"without issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ເຕືອນວ່າລະຫັດຂອງໃບຮັບຮອງໝົດອາຍຸ</h1>\n"
"ເລືອກຕົວນ້ອຍສຸດຂອງຕົວເລກຂອງມື້ຂອງລະຫັດໃບຮັບຮອງເພື່ອບໍ່ໃຫ້ມີການເຕືອນ.\n"
"<p>\n"
"ແນະນຳໃຫ້ຕັ້ງຄ່າ SPHINX ແມ່ນ 14 ມຶ້.\n"
"</qt>"

#: rc.cpp:147
msgid "Warn if &receiver certificate expires in less than"
msgstr "ເຕືອຍ&ໃບຮັບຮອງຜູ້ຮັບຫມົດອາຍຸ"

#: rc.cpp:150
msgid "Warn if receiver's email address is &not in certificate"
msgstr "ເຕືອນຖ້າທີ່ຢູ່ອີເມລຂອງຜູ້ຮັບແມ່ນ&ບໍ່ຢູ່ໃນໃບຮັບຮອງ"

#: rc.cpp:151 rc.cpp:262
msgid "Check to be warned if the address is not in the certificate"
msgstr "ກວດແລະເຕືອນຖ້າວ່າທີ່ຢູ່ແມ່ນບໍ່ຢູ່ໃນໃບຮັບຮອງ"

#: rc.cpp:152
msgid ""
"<qt>\n"
"<h1>Warn If Receiver's Email Address Is Not In Certificate</h1>\n"
"If this option is checked, a warning is issued if the email address of the "
"receiver is not contained in the certificate used for encrypting.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum security.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ເຕືອນທີຢູ່ອີເມລຂອງຜູ້ຮັບບໍ່ມີໃບຮັບຮອງ</h1>\n"
"ຖ້າແມ່ນຕົວປ່ຽນແປງນີ້ກວດກາ,ຫົວຂໍ້ຄຳເຕືອນແມ່ນຖ້າທີ່ຢູ່ອີເມລຈາກຜູ້ຮັບແມ່ນບໍ່ໄດ້ບັນຈຸໃນໃບຮັບຮອງໃຊ້ລະຫັດ.\n"
"<p>\n"
"ຈະແນະນຳການອອກຈາກຕົວປ່ຽນແປງແລະກັບໄປໃນຄ່າສູງສຸດຂອງການປ້ອງກັນ.\n"
"</qt>"

#: rc.cpp:153
msgid "Folder Properties"
msgstr "ຕຳແຫນ່ງໂຟເດີ"

#: rc.cpp:154
msgid "General"
msgstr "ທົ່ວໄປ"

#: rc.cpp:156
msgid "Folder holds a &mailing list"
msgstr "&ໂຟເດີເກັບຈົດໝາຍວຽນ"

#: rc.cpp:158
msgid "List address:"
msgstr "ທີ່ຢູ່ທາງໄປສະນີ:"

#: rc.cpp:161
msgid "Unread:"
msgstr "ຍັງບໍ່ໄດ້ອ່ານ:"

#: rc.cpp:162
msgid "Normal:"
msgstr "ທຳມະດາ:"

#: rc.cpp:163
msgid "Expiring Old Messages"
msgstr "ໃຫ້ຈົດໝາຍເກົ່າໝົດອາຍຸ?"

#: rc.cpp:164 rc.cpp:166
msgid "Expire after:"
msgstr "ໂຟເດີໝົດອາຍຸ"

#: rc.cpp:165
msgid "Expire read messages"
msgstr "ໃຫ້ຈົດໝາຍເກົ່າໝົດອາຍຸ?"

#: rc.cpp:167
msgid "Expire unread messages"
msgstr "ຈົດໝາຍເກົ່າທີ່ໝົດອາຍຸ"

#: rc.cpp:174
msgid "Advanced"
msgstr "ຕົວເລືອກເພີ່ມເຕີ່ມ"

#: rc.cpp:175
msgid "&Format:"
msgstr "&ທຳມະດາ:"

#: rc.cpp:180
msgid "Show Sender/Receiver:"
msgstr "ສະແດງ ຜູ້ສົ່ງ/ຜູ້ຮັບ"

#: rc.cpp:181
msgid "Signature Configuration"
msgstr "ປັບແຕ່ງລາຍເຊັ່ນ"

#: rc.cpp:182
msgid "Sending Certificates"
msgstr "ການສົ່ງໃບຮັບຮອງ"

#: rc.cpp:183
msgid "&Don't send certificates"
msgstr "ຢ່າສົ່ງ&ໃບຮັບຮອງ"

#: rc.cpp:184 rc.cpp:187 rc.cpp:190 rc.cpp:193
msgid "Selects which certificates to send"
msgstr "ເລືອກໃບຮັບຮອງທີ່ຈະສົ່ງ"

#: rc.cpp:185 rc.cpp:188 rc.cpp:191 rc.cpp:194
msgid ""
"<qt> "
"<h1>Sending Certificates</h1> Without your certificate, the receiver will "
"not be able to determine whether it was really you who sent the message or "
"whether the message was altered by a third party. "
"<p> The receiver can obtain your certificate from a central server, but you "
"can also opt to enclose your certificate with your message. You can select "
"whether you do not want to include a certificate at all, only your own "
"certificate or the whole chain of certificates that certify your own "
"certificate, including or excluding the root certificate. "
"<p> It is recommended to always include at least your own certificate with "
"the message. "
"<p> This setting is a default, you can override it for each individual "
"message. </qt>"
msgstr ""
"<qt> "
"<h1>ສົ່ງໃບຮັບຮອງ</h1> ປາດສະຈາກໃບຮັບຮອງຂອງທ່ານ,ຜູ້ຮັບຈະບໍ່ແມ່ນຕັ້ງໃຈຢ່າງແທ້ຈາກທ່ານ ໃຜສົ່ງຈົດໝາຍຫລືສົ່ງເຊີນຊວນຈາກບຸກຄົນທີ່ສາມ. "
"<p>ຜູ້ຮັບສາມາດບັນຈຸໃບຮັບຮອງຂອງທ່ານຈາກເຊີບເວີບກາງ ແຕ່ວວ່າທ່ານສາມາດປິດໃບຮັບຮອງຂອງທ່ານກັບຈົດໝາຍຂອງທ່ານ.ທ່ານສາມາດເລືອກວ່າທ່ານບໍ່ຕ້ອງການການລວມໃບຮັບຮອງທັງຫມົດພຽງແຕ່ໃບຮັບຮອງຂອງທ່ານຫລື ໃບຮັບຮອງແບບຕໍ່ເນືອງ,ລວມ ຫລື ບໍ່ລວມກັບໃບຮັບຮອງຂອງ ລຸດ. "

#: rc.cpp:186
msgid "Send &your own certificate"
msgstr "ສົ່ງ&ໃບຮັບຮອງຂອງທ່ານ"

#: rc.cpp:189
msgid "Send certificate chain &without root"
msgstr "ສົ່ງລູກໂຊ້&ຮັບຮອງໂດຍບໍ່ມີລູດ"

#: rc.cpp:192
msgid "Send certificate c&hain with root"
msgstr "ສົ່ງລູກ&ໂຊ້ໃບຮັລຮອ້ງໂດຍມີລູດ"

#: rc.cpp:195
msgid "Signatures"
msgstr "ລາຍເຊັ່ນ"

#: rc.cpp:196
msgid "Sign all message &parts"
msgstr "ເຊັ່ນທຸກສ່ວນ&ຂອງຈົດໝາຍ"

#: rc.cpp:197
msgid "Check to have all message parts signed by default"
msgstr "ວດວ່າມີສວ່ນຫນື່ງຂອງຈົດໝາຍທັງໝົດຂອງການເຂົາເຖີ່ງໂດຍຄ່າປະລິຍາຍ"

#: rc.cpp:198
msgid ""
"<qt>\n"
"<h1>Sign All Message Parts By Default</h1>\n"
"If this option is selected, all parts of a message (i.e. the main message "
"body and all attachments) are signed by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ເຂົ້າໄປໃນທັງໝົດຂອງຈົດໝາຍສ່ວນຫນືງໂດຍຄ່າປະລິຍາຍ</h1>\n"
"ຖ້າຕົວເລືອກນີ້ແມ່ນຖືກເລືອກ,ສ່ວນຫນືງຂອງຈົດໝາຍທັງຫົມດ (i.e.ໝາຍເຖິ່ງສ່ວນກະໂຕຂອງຈົດໝາຍແລະທັງໝົດຂອງການແນບໄຟ)ແມ່ນເຂົ້າໂດຍຕັ້ງຄ່າປະລິຍາຍ.\n"
"<p>\n"
"ນີ້ແມ່ນຕັ້ງຄ່າປະລິຍາຍ,ທ່ານສາມາດຍັງຄົງມີຄ່າຕອບແທນຈາກແຕ່ລະຜົນປະໂຫຍດຈົດໝາຍ.\n"
"</qt>"

#: rc.cpp:199
msgid "Ask &before signing each part"
msgstr "ໃຫ້&ຖາມກ່ອນທຳການເຊັ່ແຕ່ລະສ່ວນ"

#: rc.cpp:200
msgid "Check to be asked for each part whether to sign"
msgstr "ກວດແລະຖາມຂອງແຕ່ລະສ່ວນຂອງການເຂົ້າໄປໃນ"

#: rc.cpp:201
msgid ""
"<qt>\n"
"<h1>Ask Before Signing Each Part</h1>\n"
"When this option is selected, you will be asked for each part of the message "
"(i.e. the main message body as well as all attachments) individually whether "
"you want the part to be signed.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ຖາມກອ່ນເຂົ້າໄປ</h1>\n"
"ຂະນະຕົວເລືອກນີ້ຖື່ກເລືອກ,ທ່ານຈະຖາມແຕ່ລະສ່ວນຂອງຈົດໝາຍ"
"(i.e. ໝາຍວ່າກະໂຕຂອງຈົດໝາຍແມ່ນດີແລະທັງໝົດການແນບໄຟ) ທ່ານຕ້ອງການເຂົາຫາ.\n"
"</qt>"

#: rc.cpp:202
msgid "Don'&t sign messages"
msgstr "ບໍ່&ໃຫ້ເຊັ່ນຈົດໝາຍ"

#: rc.cpp:203
msgid "Check for not signing a message by default"
msgstr "ກວດສຳລັບບໍ່ເຂົ້າໄປຕັ້ງຄ່າປະລິຍາຍ"

#: rc.cpp:204
msgid ""
"<qt>\n"
"<h1>Don't Sign Messages</h1>\n"
"If this option is selected, messages are not signed by default.\n"
"<p>\n"
"This is a default setting, you can still override it for each individual "
"setting.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ບໍ່ເຂົ້າໄປໃນຈົດໝາຍ</h1>\n"
"ຖ້າຕົວເລືອກນີ້ຖືກເລືອກ,ຈົດໝາຍແມ່ນບໍ່ໄດ້ຕັ້ງຄ່າເປັນປະລິຍາຍ.\n"
"<p>\n"
"ນີ້ແມ່ນຕັ້ງຄ່າປະລິຍາຍ,ທ່ານສາມາດຍັງຄົງໄດ້ຮັບຜົນປະໂຫຍດຂອງການຕັ້ງຢູ່.\n"
"</qt>"

#: rc.cpp:205
msgid "The signature certificate is configured on the <em>Certificates</em> page!"
msgstr ""
"ລາຍເຊັ່ນຂອງໃບຮັບຮອງແມ່ນແກ້ໄຂເທີ່ງ <em> "
"ຫນ້າໃບຮັບ</em>ຮອງ!"

#: rc.cpp:206
msgid "RSA + SHA-1"
msgstr "RSA + SHA-1"

#: rc.cpp:207
msgid "Selects the signature algorithm"
msgstr "ເລືອກອັລກໍລີທືກຂອງລາຍເຊັ່ນ"

#: rc.cpp:208
msgid ""
"<qt>\n"
"<h1>Signature Algorithm</h1>\n"
"An algorithm is a description for the computer on how it should perform a "
"certain task. The signature algorithm describes how the computer applies "
"your signature key to your message so that the receiver can determine "
"whether the message really is from you.\n"
"<p>\n"
"The selection of a certain signature algorithm determines how easy or how "
"difficult it is to forge a message. However, all algorithms provided in the "
"SPHINX environment are considered to be very safe. Generally, the default "
"will work just fine here.\n"
"<p>\n"
"This setting is a default, you can override it for each individual message.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ລາຍເຊັ່ນອໍກໍລິທືມ</h1>\n"
"ອໍກໍລິທືມແມ່ນການບັນຍາຍສຳລັບຄອມພິວເຕີ້ເທີ່ງແຖບ.ລາຍເຊັ່ນອໍກໍລີທືມບັນຍາຍການທີ່ຄອມພິວເຕີບອກເຖີງປຸ່ມລາຍເຊັ່ນຂອງທ່ານໄປຫາຈົດໝາຍຂອງທ່ານ ເຊີ່ງຜູ້ຮັບຈະສາມາດໃຊ້ເຄືອງມືໃນຈົດໝາຍໄດຈາກທ່ານ.\n"
"<p>\n"
"ການເລືອກລາຍເຊັ່ນທີ່ບໍ່ຈຸທີ່ອໍກໍລີທືມ ແລະບອກໃຫ້ເຖີ່ງການໃຊ້ທີ່ງາ່ຍແນວໃດຍາກແນວໃດໂດຍທີ່ຢູ່ໃນຈົດໝາຍ.ເຖີ່ງຢ່າງໃດກໍຕາມທັງໝົດຂອງອໍກໍລີທືມພາຍໃຕ້ເງືືອນໄຂໃ"

#: rc.cpp:209
msgid "Signature &algorithm:"
msgstr "&ອັລກໍລີທືມຂອງລາຍເຊັ່ນ:"

#: rc.cpp:210
msgid "&Store messages with signatures"
msgstr "&ເກັບຈົດໝາຍທີ່ມີລາຍເຊັ່ນໄ້ວ"

#: rc.cpp:211
msgid "Check to store messages with their signatures"
msgstr "ກວດໃນການບັນທືກຈົດໝາຍກັບລາຍເຊັ່ນຂອງພວກເຂົາ"

#: rc.cpp:212
msgid ""
"<qt>\n"
"<h1>Store Messages With Signatures</h1>\n"
"When this box is checked, sent messages are stored together with the "
"signatures applied to them. This is recommended, because it enables you to "
"check later whether you signed a message or a certain part of it.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ບັນືກຈົດໝາຍກັບລາຍເຊັ່ນ</h1>\n"
"ຂະນະທີ່ມີການກວດໃນກັບ,ສົ່ງຈົດໝາຍ ແມ່ນຖືກບັນືກນຳກັບລາຍເຊັ່ນພວກເຂົາ. ນີ້ແມ່ນການແນະນຳ,ເພາະວ່າມັນທຳງານ ກວດກາຈົດໝາຍລາຍເຊັ່ນຂອງຈົດໝາຍທີ່ບັນຈຸໃນສ່ວນຫນື່ງຈາກມັນ.\n"
"</qt>"

#: rc.cpp:214
msgid "Standa&rd MIME"
msgstr "ສ່ວນ&ຫວົມາດາຕະຖານ"

#: rc.cpp:215
msgid "A Multipart/Signed holding Signature and signed data."
msgstr ""
"ສ່ວນຫລາຍ/ລາຍເຊັ່ນການຢືດເຄືອງໝາຍແລະຂໍ້ມູນ "
"ເຄືອງໝາຍ"

#: rc.cpp:216
msgid ""
"<qt>\n"
"<h1>Multipart detached signature</h1>\n"
"When this option is selected, the signature and the signed data will be "
"separate parts of a Multipart/Signed message part. Signed message data will "
"be readable even by Mail User Agents not supporting the signaturing "
"algorithm and not supporting ASN.1 decoding.\n"
"</qt>"
msgstr ""
"<qt>\n"
"       <h1>ລາຍເຊັນສ່ວນຫລາຍແຍກຕາ່ງຫາກ<h1>\n.ເມື່່ອຕົວເລືອກຖືກເລືອກ,ລາຍເຊັນແລະຂໍ້ມູນເຄື່ອງຫມາຍຈະຖືກແຍກດປັນສ່ວນຂອງຫລາຍສ່ວນ/ສ່ວນຂາ່ວສານເຄື້ອງຫມາຍ. ຂໍ້ມູນຂາ່ວສານເຄື້ອງຫມາຍ ຈະສະຫມ່ຳ່ສະເຫມີເປັນຕາອາ່ນດ້ວຍການບໍ່ສະຫນັບສະຫນູນຕົົວແທນຜູ້ໄຊ້ຈົດຫມາຍ. ການເຊັນອອນໂຈລີດທແລະບໍ່ສະຫນັບສະຫນູນASN.1 ຖອດ\n</qt>"

#: rc.cpp:217
msgid "Opa&que (only recommended for SPHINX)"
msgstr "ເຂົ້າໃຈ&ຍາກ (ພຽງແຕ່ສົ່ງເສີມ  SPHINX) "

#: rc.cpp:218
msgid "Signature and signed data encoded in one ASN.1 block."
msgstr ""
"ລາຍເຊັ່້ນແລະຂໍ້ມູນເຄື່ອງໝາຍ ອີງຕາມຫນື່ງຫ້ອງແຖວ "
"ASN"

#: rc.cpp:219
msgid ""
"<qt>\n"
"<h1>Opaque signed messages</h1>\n"
"When this option is selected, both the signature and the signed data will be "
"encoded into one ASN.1 block. Messages will be readable only by Mail User "
"Agents supporting ASN.1 decoding.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ຂ່າວສານເຄື່ອງໝາຍທີ່ເຂົ້າໃຈຍາກ</h1>\n"
"ເມື່ອຕົວເລືອກຖືກເລືອກ ອີງຕາມລາຍເຊັນທັງໝົດແລະຂໍ້ມູນ "
"ເຄື່ອງໝາຍຈະເຂົ້າເຖີ່ງຫນື່ງ ASN ຫນື່ງຫ້ອງ "
"ແຖວ ຂ່າວສານຈະອ່ານງ່າຍໂດຍການສະໜັບສະໜູນ "
"ຕົວແທນຜູ້ໃຊ້ຈົດໝາຍ ASN 1 ຖອດ 'N</QT> "

#: rc.cpp:220
msgid "Compound Mode:"
msgstr "ຂໍ້ມູນກຸນແຈຂອງລາຍເຊັນ:"

#: rc.cpp:222
msgid "Entering PIN is required:"
msgstr ""
"ການປ້ອງ PIN ກະດານສຳລັບໃຊ້ຂຽນຈຳນວນ 24 "
"ແຜ່ນ :"

#: rc.cpp:223
msgid "When adding certificates"
msgstr "ເມື່ອມີການເພີ່ມໃບຮັບຮອງ"

#: rc.cpp:224 rc.cpp:227 rc.cpp:230 rc.cpp:233 rc.cpp:236
msgid "Select how often the PIN must be entered"
msgstr "ເລືອກແບບໃດທີຕ້ອງປ້ອນ PIN"

#: rc.cpp:225 rc.cpp:228 rc.cpp:231 rc.cpp:234 rc.cpp:237
msgid ""
"<qt> "
"<h1>PIN Entry</h1> Here, you can select how often you need to enter the PIN "
"in order to access your personal security environment (PSE) that contains "
"your certificates. "
"<p> The more often you need to enter your PIN, the more protected you are "
"against email messages being forged in your name, but the more inconvenient "
"operations will be. "
"<p> If you are unsure what to select here, leave this option as it is. "
"<p>"
" Note that it is not possible to turn off PIN entry entirely for security "
"reasons. </qt><"
msgstr ""
" <qt>"
"       <h1>PIN ປອ້ນອອກ</h1> ທີ່່່ນີ້ ແບບໃດທີ່ທາ່ນສາມາດເລືອກ. ທາ່ນຕອ້ງການທີ່ຈະປອ້ນPIN ໃນການຈັດການຄຳສັ່ງ .ຄວາມປອດໄພທົ່ວໄປຕໍ່ບຸກຄົນຂອງທາ່ນບັນຈຸ(PSE)ໃນໃບຮັບຮອງຂອງທາ່ນ."
"<p ທາ່ນຕອ້ງການປອ້ນPINຂອງທາ່ນເຂັ້າເລື້ອຍໆ.ທາ່ນແມ່ນຕົວແທນຂໍ້ຄວາມຈົດຫມາຍທີ່ຕອ້ງຮັກສາຫລາຍທີ່ເປັນການເຄື່ອນໄປຂາ້ງຫນ້າຢ່າງຊ້າໆທີ່ຊື່ຂອງທາ່ນ,ແຕ່ຈະເປັນການທຳງານທີ່່ບໍ່ສະດວກ."
"<P> ຖ້າທາ່ນບໍ່ແນ່ໃຈ.ທີ່ນີ້ຈະເລືອກຫຍັງຈາກການເລອືກນີ້ "
"<P>ບໍ່ມັນເປັນໄປບໍ່ໄດ້ທີຈະມອດ PIN ປ້ອນ "
"ອອກຢ່າງຊີ້ນເຊີງ ສຳລັບເຫັດຜົນຄວາມປອດໄພ "
"</qt >"

#: rc.cpp:226
msgid "Once per session"
msgstr "ຫນື່ງຄັ້ງຕໍ່ເຊສຊັ້ນ"

#: rc.cpp:229
msgid "Always when signing"
msgstr "ສະເໝີເມື່ອມີການເຊັນ"

#: rc.cpp:232
msgid "Always"
msgstr "ສະເໝີ"

#: rc.cpp:235
msgid "After"
msgstr "ຫລັງຈາກ"

#: rc.cpp:240
msgid "Warn when trying to send &unsigned messages"
msgstr ""
"ແຈ້ງເຕື່ອ&ມເມື່ອພະຍະຍາມຈະສົ່ງຈົດໝາຍ "
"ທີ່່ຍ້າຍບໍ່ໄດ້ເຊັນໄວ້"
"้"

#: rc.cpp:241
msgid "Check to be warned when sending unsigned messages."
msgstr ""
"ກວດເພື່ອໃຫ້ມີການແຈ້ງເຕື່ອນເມື່ອພະຍາຍາມ "
"ຈະສົ່ງຈົດໝາຍທີ່ຍັງບໍ່ໄດ້ເຊັນໄວ້"

#: rc.cpp:242
msgid ""
"<qt>\n"
"<h1>Warn When Trying To Send Unsigned Messages</h1>\n"
"If this box is checked, you will be warned when you try to send parts of or "
"the whole message unsigned.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum integrity.\n"
"</qt>"
msgstr ""
"<qt>\n"
"       <h1> ເຕືອນ. ເມື່ອພະຍາຍາມສົ່ງຂໍ້ຄວາມທີ່ບໍ່ມີເຄື່ອງຫມາຍ</h1>\n ຖ້າກັບກວດສອບ,ທາ່ນຈະເຕືອນເມື່ອທາ່ນພະຍາຍາມທີ່ຈະສົ່ງສວ່ນປະກອບຫລືຂໍ້ຄວາມທັງຫນົດທີ່ບໍ່ມີເຄື່ອງຫມາຍ.\n "
"<p>\n ມັນເປັນການສົ່ງເສີມຈາກການເລືອກເປີດນີ້ ສຳລັບອີນເຕີກຣິດຕີໃຫຍ່.\n </qt>"

#: rc.cpp:243
msgid "Warn if CA certificate e&xpires in less than"
msgstr "&ແຈ້ງເຕື່ອນ ຫາກໃບຮັບຮອງໃນລູກໂຊ້ຂະໝົດອາຍຸນ້ອຍກວ່າ"

#: rc.cpp:245 rc.cpp:251 rc.cpp:254
msgid ""
"<qt>\n"
"<h1>Warn If Certificate Expires</h1>\n"
"If this option is checked, then you will be warned when trying to use a "
"certificate for signing that expires within the specified amount of days.\n"
"<p>\n"
"It is recommended to keep this option turned on to avoid using certificates "
"that expire in the near future.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ແຈ້ງເຕື່ອນຖ້າໃບຮັບຮອງໝົດໄປ</h1> "
"ຖ້າການເລື່ອນໄດ້ກວດ ແລ້ວທ່ານຈະແຈ້ງເຕື່ອນເມ້່ອ "
"ພະຍາຍາມທີ່ໃຊ້ໃບຮັບຮອງສຳລັບລວມວັນທີ່ "
"ລະບຸພາຍໃນກຳນົດເຄື່ອງໝາຍ \n"
"<p>\nມັນເປັນການສົ່ງເສີມການເລືອກເປີດທີ່ເກັບໄວ້ເພື່ອລີກລ້ງ "
"ໃບຮັບຣອງທີ່ກຳນົດເຄື່ອງໝາຍ\n"
"ໃນອະນາຄົດໃກ້ຯ</qt>"

#: rc.cpp:248
msgid ""
"<qt>\n"
"<h1>Warn If Signature Certificate Expires</h1>\n"
"Select the minimum number of days the signature certificate should be valid "
"without issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ແຈ້ງເຕື່ອນຖ້າຫາກໃບຮັບຮອງ CA ໝົດອາຍຸ</h1>\n"
"ເລືອກເລກໝາຍວັນທີ່ນ້ອຍສຸດ ໃບຮັບຮອງ CA "
"ຈະໝົດອາຍຸນ້ອຍກວ່າ ແຈ້ງເຕືອນການອອກຄຳສັ່ງ 'n "
"<p>\n"
"ແນະນຳສະຖານທີ່ຕິດຕັ້ງ SPHINX 14 "
"ມື້ \n"
"</qt>"

#: rc.cpp:249
msgid "Warn if s&ignature certificate expires in less than"
msgstr ""
"ແຈ້ງເຕືອນຖ້າຫາ&ກວ່າຈົດໝາຍທີ່ຢູຸ່ຫາກບໍ່ມີເຄືອງ "
"ບົ່ງບອກແມ່ນບໍ່ມີໃນໃບຮັບຮອງ"

#: rc.cpp:252
msgid "Warn if root certificate expires in &less than"
msgstr "ແຈ້ງເຕື່ອ&ນ ຫາກໃບຮັບຮອງໃນລູກໂຊ້ຈະໝົດອາຍຸນ້ອຍກວ່າ"

#: rc.cpp:257
msgid ""
"<qt>\n"
"<h1>Warn If CA Certificate Expires</h1>\n"
"Select the minimum number of days the CA certificate should be valid without "
"issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ແຈ້ງເຕື່ອນຖ້າຫາກໃບຮັບຮອງ ໃນລູກໂຊ້ໝົດອາຍຸ</h1>\n"
"ເລືອກເລກໝາຍວັນທີ່ນ້ອຍສຸດ ໃບຮັບຮອງ CA "
"ຈະໝົດອາຍຸນ້ອຍກວ່າ ແຈ້ງເຕືອນການອອກຄຳສັ່ງ 'n "
"<p>\n"
"ແນະນຳສະຖານທີ່ຕິດຕັ້ງ SPHINX 14 "
"ມື້ \n"
"</qt>"

#: rc.cpp:260
msgid ""
"<qt>\n"
"<h1>Warn If Root Certificate Expires</h1>\n"
"Select the minimum number of days the root certificate should be valid "
"without issuing a warning.\n"
"<p>\n"
"The recommended SPHINX setting is 14 days.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ແຈ້ງເຕືອນຫາກໃບຮັບຮອງໃນລູກໂຊ້ໝົດອາຍຸ</h1>n "
"ເລືອກເລກໝາຍວັນທີ່ນ້ອຍສຸດ ໃບຮັບຮອງລູກໂຊ້ "
"ຈະໝົດອາຍຸນອ້ຍກວ່າ ແຈ້ງເຕືອນການອອກຄຳສັ່ງ 'n "
"<p>\n ແນະນຳສະຖານທີ່ຕິດຕັ້ງ SPHINX 14 ມື້ 'N "
"</qt> "

#: rc.cpp:261
msgid "Warn if signer's email address is &not in certificate"
msgstr ""
"ແຈ້ງເຕືອນຖ້າຫາກວ່າຈົດໝາຍທີ່ຢູ່ຫາກບໍ່ມີເຄືອງ "
"ບົ່ງ&ບອກແມ່ນບໍ່ມີໃນໃບຮັບຮອງ"

#: rc.cpp:263
msgid ""
"<qt>\n"
"<h1>Warn If Signer's Email Address Is Not In Certificate</h1>\n"
"If this option is checked, a warning is issued if the email address of the "
"signer is not contained in the certificate used for signing.\n"
"<p>\n"
"It is recommended to leave this option turned on for maximum integrity.\n"
"</qt>"
msgstr ""
"<qt>\n"
"<h1>ແຈ້ງເຕືອນຖ້າຫກາວ່າຈົດໝາຍທີ່ຢູ່ຫາກບໍ່ມີເຄື້ອງ "
"ບົ່ງບອກແມ່ນບໍ່ມີໃນໃບຮັບຮອງ</h1>\n"
"ຖ້າການເລືອກໄດ້ກວດ ແຈ້ງເຕືອນອອກມາຖ້າຫກາ "
"ວ່າຈົດໝາຍທີ່ຢູ່ເຄືອງໝາຍບໍ່ບັນຈຸໃນໃບຮັບຮອ້ງໃຊ້ເຄືອງໝາຍ "
"\n"
"<p>\n"
"ມັນແມ່ນຂໍຊີ້ນຳຖື້ມໄວ້ການເລືອກໄດ້ກວດຄືນທີ່ຄ່າ "
"ສູງສຸດຂອງຄວາມໝັ້ນຄົງ \n </qt> "

