#: kcmcss.cpp:228
msgid ""
"<h1>Konqueror Stylesheets</h1> This module allows you to apply your own "
"color and font settings to Konqueror by using stylesheets (CSS). You can "
"either specify options or apply your own self-written stylesheet by pointing "
"to its location."
"<br> Note that these settings will always have precedence before all other "
"settings made by the site author. This can be useful to visually impaired "
"people or for web pages that are unreadable due to bad design."
msgstr ""
"ໂມດູນນີ້"
"ໃຫ້ທ່ານສາມາດເລືອກຕັ້ງຄ່າແລະ "
"ຮູບແບບຕົວອັກສອນຂອງທ່ານເອງໄດ້"
"ี ເພື່ອໃຊ້ກັບຄອນເຄຍເຣີ"
"ໂດຍໃຊ້ສະຕາຍຊິດທ໌ (CSS) "
"ທ່ານສາມາດກຳນົດຕົວເລືອກ"
"ຂງນຂຶ້ນເອງ"
"ໂດຍລະບຸຕຳແຫນ່ງ"
"<br> ຂໍ້ຄວນຈຳການຕັ້ງຄ່ານີ້"
"ຈະຖືກນຳມາໃຊ້ກ່ອນຄ່າທີ່ຖືກ"
"ຕັ້ງໄວ້ຈາກໄຊທ໌ສະເຫມີ"
"ຊຶ່ງຈະຊ່ວຍໃຫ້ທ່ານສາມາດອ່ານ ຫລືປ່ງນຄ່າເວບເພດຈ໌"
"ທີ່່ບໍ່ສາມາດອ່ານໄດ້"
"ຫລືອອກແບບມາບໍ່ດີ"

#: rc.cpp:1 rc.cpp:5
msgid "Stylesheets"
msgstr "ສະຕາຍຊິດ"

#: rc.cpp:2 rc.cpp:3
msgid ""
"<b>Stylesheets</b>"
"<p>See http://www.w3.org/Style/CSS for further information on cascading "
"style sheets.</p>"
msgstr ""
"<b>ສະຕາຍຊິດ</b>"
"<p>ເບິ່ງລາຍລະອງດຂອງ cascading style sheets "
"ໄດ້ທີ่່ http://www.w3.org/Style/CSS</p>"

#: rc.cpp:4
msgid "&General"
msgstr "ທົ່ວໄປ"

#: rc.cpp:6
msgid ""
"<b>Stylesheets</b>"
"<p>Use this groupbox to determine how Konqueror will render style sheets.</p>"
msgstr ""
"<b>ສະຕາຍຊິດ</b>"
"<p>ໃຊ້ກຣຸບບອກນີ້"
"ເພື່ອກຳນົດວ່າ"
"ຈະໃຫ້ຄອນເຄຍເຣີ"
"ຈະທຳການສະແດງຢ່າງໃດ</p>"

#: rc.cpp:7
msgid "Use &user-defined stylesheet"
msgstr "ໃຊ້ສະຕາຍຊິດທີ່ກຳນົດເອງ"

#: rc.cpp:8
msgid ""
"<b>Use user-defined stylesheet</b>"
"<p>If this box is checked, Konqueror will try to load a user-defined style "
"sheet as specified in the location below. The style sheet allows you to "
"completely override the way web pages are rendered in your browser. The file "
"specified should contain a valid style sheet (see "
"http://www.w3.org/Style/CSS for further information on cascading style "
"sheets).</p>"
msgstr ""
"<b>ໃຊ້ສະຕາຍຊິດທີ່ກຳນົດເອງ</b>"
"<p>ຫາກເລືອກໃຫ້ຕົວເລືອກນີ້"
"konqueror "
"ຈະພະຍາຍາມຮງກໃຊ້ສະຕາຍຊິດ"
"ກຳນົດໄວ້ໃນຕຳແຫນ່ງດ້ານລຸ່ມນີ້"
"ສະຕາຍຊິດຈະຊ່ວຍໃຫ້ທ່ານສາມາດ"
"ປ່ງນຮູບແບບຂອງເວັບເພດຈ໌"
"ເທິງບຣາວເຊີ"
"ໄປເປັນລັກສະນະທີ່ທ່ານກຳນົດ"
"ແຟ້ມທີ່ກຳນົດ"
"ຄວນຈະມີໄວຍາກອນສະຕາຍຊິດທີ່ຖືກ"
"ຕ້ອງອີກດ້ວຍ"
"(ເບິ່ງລາຍລະອງດຂອງ cascading style sheets "
"ໄດ້ທີ່ี่ http://www.w3.org/Style/CSS)</p>"

#: rc.cpp:9
msgid "U&se accessiblity stylesheet defined in \"Customize\"-tab"
msgstr ""
"ໃຊ້ຄວາມສາມາດຂອງສະຕາຍຊິດ"
"ກຳນົດໃນແທັບ \"ກຳນົດເອງ\""

#: rc.cpp:10
msgid ""
"<b>Use accessiblity stylesheet defined in "
"&quot;Customize&quot;-tab</b>"
"<p>"
"Selecting this option will allow you to define a default font, font size, "
"and font color with a few simple clicks of the mouse. Simply wander over to "
"the Customize tab and pick out your desired options.</p>"
msgstr ""
"<b>ໃຊ້ຄວາມສາມາດຂອງສະຕາຍຊິດ"
"ທີ່ກຳນົດໃນແທັບ"
"&quot;ກຳນົດເອງ&quot;</b>"
"<p>ເລືອກຕົວເລືອກນີ້"
"ທ່ານສາມາດ ກຳນົດຮູບແບບ"
"ຂະຫນາດ,ແລະສີຂອງຕົວອັກສອນໄດ້"
"ດ້ວຍການຄລິກເມົາສ໌ປົກກະຕິ"
"ພາຍໃນຫນ້າແທັບ ກຳນົດເອງ"
"ແລະເລືອກຕົວເລືອກຕ່າງໆ"
"ທີ່ຕ້ອງການ</p>"

#: rc.cpp:11
msgid "Us&e default stylesheet"
msgstr "ໃຊ້ສະຕາຍຊິດປະຣິຍາຍ"

#: rc.cpp:12
msgid ""
"<b>Use default stylesheet</b>"
"<p>Select this option to use the default stylesheet.</p>"
msgstr ""
"<b>ໃຊ້ສະຕາຍຊິດປະຣິຍາຍ</b>"
"<p>ເລືອກຕົວເລືອກນີ້"
"ເພື່ອໃ້ຫ້ໃຊ້ສະຕາຍຊິດປະຣິຍາຍ</"
"p>"

#: rc.cpp:13
msgid "Custom&ize"
msgstr "ກຳນົດເອງ"

#: rc.cpp:14
msgid "Colors"
msgstr "ສີ"

#: rc.cpp:15
msgid "&Black on white"
msgstr "ດຳເທິງພື້ນຂາວ"

#: rc.cpp:16
msgid "<b>Black on White</b><p>This is what you normally see.</p>"
msgstr ""
"<b>ດຳເທິງພື້ນຂາວ</b>"
"<p>ເປັນລັກສະນະທີ່ປົກກະຕິທີ່ທ່ານເຫັນ"
"</p>"

#: rc.cpp:17
msgid "&White on black"
msgstr "ຂາວເທິງພື້ນດຳ"

#: rc.cpp:18
msgid "<b>White on Black</b><p>This is your classic inverse color scheme.</p>"
msgstr ""
"<b>ຂາວເທິງພື້ນດຳ</b>"
"<p>ນີ້ເປັນຊຸດສີທີ່ກັບກັນ"
"ຊຸດສີເດີມໆ</p>"

#: rc.cpp:19
msgid "Cus&tom"
msgstr "ກຳນົດເອງ"

#: rc.cpp:20
msgid ""
"<b>Custom</b>"
"<p>Select this option to define a custom color for the default font.</p>"
msgstr ""
"<b>ກຳນົດເອງ</b>"
"<p>ເລືອກຕົວເລືອກນີ້"
"ເພື່ອກຳນົດສີສຳຫລັບຕົວອັກສອນເອງ</p>"

#: rc.cpp:21 rc.cpp:23
msgid ""
"<b>Foreground color</b>"
"<p>The foreground color is the color that the text is drawn in.</p>"
msgstr ""
"<b>ສີພື້ນຫນ້າ</b>"
"<p>ສີພື້ນຫນ້າ"
"ເປັນສີທີ່ໃຊ້ກັບຕົວອັກສອນ</p>"

#: rc.cpp:22
msgid "&Foreground:"
msgstr "ພື້ນຫນ້າ:"

#: rc.cpp:24
msgid ""
"<b>Background</b>"
"<p>Behind this door lays the ability to choose a custom default "
"background.</p>"
msgstr ""
"<b>ພື້ນຫລັງ</b>"
"<p>ສາມາດເລືອກພື້ນຫລັງຮູບແບບຕ່າງໆ ໄດ້ເອງ</p>"

#: rc.cpp:25
msgid "Bac&kground:"
msgstr "ພື້ນຫລັງ:"

#: rc.cpp:26
msgid ""
"<b>Background</b>"
"<p>This background color is the one displayed behind the text by default. A "
"background image will override this.</p>"
msgstr ""
"<b>ພື້ນຫລັງ</b>"
"<p>ສີພື້ນຫລັງນີ້"
"ຕາມປົກກະຕິຈະຖືກສະແດງຢູ່ເບື້ອງຫລັງຂໍ້ຄວາມ"
"ຊຶ່ງສາມາດປ່ງນໄປໃຊ້ພາບພື້ນຫລັງແທນໄດ້"
"</p>"

#: rc.cpp:27
msgid "Use same color for all text"
msgstr "ໃຊ້ສີດງວກັນກັບທຸກຂໍ້ຄວາມ"

#: rc.cpp:28 rc.cpp:29
msgid ""
"<b>Use same color for all text</b>"
"<p>"
"Select this option to apply your chosen color to the default font as well as "
"any custom fonts as specified in a stylesheet.</p>"
msgstr ""
"<b>ໃຊ້ສີດງວກັນກັບທຸກຂໍ້ຄວາມ</b>"
"<p>ເລືອກຕົວເລືອກນີ້"
"ເພື່ອໃຫ້ສີທີ່ທ່ານເລືອກໄ້ວ້"
"ຖືກນຳໄປໃຊ້ກັບຮູບແບບຕົວອັກສອນປະຣິຍາຍ"
"ເຊັ່ນດງວກັບຮູບແບບຕົວອັກສອນ"
"ທີ່ກຳນົດໄວ້ໃນສະຕາຍຊິດ</p>"

#: rc.cpp:30
msgid "Images"
msgstr "ພາບ"

#: rc.cpp:31
msgid "<b>Images</b><p></b>"
msgstr "<b>ພາບ</b><p></b>"

#: rc.cpp:32
msgid "&Suppress images"
msgstr "ງົດໃຊ້ພາບ"

#: rc.cpp:33
msgid ""
"<b>Suppress images</b>"
"<p>Selecting this will prevent Konqueror from loading images.</p>"
msgstr ""
"<b>ງົດໃຊ້ພາບ</b>"
"<p>ເລືອກຕົວເລືອກນີ້"
"ເພື່ອບໍ່ໃຫ້ຄອນເຄຍເຣີ"
"ໂຫລດຮູບພາບ</p>"

#: rc.cpp:34
msgid "Suppress background images"
msgstr "ົງົດໃຊ້ພາບພື້ນຫລັງ"

#: rc.cpp:35
msgid ""
"<b>Suppress background images</b>"
"<p>Selecting this option will prevent Konqueror from loading background "
"images.</p>"
msgstr ""
"<b>ງົດໃຊ້ພາບພື້ນຫລັງ</b>"
"<p>ເລືອກຕົວເລືອກນີ້"
"ເພື່ອບໍ່ໃຫ້ຄອນເຄຍເຣີ"
"ທຳການໂຫລດພາບພື້ນຫລັງ</p>"

#: rc.cpp:36
msgid "&Preview"
msgstr "ສະແດງຕົວຢ່າງ"

#: rc.cpp:37
msgid ""
"<b>Preview</b>"
"<p>Click on this button to see what your selections look like in action.</p>"
msgstr ""
"<b>ສະແດງຕົວຢ່າງ</b>"
"<p>ຄລິກທີ່ປຸ່ມນີ້"
"ເພື່ອເບິ່ງວ່າສິ່ງທີ່ທ່ານເລືອກ"
"ໄວ້ຈະຖືກສະແດງຢ່າງໃດ</p>"

#: rc.cpp:38
msgid "Font Family"
msgstr "ຕະກູນຕົວອັກສອນ"

#: rc.cpp:39 rc.cpp:40
msgid ""
"<b>Font family</b>"
"<p>A font family is a group of fonts that resemble one another, with family "
"members that are e.g. bold, italic, or any number of the above.</p>"
msgstr ""
"<b>ຕະກູນຕົວອັກສອນ</b>"
"<p>ຕະກູນຕົວອັກສອນ"
"ເປັນກຸ່ມຕົວອັກສອນທີ່ຄ້າຍຄືກັນ "
"ຊຶ່ງຈະມີສາມາແບບ"
"ເຊັ່ນ ຕົວຫນາ,ຕົວອງງ"
"ຫລືຫມາຍເລກຂະຫນາດຕ່າງໆ</p>"

#: rc.cpp:41
msgid "Base fa&mily:"
msgstr "ຕະກູນພື້ນຖານ:"

#: rc.cpp:43
msgid "<p>This is the currently selected font family</p>"
msgstr ""
"<p>ນີ້ເປັນຕະກູນຕົວອັກສອນທີ່"
"ຖືກເລືອກຢູ່ໃນປະຈຸບັນ</p>"

#: rc.cpp:44
msgid "Use same family for all text"
msgstr "ໃຊ້ຕະກູນດງວກັນກັບທຸກຂໍ້ຄວາມ"

#: rc.cpp:45
msgid ""
"<b>Use same family for all text</b>"
"<p>Select this option to override custom fonts everywhere in favor of the "
"base font.</p>"
msgstr ""
"ີີີ<b>ໃຊ້ຕະກູນດງວກັນກັບທຸກຂໍ້ຄວາມ</b> <p>ເລືອກໂຕເລືອກນີ້ເພື່ອໃຫ້ໃຊ້ຮູບແບບຕົວອັກສອນ "
"ທີ່ກຳນົດໃນທຸກຕຳແຫນ່ງທີ່ເປັນຕົວອັກສອນພື້ນຖານ "
"้"

