#: kstart.cpp:193
msgid "Command to execute."
msgstr "ຄຳສັ່ງທີ່ຈະປະມວນຜົນ"

#: kstart.cpp:195
msgid ""
"A regular expression matching the window title.\n"
"If you do not specify one, then the very first window\n"
"to appear will be taken. Not recommended!"
msgstr ""
"ຖ້າທ່ານບໍ່ໄດ້ກຳນົດເງື່ອນໄຂໃນການຄົ້ນຫາຫົວເລື່ອງຫນ້າຕ່າງແລ້ວແລະກະ\n"
"ຫນ້າຕ່າງທຳອິດຈະຖືກຮງກໃຫ້ປະກົດສະເຫມີ ຈື່ງບໍ່ຂໍແນະນຳ !"

#: kstart.cpp:198
msgid "Desktop where to make the window appear. "
msgstr "ພື້ນທີ່ທຳງານທີ່ຕ້ອງການໃຫ້ຫນ້າຕ່າງປະກົດ"

#: kstart.cpp:199
msgid ""
"Make the window appear on the desktop that was active\n"
"when starting the application. "
msgstr "ໃຫ້ຫນ້າຕ່າງປະກົດພື້ນທີ່ທຳງານທີ່ກຳລັງແອກທີບຢູ່\nເມື່ອເລີ້ມການທຳງານຂອງແອພພຣີເຄຊັນ"

#: kstart.cpp:200
msgid "Make the window appear on all desktops"
msgstr "ເຮັດໃັຫ້ຫນ້າຕ່າງປະກົດຢູ່ທຸກພື້ນທີ່ທຳງານ"

#: kstart.cpp:201
msgid "Iconify the window"
msgstr "ຫຍໍ້ຫນ້າຕ່າງເປັນໄອຄອນ"

#: kstart.cpp:202
msgid "Maximize the window"
msgstr "່ຂະຫຍາຍຫນ້າຕ່າງໃຫຍ່ສຸດ"

#: kstart.cpp:203
msgid "Show window fullscreen. Implies type Override."
msgstr "Show window fullscreen Implies type Override."

#: kstart.cpp:204
msgid ""
"The window type: Normal, Desktop, Dock, Tool, \n"
"Menu, Dialog, TopMenu or Override"
msgstr "ປະເພດຫນ້າຕ່າງ: ປົກະຕິ, ພື້ນທີ່ທຳງານ, Dock, ເຄື່ອງມື, \n ເມນູ, ກ່ອງໂຕ້ຕອບ ຫລືໃຊ້ແທນ"

#: kstart.cpp:205
msgid ""
"Jump to the window even if it is started on a \n"
"different virtual desktop"
msgstr "ກະໂດດໄປຍັງຫນ້າຕ່າງ ເຖິງວ່າມັນຈະເລີ້ມການທຳງານ\nໃນພື້ນທີ່ທຳງານອື່ນກໍຕາມ"

#: kstart.cpp:207
msgid "Make the window always stay on top of any other window"
msgstr "ເຮັດໃຫ້ຫນ້າຕ່າງຢູ່ເຫນືອຫນ້າຕ່າງອື່່ນສະເຫມີ"

#: kstart.cpp:208
msgid "The window does not get an entry in the taskbar"
msgstr "ຫນ້າຕ່າງບໍ່ປະກົດໃນສ່ວນແຖບຫນ້າຕ່າງງານ"

#: kstart.cpp:209
msgid "The window does not get an entry on the pager"
msgstr "ຫນ້າຕ່າງບໍ່ປະກົດໃນສ່ວນເພຈເຈີ"

#: kstart.cpp:210
msgid "The window is sent to the system tray in Kicker."
msgstr "ຫນ້າຕ່າງຖືກສົ່ງໄປຍັງສ່ວນແຖບຫນ້າຕ່າງງານໃນ Kicker"

#: kstart.cpp:217
msgid "KStart"
msgstr "KStart"

#: kstart.cpp:218
msgid ""
"Utility to launch applications with special window properties \n"
"such as iconified, maximized, a certain virtual desktop, a special "
"decoration\n"
"and so on."
msgstr ""
"ເຄື່ອງມືຮງກແອພພຣີເຄຊັນ "
"ພ້ອມຄຸນສົມບັດພິເສດຂອງຫນ້າຕ່າງ \n"
"ເຊັ່ນ ຫຍໍ້ເປັນໄອຄອນ, ຂະຫຍາຍໃຫຍ່ສຸດ, "
"ເທິງພື້ນທີ່ທຳງານສະເຫມືອນ\n, ຮູບແບບຫນ້າຕ່າງແບບພິເສດ ແລະອື່ນໆ"

#: kstart.cpp:238
msgid "No command specified"
msgstr "ຍັງບໍ່ໄດ້ລະບຸຄຳສັ່ງ"

