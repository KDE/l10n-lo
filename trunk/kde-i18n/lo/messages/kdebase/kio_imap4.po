#: imap4.cc:813
msgid "What do you want to store in this folder?"
msgstr ""
"ທ່ານຕ້ອງການໃສ່ຫຍັງໄວ້ໃນໂຟ"
"ລເດີນີ້ ?"

#: imap4.cc:813
msgid "Create Folder"
msgstr "ສ້າງໂຟລເດີ"

#: imap4.cc:814
msgid "&Messages"
msgstr "ຈົດຫມາຍ"

#: imap4.cc:814
msgid "&Subfolders"
msgstr "ໂຟລເດີຍ່ອຍ"

#: imap4.cc:1092
msgid "Unsubscribe of folder %1 failed."
msgstr "Unsubscribe of folder %1 failed."

#: imap4.cc:1109
msgid "Subscribe of folder %1 failed."
msgstr "Subscribe of folder %1 failed."

#: imap4.cc:1131 imap4.cc:1142
msgid "Changing the flags of message %1 failed."
msgstr ""
"ການປ່ງນສະຖານະຂອງຈົດຫມາຍ %1 "
"ລົ້ມເຫຼວ"

#: imap4.cc:1231
msgid "Unable to close mailbox."
msgstr ""
"ບໍ່ສາມາດປິດກ່ອງຈົດຫມາຍໃດ້"
"้"

#: imap4.cc:1254
msgid "Unable to get information about folder %1. The server replied: %2"
msgstr ""
"ບໍ່ສາມາດທຳການກວດສອບສິດສ໌ຜ"
"່ານ %1 ໄດ້\n"
"ໂດຍເຊີຟເວີຕອບກັບມາວ່:\n"
"%2"

#: imap4.cc:1417
msgid ""
"The server %1 supports neither IMAP4 nor IMAP4rev1.\n"
"It identified itself with: %2"
msgstr ""
"ເຊີຟເວີ์ %1 "
"ບໍ່ສະຫນັບສະຫນູນທັງ IMAP4 ຫຼື "
"IMAP4rev1\n"
"ມັນສະແດງຕົວມັມເອງເປັນ: %2"

#: imap4.cc:1428
msgid ""
"The server does not support TLS.\n"
"Disable this security feature to connect unencrypted."
msgstr ""
"ເຊີຟເວີບໍ່ສະຫນັບສະຫນູນ TLS\n"
"ຍົກເລີກຄຸນສົມບັດຄວາມປອດໄພ"
"ນີ້ເພື່ອທຳການເຊື່ອມຕໍ່ແບບ"
"ບໍ່ເຂົ້າລະຫັດ"

#: imap4.cc:1453
msgid "Starting TLS failed."
msgstr "ການເລີ່ມການທຳງານ TLS ລົ້ມເຫຼວ"

#: imap4.cc:1463
msgid "The authentication method %1 is not supported by the server."
msgstr ""
"ເຊີຟເວີບໍ່ສະຫນັບສະຫນູນວິທ"
"ີການກວດສິດ %1"

#: imap4.cc:1474
msgid "Username and password for your IMAP account:"
msgstr ""
"ຊື່ຜູ້ໃຊ້ແລະລະຫັດຜ່ານຂອງບ"
"ັນຊີຜູ້ໃຊ້ IMAP ຂອງທ່ານ:"

#: imap4.cc:1488
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or try to get a "
"different username."
msgstr ""
"ໃນສ່ວນຂໍ່ຄວາມລ໋ອກອິນ IMAP "
"ແບບທຳມະດາຈະສາມາດເຕີມໄດ້ພງ"
"ງລະຫັດແອສກີແບບ US ເທົ່ານັ້ນ "
"ໂປດເລືອກວິທີການກວດສອບສິດທ"
"ິແບບອື່ນຯທີ່ເຊີຟເວີຂອງທ່າ"
"ສະຫນັບສະຫນູນຫຼືລອງປງ່ນເປັ"
"ນຊື່ຜູ້ໃຊ້ອື່ນ"

#: imap4.cc:1493
msgid ""
"In IMAP clear text login, only US-ASCII characters are possible. Please use "
"a different authentication method that your server supports or change your "
"password."
msgstr ""
"ໃນສ່ວນຂໍ່ຄວາມລ໋ອກອີນ IMAP "
"ແບບທຳມະດາຈະສາມາດເຕີມໄດ້ພງ"
"ງລະຫັດແອສກີແບບ US ເທົ່ານັ້ນ "
"ໂປດເລືອກວິທີການກວດສີທິແບບ"
"ອື່ນຯ "
"ທີ່ເຊີຟເວີຂອງທ່ານສະຫນັບສະ"
"ຫນູນຫຼືລອງປງ່ນລະຫັດຜ່ານຂອ"
"ງທ່ານ"

#: imap4.cc:1498
#, c-format
msgid ""
"Unable to login. Probably the password is wrong.\n"
"The server replied:\n"
"%1"
msgstr ""
"ບໍ່ສາມາດທຳການລອກອີນໄດ้້ "
"ຊິ່ງລະຫັດຜ່ານອາດຈະບໍ່ຖືກຕ"
"້ອງ\n"
"ໂດຍເຊີຟເວີຕອບກັບມາວ່າ:\n"
"%1"

#: imap4.cc:1504
msgid ""
"Unable to authenticate via %1.\n"
"The server replied:\n"
"%2"
msgstr ""
"ບໍ່ສາມາດທຳການກວດສອບສິດຜ່າ"
"ນ %1 ໄດ້\n"
"ໂດຍເຊີຟເວີຕອບກັບມາວ່າ:\n"
"%2"

#: imap4.cc:1904
msgid "Unable to open folder %1. The server replied: %2"
msgstr ""
"ບໍ່ສາມາດທຳການກວດສອບສິດຜ່າ"
"ນิ์ %1 ໄດ້\n"
"ໂດຍເຊີຟເວີຕອບກັບມາວ່າ:\n"
"%2"
