#: crypto.cpp:104
msgid "%1 (%2 of %3 bits)"
msgstr "%1 (%2 ບິດຈາກ %3 ບິດ)"

#: crypto.cpp:252
msgid "Enable &TLS support if supported by the server"
msgstr ""
"ເປີດໃຊ້ການສະຫນັບສະຫນຸນ &TLS "
"ຫາກເຊີຟເວີສະຫນັບສະຫນຸນ"

#: crypto.cpp:255
msgid ""
"TLS is the newest revision of the SSL protocol. It integrates better with "
"other protocols and has replaced SSL in protocols such as POP3 and SMTP."
msgstr ""
"TLS "
"ເປັນຮູບແບບການເຂົ້າລະຫັດໃຫມ່ກວ່າໂປຣໂຕຄອນ SSL "
"ມັນຖືກລວມໄວ້ໃນຫລາຍໂປຣໂຕຄອນ "
"ແລະທຳການແທນທີ່ການເຂົ້າລະຫັດແບບ SSL ແບບເກົ່າ ເຊັ່ນ ໂປຣໂຕຄອນ "
"POP3 และ SMTP"

#: crypto.cpp:260
msgid "Enable SSLv&2"
msgstr "ເປີດໃຊ້ງານ SSLv&2"

#: crypto.cpp:263
msgid ""
"SSL v2 is the second revision of the SSL protocol. It is most common to "
"enable v2 and v3."
msgstr ""
"SSL v2 "
"ເປັນການເຂົ້າລະຫັດລຸ້ນທີສອງຂອງໂປຣໂຕຄອນ SSL "
"ເຊຶ່ງຈະເປີດໃຊ້ງານ ທັງແບບ v2 "
"ແລະ v3"

#: crypto.cpp:267
msgid "Enable SSLv&3"
msgstr "ເປີດໃຊ້ງານ SSLv&3"

#: crypto.cpp:270
msgid ""
"SSL v3 is the third revision of the SSL protocol. It is most common to "
"enable v2 and v3."
msgstr ""
"SSL v3 ເປັນການເຂົ້າລະຫັດລຸ້ນທີ 3 "
"ຂອງໂປຣໂີຕຄອນ SSL "
"ເຊຶ່ງຈະເປີດໃຊ້ງານ ທັງແບບ v2 "
"ແລະ v3"

#: crypto.cpp:276
msgid "SSLv2 Ciphers to Use"
msgstr ""
"ຊຸດຮູບແບບການເຂົ້າລະຫັດ SSLv2 "
"ທີ່ຈະໃຊ້:"

#: crypto.cpp:277
msgid ""
"Select the ciphers you wish to enable when using the SSL v2 protocol. The "
"actual protocol used will be negotiated with the server at connection time."
msgstr ""
"ເລືອກຊຸດຮູບແບບການເຂົ້າລະຫັດທີ່ຕ້ອງການໃຊ້ "
"ເມື່ອມີການໃຊ້ງານໂປຣໂຕຄອນ SSL "
"v2 "

#: crypto.cpp:287
msgid ""
"SSL ciphers cannot be configured because this module was not linked with "
"OpenSSL."
msgstr ""
"ບໍ່ສາມາດປັບແຕ່ງຊຸດຮູບແບບການເຂົ້າລະຫັດ SSL ໄດ້ "
"ເນື່ອງຈາກໂມດູນນີ້ບໍ່ໄດ້ລິງກັບໄລບຣາລີ OpenSSL"

#: crypto.cpp:302
msgid "SSLv3 Ciphers to Use"
msgstr ""
"ຊຸດຮູບແບບການເຂົ້າລະຫັດ SSLv3 "
"ທີ່ຈະໃຊ້:"

#: crypto.cpp:303
msgid ""
"Select the ciphers you wish to enable when using the SSL v3 protocol. The "
"actual protocol used will be negotiated with the server at connection time."
msgstr ""
"ເລືອກຊຸດຮູບແບບການເຂົ້າລະຫັດທີ່ຕ້ອງການໃຊ້"
"ເມື່ອມີການໃຊ້ງານໂປຣໂຕຄອນ SSL "
"v3 "

#: crypto.cpp:317
msgid "Cipher Wizards"
msgstr "ຕົວຊ່ວຍເຫລືອການເຂົ້າລະຫັດ"

#: crypto.cpp:318
msgid "&Most Compatible"
msgstr "ເຂົ້າກັນໄດ້ຫລາຍທີ່ສຸດ"

#: crypto.cpp:319
msgid "U&S Ciphers Only"
msgstr "ຮູບແບບການເຂົ້າລະຫັດແບບອາເມລິກາເທົ່ານັ້ນ"

#: crypto.cpp:320
msgid "E&xport Ciphers Only"
msgstr "ສົ່ງອອກຮູບແບບການເຂົ້າລະຫັດເທົ່ານັ້ນ"

#: crypto.cpp:321
msgid "E&nable All"
msgstr "ເປີດໃຊ້ງານທັງຫມົດ"

#: crypto.cpp:327
msgid "Use these buttons to more easily configure the SSL encryption settings."
msgstr ""
"ເພື່ອໃຫ້ການປັບແຕ່ງຄ່າຂອງການເຂົ້າລະຫັດ SSL ງ່າຍຂື້ນ "
"ໃຫ້ໃຊ້ປຸ່ມນີ້"

#: crypto.cpp:329
msgid "Select the settings found to be most compatible."
msgstr "ເລືອກການຕັ້ງຄ່າທີ່ພົບໃຫ້ມີຄວາມເຂົ້າກັນໄດ້ຫລາຍທີ່ສຸດ"

#: crypto.cpp:331
msgid "Select only the US strong (>= 128 bit) encryption ciphers."
msgstr ""
"ເລືອກຮູບແບບການເຂົ້າລະຫັດເຂັ້ມງວດຫລາຍ "
"ລະດັບດງວກັບປະເທດອາເມລິກາ (>= 128 ບິດ) ເທົ່ານັ້ນ"

#: crypto.cpp:333
msgid "Select only the weak ciphers (<= 56 bit)."
msgstr ""
"ເລືອກສະເພາະຮູບແບບການເຂົ້າລະຫັດທີ່ບໍ່ເຂັ້ມງວດ (<= 56 ບິດ) "
"ເທົ່ານັ້ນ"

#: crypto.cpp:335
msgid "Select all SSL ciphers and methods."
msgstr ""
"ເລືອກຮູບແບບການເຂົ້າລະຫັດ SSL "
"ແລະວິທີການທີ່ມີທັງຫມົດ"

#: crypto.cpp:344
msgid "Use EGD"
msgstr "ໃຊ້ EGD"

#: crypto.cpp:346
msgid "Use entropy file"
msgstr "ໃຊ້ແຟ້ມ Entropy"

#: crypto.cpp:354 crypto.cpp:2248
msgid "Path to EGD:"
msgstr "ຕຳແຫນ່ງ EGD:"

#: crypto.cpp:360
msgid ""
"If selected, OpenSSL will be asked to use the entropy gathering daemon (EGD) "
"for initializing the pseudo-random number generator."
msgstr ""
"ຖ້າເລືອກໃຊ້ OpenSSL "
"ຈະຖາມໃນການໃຊ້ງານ Entropy Gathering Daemon "
"(EGD) "
"ເພື່ອເລີ້ມທຳສ້າງການສຸ່ມຕົວເລກ"

#: crypto.cpp:363
msgid ""
"If selected, OpenSSL will be asked to use the given file as entropy for "
"initializing the pseudo-random number generator."
msgstr ""
"ຖ້າເລືອກໃຊ້ OpenSSL "
"ຈະຖາມໃນການໃຊ້ງານ Entropy Gathering Daemon "
"(EGD) "
"ເພື່ອເລີ້ມທຳສ້າງການສຸ່ມຕົວເລກ"

#: crypto.cpp:366
msgid ""
"Enter the path to the socket created by the entropy gathering daemon (or the "
"entropy file) here."
msgstr ""
"ເຕີມຕຳແຫນ່ງທີ່ຊີ້ໄປທີ່ຊັອກເກັດທີ່ຖືກສ້າງໂດຍເດມອນ "
"Entropy Gathering ທີ່ນີ້"

#: crypto.cpp:369
msgid "Click here to browse for the EGD socket file."
msgstr ""
"ກົດທີ່ນີ້ "
"ເພື່ອເລືອກແຟ້ມຊັອກເກັດຂອງ "
"EGD"

#: crypto.cpp:377
msgid "Warn on &entering SSL mode"
msgstr "ເຕືອນເມື່ອເຂົ້າສູ່ໂຫມດການເຂົ້າລະຫັດ SSL"

#: crypto.cpp:380
msgid "If selected, you will be notified when entering an SSL enabled site"
msgstr ""
"ເລືອກຕົວເລືອກນີ້ "
"ເພື່ອໃຫ້ມີການເຕືອນເມື່ອມີ"
"ການເຂົ້າສູ່ໄຊຕ໌ທີ່ມີການເຂົ້າລະຫັດ SSL ທຸກຄັ້ງ"

#: crypto.cpp:384
msgid "Warn on &leaving SSL mode"
msgstr "ເຕືອນເມື່ອອອກຈາກໂຫມດການເຂົ້າລະຫັດ SSL"

#: crypto.cpp:387
msgid "If selected, you will be notified when leaving an SSL based site."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ "
"ເພື່ອໃຫ້ມີການເຕືອນເມື່ອມີການອອກຈາກໄຊຕ໌ທີ່ມີການລະຫັດ SSL ທຸກຄັ້ງ"

#: crypto.cpp:391
msgid "Warn on sending &unencrypted data"
msgstr "ເຕືອນເມື່ອມີການສົ່ງຂໍ້ມູນທີ່ບໍ່ມີການເຂົ້າລະຫັດ"

#: crypto.cpp:394
msgid ""
"If selected, you will be notified before sending unencrypted data via a web "
"browser."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ "
"ເພື່ອໃຫ້ມີການເຕືອນເມື່ອມີ"
"ການສົ່ງຂໍ້ມູນທີ່ບໍ່ມີການເຂົ້າລະຫັດຜ່ານທາງເວບບຣາວເຊີ"

#: crypto.cpp:399
msgid "Warn on &mixed SSL/non-SSL pages"
msgstr ""
"ເຕືອນເມື່ອເຂົ້າສູ່ໄຊຕ໌ທີມ"
"ຫນ້າຜະສົມທັງແບບເຂົ້າລະຫັດ SSL "
"ແລະບໍ່ໄດ້ເຂົ້າລະຫັດ"

#: crypto.cpp:402
msgid ""
"If selected, you will be notified if you view a page that has both encrypted "
"and non-encrypted parts."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ "
"ເພື່ອໃຫ້ມີການເຕືອນເມື່ອການເຂົ້າສູ່ໄຊຕ໌ທີ່ມີຫນ້າຜະສົມ "
"ທັງແບບເຂົ້າລະຫັດ SSL "
"ແລະບໍ່ໄດ້ເຂົ້າລະຫັດໄວ້"

#: crypto.cpp:415
