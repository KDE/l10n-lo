#: crypto.cpp:106
msgid "%1 (%2 of %3 bits)"
msgstr "%1 (%2 ບິດຈາກ %3 ບິດ)"

#: crypto.cpp:254
msgid "Enable &TLS support if supported by the server"
msgstr ""
"ເປີດໃຊ້ການສະຫນັບສະຫນຸນ &TLS "
"ຫາກເຊີຟເວີສະຫນັບສະຫນຸນ"

#: crypto.cpp:257
msgid ""
"TLS is the newest revision of the SSL protocol. It integrates better with "
"other protocols and has replaced SSL in protocols such as POP3 and SMTP."
msgstr ""
"TLS "
"ເປັນຮູບແບບການເຂົ້າລະຫັດໃຫ"
"ມ່ກວ່າໂປຣໂຕຄອນ SSL "
"ມັນຖືກລວມໄວ້ໃນຫລາຍໂປຣໂຕຄອ"
"ນ "
"ແລະທຳການແທນທີ່ການເຂົ້າລະຫ"
"ັດແບບ SSL ແບບເກົ່າ ເຊັ່ນ "
"ໂປຣໂຕຄອນ POP3 และ SMTP"

#: crypto.cpp:262
msgid "Enable SSLv&2"
msgstr "ເປີດໃຊ້ງານ SSLv&2"

#: crypto.cpp:265
msgid ""
"SSL v2 is the second revision of the SSL protocol. It is most common to "
"enable v2 and v3."
msgstr ""
"SSL v2 "
"ເປັນການເຂົ້າລະຫັດລຸ້ນທີສອ"
"ງຂອງໂປຣໂຕຄອນ SSL "
"ເຊຶ່ງຈະເປີດໃຊ້ງານ ທັງແບບ v2 "
"ແລະ v3"

#: crypto.cpp:269
msgid "Enable SSLv&3"
msgstr "ເປີດໃຊ້ງານ SSLv&3"

#: crypto.cpp:272
msgid ""
"SSL v3 is the third revision of the SSL protocol. It is most common to "
"enable v2 and v3."
msgstr ""
"SSL v3 ເປັນການເຂົ້າລະຫັດລຸ້ນທີ "
"3 ຂອງໂປຣໂີຕຄອນ SSL "
"ເຊຶ່ງຈະເປີດໃຊ້ງານ ທັງແບບ v2 "
"ແລະ v3"

#: crypto.cpp:278
msgid "SSLv2 Ciphers to Use"
msgstr ""
"ຊຸດຮູບແບບການເຂົ້າລະຫັດ SSLv2 "
"ທີ່ຈະໃຊ້:"

#: crypto.cpp:279
msgid ""
"Select the ciphers you wish to enable when using the SSL v2 protocol. The "
"actual protocol used will be negotiated with the server at connection time."
msgstr ""
"ເລືອກຊຸດຮູບແບບການເຂົ້າລະຫ"
"ັດທີ່ຕ້ອງການໃຊ້ "
"ເມື່ອມີການໃຊ້ງານໂປຣໂຕຄອນ SSL "
"v2 "

#: crypto.cpp:289
msgid ""
"SSL ciphers cannot be configured because this module was not linked with "
"OpenSSL."
msgstr ""
"ບໍ່ສາມາດປັບແຕ່ງຊຸດຮູບແບບກ"
"ານເຂົ້າລະຫັດ SSL ໄດ້ "
"ເນື່ອງຈາກໂມດູນນີ້ບໍ່ໄດ້ລິ"
"ງກັບໄລບຣາລີ OpenSSL"

#: crypto.cpp:304
msgid "SSLv3 Ciphers to Use"
msgstr ""
"ຊຸດຮູບແບບການເຂົ້າລະຫັດ SSLv3 "
"ທີ່ຈະໃຊ້:"

#: crypto.cpp:305
msgid ""
"Select the ciphers you wish to enable when using the SSL v3 protocol. The "
"actual protocol used will be negotiated with the server at connection time."
msgstr ""
"ເລືອກຊຸດຮູບແບບການເຂົ້າລະຫ"
"ັດທີ່ຕ້ອງການໃຊ້ເມື່ອມີການ"
"ໃຊ້ງານໂປຣໂຕຄອນ SSL v3 "

