#: kdesu.cpp:57 kdesu.cpp:58
msgid "Specifies the command to run."
msgstr ""
"ກຳນົດຄຳສັ່ງທີ່ຈະໃຊ້ປະມວນຜ"
"ົນ"

#: kdesu.cpp:59
#, fuzzy
msgid "Run command under target uid if <file> is not writable."
msgstr ""
"ປະມວນຜົນຄຳສັ່ງດ້ວຍຫມາຍເລກ"
"ຜູ້ໃຊ້ອື່ນ ຖ້າບໍ່ສາມາດຂງນ "
"<ແຟ້ມ> ໄດ້"

#: kdesu.cpp:60
msgid "Specifies the target uid."
msgstr ""
"ກຳນົດຫມາຍເລກຜູ້ໃຊ້ເປົ້າຫມ"
"າຍ"

#: kdesu.cpp:61
msgid "Do not keep password."
msgstr "ຢ່າຈື່ລະຫັດຜ່ານ"

#: kdesu.cpp:62
msgid "Stop the daemon (forgets all passwords)."
msgstr ""
"ຢຸດການທຳງານເດມອນ "
"(ຖິ່ມທຸກລະຫັດຜ່ານ)"

#: kdesu.cpp:63
msgid "Enable terminal output (no password keeping)."
msgstr ""
"ເປີດໃຫ້ສົ່ງຜົນເອກເທີມີນອລ"
"ດ້ວຍ (ບໍ່ເກັບລະຫັດຜ່ານ)"

#: kdesu.cpp:64
msgid "Set priority value: 0 <= prio <= 100, 0 is lowest."
msgstr ""
"ຕັ້ງຄ່າລະດັບຄວາມສຳຄັນ: 0 <= "
"ສຳຄັນກ່ວາ<= 100, 0 ຄືຕຳ່ສຸດ"

#: kdesu.cpp:65
msgid "Use realtime scheduling."
msgstr ""
"ໃຊ້ລະດັບການທຳງານແບບລງວທາມ"
"์"

#: kdesu.cpp:66
msgid "Let command use existing dcopserver."
msgstr ""
"ໃຫ້ຄຳສັ່ງໃຊ้ dcopserver "
"ທີ່ເຮັດວງກຢູ່"

#: kdesu.cpp:97
msgid "KDE su"
msgstr "KDE su"

#: kdesu.cpp:98
msgid "Runs a program with elevated privileges."
msgstr ""
"ປະມວນຜົນຄຳສັ່ງດ້ວຍສິດຂອງຜ"
"ູ້ໃຊ້ອື່ນ"

#: kdesu.cpp:101
msgid "Maintainer"
msgstr "ຜູ້ເບິ່ງແຍງ"

#: kdesu.cpp:103
msgid "Original author"
msgstr "ຜູ້ຂງນທຳອິດ"

#: kdesu.cpp:122
msgid "Command '%1' not found."
msgstr ""

#: kdesu.cpp:190
#, c-format
msgid "Illegal priority: %1"
msgstr "ລະດັບຄວາມສຳຄັນ: %1 ບໍ່ຖືກຕ້ອງ"

#: kdesu.cpp:218
msgid "No command specified!"
msgstr "ຍັງບໍ່ໄດ້ລະບຸຄຳສັ່ງ !"

#: kdesu.cpp:323
msgid ""
"Su returned with an error!\n"
msgstr ""
"ຄ່າທີ່ສົ່ງກັບຂອງ Su "
"ມີຂໍ່ຜິດພາດ !\n"

#: kdesu.cpp:343
msgid "Command:"
msgstr "ຄຳສັ່ງ:"

#: kdesu.cpp:348
msgid "realtime: "
msgstr "ລງວທາມ์:"

#: kdesu.cpp:350
msgid "Priority:"
msgstr "ລະດັບຄວາມສຳຄັນ:"

#: sudlg.cpp:21
#, c-format
msgid "Run as %1"
msgstr "ເຮັດວງກດ້ວຍສິດຂອງ %1"

#: sudlg.cpp:25
msgid ""
"The action you requested needs root privileges. Please enter root's password "
"below or click Ignore to continue with your current privileges."
msgstr ""
"ການເຮັດທີ່ເອີ້ນຕ້ອງການສິດ"
"ຂອງຜູ້ເບິ່ງແຍງລະບົບກາລຸນາ"
"ໃສ່ລະຫັດຜ່ານຂອງຜູ້ເບິ່ງແຍ"
"ງລະບົບຫຼືຄລິກລ້າໆເພື່ອເຮັ"
"ດຕໍ່ໄປໂດຍໃຊ້ສິດທີ່ມີຢູ່ໃນ"
"ປະຈຸບັນ"

#: sudlg.cpp:29
msgid ""
"The action you requested needs additional privileges. Please enter the "
"password for \"%1\" below or click Ignore to continue with your current "
"privileges."
msgstr ""
"ການເຮັດທີ່ເອີ້ນໃຊ້ຕ້ອງການ"
"ສິດທີ່ສູງກວ່ານี้ "
"ກາລຸນາໃສ່ລະຫັດຜ່ານຂອງ  \"%1\" "
"ຫຼືຄລິກລາ້ໆເພື່ອເຮັດຕໍ່ໄປ"
"ໂດຍໃຊ້ສິດທີ່ມີຢູ່ໃນປະຈຸບັ"
"ນ"

#: sudlg.cpp:34
msgid "&Ignore"
msgstr "&ເມີນເສີຍ"

#: sudlg.cpp:50
msgid "Conversation with su failed."
msgstr "ການສົນທະນາກັບ su ລົ້ມເຫຼວ"

#: sudlg.cpp:59
msgid ""
"The program 'su' is not found!\n"
"Make sure your PATH is set correctly."
msgstr ""
"ບໍ່ພົບໂປຣແກຣມ`su' !\n"
"ກາລຸນາກວດສອບວ່າພາການເຮັດວ"
"ງກຂອງທ່ານຕັ້ງຄ່າຖືກຕ້ອງແລ"
"້ວ"

#: sudlg.cpp:66
msgid ""
"You are not allowed to use 'su'!\n"
"On some systems, you need to be in a special group (often: wheel) to use "
"this program."
msgstr ""
"ທ່ານບໍ່ໄດ້ຮັບອານຸຍາດໃທ້ໃຊ"
"້ງານຄຳສັ່ງ `su'!\n"
"ໃນບາງລະບົບ "
"ທ່ານຕ້ອງເປັນສະມາຊິກຂອງກຸ້"
"ມພິເສດເສຍກ່ອນ\n"
"(ສ່ວນຫຼາຍມັກຈະເປັນ: wheel) "
"ເພື່ອທີ່ຈະສາມາດໃຊ້ງານໄດ້"

#: sudlg.cpp:73
msgid "Incorrect password! Please try again."
msgstr ""
"ລະຫັດຜ່ານບໍ່ຖືກຕ້ອງ ! "
"ກາລຸນາລອງອີກເທື່ອຫນຶ່ງ"

#: sudlg.cpp:77
msgid "Internal error: Illegal return from SuProcess::checkInstall()"
msgstr ""
"ຂໍ່ຜິດພາດພາຍໃນ: "
"ຄ່າທີ່ສົ່ງກັບຈາກຟັງຊັນ "
"SuProcess::checkInstall() ບໍ່ຖືກຕ້ອງ"

