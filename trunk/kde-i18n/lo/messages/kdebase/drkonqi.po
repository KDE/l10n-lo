#: main.cpp:44
msgid "KDE Crash Handler gives the user feedback if a program crashed."
msgstr ""
"ເຄື່ອງມືດັກຈັບຄວາມລົ້ມເລວໃນການທໍາງານບົນ KDE "
"ເພຶ່ອໃຫ້ຜູ້ໃຊ້ຣາຍງານກັບຫາກໂປຣແກມທໍາງານລົ້ມເລວ"

#: main.cpp:48
msgid "The signal number that was caught"
msgstr "ໄດ້ຣັບສັນຍານຫມາຍເລກ"

#: main.cpp:49
msgid "Name of the program"
msgstr "ຊື່ຂອງໂປຣແກມ"

#: main.cpp:50
msgid "Path to the executable"
msgstr "ພາລະຂອງແຟ້ມທີ່ຈະທໍາງານ"

#: main.cpp:51
msgid "The version of the program"
msgstr "ຣູ່ນຂອງໂປຣແກມ"

#: main.cpp:52
msgid "The bug address to use"
msgstr "ທີ່ຢູ່ຂອງຄວາມຜິດພາດທີ່ໃຊ້"

#: main.cpp:53
msgid "Translated name of the program"
msgstr "ຊຶ່ຂອງການແປພາສາຂອງໂປຣແກມ"

#: main.cpp:54
msgid "The PID of the program"
msgstr "ຫມາຍເລກໂປຣເຊສ (PID) ຂອງໂປຣແກມ"

#: main.cpp:55
msgid "Startup ID of the program"
msgstr "ຊຶ່ຂອງໂປຣແກມ"

#: main.cpp:56
msgid "The program was started by kdeinit"
msgstr "ໂປຣແກມຖຶກເອິ້ນໃຫ້ທໍາງານໂດຍ kdeinit"

#: main.cpp:70
msgid "The KDE Crash Handler"
msgstr "ເຄຶ່ອງມືດັກຈັບຄວາມລົ້ມເລວບົນ KDE"

#: debugger.cpp:66
msgid "C&opy"
msgstr "ຄັດລອກ"

#: debugger.cpp:83
msgid "Done."
msgstr "ຮງບຮ້ອບແລ້ວ"

#: debugger.cpp:96
msgid "Select Filename"
msgstr "ເລຶ່ອກຊື່ແຟ້ມ"

#: debugger.cpp:105
msgid "Can't open file %1 for writing"
msgstr "ບໍ່ສາທາດເປີດແຟ້ມ %1ເພຶ່ອຂງນລົງໄປໄດ້"

#: debugger.cpp:112
msgid "Unable to create backtrace."
msgstr "ບໍ່ສາມາດສ້າງການທໍາງານບ້ອນຫລັງໄດ້"

#: debugger.cpp:117
msgid "Loading backtrace..."
msgstr "ເອີ້ນຍັນທຶກການທໍາງານຍ້ອນຫລັງ..."

#: debugger.cpp:134
msgid "Loading symbols..."
msgstr "ກໍາລັງໂຫລດສັນບາລັກ..."

#: krashconf.cpp:61
msgid "unknown"
msgstr "ບໍ່ຮູ້ຈັກ"

#: drbugreport.cpp:55
msgid "You have to edit the description before the report can be sent."
msgstr ""
"ທ່ານຕ້ອງແກ້ໄຂຄໍ່ອະທິບາຍແລະຮາຍລະອງດ"
"ກ່ອນທີ່ຈະສາມາດສົ່ງຮາຍງານໄດ້"

#: backtrace.cpp:84
msgid ""
"%1 not found. Check if it is installed -- you need it to generate the "
"backtrace.\n"
"If you have another debugger, contact kde-devel@kde.org for help on how to "
"set it up."
msgstr ""
"ບໍ່ພົບ %1 "
"ໂປດກວດສອບວາ່ຫາກມັນຖືກຕິດຕັ້ງແລ້ວ "
"ທ່ານຕ້ອງໃຊ້ມັນໃນການສາ້ງການທໍາງານຍ້ອນຫັລງ\n"
"ຫຶລຖ້າທ່ານມີເຄຶ່ອງມືດີບກໍ່ຕິດຕໍ່ kde-devel@kde.org "
"ເພື່ອຊ່ວຍເຫຶລອການຕິດຕັ້ງມັນ"

#: toplevel.cpp:60
msgid "&Bug report"
msgstr "ຮາຍງານຂໍ້ຜິດພາດ"

#: toplevel.cpp:61
msgid "&Debugger"
msgstr "ເຄື່ອງມືດີບັກ"

#: toplevel.cpp:65
msgid "&General"
msgstr "ທົ່ວໄປ"

#: toplevel.cpp:80
msgid "&Backtrace"
msgstr "ຕິດຕາມຍ້ອນຫລັງ"

#: toplevel.cpp:99
msgid "<p><b>Short description</b></p><p>%1</p>"
msgstr "<p><b>ຮາຍລະອງດຫຍໍ້</b></p><p>%1</p>"

#: toplevel.cpp:103
msgid "<p><b>What is this?</b></p><p>%1</p>"
msgstr "<p><b>ນີ້ແມ່ນຫຍັງ?</b></p><p>%1</p>"

#: toplevel.cpp:107
msgid "<p><b>What can I do?</b></p><p>%1</p>"
msgstr "<p><b>ຂ້ອຍສາມາດເຮັດຫຍັງໄດ້ແດ່?</b></p><p>%1</p>"

#: toplevel.cpp:112
msgid "<p><b>Application crashed</b></p><p>The program %appname crashed.</p>"
msgstr ""
"<p><b>ໂປຣແກມທໍາງານລົ້ມເລວ</b></p>"
"<p>ໂປຣແກມ %appname ຢຸດທໍາງານ</p>"

#: toplevel.cpp:130
msgid ""
"<p>Do you want to generate a backtrace? This will help the developers to "
"figure out what went wrong.</p>\n"
"<p>Unfortunately this will take some time on slow machines.</p>"
"<p><b>Note: A backtrace is not a substitute for a proper description of the "
"bug and information on how to reproduce it. It is not possible to fix the "
"bug without a proper description.</b></p>"
msgstr ""
"້<p>ທ່ານຕ້ອງການສາ້ງການທໍາງານຍ້ອນຫລັງຫຶລບໍ່?ນີ້ແມ່ນການຊ່ວຍຜູ້ພັດທະນາແກໄຂບ່ອນທີ່ມີສິ່ງຜີດພາດ "
"ຂື້ນ</p>\n"
"<p>ມັນອາດຈະໃຊ້ເວລາຫລາຍບົນເຄື່ອງທີ່ມີຄວາມໄວບໍ່ຫລາຍ</p>"
"<p><b>ຂໍ້ຄວນຈຳ: "
"ການທຳງານຍ້ອນຫລັງ "
"ບໍ່ໄດ້ມີການໃຫ້ຮາຍລະອງດຂອງຄວາມຜິດພາດແແລະຂໍ້ມູນທີ່ຈະໃໍ້ໍ້ຊ້ສ້າງຄວາມ"
"ຜິດພາດຂື້ນມາໃຫມ່ທີ່ຄົບຖ້ວນຊື່ງມັນເປັນໄປບໍ່ໄດ້ "
"ທີ່ຈະແກ້ໄຂຄວາມຜິດພາດໂດຍປາດສະຈາກຂໍ້ມູນທີ່ຄົບຖ້ວນ</b></p>"

#: toplevel.cpp:142
msgid "Include Backtrace"
msgstr "ລວມການທຳງານຍ້ອນຫລັງ"

#: toplevel.cpp:199
msgid "It was not possible to generate a backtrace."
msgstr "ບໍ່ມີທາງທີ່ຈະສ້່ງການຕິດຕາມການທຳງານຍ້ອນຫລັງ"

#: toplevel.cpp:200
msgid "Backtrace not Possible"
msgstr "ການຕິດຕາມຍ້ອນຫລັງບໍ່ສາມາດເຮັດໄດ້"

