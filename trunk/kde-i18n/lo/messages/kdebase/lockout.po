#~ msgid ""
#~ "<h1>Konqueror Stylesheets</h1> This module allows you to apply your own "
#~ "color and font settings to Konqueror by using stylesheets (CSS). You can "
#~ "either specify options or apply your own self-written stylesheet by "
#~ "pointing to its location.<br> Note that these settings will always have "
#~ "precedence before all other settings made by the site author. This can be "
#~ "useful to visually impaired people or for web pages that are unreadable "
#~ "due to bad design."
#~ msgstr ""
#~ "ໂມດູນນີ້ໃຫ້ທ່ານສາມາດເລືອກຕັ້ງຄ່າແລະ ຮູບແບບຕົວອັກສອນຂອງທ່ານເອງໄດ້ี "
#~ "ເພື່ອໃຊ້ກັບຄອນເຄຍເຣີໂດຍໃຊ້ສະຕາຍຊິດທ໌ (CSS) "
#~ "ທ່ານສາມາດກຳນົດຕົວເລືອກຂງນຂຶ້ນເອງໂດຍລະບຸຕຳແຫນ່ງ<br> "
#~ "ຂໍ້ຄວນຈຳການຕັ້ງຄ່ານີ້ຈະຖືກນຳມາໃຊ້ກ່ອນຄ່າທີ່ຖືກຕັ້ງໄວ້ຈາກໄຊທ໌ສະເຫມີຊຶ່ງຈະຊ່ວຍໃຫ້ທ່ານສາມາດອ່ານ "
#~ "ຫລືປ່ງນຄ່າເວບເພດຈ໌ທີ່່ບໍ່ສາມາດອ່ານໄດ້ຫລືອອກແບບມາບໍ່ດີ"

#~ msgid "Stylesheets"
#~ msgstr "ສະຕາຍຊິດ"

#~ msgid ""
#~ "<b>Stylesheets</b><p>See http://www.w3.org/Style/CSS for further "
#~ "information on cascading style sheets.</p>"
#~ msgstr ""
#~ "<b>ສະຕາຍຊິດ</b><p>ເບິ່ງລາຍລະອງດຂອງ cascading style sheets ໄດ້ທີ่່ http://www.w3."
#~ "org/Style/CSS</p>"

#~ msgid "&General"
#~ msgstr "ທົ່ວໄປ"

#~ msgid ""
#~ "<b>Stylesheets</b><p>Use this groupbox to determine how Konqueror will "
#~ "render style sheets.</p>"
#~ msgstr ""
#~ "<b>ສະຕາຍຊິດ</b><p>ໃຊ້ກຣຸບບອກນີ້ເພື່ອກຳນົດວ່າຈະໃຫ້ຄອນເຄຍເຣີຈະທຳການສະແດງຢ່າງໃດ</p>"

#~ msgid "Use &user-defined stylesheet"
#~ msgstr "ໃຊ້ສະຕາຍຊິດທີ່ກຳນົດເອງ"

#~ msgid ""
#~ "<b>Use user-defined stylesheet</b><p>If this box is checked, Konqueror "
#~ "will try to load a user-defined style sheet as specified in the location "
#~ "below. The style sheet allows you to completely override the way web "
#~ "pages are rendered in your browser. The file specified should contain a "
#~ "valid style sheet (see http://www.w3.org/Style/CSS for further "
#~ "information on cascading style sheets).</p>"
#~ msgstr ""
#~ "<b>ໃຊ້ສະຕາຍຊິດທີ່ກຳນົດເອງ</b><p>ຫາກເລືອກໃຫ້ຕົວເລືອກນີ້konqueror "
#~ "ຈະພະຍາຍາມຮງກໃຊ້ສະຕາຍຊິດກຳນົດໄວ້ໃນຕຳແຫນ່ງດ້ານລຸ່ມນີ້ສະຕາຍຊິດຈະຊ່ວຍໃຫ້ທ່ານສາມາດປ່ງນຮູບແບບຂອງເວັບເພດຈ໌ເທິງບຣາວເຊີໄປເປັນລັກສະນະທີ່ທ່ານກຳນົດແຟ້ມທີ່ກຳນົດຄວນຈະມີໄວຍາກອນສະຕາຍຊິດທີ່ຖືກຕ້ອງອີກດ້ວຍ"
#~ "(ເບິ່ງລາຍລະອງດຂອງ cascading style sheets ໄດ້ທີ່ี่ http://www.w3.org/Style/CSS)</"
#~ "p>"

#~ msgid "U&se accessiblity stylesheet defined in \"Customize\"-tab"
#~ msgstr "ໃຊ້ຄວາມສາມາດຂອງສະຕາຍຊິດກຳນົດໃນແທັບ \"ກຳນົດເອງ\""

#~ msgid ""
#~ "<b>Use accessiblity stylesheet defined in &quot;Customize&quot;-tab</"
#~ "b><p>Selecting this option will allow you to define a default font, font "
#~ "size, and font color with a few simple clicks of the mouse. Simply wander "
#~ "over to the Customize tab and pick out your desired options.</p>"
#~ msgstr ""
#~ "<b>ໃຊ້ຄວາມສາມາດຂອງສະຕາຍຊິດທີ່ກຳນົດໃນແທັບ&quot;ກຳນົດເອງ&quot;</"
#~ "b><p>ເລືອກຕົວເລືອກນີ້ທ່ານສາມາດ ກຳນົດຮູບແບບຂະຫນາດ,"
#~ "ແລະສີຂອງຕົວອັກສອນໄດ້ດ້ວຍການຄລິກເມົາສ໌ປົກກະຕິພາຍໃນຫນ້າແທັບ "
#~ "ກຳນົດເອງແລະເລືອກຕົວເລືອກຕ່າງໆທີ່ຕ້ອງການ</p>"

#~ msgid "Us&e default stylesheet"
#~ msgstr "ໃຊ້ສະຕາຍຊິດປະຣິຍາຍ"

#~ msgid ""
#~ "<b>Use default stylesheet</b><p>Select this option to use the default "
#~ "stylesheet.</p>"
#~ msgstr "<b>ໃຊ້ສະຕາຍຊິດປະຣິຍາຍ</b><p>ເລືອກຕົວເລືອກນີ້ເພື່ອໃ້ຫ້ໃຊ້ສະຕາຍຊິດປະຣິຍາຍ</p>"

