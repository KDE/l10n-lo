#~ msgid ""
#~ "<b>White on Black</b><p>This is your classic inverse color scheme.</p>"
#~ msgstr "<b>ຂາວເທິງພື້ນດຳ</b><p>ນີ້ເປັນຊຸດສີທີ່ກັບກັນຊຸດສີເດີມໆ</p>"

#~ msgid "Cus&tom"
#~ msgstr "ກຳນົດເອງ"

#~ msgid ""
#~ "<b>Custom</b><p>Select this option to define a custom color for the "
#~ "default font.</p>"
#~ msgstr "<b>ກຳນົດເອງ</b><p>ເລືອກຕົວເລືອກນີ້ເພື່ອກຳນົດສີສຳຫລັບຕົວອັກສອນເອງ</p>"

#~ msgid ""
#~ "<b>Foreground color</b><p>The foreground color is the color that the text "
#~ "is drawn in.</p>"
#~ msgstr "<b>ສີພື້ນຫນ້າ</b><p>ສີພື້ນຫນ້າເປັນສີທີ່ໃຊ້ກັບຕົວອັກສອນ</p>"

