#: kcmkhotkeys.cpp:190
msgid "Select Shortcut"
msgstr "ເລືອກແປ້ນພິມລັດ"

#: kcmkhotkeys.cpp:206
msgid "Desktop file to run"
msgstr "ແຟ້ມພຶ້ນທີ່ເຮັດວງກທີ່ຈະປະມວນຜົນ"

#: kcmkhotkeys.cpp:254
msgid ""
"The %1 key combination has already been allocated to the %2 action.\n"
"Please choose a unique key combination."
msgstr ""
"ການຈັບຄູ່ປຸ່ມພິມ %1 "
"ຖຶກຈອງໄວ້ໃຊ້ກັບ\n"
"ການກະທຳ %2 ແລ້ວ\n"
"ກະລຸນາເລືອກປຸ່ມພິມອຶ່ນໆທີ່ຍັງບໍ່ຖຶກໃຊ້"

#: kcmkhotkeys.cpp:258
msgid "Key conflict"
msgstr "ປຸ່ມພິມຂັດແຍ່ງກັນ"

