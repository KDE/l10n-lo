#: kio_smb.cpp:279 kio_smb.cpp:293 kio_smb.cpp:523 kio_smb.cpp:558
#: kio_smb.cpp:1634 kio_smb.cpp:1824 kio_smb.cpp:2076 kio_smb.cpp:2111
#: kio_smb.cpp:2191 kio_smb.cpp:2242 kio_smb.cpp:2275
msgid ""
"\n"
"Make sure that the samba package is installed properly on your system."
msgstr ""
"\n"
"ໂປດກວດສອບວ່າມີການຕິດຕັ້ງແພກເກດ samba "
"ເທິງລະບົບຂອງທ່ານແລ້ວ"

#: kio_smb.cpp:289
msgid ""
"\n"
"There is probably no SMB service running on this host."
msgstr ""
"\n"
"ເບິ່ງຄືວ່າຍັງບໍ່ມີເຊີວິດສ໌ SMB "
"ທີ່ກຳລັງທຳງານຢູ່ເທີງຮອດສ໌"
"ี้"

#: kio_smb.cpp:308 kio_smb.cpp:313
msgid ""
"\n"
"Invalid user/password combination."
msgstr ""
"\n"
"ຊື່ຜູ້ໃຊ้້/ລະຫັດຜ່ານ "
"ອາດຈະບໍ່ຖືກຕ້ອງ"

#: kio_smb.cpp:332
msgid "Hmm..."
msgstr "ອືມມ..."

#: kio_smb.cpp:484
msgid "Server"
msgstr "ເຊີເວີ"

#: kio_smb.cpp:488
msgid "Workgroup"
msgstr "ເວີກກຸບປ໌"

#: kio_smb.cpp:493
msgid "Share"
msgstr "ຊັບພະຍາກອນທີ່ໃຊ້ຮ່ວມກັນ"

#: kio_smb.cpp:724
msgid ""
"To access the shares of a host, use smb://hostname\n"
"To get a list of all hosts use lan:/ or rlan:/ .\n"
"See the KDE Control Center under Network, LANBrowsing for more information."
msgstr ""
"ເພືອເຂົ້າໃຊ້ຊັບພະຍາກອນທີ່ໃຊ້ຮ້ວມກັນເທິງຮອດສ໌"
"ໃຫ້ໃຊ້ smb://ຊື່ຮອດສ໌\n"
"ສຳລັບການເອີ່ນເບິ່ງທຸກຮອດສ໌"
"ีບໍ່ໍ່ໃຫ້ໃຊ້ lan:/ ຫຼື rlan:/\n"
"ເບິ່ງລາຍລະອງດເພີ່ມເຕີມ "
"ທີ່ສູນຄວບຄູມ KDE ຫົວຂໍ່ "
"ລະບົບເຄືອຂ່າຍ -> ການເອີ່ນເບີ່ງລະບົບແລນ"

#: kio_smb.cpp:1164
msgid ""
"\n"
"To access the shares of a host, use smb://hostname\n"
"To get a list of all hosts use lan:/ or rlan:/ .\n"
"See the KDE Control Center under Network, LANBrowsing for more information."
msgstr ""
"\n"
"ເພື່ອເຂົ້າໃຊ້ງານຊັບພະຍາກອນທີ່ໃຫ້ໃຊ້ຮ່ວມກັນເທິງຮອດສ໌"
"ໃຫ້ຊ้້ smb://ຊື່ຮອດສ໌์\n"
"ສຳລັບການເອີ້ນເບິ່ງທຸກຮອດສ"
"ี่ມີໃຫ້ໃຊ້ lan:/ ຫຼື rlan:/\n"
"ເບິ່ງລາຍລະອງດເພິ່ມເຕີມທີ່ສູນຄວບຄູມ KDE ຫົວຂໍ້ "
"ລະບົບເຄືອຂ່າຍ -> ການເອີ່ນເບີ່ງລະບົບແລນ"

#: kio_smb.cpp:1202 kio_smb.cpp:1251 kio_smb.cpp:1375 kio_smb.cpp:1406
#, c-format
msgid ""
"\n"
"Could not create required pipe %1."
msgstr ""
"\n"
"ບໍ່ສາມາດສ້າງແປບ %1 "
"ທີ່ຕ້ອງການໃດ້"

#: kio_smb.cpp:1238
msgid ""
"To be able to write to a remote Samba share you must patch and recompile "
"smbclient.\n"
"Visit http://lisa-home.sourceforge.net/smbclientpatch.html and follow the "
"instructions there."
msgstr ""
"ເພື່ອໃຫ້ສາມາດຂງນໃປຍັງຊັບພະຍາກອນທີ່ໃຊ້ຮ່ວມກັນຂອງ Samba "
"ໃລຍະໃກ້ທ່ານທຳການແພດສ໌ແລະຄອມໄພລ໌ smbclient ໃຫມ່\n"
"ລອງໃປທີ່ "
"http://lisa-home.sourceforge.net/smbclientpatch.html "
"ແລະທຳຕາມຄຳແນະນຳ"

#: kio_smb.cpp:1261 kio_smb.cpp:1269 kio_smb.cpp:1417 kio_smb.cpp:1425
#, c-format
msgid ""
"\n"
"Could not fcntl() pipe %1."
msgstr ""
"\n"
"ບໍ່ສາມາດໃຊ້ຟັງຊັນ fcntl() "
"ກັບແປບ %1 ໄດ້"

