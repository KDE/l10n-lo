#: kio_sftp.cpp:268 kio_sftp.cpp:828
msgid "SFTP slave unexpectedly killed"
msgstr "SFTP slave unexpectedly Killed"

#: kio_sftp.cpp:318
msgid "Opening SFTP connection to host <b>%1:%2</b>"
msgstr "ກຳລັງເປີດການເຊື່ອມຕໍ່ກັບໂຮສທ໌ <b>%1:%2</b>"

#: kio_sftp.cpp:323
msgid "No hostname specified"
msgstr "ຍັງບໍ່ກຳນົດຊື່ໂຮສທ໌"

#: kio_sftp.cpp:335 kio_sftp.cpp:447
msgid "SFTP Login"
msgstr "ລັອກອິນ Sftp"

#: kio_sftp.cpp:337 kio_sftp.cpp:448
msgid "site:"
msgstr "ໄຊສ໌"

#: kio_sftp.cpp:439
msgid "Please enter your username and key passphrase."
msgstr "ກາລຸນາຕື່ມຊື່ແລະຜູ້ໃຊ້ລະຫັດຜ່ານຂອງທ່ານ"

#: kio_sftp.cpp:444
msgid "Please enter your username and password."
msgstr "ກາລຸນາດຕື່ມຊື່ຜູ້ໃຊ້ແລະລະຫັດຜ່ານຂອງທ່ານ"

#: kio_sftp.cpp:458
msgid "Incorrect username or password"
msgstr "ກາລຸນາຕື່ມຊື່ແລະລະຫັດຜ່ານຂອງທ່ານ"

#: kio_sftp.cpp:464
msgid "Please enter a username and password"
msgstr "ກາລຸນາຕື່ມຊື່ຜູ້ໃຊແລະລະຫັດຜ່ານ"

#: kio_sftp.cpp:523
msgid "Warning: Cannot verify host's identity!"
msgstr ""
"ແຈ້ງເຕືອນ: "
"ບໍ່ສາມາດກວດສອບການສະແດງຕົວຂອງໂຮສທ໌ໄດ້ !"

#: kio_sftp.cpp:534
msgid "Warning: Host's identity changed!"
msgstr ""
"ຄຳເຕືອນ: "
"ກະແຈຂອງໂຮສທ໌ມີການປງ່ນແປງ !"

#: kio_sftp.cpp:545 kio_sftp.cpp:546
msgid "Authentication failed."
msgstr "ການເຊື່ອມຕໍ່ລົ້ມເຫຼວ"

#: kio_sftp.cpp:560 kio_sftp.cpp:575
msgid "Connection failed."
msgstr "ການເຊື່ອມຕໍ່ລົ້ມເຫຼວ"

#: kio_sftp.cpp:561 ksshprocess.cpp:767 ksshprocess.cpp:914
msgid "Connection closed by remote host."
msgstr "ການເຊື່ອມຕໍ່ຖືກຢຸດຕິຈາກໂຮສທ໌ປາຍທາງ"

#: kio_sftp.cpp:576
#, c-format
msgid "Unexpected SFTP error: %1"
msgstr ""
"ຂໍ່ຜິດພາດຂອງ SFTP "
"ທີ່ບໍ່ຄາດຫັວງ: %1"

#: kio_sftp.cpp:615
#, c-format
msgid "SFTP version %1"
msgstr "SFTP version %1"

#: kio_sftp.cpp:621
msgid "Protocol error."
msgstr "Protocol error."

#: kio_sftp.cpp:627
#, c-format
msgid "Successfully connected to %1"
msgstr ""
"ເຊື່ອມຕໍ່ໄປຍັງ %1 "
"ຮງບຮ້ອຍແລ້ວ"

#: kio_sftp.cpp:1251
msgid "Could not allocate memory for SFTP packet."
msgstr "Could not allocate memory for SFTP packet."

#: kio_sftp.cpp:1262
msgid "Connection closed"
msgstr "ການເຊື່ອມຕໍ່ລົ້ມເຫຼວ"

#: kio_sftp.cpp:1269
msgid "Could not read SFTP packet"
msgstr "Could not read SFTP packet"

#: kio_sftp.cpp:1366
msgid "SFTP command failed for an unknown reason."
msgstr "SFTP command failed for an unknown reason."

#: kio_sftp.cpp:1369
msgid "The SFTP server received a bad message."
msgstr "The SFTP server received a bad message."

#: kio_sftp.cpp:1372
msgid "You attempted an operation unsupported by the SFTP server."
msgstr "You attempted an operation unsupported by the SFTP server."

#: kio_sftp.cpp:1377
msgid "Error code: "
msgstr "Error code:"

#: ksshprocess.cpp:356
msgid "Cannot specify a subsystem and command at the same time."
msgstr "ບໍ່ສາມາດລະບຸລະບົບຍ່ອຍແລະຄຳສັ່ງໃນເວລາດງວກັນໄດ້"

#: ksshprocess.cpp:702
msgid "No options provided for ssh execution."
msgstr "ບໍ່ມີສ່ວນຕົວເລືອກໃນການປະມວນຜົນຂອງ ssh"

#: ksshprocess.cpp:710
msgid "Failed to execute ssh process."
msgstr "ລົ້ມເຫຼວໃນການປະມວນຜົນ ssh"

#: ksshprocess.cpp:733 ksshprocess.cpp:762 ksshprocess.cpp:881
#: ksshprocess.cpp:953
msgid "Error encountered while talking to ssh."
msgstr "ເກີດຄວາມຜິດພາດຄະນະທຳການເວົ້າກັບ ssh"

#: ksshprocess.cpp:813
msgid "Please supply a password."
msgstr "ກາລູນາຕື່ມຊື່ຜູ້ໃຊ້ແລະລະຫັດຜ່ານ"

#: ksshprocess.cpp:852
msgid "Please supply the passphrase for your SSH private key."
msgstr ""
"ກາລູນາກວດສອບສ່ວນ passphrase "
"ສຳລັບກະແຈສ່ວນຕົວຂອງ SSH"

#: ksshprocess.cpp:866
msgid "Authentication to %1 failed"
msgstr ""
"ການກວດສອບສິດໄປຍັງ %1 "
"ລົ້ມເຫຼວ"

#: ksshprocess.cpp:889
msgid ""
"The identity of the remote host '%1' could not be verified because the "
"host's key is not in the \"known hosts\" file."
msgstr ""
"The identity of the remote host '%1'could not be verified becuase  "
"the key is not in the \"known hosts\"file."

#: ksshprocess.cpp:895
msgid ""
" Manually, add the host's key to the \"known hosts\" file or contact your "
"administrator."
msgstr ""
"Manually, add the host's key to the \"known hosts\" file or "
"contact your administrator."

#: ksshprocess.cpp:901
msgid " Manually, add the host's key to %1 or contact your administrator."
msgstr "Manually, add the host's key to %1 or contact your administrator."

#: ksshprocess.cpp:933
msgid ""
"The identity of the remote host '%1' could not be verified. The host's key "
"fingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator before "
"connecting.\n"
"\n"
"Would you like to accept the host's key and connect anyway? "
msgstr ""
"The indentity of the remote host'%1' could not be verified. the "
"host's keyfingerprint is:\n"
"%2\n"
"You should verify the fingerprint with the host's administrator "
"before connecting.\n"
"\n"
"Would you like to accept the host's key and conect anyway?"

#: ksshprocess.cpp:961
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator. The key fingerprint is:\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."
msgstr ""
"WARNING: The identity of the remote host '%1' had changed!\n"
"\n "
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way ,you should verify the host's "
"key fingerpprint with the host's administrator. The key fingerppint is :\n"
"%2\n"
"Add the correct host key to \"%3\" to get rid of this message."

#: ksshprocess.cpp:996
msgid ""
"WARNING: The identity of the remote host '%1' has changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator may "
"have just changed the host's key. Either way, you should verify the host's "
"key fingerprint with the host's administrator before connecting. The key "
"fingerprint is:\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"
msgstr ""
"WARNING: The identity of the remote host '%1' had changed!\n"
"\n"
"Someone could be eavesdropping on your connection, or the administrator "
"may have just changed the host's key.Either way, you sould verify the host's "
"key fingerprint with the host's administrator before connecting. The key "
"fingerprint is :\n"
"%2\n"
"\n"
"Would you like to accept the host's new key and connect anyway?"

#: ksshprocess.cpp:1020
msgid "Host key was rejected."
msgstr "Host key was rejected."

