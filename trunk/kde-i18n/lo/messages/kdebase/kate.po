msgstr "ເລືອກຄອມໂພເນັນເຄື່ອງມືແກ້ໄຂຂໍ້ຄວາມ"

#: app/kateprojectmanager.cpp:242
msgid "New Project"
msgstr "ປິດໂຄງການປະຈຸບັນ"

#: app/kateprojectmanager.cpp:251
msgid "Project Type:"
msgstr "ປະເພດເອກະສານ"

#: app/kateprojectmanager.cpp:257
