#: app/kateconfigdialog.cpp:65
msgid "Configure Kate"
msgstr "ປັບແຕ່ງ Kate"

#: app/kateconfigdialog.cpp:90 app/kateconfigdialog.cpp:96
#: app/kateconfigdialog.cpp:197 app/kateconfigdialog.cpp:205
msgid "Application"
msgstr "ແອພພລິເຄຊັນ"

#: app/kateconfigdialog.cpp:96
msgid "General"
msgstr "ທົ່ວໄປ"

#: app/kateconfigdialog.cpp:97
msgid "General Options"
msgstr "ຕົວເລືອກທົ່ວໄປ"

#: app/kateconfigdialog.cpp:104
msgid "Startup"
msgstr "ເມື່ອເລີ່ມໂປຣແກຣມ"

#: app/kateconfigdialog.cpp:108
msgid "Reopen &files at startup"
msgstr "ເປີດແຟ້ມທີ່ເຄີຍໃຊ້"

#: app/kateconfigdialog.cpp:112
msgid ""
"If this is enabled Kate will attempt to reopen files that were open when you "
"closed last time. Cursor position will be recovered if possible. "
"Non-existent files will not be opened."
msgstr ""
"ເປີດໃຊ້ຕົວເລືອກນີ້"
"ເພື່ອໃຫ້ Kate "
"ທຳການເປີດແຟ້ມເກົ່າທີ່ເຄີຍແປ"
"ิຄ້າງໄວ້ໃນການໃຊ້ວງກເທື່ອລ່າສຸດ"
"ພ້ອມທັງຈັດຕຳແຫນ່ງເຄີຣ໌ເຊີຣ໌ໄປຍັງຕຳແຫນ່ງເດີມ ຫາກເຮັດໄດ້ ຫາກແຟ້ມບໍ່ມີຢູ່ແລ້ວ "
"ກໍ່ຈະບໍ່ທຳການເປີດ"

#: app/kateconfigdialog.cpp:119
msgid "Restore &view configuration"
msgstr "ເອີ້ນຄຶນການປັບແຕ່ງມຸມເບິ່ງ"

#: app/kateconfigdialog.cpp:122
msgid ""
"Check this if you want all your views and frames restored each time you open "
"Kate"
msgstr ""
"ເລືອກຕົວເລືອກນີ້ຫາກທ່ານຕ້ອງການໃຫ້ມີການເອີ້ນຄຶນມຸມເບິ່ງແລະ "
"ແລະເຟລມທັງຫມົດຂອງທ່ານທຸກຄັ້ງທີ່ເລີ່ມການທຳງານ Kate"

#: app/kateconfigdialog.cpp:127
msgid "Allow Kate to use more than one UN&IX process"
msgstr ""
"ອະນຸຍາດໃຫ้້ Kate "
"ໃຊ້ງານໄດ້ຫລາຍໂປຣເຊສ໌"

#: app/kateconfigdialog.cpp:131
msgid ""
"If this is unchecked, Kate will only use one UNIX process. If you try "
"running it again, the current process will get the focus, and open any files "
"you requested to be opened. If it is checked, each time you start Kate, a "
"new UNIX process will be started."
msgstr ""
"ຫາກບໍ່ໄດ້ເລືອກຕົວເລືອກນີ້ທ່ານອາດຈະໃຊ້ Kate "
"ໄດ້ເທື່ອລະຫນຶ່ງຕົວເທົ່ານັ້ນຫາກທ່ານພະຍາຍາມເປີດຫນ້າຕ່າງໃຫມ່ "
"ມັນຈະກະໂດດໄປຍັງຫນ້າຕ່າງ"
"Kate ທີ່ກຳລັງທຳງານຢູ່ແລະເປີດແຟ້ມທີ່ທ່ານຕ້ອງການປິດແທນ "
"ແຕ່ຫາກເລືອກໃຊ້ຕົວເລືອກນີ້ຈະເຮັດໃຫ້ທຸກຄັ້ງທີ່ທ່ານເອີ້ນໃຫ້ Kate ທຳງານ "
"ມັນຈະເປີດຫນ້າຕ່າງໂປຣເຊສ໌ໃຫມ່ຂອງKate ໃຫ້"

#: app/kateconfigdialog.cpp:137
msgid "Show full &path in title"
msgstr "ສະແດງເສັ້ນທາງເຕັມຮູບແບບເທິງແຖບຫົວຂອງຫນ້າຕ່າງ"

#: app/kateconfigdialog.cpp:140
msgid ""
"If this option is checked, the full document path will be shown in the "
"window caption."
msgstr ""
"ຫາກເປີດໃຊ້ຕົວເລືອກນີ້ຈະເຮັດໃຫ້ການສະແດງເສັ້ນທາງເຕັມ "
"ທີ່ເອກະສານເກັບຢູ່ເທິງແຖບຫວົເລື່ອງຫນ້າຕ່າງດ້ວຍ"

#: app/kateconfigdialog.cpp:145
msgid "&Show content when resizing views"
msgstr "ສະແດງທຸກສ່ວນທີ່ຢູ່ພາຍໃນຂະຫນະປັບຂະຫນາດມຸມເບິ່ງ"

#: app/kateconfigdialog.cpp:148
msgid ""
"If this is disabled, resizing views will display a <i>rubberband</i>"
" to show the new sizes untill you release the mouse button."
msgstr ""
"ຫາກປິດການໃຊ້ງານຕົວເລືອກນີ້ "
"ເມື່ອມີການປັບຂະຫນາດມຸມເບິ່ງ"
"้ຈະມີການສະແດງພງງ"
"<i>ໂຄງ</i> "
"ໃນຂະຫນາດໃຫມ່ເທົ່ານັ້ນຈົນກວ່າທ່ານຈະປ່ອຍປຸ່ມເມົາສ໌"

#: app/kateconfigdialog.cpp:154
msgid "Sync &terminal emulator with active document"
msgstr "ປ່ງນຕຳແຫນ່ງໃນຕົວຈຳລອງເທີມິນອລໄປຍັງຕຳແຫນ່ງທີ່ເອກະສານແອກທີຟຢູ່"

#: app/kateconfigdialog.cpp:157
msgid ""
"If this is checked, the built in Konsole will <code>cd</code> to the "
"directory of the active document when started and whenever the active "
"document changes, if the document is a local file."
msgstr ""
"ຫາກເລືອກຕົວເລືອກນີ້ຄອນໂຊນພາຍໃນຈະກະທຳຄຳສັ່ງ"
"<code>cd</code> ໄປຍັງໄດເຣັກທໍຣີທີ່ເກັບເອກະສານ"
"ທີ່ໃຊ້ຢູ່ເມື່ອເລີ່ມເຮັດວງກແລ້ວ ເຖິງວ່າເອກະສານທີ່ໃຊ້ຢູ່ອາດຈະມີການປ່ງນແປງ"
"ຫາກເອກະສານດັ່ງກ່າວເປັນແຟ້ມໃນລະບົບ"

#: app/kateconfigdialog.cpp:164
msgid "&Number of recent files:"
msgstr ""
"ຈຳນວນຂອງແຟ້ມທີ່ເຄີຍເອິ້ນໃຊ້"
"้"

#: app/kateconfigdialog.cpp:169
msgid ""
"<qt>Sets the number of recent files remembered by Kate."
"<p><strong>NOTE: </strong>If you set this lower than the current value, the "
"list will be truncated and some items forgotten.</qt>"
msgstr ""
"<qt>ຕັ້ງຄ່າຈຳນວນຂອງແຟ້ມທີ່ເຄີຍເອິ້ນໃຊ້ ທີ່ຈະໃຫ້ Kate "
"ຈື່ຈຳ"
"<p><strong>ຂໍ້ຄວນຈື່:"
"</strong>ຫາກທ່ານຕັ້ງຄ່ານີ້ຕຳກວ່າຄ່າປະຈຸບັນ "
"ລາຍການຈະມີການປ່ງນແປງແລະບາງລາຍການອາດຈະຫາຍໄປ</qt>"

#: app/kateconfigdialog.cpp:178
msgid "Toolview mode:"
msgstr "ໂຫມດສະແດງເຄື່ອງມື:"

#: app/kateconfigdialog.cpp:180
msgid "Modern Style"
msgstr "ຮູບແບບສະໄຫມໃຫມ່"

#: app/kateconfigdialog.cpp:181
msgid "Classic Style"
msgstr "ຮູບແບບຄລາສ໌ສິກ"

#: app/kateconfigdialog.cpp:183
msgid ""
"Choose how you want the toolviews managed."
"<BR>"
"<ul>"
"<li><b>Modern Style</b> The toolviews will behave similiar to the views in "
"Konqueror's navigation panel.</li>"
"<li><b>Classic Style</b> The toolviews (filelist, fileselector, ...) can be "
"docked anywhere and made floating.</li></ul>"
msgstr ""
"ເລືອກວິທີການທີ່ທ່ານຕ້ອງການໃຫ້ຈັດການກັບການສະແດງເຄື່ອງມື"
"<BR>"
"<ul>"
"<li><b>ຮູບແບບສະໄຫມໃຫມ່</b> ການສະແດງເຄື່ອງມືຈະຄ້າຍກັບທີ່ສະແດງເທິງແຖບດ້ານຂ້າງຂອງ "
"ຄອນເຄີຣ໌ເຣີຣ໌</li></ul>"
"<li><b>ຮູບແບບຄລາສ໌ສິກ</b> "
"ການສະແດງເຄື່ອງມື (ລາຍການແຟ້ມ, ຊ່ອງເລືອກແຟ້ມ, ...) "
"ສາມາດຈະຝັງໄວ້ໃນທີ່ໃດໆແລະສາມາດຈະແຍກເປັນຫນ້າຕ່າງລອຍໄດ້</li>"

#: app/kateconfigdialog.cpp:197
msgid "File Selector"
msgstr "ກ່ອງເລືອກແຟ້ມ"

#: app/kateconfigdialog.cpp:199
msgid "File Selector Settings"
msgstr "ຕັ້ງຄ່າກ່ອງເລືອກແຟ້ມ"

#: app/kateconfigdialog.cpp:205 app/kateconfigdialog.cpp:226
#: app/kateconfigdialog.cpp:251
msgid "Plugins"
msgstr "ປລັກອິນ"

#: app/kateconfigdialog.cpp:206
msgid "Plugin Manager"
msgstr "ຕົວຈັດການປລັກອິນ"

#: app/kateconfigdialog.cpp:212 app/kateconfigdialog.cpp:218
msgid "Editor"
msgstr "ແກ້ໄຂຂໍ້ຄວາມ"

#: app/kateconfigplugindialogpage.cpp:143 app/katemailfilesdialog.cpp:63
msgid "Name"
msgstr "ໍຊື່"

#: app/kateconfigplugindialogpage.cpp:144
msgid "Description"
msgstr "ລາຍລະອງດ"

#: app/kateconfigplugindialogpage.cpp:145
msgid "Author"
msgstr "ຜູ້ຂງນ"

#: app/kateconfigplugindialogpage.cpp:146
msgid "License"
msgstr "ລິຂະສິດ"

#: app/kateconfigplugindialogpage.cpp:147
msgid ""
"Here you can see all available Kate plugins. Those with a check mark are "
"loaded, and will be loaded again the next time Kate is started."
msgstr ""
"ສະແດງໃຫ້ເຫັນປລັກອິນຂອງ KATE "
"ໂດຍໂຕທີ່ຖຶກກາເຄື່ອງຫມາຍຢູ່ຄືຕົວທີ່ໂຫລດຢູ່ແລະຈະຖຶກໂຫລດອີກເທຶ່ອຫນຶ່ງໃນການເລີ່ມການເຮັດວງກຄັ້ງຕໍ່ໄປຂອງ KATE"

#: app/katefileselector.cpp:152
msgid "Bookmarks"
msgstr "ບ່ອນຂັ້ນປຶ້ມ"

#: app/katefileselector.cpp:171
msgid "Current Document Directory"
msgstr "ໄດເຣັກທໍຣີປະຈະບັນຂອງເອກະສານ"

#: app/katefileselector.cpp:198
msgid ""
"<p>Here you can enter a path for a directory to display."
"<p>"
"To go to a directory previously entered, press the arrow on the right end "
"and choose one."
"<p>The entry has directory completion. Right-click to choose how completion "
"should behave."
msgstr ""
"<p>ທ່ານສາມາດຕື່ມເສັ້ນທ່າງຂອງໄດເຣັກທໍຣີທີ່ຈະສະແດງທີ່ນີ້"
"่<p>ສຳລັບການກັບໄປຍັງໄດເຣັກທໍຣີທີ່ໄດ້ເຂົ້າໄປກ່ອນຫນ້ານີ້ "
"ໃຫ້ກົດລູກສອນທາງດ້ານຂວາຂອງປຸ່ມແລະເລືອກຕຳແຫນ່ງກ່ອນຫນ້າທີ່ຕ້ອງການ"
"<p>ລາຍການເຫລົ່ານີ້ສາມາດຕື່ມໃຫ້ສົມບູນໄດ້ດ້ວຍການຄລິກເມົາສ໌ປຸ່ມຂວາແລະເລືອກຕົວຕື່ມທີ່ຕ້ອງການ"

#: app/katefileselector.cpp:202
msgid ""
"<p>Here you can enter a name filter to limit which files are displayed."
"<p>To clear the filter, toggle off the filter button to the left."
"<p>To reapply the last filter used, toggle on the filter button."
msgstr ""
"<p>ທ່ານສາມາດຕື່ມຕົວກອງຊື່ເພື່ອຈຳກັດແຟ້ມທີ່ຈະສະແດງໄດ້ທີ່ນີ້"
"<p>ຫາກຕ້ອງການລ້າງຕົວກອງໃຫ້ສລັບປຸ່ມຕົວກອງໄປທາງດ້ານຊ້າຍເພື່ອປິດ"
"<p>ຫາກຕອ້ງການໃໍ້ຊ້ຕົວກອງລ່າສຸດໃຫ້ສະລັບປຸ່ມຕົວກອງມາຕຳແຫນ່ງເປີດ"

#: app/katefileselector.cpp:206
msgid ""
"<p>This button clears the name filter when toggled off, or reapplies the "
"last filter used when toggled on."
msgstr "<p>ປຸ່ມນີ້ຈະທຳການລ້າງຕົວກອງຊື່ເມື່ອສະລັບມາປິດຫລືໃຊ້ຕົວກອງລ່າສຸດເມື່ອສະລັບມາທາງເປີດ"

#: app/katefileselector.cpp:316
msgid "Apply Last Filter (\"%1\")"
msgstr "ເອິ້ນໃຊ້ຕົວກອງລ່າສຸດ (\"%1\")"

#: app/katefileselector.cpp:321
msgid "Clear Filter"
msgstr "ລ້າງຕົວກອງ"

#: app/katefileselector.cpp:512
msgid "Toolbar"
msgstr "ແຖບເຄື່ອງມື"

#: app/katefileselector.cpp:514
msgid "A&vailable actions:"
msgstr "ການກະທຳທີ່ມີຢູ່"

#: app/katefileselector.cpp:515
msgid "S&elected actions:"
msgstr "ການກະທຳທີ່ເລືອກໄວ້"

#: app/katefileselector.cpp:518
msgid "Auto Synchronization"
msgstr "ປ່ງນຕຳແຫນ່ງອັດຕະໂນມັດ"

#: app/katefileselector.cpp:519
msgid "When a docu&ment becomes active"
msgstr "ເມື່ອເອກະສານກັບມາແອທິຟ໌"

#: app/katefileselector.cpp:520
msgid "When a document is o&pened"
msgstr "ເມື່ອເອກະສານຖຶກເປີດ"

#: app/katefileselector.cpp:521
msgid "When the file selector becomes visible"
msgstr "ເມື່ອສາມາດເບິ່ງເຫັນກ່ອງເລືອກແຟ້ມ"

#: app/katefileselector.cpp:526
msgid "Remember &locations:"
