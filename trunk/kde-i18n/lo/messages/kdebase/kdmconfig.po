#: background.cpp:50
msgid "E&nable background"
msgstr "&ພື້ນຫລັງ"

#: background.cpp:52
msgid ""
"If this is checked, KDM will use the settings below for the background. If "
"it is disabled, you have to look after the background yourself. This is done "
"by running some program (possibly xsetroot) in the script specified in the "
"Setup= option in kdmrc (usually Xsetup)."
msgstr ""
"If this is checked, KDM will use the settings below for the background. If "
"it is disabled, you have to look after the background yourself. This is done "
"by running some program (possibly xsetroot) in the script specified in the "
"Setup= option in kdmrc (usually Xsetup)."

#: kdm-appear.cpp:72
msgid "&Greeting:"
msgstr "&ຂໍ້ຄວາມຕ້ອນຮັບ:"

#: kdm-appear.cpp:77
#, c-format
msgid ""
"This is the string KDM will display in the login window. You may want to put "
"here some nice greeting or information about the operating system."
"<p> KDM will replace the string '%n' with the actual host name of the "
"computer running the X server. Especially in networks this is a good idea."
msgstr ""
"ນີ້ເປັນຂໍ້ຄວາມທີ່ KDM "
"ຈະສະແດງໃນຫນ້າຕ່າງລອກອິນ "
"ໍຊື່ງທ່ານສາມາດປ່ງນເປັນຂໍ້ຄວາມອື່ນໆ"
"ໄດ້ຕາມທີ່ທ່ານຕ້ອງການ <p> ໂດຍ KDM ຈະແທນທີ່ \"%n\" "
"ດ້ວຍຊື່ເຄື່ອງທີ່ X server "
"ທຳງານຢູ່ຫາກໃຊ້ຊື່ຕາມທີ່ໃຊ້ໃນລະບົບເຄືອຂ່າຍກໍ່ເປັນຄວາມຄິດທີ່ດີ"

#: kdm-appear.cpp:91
msgid "Logo area:"
msgstr "ພື້ນທີ່ສະແດງໂລໂກ:"

#: kdm-appear.cpp:96 kdm-conv.cpp:76 kdm-users.cpp:110
msgid "&None"
msgstr "ບໍ່ສະແດງເລີຍ"

#: kdm-appear.cpp:97
msgid "Show cloc&k"
msgstr "ສະແດງໂມງ"

#: kdm-appear.cpp:98
msgid "Sho&w logo"
msgstr "ສະແດງໂລໂກ"

#: kdm-appear.cpp:110
msgid ""
"You can choose to display a custom logo (see below), a clock or no logo at "
"all."
msgstr ""
"ທ່ານສາມາດເລືອກໃຫ້ສະແດງໂລໂກ"
"ທີ່ກຳນົດ (ເບິ່ງດ້ານລຸ່ມນີ້), ສະແດງໂມງ "
"ຫລືບໍ່ມີໂລໂກເລຍ"

#: kdm-appear.cpp:116
msgid "&Logo:"
msgstr "ໂລໂກ:"

#: kdm-appear.cpp:128
msgid ""
"Click here to choose an image that KDM will display. You can also drag and "
"drop an image onto this button (e.g. from Konqueror)."
msgstr ""
"ຄລີກທີ່ນີ້ເພື່ອເລືອກພາບທີ່ຈະໃຊ້ KDM "
"ສະແດງຜົນ ທ່ານສາມາດໃຊ້ວິທີລາກແລະວາງພາບ"
"ມາຫາປຸ່ມນີ້ໄດ້ (ເຊັ່ນ ລາກມາຈາກຄອນເຄີເຣີ)"

#: kdm-appear.cpp:141
msgid "Position:"
msgstr "ຕຳແຫນ່ງ:"

#: kdm-appear.cpp:146
msgid "Cente&red"
msgstr "ທາງກາງ"

#: kdm-appear.cpp:147
msgid "Spec&ify"
msgstr "ກຳນົດ"

#: kdm-appear.cpp:157
msgid ""
"You can choose whether the login dialog should be centered or placed at "
"specified coordinates."
msgstr ""
"ທ່ານສາມາດເລືອກໃຫ້ກ່ອງໂຕ້ຕອບການລັອກອິນ"
"ສະແດງຜົນຢູ່ທາງກາງ ຫລືໃນຕຳແຫນ່ງທີ່ກຳນົດໄດ້ທີ່ນີ້"

#: kdm-appear.cpp:166
msgid "&X:"
msgstr "ຕຳແຫນ່ງ X"

#: kdm-appear.cpp:173
msgid "&Y:"
msgstr "ຕຳແຫນ່ງ Y"

#: kdm-appear.cpp:180
msgid "Here you specify the coordinates of the login dialog's <em>center</em>."
msgstr ""
"ທ່ານສາມາດກຳນົດໃຫ້ກ່ອງໂຕ້ຕອບການລັອກອິນ "
"ສະແດງຜົນ <em>ກາງ</em>ຕຳແຫນ່ງທີ່ກຳນົດໄດ້"

#: kdm-appear.cpp:196
msgid "GUI s&tyle:"
msgstr "ສະແດງຜົນແບບ:"

#: kdm-appear.cpp:200
msgid "You can choose a basic GUI style here that will be used by KDM only."
msgstr ""
"ທ່ານສາມາດເລືອກຮູບແບບການສະແດງຜົນໄດ້ທີ່ນີ້"
"ໂດຍຈະຖືກໃຊ້ກັບ KDM ເທົ່ານັ້ນ"

#: kdm-appear.cpp:207
msgid "&Color scheme:"
msgstr "ສີທີ&1:"

#: kdm-appear.cpp:211
msgid "You can choose a basic Color Scheme here that will be used by KDM only."
msgstr ""
"ທ່ານສາມາດເລືອກຮູບແບບການສະແດງຜົນໄດ້ທີ່ນີ້"
"ໂດຍຈະຖືກໃຊ້ກັບ KDM ເທົ່ານັ້ນ"

#: kdm-appear.cpp:216
msgid "Echo &mode:"
msgstr "ສະແດງປຸ່ມທີ່ພິມ:"

#: kdm-appear.cpp:219
msgid "No Echo"
msgstr "ບໍ່ສະແດງ"

#: kdm-appear.cpp:220
msgid "One Star"
msgstr "ດອກຈັນ 1 ຕົວ"

#: kdm-appear.cpp:221
msgid "Three Stars"
msgstr "ດອກຈັນ 3 ຕົວ"

#: kdm-appear.cpp:225
msgid "You can choose whether and how KDM shows your password when you type it."
msgstr ""
"ທ່ານສາມາດເລືອກວ່າຈະໃຫ້ KDM "
"ສະແດງລະຫັດຜ່ານທີ່ທ່ານພິມຢ່າງໃດ"

#: kdm-appear.cpp:231
msgid "Locale"
msgstr "ພາສາທ້ອງຸຸຖິ່ນ"

#: kdm-appear.cpp:238
msgid "Languag&e:"
msgstr "ພາສາ:"

#: kdm-appear.cpp:245
msgid ""
"Here you can choose the language used by KDM. This setting doesn't affect a "
"user's personal settings that will take effect after login."
msgstr ""
"ທ່ານສາມາດເລືອກພາສາທີ່ໃຊ້ກັບ KDM ໄດ້ທີ່ນີ້"
"ໍຊຶ່ງຈະບໍ່ມີຜົນກັບການປັບແຕ່ງສ່ວນຕົວຂອງທ່ານ "
"(ການປັບແຕ່ງສ່ວນຕົວຈະມີຜົນເມື່ອຜ່ານຂະບວນການ"
"ລັອກອິນ)"

#: kdm-appear.cpp:289
msgid "without name"
msgstr "ບໍ່ໃສ່ຊື່"

#: kdm-appear.cpp:406
msgid ""
"There was an error loading the image:\n"
"%1\n"
"It will not be saved."
msgstr ""
"ເກີດຄວາມຜິດພາດໃນ "
"ການໃຊ້ແຟ້ມພາບ:\n"
"%1\n"
"ມັນຈະບໍ່ຖືກບັນທຶກ..."

#: kdm-appear.cpp:450 kdm-appear.cpp:500
#, c-format
msgid "Welcome to %s at %n"
msgstr ""
"ຍິນດີຕ້ອນຮັບສູ່ %s ເທິງເຄື່ອງ "
"%n"

#: kdm-appear.cpp:514
msgid ""
"<h1>KDM - Appearance</h1>"
" Here you can configure the basic appearance of the KDM login manager, i.e. "
"a greeting string, an icon etc."
"<p> For further refinement of KDM's appearance, see the \"Font\" and "
"\"Background\"  tabs."
msgstr ""
"<h1>ລັກສະນະ KDM ທີ່ປະກົດ</h1> "
"່ທ່ານສາມາດປັບແຕ່ງລັກສະນະທີ່ປະກົດ"
"ຂອງໂປຣແກຣມຈັດການ ການລັອກອິນ KDM "
"ໄດ້ທີ່ນີ້ ເຊັ່ນ ປ່ງນຂໍ້ຄວາມຕ້ອນຮັບໄອຄອນ ຫລືອື່ນໆ"
"<p> "
"ສຳລັບສ່ວນປັບແຕ່ງສ່ວນປັບແຕ່ງທີ່ກງ່ວຂ້ອງຂອງ KDM "
"ເບິ່ງທີ່ແທັບ \"ຮູບແບບຕົວອັກສອນ\" ແລະ\"ພື້ນຫລັງ\""

#: kdm-font.cpp:46
msgid "Select Fonts"
msgstr "ເລືອກຕົວອັກສອນ"

#: kdm-font.cpp:49
msgid "Greeting"
msgstr "ຂໍ້ຄວາມຕ້ອນຮັບ"

#: kdm-font.cpp:50
msgid "Fail"
msgstr "ຂໍ້ຄວາມລົ້ມເຫລວ"

#: kdm-font.cpp:51
msgid "Standard"
msgstr "ຂໍ້ຄວາມມາດຕະຖານ"

#: kdm-font.cpp:55
msgid ""
"Here you can select the font you want to change. KDM knows three fonts: "
"<ul>"
"<li><em>Greeting:</em> used to display KDM's greeting string (see "
"\"Appearance\" tab)</li>"
"<li><em>Fail:</em> used to display a message when a person fails to "
"login</li><li><em>Standard:</em> used for the rest of the text</li></ul>"
msgstr ""
"ທ່ານສາມາດເລືອກຕົວອັກສອນທີ່ຕ້ອງການປ່ງນໄດ້ທີ່ນີ້"
"่ KDM ແຍກໃຊ້ຕົວອັກສອນກັບສາມຂໍ້ຄວາມຄື: "
"<ul>"
"<li><em>ຂໍ້ຄວາມຕ້ອນຮັບ:</em> "
"ໃໍຊ້ສະແດງຂໍ້ຄວາມຕ້ອນຮັບຂອງ KDM "
"(ເບິ່ງແທບ \"ລັກສະນະທີ່ປະກົດ\")</li>"
"<li><em>ຂໍ້ຄວາມລົ້ມເຫລວ:</em> "
"ໃຊ້ສະແດງຂໍ້ຄວາມເມື່ອຜູ້ໃຊ້ລັອກອິນຜິດພາດ</li>"
"<li><em>ຂໍ້ຄວາມມາດຕະຖານ:</em> "
"ໃຊ້ສຳລັບຮູບແບບທົ່ວໄປ </li></ul>"

#: kdm-font.cpp:60
msgid "C&hange Font..."
msgstr "ປ່ງນຕົວອັກສອນ..."

#: kdm-font.cpp:64
msgid "Click here to change the selected font."
msgstr "ຄລິກທີ່ນີ້ເພື່ອປ່ງນຕົວອັກສອນທີ່ເລືອກໄວ້"

#: kdm-font.cpp:68
msgid "Example"
msgstr "ຕົວຢ່າງ"

#: kdm-font.cpp:69
msgid "Shows a preview of the selected font."
msgstr "ສະແດງຕົວຢ່າງຂອງຕົວອັກສອນທີ່ເລືອກ"

#: kdm-font.cpp:76
msgid "Use anti-aliasing for fonts"
msgstr "ໃຊ້ການສະແດງຜົນແບບບໍ່ມີຮອຍຢັກສຳລັບຕົວອັກສອນ"

#: kdm-font.cpp:77
msgid ""
"If you check this box and your X-Server has the Xft extension, fonts will be "
"antialiased (smoothed) in the login dialog."
msgstr ""
"ຫາກທ່ານຄຸນເລືອກໃຊ້ຕົວເລືອກນີ້ແລະ"
"ເຊີບເວີ X ມີສ່ວນຂະຫຍາຍ "
"Xft ຈະເຮັດໃຫ້ຕົວອັກສອນທີ່ສະແດງເທິງກ່ອງການ "
"ລັອກອິນ ສະແດງຜົນແບບບໍ່ມີຮອຍຢັກ"

#: kdm-font.cpp:178
msgid "Greeting font"
msgstr ""
"ຕົວອັກສອນຂໍ້ຄວາມ - "
"Greeting font"

#: kdm-font.cpp:182
msgid "Fail font"
msgstr ""
"ຕົວອັກສອນຂໍ້ຄວາມລົ້ມເຫລວ - Fail "
"font"

#: kdm-font.cpp:186
msgid "Standard font"
msgstr ""
"ຕົວອັກສອນຂໍ້ຄວາມມາດຕະຖານ - "
"Standard font"

#: kdm-sess.cpp:50
msgid "Allow Shutdown"
msgstr "ການອະນຸຍາດໃຫ້ເປີດເຄື່ອງ"

#: kdm-sess.cpp:53
msgid "Co&nsole:"
msgstr "ຈາກຄອນໂຊນ:"

#: kdm-sess.cpp:54 kdm-sess.cpp:60
msgid "Everybody"
msgstr "ອະນຸຍາດທຸກຄົນ"

#: kdm-sess.cpp:55 kdm-sess.cpp:61
msgid "Only root"
msgstr "ສະເພາະ root ເທົ່ານັ້ນ"

#: kdm-sess.cpp:56 kdm-sess.cpp:62
msgid "Nobody"
msgstr "ບໍ່ອະນຸຍາດໃຫ້ເລຍ"

#: kdm-sess.cpp:59
msgid "Re&mote:"
msgstr "ຈາກໄລຍະໄກ:"

#: kdm-sess.cpp:64
msgid ""
"Here you can select who is allowed to shutdown the computer using KDM. You "
"can specify different values for local (console) and remote displays. "
"Possible values are:"
"<ul> "
"<li><em>Everybody:</em> everybody can shutdown the computer using KDM</li> "
"<li><em>Only root:</em> KDM will only allow shutdown after the user has "
"entered the root password</li> "
"<li><em>Nobody:</em> nobody can shutdown the computer using KDM</li></ul>"
msgstr ""
"ທ່ານສາມາດກຳນົດທີ່ຈະໃຫ້ບາງຄົນທີ່ມີສິດໃນການ"
"ເປີດເຄື່ອງຜ່ານ KDM ໄດ້ທີ່ນີ້"
"ໍຊຶ່ງທ່ານກຳນົດການປິດຈາກພາຍໃນ (ຫນ້າຈໍເຄື່ອງ) "
"ແລະຈາກໄລຍະໄກ ໂດຍຄ່າຕ່າງໆຄື:"
"<ul> "
"<li><em>ໄດ້ທຸກຄົນ:</em> "
"ທ່ານສາມາດສັ່ງປິດເຄື່ອງນີ້ໄດ້ ໂດຍຜ່ານທາງ KDM</li> "
"<li><em>ສະເພາະ root ເທົ່ານັ້ນ:</em> KDM "
"ຈະອະນຸຍາດໃຫ້ສະເພາະ root ເທົ່ານັ້ນທີ່ມີສິດປິດເຄື່ອງ "
"ໂດຍຈະມີການຖາມລະຫັດຜ່ານ root "
"ກ່ອນທີ່ຈະປິດ</li> "
"<li><em>ບໍ່ອະນຸຍາດເລຍ:</em> "
"ບໍ່ອະນຸຍາດໃຫ້ຜູ້ໃດສາມາດສັ່ງປິດເຄື່ອງ"
"ຜ່ານທາງ KDM ໄດ້</li></ul>"

#: kdm-sess.cpp:72
msgid "Commands"
msgstr "ຄຳສັ່ງ"

#: kdm-sess.cpp:75
msgid "Ha&lt:"
msgstr "ປິດເຄື່ອງ:"

#: kdm-sess.cpp:78
msgid "Command to initiate the system halt. Typical value: /sbin/halt"
msgstr ""
"ຄຳສັ່ງທີ່ໃຊ້ສັ່ງໃຫ້ລະບົບທຳການປິດເຄື່ອງ"
"ໂດຍທົ່ວໄປຈະເປັນ: /sbin/halt"

#: kdm-sess.cpp:83
msgid "&Reboot:"
msgstr "ບູດເຄື່ອງໃຫມ່:"

#: kdm-sess.cpp:86
