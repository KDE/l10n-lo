#: kgreeter.cpp:587
msgid ""
"A critical error occurred.\n"
"Please look at KDM's logfile for more information\n"
"or contact your system administrator."
msgstr ""
"ມີຂໍ້ຜິດພາດຮ້່ຍແຮງ\n"
"ກະລຸນາເບິ່ງແຟ້ມການເຮັວງກຂອງ KDM ເພືອລາຍລະອງດ\n"
"ທີ່ຫລາຍກ່ວານີ້ "
"ຫລືກະລຸນາຕິດຕໍ່ຜູ້ຮັກສາລະບົບຂອງທ່ານ"

#: kgreeter.cpp:592
msgid "Home directory not available."
msgstr "ບໍ່ເຫັນໄດເລກເທີລີຂອງທ່ານ"

#: kgreeter.cpp:595
msgid "Root logins are not allowed."
msgstr "ບໍ່ອະນຸາດລອກອິນດ້ວຍຜູ້ໄຊ້ root"

#: kgreeter.cpp:599
msgid "Your login shell is not listed in /etc/shells."
msgstr ""
"ເຊວສຳລັບລອກອິນຂອງທ່ານ "
"ບໍ່ມີໃນແຟ້ມ /etc/shells"

#: kgreeter.cpp:602
msgid "Your account has expired."
msgstr "ທະບງນຜູ້ໄຊ້ຂອງທ່ານຫມົດອາຍຸແລ້ວ"

#: kgreeter.cpp:605
msgid "Your password has expired."
msgstr "ລະຫັດຜ່ານຂອງທ່ານຫນົດອາຍຸແລ້ວ"

#: kgreeter.cpp:608
msgid ""
"You are not allowed to login\n"
"at the moment."
msgstr "ຍັງບໍ່ອະນຸບາດໃຫ້ທ່ານລອກອິນໃນຕອນນີ້"

#: kgreeter.cpp:625
msgid ""
"Logins are not allowed at the moment.\n"
"Try again later."
msgstr ""
"ຍັງບໍ່ອະນຸຍາດໃຫ້ລອກອາິນໃນຕອນນີ້\n"
"ລອງພະຍາຍາມໃຫມ່ໃນຕອນນີ້"

#: kgreeter.cpp:660
msgid "Your account expires today."
msgstr "ທະບງນຂອງທ່ານຈະຫມົດອາຍຸໃນມື້ນີ້"

#: kgreeter.cpp:662
msgid "Your account expires tomorrow."
msgstr "ທະບງນຜູ້ໄຊ້ຂອງທ່ານຈະຫມົດອາຍຸໃນມື້ອື່ນນີ້"

#: kgreeter.cpp:665
msgid "Your account expires in %1 days."
msgstr "ທະບງນຜູ້ໄຊ້ຂອງທ່ານຈະຫມົດອາຍຸໃນ %1 ວັນ"

#: kgreeter.cpp:670
msgid "Your password expires today."
msgstr "ລະຫັດຜ່ານຂອງທ່ານຈະຫມົດອາຍຸໃນມື່ນີ້"

#: kgreeter.cpp:672
