msgstr "ບໍ່ພົບພາຣາມິເຕີ"

#: kdcopwindow.cpp:320
msgid "DCOP Browser Error"
msgstr "ບຣາວເຊີ DCOP ຜິດພາດ"

#: kdcopwindow.cpp:336
#, fuzzy, c-format
msgid "Call Function %1"
msgstr "ເອີ້ນຟັງຊັນ %1"

#: kdcopwindow.cpp:340
msgid "Name"
msgstr "ຊື່"

#: kdcopwindow.cpp:341
msgid "Type"
msgstr "ຊະນິດ"

#: kdcopwindow.cpp:342
msgid "Value"
msgstr "ຄ່າ"

