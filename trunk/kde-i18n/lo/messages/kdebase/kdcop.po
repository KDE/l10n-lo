#: kdcopwindow.cpp:133
msgid "%1 (default)"
msgstr "%1 (ຄ່າປະລິຍາຍ)"

#: kdcopwindow.cpp:195
msgid "Welcome to the KDE DCOP browser"
msgstr "ຍິນດີຕ້ອນຮັບສູ່ບຣາວເຊີ KDE DCOP"

#: kdcopwindow.cpp:199
msgid "Application"
msgstr "ແອັບພລິເຄຊັນ"

#: kdcopwindow.cpp:229
msgid "&Execute"
msgstr "ປະມວນຜົນ"

#: kdcopwindow.cpp:239
msgid "Execute the selected DCOP call."
msgstr ""
"ເອີ້ນ DCOP "
"ໃຫ້ປະມວນຜົນທີ່ເລືອກໄວ້"

#: kdcopwindow.cpp:241
msgid "Language Mode"
msgstr "ໂຫມດພາສາ"

#: kdcopwindow.cpp:249
msgid "Set the current language export."
msgstr ""
"ຕັ້ງຄ່າສົ່ງອອກເປັນພາສາປະຈ"
"ຸບັນ"

#: kdcopwindow.cpp:268
msgid "DCOP Browser"
msgstr "ບຣາວເຊີ DCOP"

#: kdcopwindow.cpp:320
