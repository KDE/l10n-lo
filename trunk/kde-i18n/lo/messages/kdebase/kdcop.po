#: kdcopwindow.cpp:592
msgid "DCOP call failed"
msgstr "ຫລົ້ມເຫລວໃນການເອີ້ນ DCOP"

#: kdcopwindow.cpp:594
#, c-format
msgid "<p>DCOP call failed.</p>%1"
msgstr "<p>ຫລົ້ມເຫລວໃນການເອີ້ນ DCOP</p>%1"

#: kdcopwindow.cpp:605
msgid ""
"<p>Application is still registered with DCOP. I don't know why this call "
"failed.</p>"
msgstr ""
"<p>ແອັບພລິເຄຊັນຍັງຄົງລົງທະບ"
"ງນກັບ DCOP ຢູ່ ແຕ່ບໍ່ຮູ້ວ່າ "
"ຍ້ອນຫຍັງການເອີ້ນນີ້ຈຶ່ງລົ"
"້ມເຫລວ </p>"

#: kdcopwindow.cpp:617
msgid "<p>The application appears to have unregistered with DCOP.</p>"
msgstr ""
"<p>ເບິ່ງຄືວ່າແອັບພລິເຄຊັນຍັ"
"ງບໍ່ໄດ້ລົງທະບງນກັບ DCOP</p>"

#: kdcopwindow.cpp:633
msgid "DCOP call %1 executed"
msgstr "DCOP ເອີ້ນປະມວນຜົນ %1"

