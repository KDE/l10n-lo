#: rc.cpp:4
msgid "&Autosuspend if idle for:"
msgstr "ປິດທຳງານຊົ່ວຄາວອັດຕະໂນມັດເມືອ່ໃຊ້ດົນ:"

#: rc.cpp:5
msgid "The sound server will suspend itself if idle for this period of time."
msgstr ""
"ເຊີບເວີລະບົບສງງຈະປິດການທຳງານຊົ່ວຄາວ"
"ຫາກບໍ່ມີການໃຊ້ງານດົນຕາມໄລຍະເວລາທີ່ກຳນົດນີ້"

#: rc.cpp:6
msgid " sec"
msgstr "ວິນາທີ"

#: rc.cpp:7
msgid "Run soundserver with &realtime priority"
msgstr "ໃຫ້ເຊີບເວີລະບົບສງງທຳງານໃນແບບຣງວທາມ"

#: rc.cpp:8
msgid ""
"On systems which support realtime scheduling, if you have sufficient "
"permissions, this option will enable a very high priority for processing "
"sound requests."
msgstr ""
"ເທິງລະບົບທີ່ສະຫນັບສະຫນູນການທຳງານແບບຣງວທາມ"
"ຖ້າທ່ານມີສິດພງງພໍທີ່ຈະເຂົ້່າໃຊ້"
"ຕົວເລືອກນີ້ຈະເຮັດໃ້ຫ້ການປະມວນຜົນສງງ"
"ມີລຳດັບຄວາມສຳຄັນສູງຫລາຍ"
"ສຳຫັລບການປະມວນຜົນສງງທີ່ຮ້ອງຂໍເຂົ້າມາ"

#: rc.cpp:9
msgid "Exchange security and reference info over the &X11 server"
msgstr ""
"ແລກປ່ງນລະບົບຄວາມປອດໄພໂດຍອ້າງອີງຂໍ້ມູນໄປຍັງເຊີບເວີ"
"์ &X11"

#: rc.cpp:10
msgid ""
"If you want network transparency or if you use the soundserver only when you "
"use X11, enable this option."
msgstr ""
"ຫາກທ່ານເປີດໃຊ້ງານກັບລະບົບເຄືອຂ່າຍ"
"ຫລືທ່ານໃຊ້ເຊີບເວີລະບົບສງງ ສະເພາະເມືອ່ທຳງານເທິງ"
" X11 "
"ເທົ່ານັ້ນ"
"ໃຫ້ເລືອກຕົວເລືອກນີ້"

#: rc.cpp:11
msgid "&Test Sound"
msgstr "ທົດສອບສງງ"

#: rc.cpp:12
msgid "Errors"
msgstr "ຜິດພາດ"

#: rc.cpp:13
msgid "Warnings"
msgstr "ຄຳເຕຶອນ"

#: rc.cpp:14
msgid "Informational"
msgstr "ຂໍ້ມູນ"

#: rc.cpp:15
msgid "Debug"
msgstr "ດີບັກ"

#: rc.cpp:16
msgid "Display &messages using:"
msgstr "ສະແດງຂໍ້ຄວາມໂດຍໃຊ້:"

#: rc.cpp:17
msgid ""
"When enabled, server error, warning, and informational messages will be "
"displayed using this external program."
msgstr ""
"ເປີດໃຊ້ງານຕົວເລືອກນີ້"
"ເພືອ່ໃຫ້ເມືອ່ເຊີບເວີຜິດພາດ,ມີຄຳເຕືອນ,"
"ແລະມີຂໍ້ຄວາມສະແດງຂໍ້ມູນຕ່າງໆ"
"ຈະຖືກສະແດງໂດຍໃຊ້ໂປຣແກຣມອື່ນໆພາຍນອກ"

#: rc.cpp:18
msgid "Message display:"
msgstr "ສະແດງຂໍ້ຄວາມ:"

#: rc.cpp:19
msgid ""
"This controls the level of messages that are output by the sound server. "
"Only messages at the selected level and above will be reported."
msgstr ""
"ໃຊ້ຄວບຄຸມລະດັບຂອງຂໍ້ຄວາມທີ່ມາຈາກເຊີບເວີລະບົບສງງ"
"ຊຶ່ງຈະມີພງງຂໍ້ຄວາມໃນລະດັບທີ່ເລືອກ"
"ແລະໃນລະດັບທີສູງກວ່າເທົ່ານັ້ນທີ່ຈະຖືກສະແດງ"

#: rc.cpp:20
msgid "&Start aRts soundserver on KDE startup"
msgstr ""
"ເລີ່ມທຳງານເຊີບເວີລະບົບສງງ"
" aRts "
"ທຸກຄັ້ງເມືອ່ເລີ່ມ KDE"

#: rc.cpp:21
msgid ""
"If this option is enabled, the arts soundserver will be started on KDE "
"startup. Recommended if you want sound."
msgstr ""
"ເລືອກຕົວເລືອກນີ້"
"ເພື່ອໃຫ້ເຊີບເວີລະບົບສງງ"
"artsທຳງານທຸກຄັ້ງທີ່ KDE "
"ເລີ່ມທຳງານ"
"*ຄວນໃຊ້ຕົວເລືອກນີ້ຖ້າທ່ານຕ້ອງການໃຊ້ງານລະບົບສງງ"

#: rc.cpp:22
msgid " Audio Buffer Size (response time) "
msgstr ""
"ຂະຫນາດບັບເຟີສງງ"
"(ເວລາຕອບສະຫນອງ) "

#: rc.cpp:23
msgid ""
"<ul>\n"
"<li>low CPU usage</li>\n"
"<li>slow response</li>\n"
"<li>less dropouts</li>\n"
"</ul>"
msgstr ""
"<ul>\n"
"<li>ອັດຕາການໃຊ้້ CPU ຕຳ່</li>\n"
"<li>ອັດຕາການຕອບສະຫນອງຊ້າ</li>\n"
"<li>ສງງກະຕຸກເລື້ອຍໆ</li>\n"
"</ul>"

#: rc.cpp:24
msgid ""
"<ul>\n"
"<li>high CPU usage</li>\n"
"<li>fast response</li>\n"
"<li>more dropouts</li>\n"
"</ul>"
msgstr ""
"<ul>\n"
"<li>ອັດຕາການໃຊ้້ CPUສູງ</li>\n"
"<li>ອັດຕາການຕອບສະຫນອງໄວ</li>\n"
"<li>ສງງກະຕຸກນ້ອຍ</li>\n"
"</ul>"

#: rc.cpp:25
msgid "Latency: 150 milliseconds (7 fragments, 4096 bytes)"
msgstr ""
"ຊ່ວງຫນ່ວງ: 150 ມິນລີວິນາທີ"
"(ກະຈັດກະຈາຍ 7, 4096 ໄບຕ໌)"

#: rc.cpp:26
msgid "Use custom s&ampling rate:"
msgstr "ໃຊ້ອັດຕາຄວາມຖີ່ສງງທີ່ກຳນົດ:"

#: rc.cpp:27
msgid "Sound quality:"
msgstr "ຄຸນນະພາບສງງ:"

#: rc.cpp:28 rc.cpp:32
msgid "Autodetect"
msgstr "ກວດເຊັກອັດຕະໂນມັດ"

#: rc.cpp:29
msgid "16 bits (high)"
msgstr "16 ບິດ(ສູງ)"

#: rc.cpp:30
msgid "8 bits (low)"
msgstr "8 ບິດ(ຕຳ່)"

#: rc.cpp:31
msgid "Sound I/O &method:"
msgstr "ວິທີການຂອງ I/O ລະບົບສງງ:"

#: rc.cpp:33
msgid "&Other custom options:"
msgstr "ຕົວເລືອກທີ່ປັບແຕ່ງເອງອື່ນໆ:"

#: rc.cpp:34
msgid "Enable full &duplex operation"
msgstr "ເປີດໃຊ້ງານ Full &Duplex"

#: rc.cpp:35
msgid ""
"This enables the soundserver to record and play sound at the same time. If "
"you use applications like Internet telephony, voice recognition or similar, "
"you probably want this."
msgstr ""
"ທ່ານສາມາດໃຊ້ເຊີບເວີລະບົບສງງ"
"ສາມາດບັນທຶກແລະຫລິ້ນສງງໄດ້ໃນເວລາດງວກັນ"
"ແລະຖ້າທ່ານໃຊ້ໂປຣແກຣມປະເພດດງວກັບອຸ"
"ສື່ສານດ້ວຍສງງ ຜ່ານທາງອິນເຕີເນັດ"
"ການສັ່ງງານດ້ວຍສງງ"
"ຫລືອື່ນໆ"
"ທີ່ຄ້າຍກັນແລ້ວ ທ່ານຄວນຈະເປີດໃຊ້ງານຕົວເລືອກ"

#: rc.cpp:36
msgid "&Use custom sound device:"
msgstr "ໃຊ້ອຸປະກອນສງງທີ່ກຳນົດສງງ:"

#: rc.cpp:37
msgid ""
"If you are using a Yamaha soundcard, you might need to set the sampling rate "
"to 48000 Hz."
msgstr ""
"ຖ້າທ່ານກຳ່ລັງໃຊ້ກາດສງງຍຳມາຮ່າຢູ່"
"ທ່ານອາດຈະຕ້ອງການຕັ້ງຄ່າໃຫ້ອັດຕາຄວາມຖີ່ສງງຢູ່ທີ່"
"48000 Hz."

