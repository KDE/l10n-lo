#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "ທອງສຳລິດ ອ່ອນມະນີສອນ"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "onemanisonet@yahoo.com"

#: main.cpp:30
msgid ""
"The reliable KDE session manager that talks the standard X11R6 \n"
"session management protocol (XSMP)."
msgstr ""
"ໂປຣແກຣມຈັດການເຊສຊັນຂອງ "
"ເຄດີອີ ຈະຕິດຕໍ່ກັບ\n"
"ໂປຣໂຕຄອນຈັດການເຊສຊັນຂອາງX11R6"
" (XSMP)"

#: main.cpp:35
msgid "Restores the saved user session if available"
msgstr ""
"ເອີ້ນຄືນເຊສຊັນກ່ອນຫນ້າທີຄ"
"້າງໄວ້(ຖ້າມີ)"

#: main.cpp:37
msgid ""
"Starts 'wm' in case no other window manager is \n"
"participating in the session. Default is 'kwin'"
msgstr ""
"ເອີ້ນໃຫ້'ດັບເບິນຢູເອັມ "
"(ໂປຣແກຣມຈັດການຫນ້າຈໍ)ເຮັດວູ"
"ກ\n"
"ຫາກຍັງບໍ່ມີການເຮັດວູກ "
"ໂປຣແກຣມໂດຍປະລິຍາຍຄື 'ເຄວິນ'"

#: main.cpp:38
msgid "Also allow remote connections."
msgstr ""
"ອະນຸຍາດການເຊື່ອມຕໍ່ຈາກເຄື"
"່ອງອື່ນ"

#: main.cpp:182
msgid "The KDE Session Manager"
msgstr "ໂປຣແກຣມຈັດການເຊສຊັນ ເຄດີອີ"

#: shutdown.cpp:80
msgid "End Session for \"%1\""
msgstr "ຈົບເຊສຊັນສຳລັບ\"%1\""

#: shutdown.cpp:103
#, fuzzy
msgid "What do you want to do?"
msgstr ""
"ທ່ານຕ້ອງການຈະເຮັດຫຍັງຕໍ່ໄ"
"ປ?"

#: shutdown.cpp:104
#, fuzzy
msgid "&End session only"
msgstr "ຈົບເຊສຊັນສຳລັບ\"%1\""

#: shutdown.cpp:105
msgid "&Turn off computer"
msgstr "ແລະ ປິດເຄື່ອງຄອມພິວເຕີ"

#: shutdown.cpp:106
msgid "&Restart computer"
msgstr ""
"ເລີ່ມການເຮັດແລະວູກຄອມພິວເ"
"ຕີ?ໃຫມ່"

#: shutdown.cpp:127
msgid "Shutdown Mode"
msgstr "ໂຫມດການປິດເຄື່ອງ"

#: shutdown.cpp:128
msgid "Sch&edule"
msgstr "ແລະຕາຕະລາງງານ"

#: shutdown.cpp:130
msgid "&Force now"
msgstr "ບັງຄັບໃຫ້ເຮັດດງວນີ້"

#: shutdown.cpp:131
msgid "&Try now"
msgstr "ເຮັດດງວນີ້"

#: shutdown.cpp:142
msgid "&Logout"
msgstr "ລັອກເອົາຕ໌"

#~ msgid "&Login as different user"
#~ msgstr "ລັອກອິນແປ້ນແລະຜູ້ໃຊ້ອື່ນ"

#~ msgid "&Save session for future logins"
#~ msgstr "บันทึกค่าของเซสชันปัจจุบัน สำหรับการล็อกอินครั้งต่อไป"
