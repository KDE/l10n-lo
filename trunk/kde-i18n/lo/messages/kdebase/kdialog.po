#: kdialog.cpp:45
msgid "Question message box with yes/no buttons"
msgstr ""
"ກ່ອງຂໍ້ຄວາມຖາມພ້ອມປຸ່ມ "
"ຖືກ/ບໍ່ຖືກ"

#: kdialog.cpp:46
msgid "Question message box with yes/no/cancel buttons"
msgstr ""
"ກ່ອງຂໍ້ຄວາມຖາມພ້ອມປຸ່ມ "
"ຖືກ/ບໍ່ຖືກ/ຍົກເລີກ"

#: kdialog.cpp:47
msgid "Warning message box with yes/no buttons"
msgstr ""
"ກ່ອງຂໍ້ຄວາມແຈ້ງເຕືອນພ້ອມປຸ່ມ"
" ຖືກ/ບໍ່ຖືກ"

#: kdialog.cpp:48
msgid "Warning message box with continue/cancel buttons"
msgstr ""
"ກ່ອງຂໍ້ຄວາມແຈ້ງເຕືອນພ້ອມ"
"ເຮັດຕໍ່ໄປ/ຍົກເລີກ"

#: kdialog.cpp:49
msgid "Warning message box with yes/no/cancel buttons"
msgstr ""
"ກ່ອງຂໍ້ຄວາມແຈ້ງເຕືອນພ້ອມປຸ່ມ"
"ຖືກ/ບໍ່ຖືກ/ຍົກເລີກ"

#: kdialog.cpp:50
msgid "'Sorry' message box"
msgstr "ກ່ອງສະແດງຂໍ້ຄວາມ 'ຂໍໂທດ'"

#: kdialog.cpp:51
msgid "'Error' message box"
msgstr "ກ່ອງສະແດງ 'ຂໍ້ຜິດພາດ'"

#: kdialog.cpp:52
msgid "Message Box dialog"
msgstr "ກ່ອງສະແດງຂໍ້ຄວາມ"

#: kdialog.cpp:53
msgid "Input Box dialog"
msgstr "ກ່ອງນຳເຂົ້າຂໍ້ມູນ"

#: kdialog.cpp:54
msgid "Password dialog"
msgstr "ກ່ອງລະຫັດຜ່ານ"

#: kdialog.cpp:55
msgid "Text Box dialog"
msgstr "ກ່ອງຂໍ້ຄວາມ"

#: kdialog.cpp:56
msgid "Menu dialog"
msgstr "ກ່ອງເມນູ"

#: kdialog.cpp:57
msgid "Check List dialog"
msgstr "ກ່ອງລາຍການປຸ່ມກວດກາ"

#: kdialog.cpp:58
msgid "Radio List dialog"
msgstr "ກ່ອງລາຍການປຸ່ມວິທະຍຸ"

#: kdialog.cpp:63
msgid "Dialog title"
msgstr "ຫົວເລື່ອງກ່ອງ"

#: kdialog.cpp:64
msgid "Return list items on separate lines (for checklist option)"
msgstr ""
"ຄືນຄ່າລາຍການເປັນບັນທັດທີ່"
"ແຍກກັນ (ສຳລັບຕົວເລືອກ checklist)"

#: kdialog.cpp:66
msgid "Arguments - depending on main option"
msgstr ""
"ອາກກູເມັນທ໌"
"ຂື້ນຢູ່ກັບຕົວເລືອກຫລັກ"

#: kdialog.cpp:245
msgid "KDialog"
msgstr "ກ່ອງໂຕ້ຕອບ K"

#: kdialog.cpp:246
msgid "KDialog can be used to show nice dialog boxes from shell scripts"
msgstr ""
"ກ່ອງໂຕ້ຕອບ K "
"ສາມາດໃຊ້ໃນການສະແດງກ່ອງໂຕ້ "
"ຕອບຈາກ ເຊລລ໌ສຄລິບໄດ້"

#: kdialog.cpp:248
msgid "Current maintainer"
msgstr "ຜູ້ດູແລໃນປະຈຸບັນ"

#: widgets.cpp:67
msgid "kdialog: could not open file "
msgstr ""
"ກ່ອງໂຕ້ຕອບ K: "
"ບໍ່ສາມາດເປີດເອກະສານໄດ້"

