msgstr "ຕົອອກສອນກ້ວາງຄົງທີ່"

#: fonts.cpp:227
msgid "Toolbar"
msgstr "ແຖບເຄື່ອງມື"

#: fonts.cpp:228
msgid "Menu"
msgstr "ເມນูູ"

#: fonts.cpp:229
msgid "Window title"
msgstr "ແຖບຫົວເລືອງຫນ້າຕ່າງ"

#: fonts.cpp:230
msgid "Taskbar"
msgstr "ທາສຄ໌ບາ"

#: fonts.cpp:231
msgid "Desktop"
msgstr "ຫນ້າຕ່າງຈໍ"

#: fonts.cpp:265
msgid "Used for normal text (e.g. button labels, list items)."
msgstr ""
"ໃຊ້ສຳລັບຂໍ້ຄວາມປົກກະຕິ "
"(ເຊັ່ນວ່າ "
"ລະດັບປຸ່ມ,ລາຍການໃນລິດສທ໌ "
"ເປັນຕົ້ນ)."

#: fonts.cpp:266
msgid "A non-proportional font (i.e. typewriter font)."
msgstr ""
"ຕົວອັກສອນທີ່ມີສັດສ່ວນບໍ່ຄ"
"ົງທີ່ (ເຊັ່ນ "
"ຕົວອັກສອນແບບເຄື່ອງພິມດີດ)."

#: fonts.cpp:267
msgid "Used to display text beside toolbar icons."
msgstr ""
"ໃຊ້ເພື່ອສະແດງຂໍ້ຄວາມໃຫ້ດ້"
"ານຂ້າງຂອງ ໄອຄອນ "
"ແຖບເຄື່ອງມື."

#: fonts.cpp:268
msgid "Used by menu bars and popup menus."
msgstr ""
"ຖືກໃຊ້ດ້ອຍ "
"ແຖບເມນູແລະເມນູພ໊ອບອັບພ໌"

#: fonts.cpp:269
msgid "Used by the window titlebar."
msgstr ""
"ຖືກໃຊ້ດ້ອຍແຖບຫົວຂໍ້ຫນ້າຕ່"
"າງ."

#: fonts.cpp:270
msgid "Used by the taskbar."
msgstr "ຖືກໃຊ້ດ້ອຍປຸ່ມທາດສຄ໌ບາ์"

#: fonts.cpp:271
msgid "Used for desktop icons."
msgstr "ຖືກໃຊ້ສຳລັບ ໄອຄອນບົນຫນ້າຈໍ."

#: fonts.cpp:322
#, fuzzy
msgid "Ad&just All Fonts..."
msgstr "ປັບທຸກໂຕອັກສອນ..."

#: fonts.cpp:323
msgid "Click to change all fonts"
msgstr "ຄີ້ລກເພື່ອປ່ງນທຸກໂຕອັກສອນ."

#: fonts.cpp:327
#, fuzzy
msgid "An&ti-Aliasing"
msgstr "ສະແດງຜົນແບບໄຮ້ຊື່ອື່ນ"

#: fonts.cpp:332
msgid "Use a&nti-aliasing for fonts"
msgstr ""
"ປັບການສະແດງຜົນຕົວອັກສອນແບ"
"ບໄຮ້ຊື່ອື່ນ"

#: fonts.cpp:333
msgid "If this option is selected, KDE will smooth the edges of curves in fonts."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພືອໃຫ້ KDE "
"ສະແດງຜົນຕົວອັກສອນແລະພາບບິ"
"ດແມພບາງສ່ວນ "
"ໃນແບບໄຮ້ຊື່ອື່ນ"

#: fonts.cpp:339
msgid "E&xclude range:"
msgstr "ບໍ່&xລອມຊ่ວງ:"

#: fonts.cpp:341 fonts.cpp:344
msgid " pt"
msgstr "ພອຍເຕີ້"

#: fonts.cpp:342
msgid " to "
msgstr "ເຖິງ"

#: fonts.cpp:351
msgid "&Use sub-pixel hinting:"
msgstr ""
"ใ້&ຊ้ຄຳແນະນຳໃນການແຕ້ມພິກເຊ"
"ວ ຮິນທິງ:"

#: fonts.cpp:353
msgid ""
"If you have a TFT or LCD screen you can further improve the quality of "
"displayed fonts by selecting this option."
"<br>Sub-pixel hinting is also known as ClearType(tm)."
"<br><br><b>This will not work with CRT monitors.</b>"
msgstr ""

#: fonts.cpp:360
msgid ""
"In order for sub-pixel hinting to work correctly you need to know how the "
"sub-pixels of your display are aligned."
"<br> On TFT or LCD displays a single pixel is actually composed of three "
"sub-pixels, red, green and blue. Most displays have a linear ordering of RGB "
"sub-pixel, some have BGR."
msgstr ""

#: fonts.cpp:432
msgid ""
"<h1>Fonts</h1> This module allows you to choose which fonts will be used to "
"display text in KDE. You can select not only the font family (for example, "
"<em>helvetica</em> or <em>times</em>), but also the attributes that make up "
"a specific font (for example, <em>bold</em> style and <em>12 points</em> in "
"height.)"
"<p> Just click the \"Choose\" button that is next to the font you want to "
"change. You can ask KDE to try and apply font and color settings to non-KDE "
"applications as well. See the \"Style\" control module for more information."
msgstr ""
"<h1>ຮູບແບບຕົວອັກສອນ</h1>ໂມດູນນີ"
"້ "
"ອະນຸຍາດໃຫ້ທ່ານເລືອກຮູບແບບ"
"ຕົວອັກສອນທີ່ຕ້ອງການສະແດງຂ"
"ໍ້ຄວາມໃນ KDE "
"ທ່ານບໍ່ພງນແຕ່ສາມາດເລືອກຕະ"
"ກຸນຕົວອັກສອນໄດ້ເທົ່ານັ້ນ "
"(ເຊັ່ນຕະກຸນ <em>helvetica</em> ຫຼື <em>times</em> "
"ແຕ່ສາມາດເລືອກຄຸນນະສົມບັດຕ"
"່າງ "
"ຂອງຕົວອັກສອນໄດ້ເຊັ່ນກັນ "
"(ເຊັ່ນຮູບແບບ "
"<em>ໂຕຫນາ</em>ແລະມີຂະຫນາດສູງ <em>12 "
"points</em>ເປັນຕົ້ນ "
"<p> "
"ໂດຍຄີ້ລກທີ່ປຸ່ມ\"ເລືອກ\"ແລ້ວ"
"ຈາກນັ້ນຕາມດ້ອຍຮູບແບບຕົວອັ"
"ກສອນທີ່ຕ້ອງ ທ່ານສາມາດໃຫ້ KDE "
"ລອງແລະ "
"ບັບໃຊ້ຮູບແບບຕົວອັກສອນແລະສ"
"ີ ກັບແອັບພີລເຄເຊີ້ນແບບ KDE "
"ໄດ້ເຊັ່ນກັນ "
"ເບິ່ງລາຍລະອງດເພີມເຕີມທີໂມ"
"ດູນ \"ຮູບແບບ\" "
"ເຊິ່ງຢູ່ພາຍໃຕ້ຮູ້ແບບໂມດູນ\""
"ຊຸດຕົບແຕ່ງ\""

#: fonts.cpp:509
msgid ""
"<p>You have changed anti-aliasing related settings. This change will only "
"affect newly started applications.</p>"
msgstr ""
"ທ່ານເລືອກຕົວເລືອກປັບການສະ"
"ແດງຜົນແບບໄຮ້ຊື່ອື່ນ\n"
"ການປ່ງນແປງນີ້ຈະບໍເກີດຂື້ນ"
"ຈົນກ່ວາທ່ານ "
"ຈະເລີ່ມການທຳງານ KDE ອີກຄັ້ງ"

