#: fonts.cpp:258
msgid "General"
msgstr "ທົ່ວໄປ"

#: fonts.cpp:259
msgid "Fixed width"
msgstr "ຕົອອກສອນກ້ວາງຄົງທີ່"

#: fonts.cpp:260
msgid "Toolbar"
msgstr "ແຖບເຄື່ອງມື"

#: fonts.cpp:261
msgid "Menu"
msgstr "ເມນูູ"

#: fonts.cpp:262
msgid "Window title"
msgstr "ແຖບຫົວເລືອງຫນ້າຕ່າງ"

#: fonts.cpp:263
msgid "Taskbar"
msgstr "ທາສຄ໌ບາ"

#: fonts.cpp:264
msgid "Desktop"
msgstr "ຫນ້າຕ່າງຈໍ"

#: fonts.cpp:298
msgid "Used for normal text (e.g. button labels, list items)."
msgstr "ໃຊ້ສຳລັບຂໍ້ຄວາມປົກກະຕິ (ເຊັ່ນວ່າ ລະດັບປຸ່ມ,ລາຍການໃນລິດສທ໌ ເປັນຕົ້ນ)."

#: fonts.cpp:299
msgid "A non-proportional font (i.e. typewriter font)."
msgstr "ຕົວອັກສອນທີ່ມີສັດສ່ວນບໍ່ຄົງທີ່ (ເຊັ່ນ ຕົວອັກສອນແບບເຄື່ອງພິມດີດ)."

#: fonts.cpp:300
msgid "Used to display text beside toolbar icons."
msgstr "ໃຊ້ເພື່ອສະແດງຂໍ້ຄວາມໃຫ້ດ້ານຂ້າງຂອງ ໄອຄອນ ແຖບເຄື່ອງມື."

#: fonts.cpp:301
msgid "Used by menu bars and popup menus."
msgstr "ຖືກໃຊ້ດ້ອຍ ແຖບເມນູແລະເມນູພ໊ອບອັບພ໌"

#: fonts.cpp:302
msgid "Used by the window titlebar."
msgstr "ຖືກໃຊ້ດ້ອຍແຖບຫົວຂໍ້ຫນ້າຕ່າງ."

#: fonts.cpp:303
msgid "Used by the taskbar."
msgstr "ຖືກໃຊ້ດ້ອຍປຸ່ມທາດສຄ໌ບາ์"

#: fonts.cpp:304
msgid "Used for desktop icons."
msgstr "ຖືກໃຊ້ສຳລັບ ໄອຄອນບົນຫນ້າຈໍ."

#: fonts.cpp:348
msgid ""
"This is a preview of the \"%1\" font. You can change this font by clicking "
"the \"Choose...\" button to the right."
msgstr ""
"ນີ້ຄືການສະແດງຕົວຢ່າງຂອງຮູບແບບຕົວອັກສອນ \"%1`\". "
"ທ່ານສາມາດປ່ງນຮູບແບບຂອງຕົວອັກສອນນີ້ໄດ້ດ້ອຍການຄີ້ລກ ທີ່ປຸ່ມ \"ເລືອກ...\" ທີ່ຢູ່ດ້ານຂວາ."

#: fonts.cpp:349
msgid "Preview of the \"%1\" font"
msgstr "ສະແດງຕົວຢ່າງຂອງຮູບແບບຕົວອັກສອນແບບ \"%1\"."

#: fonts.cpp:355
msgid "Choose..."
msgstr "ເລືອກ..."

#: fonts.cpp:357
msgid "Click to select a font"
msgstr "ຄີ້ລກເພື່ອກຮູບແບບຂອງຕົວອັກສອນ."

#: fonts.cpp:371
msgid "Adjust All Fonts..."
msgstr "ປັບທຸກໂຕອັກສອນ..."

#: fonts.cpp:372
msgid "Click to change all fonts"
msgstr "ຄີ້ລກເພື່ອປ່ງນທຸກໂຕອັກສອນ."

#: fonts.cpp:376
msgid "Anti-Aliasing"
msgstr "ສະແດງຜົນແບບໄຮ້ຊື່ອື່ນ"

#: fonts.cpp:381
msgid "Use a&nti-aliasing for fonts"
msgstr "ປັບການສະແດງຜົນຕົວອັກສອນແບບໄຮ້ຊື່ອື່ນ"

#: fonts.cpp:382
msgid "If this option is selected, KDE will smooth the edges of curves in fonts."
msgstr "ເລືອກຕົວເລືອກນີ້ເພືອໃຫ້ KDE ສະແດງຜົນຕົວອັກສອນແລະພາບບິດແມພບາງສ່ວນ ໃນແບບໄຮ້ຊື່ອື່ນ"

#: fonts.cpp:388
msgid "E&xclude range:"
msgstr "ບໍ່&xລອມຊ่ວງ:"

#: fonts.cpp:390 fonts.cpp:393
msgid " pt"
msgstr "ພອຍເຕີ້"

#: fonts.cpp:391
msgid " to "
msgstr "ເຖິງ"

#: fonts.cpp:400
msgid "&Use sub-pixel hinting:"
msgstr "ใ້&ຊ้ຄຳແນະນຳໃນການແຕ້ມພິກເຊວ ຮິນທິງ:"

#: fonts.cpp:467
msgid ""
"<h1>Fonts</h1> This module allows you to choose which fonts will be used to "
"display text in KDE. You can select not only the font family (for example, "
"<em>helvetica</em> or <em>times</em>), but also the attributes that make up "
"a specific font (for example, <em>bold</em> style and <em>12 points</em> in "
"height.)"
"<p> Just click the \"Choose\" button that is next to the font you want to "
"change. You can ask KDE to try and apply font and color settings to non-KDE "
"applications as well. See the \"Style\" control module for more information."
msgstr ""
"<h1>ຮູບແບບຕົວອັກສອນ</h1>ໂມດູນນີ້ "
"ອະນຸຍາດໃຫ້ທ່ານເລືອກຮູບແບບຕົວອັກສອນທີ່ຕ້ອງການສະແດງຂໍ້ຄວາມໃນ KDE "
"ທ່ານບໍ່ພງນແຕ່ສາມາດເລືອກຕະກຸນຕົວອັກສອນໄດ້ເທົ່ານັ້ນ (ເຊັ່ນຕະກຸນ <em>helvetica</em> ຫຼື "
"<em>times</em> "
"ແຕ່ສາມາດເລືອກຄຸນນະສົມບັດຕ່າງ ຂອງຕົວອັກສອນໄດ້ເຊັ່ນກັນ "
"(ເຊັ່ນຮູບແບບ <em>ໂຕຫນາ</em>ແລະມີຂະຫນາດສູງ <em>12 points</em>ເປັນຕົ້ນ "
"<p> ໂດຍຄີ້ລກທີ່ປຸ່ມ\"ເລືອກ\"ແລ້ວຈາກນັ້ນຕາມດ້ອຍຮູບແບບຕົວອັກສອນທີ່ຕ້ອງ ທ່ານສາມາດໃຫ້ KDE ລອງແລະ "
"ບັບໃຊ້ຮູບແບບຕົວອັກສອນແລະສີ ກັບແອັບພີລເຄເຊີ້ນແບບ KDE ໄດ້ເຊັ່ນກັນ ເບິ່ງລາຍລະອງດເພີມເຕີມທີໂມດູນ \"ຮູບແບບ\" "
"ເຊິ່ງຢູ່ພາຍໃຕ້ຮູ້ແບບໂມດູນ\"ຊຸດຕົບແຕ່ງ\""

#: fonts.cpp:544
msgid ""
"<p>You have changed anti-aliasing related settings. This change will only "
"affect newly started applications.</p>"
msgstr ""
"ທ່ານເລືອກຕົວເລືອກປັບການສະແດງຜົນແບບໄຮ້ຊື່ອື່ນ\nການປ່ງນແປງນີ້ຈະບໍເກີດຂື້ນຈົນກ່ວາທ່ານ "
"ຈະເລີ່ມການທຳງານ KDE ອີກຄັ້ງ"

#: fonts.cpp:545
msgid "Anti-Aliasing Settings Changed"
msgstr "ປັບໃຊ້ການສະແດງຜົນແບບໄຮ້ຊື່ອື່ນແລ້ວ"

