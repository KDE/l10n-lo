#: kcmsmserver.cpp:139
msgid ""
"<h1>Session Manager</h1> You can configure the session manager here. This "
"includes options such as whether or not the session exit (logout) should be "
"confirmed, whether the session should be restored again when logging in and "
"whether the computer should be automatically shut down after session exit by "
"default."
msgstr ""
"<h1>ຈັດການເຊສຊັນ</h1> "
"ທ່ານສາມາດປັບແຕ່ງການທຳງານໂ"
"ປຣແກຣມຈັດການເຊສຊັນໄດ້ທີ່ນ"
"ີ້ "
"ພ້ອມການສະແດງກ່ອງຢືນຢັນການ"
"ລັອກເອົ້າ "
"ແລະເອີ້ນຄືນເຊສຊັນເດີມທີ່ທ"
"ຳງານຄ້າງໄວ້ເມື່ອລັອກອິນຄັ"
"້ງຕໍ່ໄປ"

#: rc.cpp:2
#, no-c-format
msgid "Session Manager"
msgstr "ໂປຣແກຣມຈັດການເຊສຊັນ"

#: rc.cpp:4
#, no-c-format
msgid "General"
msgstr "ທົ່ວໄໍປ"

#: rc.cpp:6
#, no-c-format
msgid "Conf&irm logout"
msgstr "ຢືນຢັນການລັອກເອົ້່າ"

#: rc.cpp:8
#, no-c-format
msgid ""
"Check this option if you want the session manager to display a logout "
"confirmation dialog box."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ຖ້າຕ້ອງກາ"
"ນໃຫ້ໂປຣແກຣມຈັດການເຊສຊັນສະ"
"ແດງໄດອະລັອກຢືນຢັນການລັອກເ"
"ອົ້າ"

#: rc.cpp:10
#, no-c-format
msgid "O&ffer shutdown options"
msgstr ""

#: rc.cpp:12
#, no-c-format
msgid "On Login"
msgstr "ເມື່ອລັອກອິນ"

#: rc.cpp:14
#, no-c-format
msgid ""
"<ul>\n"
"<li><b>Restore previous session:</b> Will save all applications running on "
"exit and restore them when they next start up</li>\n"
"<li><b>Restore manually saved session: </b> Allows the session to be saved "
"at any time via \"Save Session\" in the K-Menu. This means the currently "
"started applications will reappear when they next start up.</li>\n"
"<li><b>Start with an empty session:</b> Do not save anything. Will come up "
"with an empty desktop on next start.</li>\n"
"</ul>"
msgstr ""

#: rc.cpp:20
#, no-c-format
msgid "Restore &previous session"
msgstr ""
"ເອີ້ນຄືນເຊສຊັນທີ່ໄດ້ບັນທຶ"
"ກໄວ້"

#: rc.cpp:22
#, no-c-format
msgid "Restore &manually saved session"
msgstr ""
"ເອີ້ນຄືນເຊສຊັນທີ່ໄດ້ບັນທຶ"
"ກໄວ້"

#: rc.cpp:24
#, fuzzy, no-c-format
msgid "Start with an empty &session"
msgstr ""
"ເລີ່ມທຳງານໂດຍເປັນເຊສຊັນວ່"
"າງ"

#: rc.cpp:26
#, no-c-format
msgid "Default Shutdown Option"
msgstr ""

#: rc.cpp:28
#, no-c-format
msgid ""
"Here you can choose what should happen by default when you log out. This "
"only has meaning, if you logged in through KDM."
msgstr ""
"ທ່ານສາມາດເລືອກໄດ້ວ່າຈະໃຫ້"
"ມີການເຮັດວງກຫຍັງຫລັງຈາກທີ"
"່ທ່ານ "
"ລັອກເອົ້າແລ້ວແຕ່ໃຊ້ໄດ້ໃນກ"
"ໍລະນີທີ່ທ່ານທຳການລັອກອິນໂ"
"ດຍຜ່ານທາງ KDM ເທົ່ານັ້ນ"

#: rc.cpp:30
#, no-c-format
msgid "&End current session"
msgstr ""

#: rc.cpp:32
#, no-c-format
msgid "&Turn off computer"
msgstr "ປິດເຄື່ອງຄອມພິວເຕີ"

#: rc.cpp:34
#, no-c-format
msgid "&Restart computer"
msgstr "ເລີ່ມທຳງານຄອມພິວເຕີໃຫມ່"

#: rc.cpp:36
#, no-c-format
msgid "Advanced"
msgstr ""

#: rc.cpp:38
#, no-c-format
msgid "Applications to be e&xcluded from sessions:"
msgstr ""

#: rc.cpp:40
#, no-c-format
msgid ""
"Here you can enter a colon-separated list of applications that should not be "
"saved in sessions, and therefore will not be started when restoring a "
"session. For example 'xterm:xconsole'.\n"
msgstr ""

#~ msgid "Default Action After Logout"
#~ msgstr "ການກະທຳໂດຍປະລິຍາຍຫລັງຈາກລັອກເອົ້າແລ້ວ"

#~ msgid "&Login as different user"
#~ msgstr "ລັອກອິນເປັນຜູ້ໃຊ້ງານອື່ນ"

#~ msgid "&Restore session as it was before logging out"
#~ msgstr "เรียกคืนเซสชันเดิมที่เปิดค้างไว้ก่อนล็อกเอาต์ครั้งล่าสุด"

#~ msgid "&Save session for future logins"
#~ msgstr "บันทึกเซสชันที่เปิดอยู่สำหรับการล็อกอินครั้งต่อไป"

#~ msgid ""
#~ "Check this option if you want the session manager to save the running "
#~ "session when logging out. At login time the last saved session will be "
#~ "restored."
#~ msgstr ""
#~ "เลือกตัวเลือกนี้ เพื่อให้โปรแกรมจัดการเซสชัน เรียกคืนเซสชันเดิมที่ทำงานค้างไว้ "
#~ "เมื่อล็อกอินครั้งต่อไป"
