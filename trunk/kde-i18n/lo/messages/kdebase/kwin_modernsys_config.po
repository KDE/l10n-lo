#: config.cpp:35
msgid "Window Resize Handle"
msgstr "ສະແດງສ່ວນການປັບຂະຫນາດຫນ້າຕ່າງ"

#: config.cpp:38
msgid "&Show handle"
msgstr "&ສະແດງສ່ວນການປັບຂະຫນາດ "

#: config.cpp:40
msgid ""
"When selected, all windows are drawn with a resize handle at the lower right "
"corner. This makes window resizing easier, especially for trackballs and "
"other mouse replacements on laptops."
msgstr ""
"ເມື່ອເປີດໃຊ້ງານຕົວເລືອກນີ້ ທຸກຫນ້າຕ່າງ ຈະຖືກແຕ້ມ ພ້ອມກັບມີສ່ວນໃຊ້ປັບຂະຫນາດ "
"ຢູຸ່ທາງມຸມດ້ານລຸ່ມຂວາ"

#: config.cpp:50
msgid "Here you can change the size of the resize handle."
msgstr "ທ່ານສາມາດປ່ງນຂະຫນາດຂອງສ່ວນປັບຂະຫນາດໄດ້ທີ່ນີ້"

#: config.cpp:57
msgid "Small"
msgstr "ນອ້ຍ"

#: config.cpp:58
msgid "Medium"
msgstr "ປານກາງ"

#: config.cpp:60
msgid "Large"
msgstr "ໃຫຍ່"

