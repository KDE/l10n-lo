#: config.cpp:40
#, fuzzy
msgid "&Show window resize handle"
msgstr ""
"ສະແດງສ່ວນການປັບຂະຫນາດຫນ້າ"
"ຕ່າງ"

#: config.cpp:42
msgid ""
"When selected, all windows are drawn with a resize handle at the lower right "
"corner. This makes window resizing easier, especially for trackballs and "
"other mouse replacements on laptops."
msgstr ""
"ເມື່ອເປີດໃຊ້ງານຕົວເລືອກນີ"
"້ ທຸກຫນ້າຕ່າງ ຈະຖືກແຕ້ມ "
"ພ້ອມກັບມີສ່ວນໃຊ້ປັບຂະຫນາດ "
"ຢູຸ່ທາງມຸມດ້ານລຸ່ມຂວາ"

#: config.cpp:52
msgid "Here you can change the size of the resize handle."
msgstr ""
"ທ່ານສາມາດປ່ງນຂະຫນາດຂອງສ່ວ"
"ນປັບຂະຫນາດໄດ້ທີ່ນີ້"

#: config.cpp:61
msgid "Small"
msgstr "ນອ້ຍ"

#: config.cpp:63
msgid "Medium"
msgstr "ປານກາງ"

#: config.cpp:65
msgid "Large"
msgstr "ໃຫຍ່"

#~ msgid "&Show handle"
#~ msgstr "&ສະແດງສ່ວນການປັບຂະຫນາດ "
