#: runapplet.cpp:59
msgid "Run command:"
msgstr "ປະມວນຜົນຄຳສັ່ງ:"

#: runapplet.cpp:179
msgid "< Run"
msgstr "< ປະມວນຜົນ"

#: runapplet.cpp:186
msgid "Run >"
msgstr "ປະມວນຜົນ >"

#: runapplet.cpp:234
msgid "You have to enter a command to execute or a URL to be opened first."
msgstr ""
"ທ່ານຕ້ອງຕື່ມຄຳສັ່ງທີ່ຈະໃຊ"
"້ປະມວນຜົນຫຼື URL ທີ່ຕ້ອງການ "
"ເປີດເສຍກ່ອນ"

#: runapplet.cpp:245
msgid ""
"Unable to logout properly.\n"
"The session manager cannot be contacted. You can try to force a shutdown by "
"pressing Ctrl+Alt+Backspace. Note, however, that your current session will "
"not be saved with a forced shutdown."
msgstr ""
"ບໍ່ສາມາດລັອກເອົາໄດ້ເນື່ອງ"
"ຈາກບໍ່ສາມາດຕິດຕໍ່ກັບ\n"
"ກະລຸນາຈັດການເຊສເຊີ້ໄດ້ທ່າ"
"ນສາມາດບັງຄັບໃຫ້ X "
"ຈົບການທຳງານໄດ້\n"
"ໂດຍການກົດປຸ່ມ CTRL-ALT-BACKSPACE "
"ພ້ອມໆກັນ\n"
"ແຕ່ຈືໄວ້ວ່າເຊສເຊການທຳງານປ"
"ະຈຸບັນຂອງທ່ານບໍ່ໄດ້ຖືກບັນ"
"ທຶກໄວ้້\n"
"ຫາກບັງຄັບໃຫ້ X  "
"ຈົບການທຳງານດ້ອຍປຸ່ມພິມດັ່"
"ງກ່າວ"

#: runapplet.cpp:276
msgid ""
"<qt>The program name or command <b>%1</b>\n"
"cannot be found. Please correct the command\n"
"or URL and try again</qt>"
msgstr ""
"<qt>ບໍ່ພົບໂປຣແກຣມຫຼືຄຳສັ່ງ "
"<b>%1</b>\n"
"ກະລຸນາກວດຄຳສັ່ງຫືຼ URL "
"ວ່າຖືກຕ້ອງຫຼືບໍ\n"
"ແລ້ວທຳການໃຫມ່ອີກຄັ້ງ</qt>"

#: runapplet.cpp:288
msgid ""
"<qt>Could not run <b>%1</b>.\n"
"Please correct the command or URL and try again.</qt>"
msgstr ""
"<qt>ບໍ່ສາມາດ້ປະມວນຜົນ <b>%1</b> ได้\n"
"ກະລຸນາກວດຄຳສັ່ງຫືຼ URL "
"ວ່າຖືກຕ້ອງຫຼືບໍ\n"
"ແລ້ວທຳການໃຫມ່ອີກຄັ້ງ</qt>"
