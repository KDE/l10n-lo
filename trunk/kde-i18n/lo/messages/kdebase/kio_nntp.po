#: nntp.cpp:156
#, c-format
msgid "Invalid special command %1"
msgstr "ຄຳສັ່ງພິເສດ %1 ບໍ່ຖຶກຕ້ອງ"

#: nntp.cpp:373
#, c-format
msgid ""
"Could not extract first message number from server response:\n"
"%1"
msgstr ""
"ບໍ່ສາມາດຂະຫຍາຍຈຳນວນຈົດຫມາ"
"ຍ ຈາກທີ່ເຊີບເວີຣ໌ຕອບກັບ:\n"
"%1"

#: nntp.cpp:398
#, c-format
msgid ""
"Could not extract first message id from server response:\n"
"%1"
msgstr ""
"ບໍ່ສາມາດຂະຫຍາຍຈຳນວນຈົດຫມາ"
"ຍໄອດີຈາກທີ່ເຊີບເວີຣ໌ຕອບກັ"
"ບ:\n"
"%1"

#: nntp.cpp:425
#, c-format
msgid ""
"Could not extract message id from server response:\n"
"%1"
msgstr ""
"ບໍ່ສາມາດຂະຫຍາຍຈຳນວນຈົດຫມາ"
