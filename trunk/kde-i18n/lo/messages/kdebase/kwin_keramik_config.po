#: rc.cpp:1
msgid "Keramik"
msgstr "ເຄລາມິກ"

#: rc.cpp:2
msgid "Decoration Settings"
msgstr "ຕັ້ງຄ່າການຕົກແຕ່ງຫນ້າຕ່າງ"

#: rc.cpp:3
msgid "Display the window &icon in the caption bubble"
msgstr "&ສະແດງໄອຄອນຂອງຫນ້າຕ່າງໃນຊວ່ງຫົວຫນ້າຕ່າງ "

#: rc.cpp:4
msgid ""
"Check this option if you want the window icon to be displayed in the caption "
"bubble next to the titlebar text."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ ຫາກທ່ານຕ້ອງການໃຫ້ມີການສະແດງໄອຄອນຂອງຫນ້າຕ່າງໃນຊ່ອງຫົວຫນ້າຕ່າງ ທີ່ຖັດຈາກ "
"ຂໍ້ຄວາມຫົວຫນ້າຕ່າງ"

#: rc.cpp:5
msgid "Draw &small caption bubbles on active windows"
msgstr "&ແຕ້ມຊ່ອງຫົວຫນ້າຕ່າງແບບນ້ອຍໃນຫນ້າຕ່າງທີ່ເຮັດວງກ"

#: rc.cpp:6
msgid ""
"Check this option if you want the caption bubble to have the same size on "
"active windows that it has on inactive ones. This option is useful for "
"laptops or low resolution displays where you want maximize the amount of "
"space available to the window contents."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ຫາກທ່ານຕ້ອງການໃຊ້ຊ່ອງຫົວຫນ້າຕ່າງໃນຫນ້າຕ່າງທີ່ທຳງານຢູ່ "
"ມີຂະຫນາດເທົ່າກັນກັບຫນ້າຕ່າງທີ່ບໍ່້ໄດ້ເຮັດວງກ "
"ຊື່ງເຫມາະກັບການໃຊ້ງານໃນເຄື່ອງແລບທອບ "
"ຫລືລະບົບສະແດງຜົນທີ່ມີຄວາມລະອງດຕຳ່ "
"ໂດຍຈະເຮັດໃຫ້ທ່ານມີພື້ນທີ່ວ່າງຫລາຍຂື້ນ"

#: rc.cpp:7
msgid "Draw g&rab bars below windows"
msgstr "Draw g&rab bars below windows"

#: rc.cpp:8
msgid ""
"Check this option if you want a grab bar to be drawn below windows. When "
"this option is not selected only a thin border will be drawn in its place."
msgstr ""
"Check this option if you want a grab bar to be drawn below windows. When "
"this option is not selected only a thin border will be drawn in its place."

#: rc.cpp:9
msgid "Use shadowed &text"
msgstr "&ສະແດງເງົາຂອງຂໍ້ຄວາມ"

#: rc.cpp:10
msgid ""
"Check this option if you want the titlebar text to have a 3D look with a "
"shadow behind it."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ ຫາກທ່ານຕ້ອງການໃຫ້ມີການສະແດງຂໍ້ຄວາມຫົວຫນ້າຕ່າງຄ້າຍ 3 ມິຕິ "
"ໂດຍມີເງົາຢູ່ດ້ານຫລັງຂໍ້ຄວາມ"

