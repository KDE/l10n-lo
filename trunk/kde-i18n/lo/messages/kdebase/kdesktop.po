msgstr "รหัสผ่าน:"

#: minicli.cpp:678
msgid "Enter the requested password here."
msgstr ""
"เติมรหัสผ่านที่ร้องขอที่น"
"ี่"

#: minicli.cpp:701
msgid "Normal"
msgstr "ปกติ"

#: minicli.cpp:702
msgid "Realtime"
msgstr "เรียลไทม์"

#: minicli.cpp:732
msgid "none"
msgstr "ไม่มี"

#: minicli.cpp:736
