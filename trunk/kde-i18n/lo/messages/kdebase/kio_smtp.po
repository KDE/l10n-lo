#: smtp.cc:262 smtp.cc:331
msgid "The sender address is missing."
msgstr "ບໍ່ມີທີ່ຢູ່ຜູ້ສົ່ງ"

#: smtp.cc:273
msgid "SMTPProtocol::smtp_open failed (%1)"
msgstr "SMTPProtocol::smtp_open ລົ້ມເຫຼວ (%1)"

#: smtp.cc:282
msgid ""
"The server did not accept the sender address.\n"
"The server responded: \"%1\""
msgstr ""
"ເຊີເວີບໍ່ຍອມຮັບທີ່ຢູ່ຜູ້ສົ່ງ:\n"
"%1"

#: smtp.cc:305
msgid ""
"The attempt to start sending the message content failed.\n"
"The server responded: \"%1\""
msgstr ""
"ລົ້ມເຫຼວໃນການພະຍາຍາມເຮີ່ມທຳການສົ່ງເນື້ອຫາຈົດຫມາຍ\n"
"ໂດຍເຊີຟເວີແຈ້ງວ່າ:\n"
"%1"

#: smtp.cc:379
msgid ""
"The message content was not accepted.\n"
"The server responded: \"%1\""
msgstr ""
"ລົ້ມເຫຼວໃນການພະຍາຍາມທຳການສົ່ງເນື້ອຫາຈົດຫມາຍ\n"
"ໂດຍເຊີເວີແຈ້ງວ່າ:\n"
"%1"

#: smtp.cc:396
msgid ""
"One of the recipients was not accepted.\n"
"The server responded: \"%1\""
msgstr ""
"ລົ້ມເຫຼວໃນການພະຍາຍາມເລີ່ມທຳການສົ່ງເນື້ອຫາຈົດຫມາຍ\n"
"ໂດຍເຊີຟເວີແຈ້ງວ່າ:\n"
"%1"

#: smtp.cc:464 smtp.cc:487
msgid "Invalid SMTP response received."
msgstr ""
"ໄດ້ຮັບການຕອບຮັບ SMTP "
"ທີ່ບໍ່ຖືກຕ້ອງ"

#: smtp.cc:520
msgid "Invalid SMTP response received: \"%1\""
msgstr ""
"ໄດ້ຮັບການຕອບຮັບ SMTP "
"ທີ່ບໍ່ຖືກຕ້ອງ: %1"

#: smtp.cc:571
msgid "The server did not accept the connection: \"%1\""
msgstr "ເຊີຟເວີບໍ່ຍອມຮັບການເຊື່ອມຕໍ່: %1"

#: smtp.cc:609 smtp.cc:657
msgid "The server responded: \"%1\""
msgstr "ເຊີຟເວີແຈ້ງວ່າ: %1"

#: smtp.cc:633
msgid ""
"Your SMTP server claims to support TLS, but negotiation was unsuccessful.\n"
"You can disable TLS in KDE using the crypto settings module."
msgstr ""
"ເຊີຟເວີ SMTP "
"ຕ້ອງການການສະຫນັບສະຫນູນ TLS "
"ແຕ່ບໍ່ສາມາດທຳໄດ້ສຳເລັດ\n"
"ທ່ານສາມາດປິດກາຍໃຊ້ງານ TLS ໃນ "
"KDE ໄດ້ "
"ໂດຍໃຊ້ໂມດູນຕັ້ງຄ່າການເຂົ້າລະຫັດ"

#: smtp.cc:638
msgid "Connection Failed"
msgstr "ການເຊື່ອມຕໍ່ລົ້ມເຫຼວ"

#: smtp.cc:678
msgid ""
"Your SMTP server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"ເຊີຟໄເວີ์ SMTP ບໍ່ສະຫນັບສະຫນູນ TLS "
"ທ່ານອາດປິດການໃຊ້ງານ TLS "
"ໄດ້ຫາກທ່ານຕ້ອງການເຊື່ອມຕໍ່ໂດຍບໍ່ມີການເຂົ້າລະຫັດ"

#: smtp.cc:690
msgid "Username and password for your SMTP account:"
msgstr "ຊື່ຜູ້ໃຊ້ແລະລະຫັດຜ່ານສຳລັບບັນຊີຜູ້ໃຊ້ SMTP ຂອງທ່ານ:"

#: smtp.cc:692
msgid "When prompted, you ran away."
msgstr "ເມື່ອມີການຖາມທ່ານໃດ້ສາກໄປແລ້ວ"

#: smtp.cc:739
msgid "No compatible authentication methods found."
msgstr "ບໍ່ພົບວິທີການກວດສອບສິດທິທີ່ເຫມາະສົມ"

#: smtp.cc:760
msgid ""
"Your SMTP server doesn't support %1.\n"
"Choose a different authentication method."
msgstr ""
"ເຊີຟເວີ SMTP ບໍ່ສະຫນັບສະຫນູນ %1\n"
"ໂປດເລືອກວິທີການກວດສອບສິດທິແບບອື່ນ"

#: smtp.cc:790
msgid ""
"Authentication failed.\n"
"Most likely the password is wrong.\n"
"The server responded: \"%1\""
msgstr ""
"ການກວດສອບສິດທິລົ້ມເຫຼວ\n"
"ຊື່ງເບິ່ງຄືວ່າລະຫັດຜ່ານຈະບໍ່ຖືກຕ້ອງ\n"
"ໂດຍເຊີຟເວີແຈ້ງວ່າ: %1"

#~ msgid ""
#~ "The server didn't accept the message content:\n"
#~ "%1"
#~ msgstr ""
#~ "เซิร์ฟเวอร์ไม่ยอมรับเนื้อหาของจดหมาย:\n"
#~ "%1"

#~ msgid ""
#~ "The server didn't accept one of the recipients.\n"
#~ "It said: %1"
#~ msgstr ""
#~ "เซิร์ฟเวอร์ไม่ยอมรับผู้รับจดหมาย\n"
#~ "โดยแจ้งว่า: %1"

