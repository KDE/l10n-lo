#: kio_smb.cpp:342 kio_smb.cpp:358 kio_smb.cpp:606 kio_smb.cpp:641
#: kio_smb.cpp:1717 kio_smb.cpp:1907 kio_smb.cpp:2159 kio_smb.cpp:2194
#: kio_smb.cpp:2274 kio_smb.cpp:2325 kio_smb.cpp:2339 kio_smb.cpp:2358
msgid ""
"\n"
"Make sure that the samba package is installed properly on your system."
msgstr ""
"\n"
"ໂປດກວດສອບວ່າມີການຕິດຕັ້ງແ"
"ພກເກດ samba "
"ເທິງລະບົບຂອງທ່ານແລ້ວ"

#: kio_smb.cpp:353
msgid ""
"\n"
"There is probably no SMB service running on this host."
msgstr ""
"\n"
"ເບິ່ງຄືວ່າຍັງບໍ່ມີເຊີວິດສ"
"໌ SMB "
"ທີ່ກຳລັງທຳງານຢູ່ເທີງຮອດສ໌"
"ี้"

#: kio_smb.cpp:376 kio_smb.cpp:382
msgid ""
"\n"
"Invalid user/password combination."
msgstr ""
"\n"
"ຊື່ຜູ້ໃຊ้້/ລະຫັດຜ່ານ "
"ອາດຈະບໍ່ຖືກຕ້ອງ"

#: kio_smb.cpp:415
msgid "Unable to parse response message."
msgstr ""

#: kio_smb.cpp:568
msgid "Server"
msgstr "ເຊີເວີ"

#: kio_smb.cpp:571
msgid "Workgroup"
msgstr "ເວີກກຸບປ໌"

#: kio_smb.cpp:576
msgid "Share"
msgstr "ຊັບພະຍາກອນທີ່ໃຊ້ຮ່ວມກັນ"

#: kio_smb.cpp:765
msgid ""
"To access the shares of a host, use smb://hostname\n"
"To get a list of all hosts use lan:/ or rlan:/ .\n"
"See the KDE Control Center under Network, LANBrowsing for more information."
msgstr ""
"ເພືອເຂົ້າໃຊ້ຊັບພະຍາກອນທີ່"
"ໃຊ້ຮ້ວມກັນເທິງຮອດສ໌ໃຫ້ໃຊ້ "
"smb://ຊື່ຮອດສ໌\n"
"ສຳລັບການເອີ່ນເບິ່ງທຸກຮອດສ"
"໌ีບໍ່ໍ່ໃຫ້ໃຊ້ lan:/ ຫຼື rlan:/\n"
"ເບິ່ງລາຍລະອງດເພີ່ມເຕີມ "
"ທີ່ສູນຄວບຄູມ KDE ຫົວຂໍ່ "
"ລະບົບເຄືອຂ່າຍ -> "
"ການເອີ່ນເບີ່ງລະບົບແລນ"

#: kio_smb.cpp:1256
msgid ""
"\n"
"To access the shares of a host, use smb://hostname\n"
"To get a list of all hosts use lan:/ or rlan:/ .\n"
"See the KDE Control Center under Network, LANBrowsing for more information."
msgstr ""
"\n"
"ເພື່ອເຂົ້າໃຊ້ງານຊັບພະຍາກອ"
"ນທີ່ໃຫ້ໃຊ້ຮ່ວມກັນເທິງຮອດສ"
"໌ໃຫ້ຊ้້ smb://ຊື່ຮອດສ໌์\n"
"ສຳລັບການເອີ້ນເບິ່ງທຸກຮອດສ"
"ี่ມີໃຫ້ໃຊ້ lan:/ ຫຼື rlan:/\n"
"ເບິ່ງລາຍລະອງດເພິ່ມເຕີມທີ່"
"ສູນຄວບຄູມ KDE ຫົວຂໍ້ "
"ລະບົບເຄືອຂ່າຍ -> "
"ການເອີ່ນເບີ່ງລະບົບແລນ"

#: kio_smb.cpp:1298 kio_smb.cpp:1348 kio_smb.cpp:1471 kio_smb.cpp:1503
#, c-format
msgid ""
"\n"
"Could not create required pipe %1."
msgstr ""
"\n"
"ບໍ່ສາມາດສ້າງແປບ %1 "
"ທີ່ຕ້ອງການໃດ້"

#: kio_smb.cpp:1335
msgid ""
"To be able to write to a remote Samba share you must patch and recompile "
"smbclient.\n"
"Visit http://lisa-home.sourceforge.net/smbclientpatch.html and follow the "
"instructions there."
msgstr ""
"ເພື່ອໃຫ້ສາມາດຂງນໃປຍັງຊັບພ"
"ະຍາກອນທີ່ໃຊ້ຮ່ວມກັນຂອງ Samba "
"ໃລຍະໃກ້ທ່ານທຳການແພດສ໌ແລະຄ"
"ອມໄພລ໌ smbclient ໃຫມ່\n"
"ລອງໃປທີ່ "
"http://lisa-home.sourceforge.net/smbclientpatch.html "
"ແລະທຳຕາມຄຳແນະນຳ"

#: kio_smb.cpp:1358 kio_smb.cpp:1366 kio_smb.cpp:1514 kio_smb.cpp:1522
#, c-format
msgid ""
"\n"
"Could not fcntl() pipe %1."
msgstr ""
"\n"
"ບໍ່ສາມາດໃຊ້ຟັງຊັນ fcntl() "
"ກັບແປບ %1 ໄດ້"

#~ msgid "Hmm..."
#~ msgstr "ອືມມ..."
