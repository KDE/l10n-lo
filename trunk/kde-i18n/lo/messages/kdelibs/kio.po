#: kio/kio/global.cpp:533
msgid "Contact the administrator of the server for further assistance."
msgstr ""
"ຕິດຕໍ່ຜູ້ດູແລລະບົບ "
"ຫລືບໍລິການທາງເທັກນິກໃນການ"
"ຂໍຮັບຄຳແນະນຳ"

#: kio/kio/global.cpp:536
msgid "Check your access permissions on this resource."
msgstr ""
"ໂປດກວດສອບສິດທີ່ໄດ້ຮັບອະນຸ"
"ຍາດໃຊ້ສັບພະຍາກອນນີ້ຂອງທ່າ"
"ນ"

#: kio/kio/global.cpp:537
msgid ""
"Your access permissions may be inadequate to perform the requested operation "
"on this resource."
msgstr ""
"ສິດທີ່ໄດ້ຮັບອະນຸຍາດທ່ານອາ"
"ດຈະບໍ່ພຽງພໍໃນການທຳປະຕິບັດ"
"ການເທີງສັບພະຍາກອນນີ້"

#: kio/kio/global.cpp:539
msgid "The file may be in use (and thus locked) by another user or application."
msgstr ""
"ແຟ້ມອາດຈະຖືກໃຊ້ຢູ່(ແລະອາດຖ"
"ືກລອກໄວ້) "
"ໂດຍຜູ້ໃຊ້ຫລືແອບພິເຄຊັ້ນ"

#: kio/kio/global.cpp:541
msgid ""
"Check to make sure that no other application or user is using the file or "
"has locked the file."
msgstr ""
"ໂປດກວດສອບໃຫ້ແນ່ໃຈວ່າບໍ່ມີ"
"ແອບພິເຄຊັ້ນຫລືຜູ້ໃຊ້ໃດກຳລ"
"ັງໃຊ້ງານແຟ້ມຫລືລອກແຟ້ມໄວ້"
"ຢູ່ຫລືບໍ่່"

#: kio/kio/global.cpp:543
msgid "Although unlikely, a hardware error may have occurred."
msgstr ""
"ແມມວ່າອາດຈະບໍ່ຄືກັນແລະອາດ"
"ຈະເກີດຄວາມຜິດພາດທາງຮາດແວຂ"
"ື້ນໄດ້"

#: kio/kio/global.cpp:545
msgid "You may have encountered a bug in the program."
msgstr ""
"ທ່ານອາດຈະເຂົ້າຖື່ງສ່ວນທີ່"
"ເປັນຄວາມຜິດພາດຂອງໂປຣແກຣ"

#: kio/kio/global.cpp:546
msgid ""
"This is most likely to be caused by a bug in the program. Please consider "
"submitting a full bug report as detailed below."
msgstr ""
"ນີ້ອາດຈະຄ້າຍກັບຂໍ້ຜິດພາດ "
"(ບັກ) "
"ໃນໂປຣແກຣມໂປດພິຈະລະນາລາຍງາ"
"ນຄວາມຜິດພາດໃນລາຍອຽດດ້ານລຸ"
"່ມນີ້"

#: kio/kio/global.cpp:548
msgid ""
"Update your software to the latest version. Your distribution should provide "
"tools to update your software."
msgstr ""
"ໃນອັບເດດຊອບແວໄປເປັນລຸ່ນລ່"
"າສຸດນັ້ນດິສທິບິວຊັ້ນຂອງທ່"
"ານມັກຈະມີເຄື່ອງມືສຳລັບໃຊ້"
"ອັບເດດໃຫ້ຢູ່ແລ້ວ"

#: kio/kio/global.cpp:550
msgid ""
"When all else fails, please consider helping the KDE team or the third party "
"maintainer of this software by submitting a high quality bug report. If the "
"software is provided by a third party, please contact them directly. "
"Otherwise, first look to see if the same bug has been submitted by someone "
"else by searching at the <a href=\"http://bugs.kde.org/\">KDE bug reporting "
"website</a>. If not, take note of the details given above, and include them "
"in your bug report, along with as many other details as you think might help."
msgstr ""
"ຫາກມີຂໍ້ຜິດພາດຫລືອື່ນຯ "
"ໂປດຊ່ວຍເລຫືອທີ KDE "
"ຫລືຜູຸ້ດູແລອື່ນຯຂອງຊອບແວນ"
"ີ້ດ້ວຍການລາຍງານຄວາມຜິດພາດ"
"ດ້ວຍລາຍລະອຽດຄວາມຜິດພາດທີ່"
"ສົມບູນ "
"ຫາກຊອບແວມາຈາກຜູຸ້ສ້າງອື່ມ"
"ຯ "
"ໂປດຕິດຕໍ່ຜູ້ສ້າງຊອບແວໂດຍຕ"
"ົງໂດຍກ່ອນອື້ນ "
"ໃຫ້ກວດສອບການລາຍງານຄວາມຜິດ"
"ພາດກ່ອນຯທີ່ເວັບໄຊ <a "
"href=\"http://bugs.kde.org/\">ລາຍງານຂໍ້ຜິດພາດ "
"KDE</a> "
"ວ່າມີການລາຍງານຜິດພາດດ່ຽວກ"
"ັນນີ້ມາກ່ອນຫລືບໍ່ຫາກຍັງບໍ"
"່ມີໃຫ້ລວບລວມລາຍລະອຽດທີີໃຫ"
"້ດ້ານເທີງ "
"ແລະລວມມັນເຂົ້າກັບລາຍງານຄວ"
"າມຜິດພາດຂອງທ່ານຫລືລາຍລະອຽ"
"ດອື່ນຯທີ່ທ່ານເຫັນວ່າມີປະໂ"
"ຫຍດ ໃນການແກ້ໄຂຄວາມຜິດພາດ"

#: kio/kio/global.cpp:558
msgid "There may have been a problem with your network connection."
msgstr ""
"ອາດຈະມີປັນຫາການເຊື່ອມຕໍ່ກ"
"ັບລະບົບເຄືອຂ່າຍຂອງທ່ານ"

#: kio/kio/global.cpp:561
msgid ""
"There may have been a problem with your network configuration. If you have "
"been accessing the Internet with no problems recently, this is unlikely."
msgstr ""
"ອາດຈະມີປັນຫາເນື່ອງມາຈາກກາ"
"ນປັບແຕ່ງລະບົບເຄືອຂ່າຍຂອງທ"
"່ານ "
"ຫາກທ່ານເຄີຍສາມາດເຂົ້່າໃຊ້"
"ງານອິນເຕີ "
"ເນັກໂດຍບໍ່ມີປັນຫາກມາກ່ອນ"

#: kio/kio/global.cpp:564
msgid ""
"There may have been a problem at some point along the network path between "
"the server and this computer."
msgstr ""
"ມັນອາດຈະມີປັນຫາໃນບາງຈຸດໃນ"
"ເສັ້່ນທາງສືສານລະຫວ່າງເຊີບ"
"ເວີແລະຄອມພິວເຕີນີ້"

#: kio/kio/global.cpp:566
msgid "Try again, either now or at a later time."
msgstr ""
"ໂປດລອງໃຫມ່ອີກຄັ້ງໃນຕອນ "
"ຫລືໃນພາຍຫລັງ"

#: kio/kio/global.cpp:567
msgid "A protocol error or incompatibility may have occurred."
msgstr ""
"ໂປໂຕຄອນຜິດພາດຫລືອາດຈະເກີດ"
"ການເຂົ້າກັນບໍ່ໄດ້ຂື້ນມາ"

#: kio/kio/global.cpp:568
msgid "Ensure that the resource exists, and try again."
msgstr ""
"ໂປດແນ່ໃຈວ່າທັບພະຍາກອນຍັງມ"
"ີຢູ່ແລະລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:569
msgid "The specified resource may not exist."
msgstr ""
"ທັບພະຍາກອນທີ່ກຳນົດອາດຈະຍັ"
"ງບໍ່ມີ"

#: kio/kio/global.cpp:570
msgid "You may have incorrectly typed the location."
msgstr ""
"ທ່ານອາດຈະພິມຕຳແຫນ່ງທີ່ຢູ່"
"ບໍ່ຖືກຕ້ອງ"

#: kio/kio/global.cpp:571
msgid "Double-check that you have entered the correct location and try again."
msgstr ""
"ໂປດກວດສອບຊຳ້ວ່າທ່ານໄດ້ເຕີ"
"່ມຕຳແໜ່ງທີ່ຢູ່ທີ່ຖືກຕ້ອງແ"
"ລ້ວແລະລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:573
msgid "Check your network connection status."
msgstr ""
"ໂປດກວດສອບສະຖານະການເຊື່ອມຕ"
"ໍ່ລະບົບເຄືອຂ່າຍຂອງທ່ານ"

#: kio/kio/global.cpp:577
msgid "Cannot Open Resource For Reading"
msgstr ""
"ບໍ່ສາມາດເປີດໃຊ້ພະຍາກອນເພື"
"່ອທຳການອ່ານໄດ້"

#: kio/kio/global.cpp:578
msgid ""
"This means that the contents of the requested file or directory "
"<strong>%1</strong> could not be retrieved, as read access could not be "
"obtained."
msgstr ""
"ບໍ່ສາມາດຮຽກຂໍເນື້ອຫາຂອງແຟ"
"້ມທີ່ຕ້ອງການຫລືໄດເລັກທໍລີ<s"
"trong>%1</strong> "
"ໄດ້ເນື່ອງຈາກບໍ່ມີສິດໃນການ"
"ອ່ານ"

#: kio/kio/global.cpp:581
msgid "You may not have permissions to read the file or open the directory."
msgstr ""
"ທ່ານຍັງບໍ່ມີສິດໃນການອ່ານແ"
"ຟ້ມຫລືເປີດໃຊ້ໄດເລັກທໍລີນີ"
"້"

#: kio/kio/global.cpp:587
msgid "Cannot Open Resource For Writing"
msgstr ""
"ບໍ່ສາມາດເປີດທັບພະຍາກອນເພື"
"່ອທຳການຂຽນໄດ້"

#: kio/kio/global.cpp:588
msgid ""
"This means that the file, <strong>%1</strong>, could not be written to as "
"requested, because access with permission to write could not be obtained."
msgstr ""
"ບໍ່ສາມາດຂຽນໄປຍັງແຟ້ມ<strong>"
"%1</strong>"
"ຕາມຕ້ອງການໄດ້ເນືອງຈາກອາດຈ"
"ະຍັງບໍ່ມີສິດໃນການເຂົ້າໃຊ້"
"ແລະຂຽນໄປໄດ້"

#: kio/kio/global.cpp:596
msgid "Cannot Initiate the %1 Protocol"
msgstr "ບໍ່ສາມາດເລີ່ມໂປໂຕຄອນ %1 ໄດ້"

#: kio/kio/global.cpp:597
msgid "Unable to Launch Process"
msgstr "ບໍ່ສາມາດຮຽກທຳງານໂປຣເຊສໄດ້"

#: kio/kio/global.cpp:598
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol could not be started. This is usually due to "
"technical reasons."
msgstr ""
"ບໍ່ສາມາດເລີ່ມໂປຣແກຣມເທີງຄ"
"ອມພິວເຕີຂອງທ່ານທີ່ຕ້ອງການ"
"ເຂົ້າໃຊ້ງານໂປຣໂຕຄອນ<strong>%1</strong>"
" "
"ໄ້ດ້ໍືຊື່ງອາດຈະເກີດຈາກປັນຫ"
"າທາງເທັກນິກ"

#: kio/kio/global.cpp:601
msgid ""
"The program which provides compatibility with this protocol may not have "
"been updated with your last update of KDE. This can cause the program to be "
"incompatible with the current version and thus not start."
msgstr ""
"ໂປຣແກຣມທີ່ຕ້ອງການຄວາມເຂົ້"
"າກັນໄດ້ກັບໂປຣໂຕຄອນນີ້ອາດຈ"
"ະຍັງບໍ່ໄດ້ປັບປຸງ "
"ເປັນໃຫ້ເປັນລຸ້ນໃຫມ່ຕາມ KDE "
"ຂອງທ່ານໍືຊື່ງອາດຈະເຮັດໃຫ້"
"ເກີດຄວາມເຂົ້າກນັບໍ່ໄດ້ກັບ"
"ໂປຣແຣກມລຸ້ນປະຈຸບັນທີ່ທ່ານ"
"ໃຊ້ຢູ່ແລະບໍ່ສາມາດທຳງານໄດ້"

#: kio/kio/global.cpp:609
msgid "Internal Error"
msgstr "ຂໍ້ຜິດພາດພາຍໃນ"

#: kio/kio/global.cpp:610
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has reported an internal error."
msgstr ""
"ເກີດຄວາມຜິດພາດພາຍໃນຈາກໂປຣ"
"ແກຣບົນຄອມພິວເຕີຂອງທ່ານຊື່"
"ງຕ້ອງການເຂົ້າໃຊ້ງານໂປຣໂຕຣ"
"ຄອນ <strong>%1</strong>"

#: kio/kio/global.cpp:618
#, fuzzy
msgid "Improperly Formatted URL"
msgstr ""
"ຮູບແບບ URL "
"ບໍ່ຖືກຕ້ອງຫລືສົມບູນ "

#: kio/kio/global.cpp:619
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator (URL) that you entered was not properly formatted. "
"The format of a URL is generally as "
"follows:"
"<blockquote><strong>"
"protocol://user:password@www.example.org:port/directory/filename.extension?qu"
"ery=value</strong></blockquote>"
msgstr ""
"ຕຳແຫນ່ງຂອງ<strong>U</strong>niversal "
"<strong>R</strong>esource <strong>L</strong>ocation (URL) "
"ທີ່ທ່ານເຕີ່ມອາດຈະບໍ່ຖືກຕ້"
"ອງຫລືສົມບູນ "
"ຊື່ງຮູບແບບຂອງຕາມປົກກະຕິຄື "
"URL "
":"
"<blockquote><strong>"
"ໂປຣໂຕຄອນ://ຜູ້ໃຊ້@ລະຫັດຜ່ານ:ໂ"
"ຫສ.ຊື່:ພອດ/ໄດເລັກທໍລີ/ຊື່ແຟ້"
"ມ.ສວນ່ຂະຫຍາຍ?ຕົວແປ=ຄ່າ</strong>"
"</blockquote>"

#: kio/kio/global.cpp:628
#, c-format
msgid "Unsupported Protocol %1"
msgstr "ບໍ່ສະນັບສະນຸນໂປຣໂຕຄອນ %1"

#: kio/kio/global.cpp:629
msgid ""
"The protocol <strong>%1</strong> is not supported by the KDE programs "
"currently installed on this computer."
msgstr ""
"ໂປຣໂຕຄອນ <strong>%1</strong> "
"ຍັງບໍ່ໄດ້ຮັບການສະນັບສະນຸນ"
"ຈາກໂປຣແກຣມ KDE "
"ຕົວປະຈຸບັນທີ່ຕິດຕັ້ງໃນຄອມ"
"ພິວເຕີນີ้້"

#: kio/kio/global.cpp:632
msgid "The requested protocol may not be supported."
msgstr ""
"ບໍ່ສະນັບສະນຸນໂປໂຕຄອນທີ່ຮ້"
"ອງຂໍມາ"

#: kio/kio/global.cpp:633
msgid ""
"The versions of the %1 protocol supported by this computer and the server "
"may be incompatible."
msgstr ""
"ລຸ້ນຂອງໂປໂຕຄອນ %1 "
"ທີ່ໄດ້ຮັບການສະນັບສະນຸນໂດຍ"
"ຄອມພິວເຕີນີ້ແລະເຊີບເວີອາດ"
"ຈະເຂົ້າກັນລໍ່ໄດ້່"

#: kio/kio/global.cpp:635
msgid ""
"You may perform a search on the Internet for a KDE program (called a "
"kioslave or ioslave) which supports this protocol. Places to search include "
"<a href=\"http://apps.kde.com/\">http://apps.kde.com/</a> and <a "
"href=\"http://freshmeat.net/\">http://freshmeat.net/</a>."
msgstr ""
"ທ່ານສາມາດຄົ້ນຫາຂໍ້ມູນເທີງ"
"ອິນເຕີເນັດດ້ວຍໂປຣແກຣຂອງ KDE "
"(ທີ່ຮຽກວ່າ kioslave ຫລື ioslave) "
"ຊື່ງສະນັບສະນຸນໂປໂຕຄອນນີ້ຊ"
"ື່ງສະຖານສຳລັບຄົ້ນຫາຈະຮວມຖ"
"ືງ <a href=\"http://apps.kde.com/\">http://apps.kde.com/</a> ແລະ "
"<a href=\"http://freshmeat.net/\">http://freshmeat.net/</a>"

#: kio/kio/global.cpp:644
msgid "URL Does Not Refer to a Resource."
msgstr ""
"ຕຳແຫນ່ງ URL "
"ບໍ່ໄດ້ອ້າງຖື່ງແຫລ່ງທີ່ມາ"

#: kio/kio/global.cpp:645
msgid "Protocol is a Filter Protocol"
msgstr ""
"ໂປຣໂຕຄອນເປັນໂປຣໂຕຄອນແບບຕົ"
"ວກອງ"

#: kio/kio/global.cpp:646
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator (URL) that you entered did not refer to a specific "
"resource."
msgstr ""
"ຕຳແຫນ່ງ <strong>U</strong>niversal <strong>R</strong>esource "
"<strong>L</strong>ທີ່ທ່ານຕື່ມບໍ່ໄດ້ອ້"
"າງອີງຖືງແຫລ່ງ"

#: kio/kio/global.cpp:649
msgid ""
"KDE is able to communicate through a protocol within a protocol; the "
"protocol specified is only for use in such situations, however this is not "
"one of these situations. This is a rare event, and is likely to indicate a "
"programming error."
msgstr ""
"KDE ສາມາດສື່ສານກັນໄດ້ "
"ຜ່ານທາງໂປຣໂຕຄອລຊ້ອນໂປຣໂຕຄ"
"ອບ "
"ເຊິ່ງຈະກຳນົດໃຊ້ໂປຣໂຕຄອບສະ"
"ເພາະກັບແຕ່ລະສະຖານະການ "
"ຢ່າງໃດກໍຕາມ "
"ມັນກໍບໍ່ໄດ້ມີພຽງຫນຶ່ງຕົວສ"
"ຳຫລັບສະຖານະການນີ້ "
"ນີ້ເປັນເຫດການຈິງ "
"ແລະເບິ່ງຄືຈະເປັນຄວາມຜິດພາ"
"ດໃນການຂຽນໂປຣແກຣມ"

#: kio/kio/global.cpp:657
#, c-format
msgid "Unsupported Action: %1"
msgstr "ບໍ່ສະຫນັບສະຫນຸນການກະທຳ: %1"

#: kio/kio/global.cpp:658
msgid ""
"The requested action is not supported by the KDE program which is "
"implementing the <strong>%1</strong> protocol."
msgstr ""
"ການກະທຳທີ່ຮ້ອງຂໍມາ "
"ບໍ່ສະຫນັບສະຫນຸນໂດຍໂປຣແກຣມ "
"KDE "
"ເຊິ່ງເປັນຕົວກຳນົດໂປຣໂຕຄອລ "
"<strong>%1</strong>"

#: kio/kio/global.cpp:661
msgid ""
"This error is very much dependent on the KDE program. The additional "
"information should give you more information than is available to the KDE "
"input/output architecture."
msgstr ""
"ຂໍ້ຜິດພາດນີ້ "
"ຂຶ້ນຢູ່ກັບໂປຣແກຣມ KDE "
"ເປັນຢ່າງຫລາຍ "
"ເຊິ່ງລາຍລະອຽດເພີ້ມເຕີມ "
"ຄວນຈະມີລາຍລະອຽດຫລາຍກວ່າທີ"
"່ມີຢູ່ ໃນສ່ວນສະຖາປັດຕະຍະກຳ "
"input/output ຂອງ KDE "

#: kio/kio/global.cpp:664
msgid "Attempt to find another way to accomplish the same outcome."
msgstr ""
"ກຳລັງຫາທາງອື່ນເພື່ອໃຫ້ໄດ້"
"ຜົນລັບແບບດຽວກັນ"

#: kio/kio/global.cpp:669
msgid "File Expected"
msgstr "ຕ້ອງການແຟ້ມ"

#: kio/kio/global.cpp:670
msgid ""
"The request expected a file, however the directory <strong>%1</strong> was "
"found instead."
msgstr ""
"ສິ່ງທີ່ຮ້ອງຂໍມາຕ້ອງການແຟ້"
"ມ ແຕ່ກັບພົບວ່າ  <strong>%1</strong> "
"ເປັນໄດເຣກທໍລີ"

#: kio/kio/global.cpp:672
msgid "This may be an error on the server side."
msgstr ""
"ອາດຈະເກີດຄວາມຜິດພາດທາງຝັ່"
"ງເຊີບເວີ"

#: kio/kio/global.cpp:677
msgid "Directory Expected"
msgstr "ຕ້ອງການໄດເຣກທໍລີ"

#: kio/kio/global.cpp:678
msgid ""
"The request expected a directory, however the file <strong>%1</strong> was "
"found instead."
msgstr ""
"ສິ່ງທີ່ຮ້ອງຂໍມາຕ້ອງການໄດເ"
"ຣກທໍລີ ແຕ່ກັບພົບວ່າ  "
"<strong>%1</strong>ເປັນແຟ້ມ"

#: kio/kio/global.cpp:685
msgid "File or Directory Does Not Exist"
msgstr "ຍັງບໍ່ມີແຟ້ມຫລືໄດເຣກທໍລີ"

#: kio/kio/global.cpp:686
msgid "The specified file or directory <strong>%1</strong> does not exist."
msgstr ""
"ແຟ້ມຫລືໄດເຣກທໍລີ <strong>%1</strong> "
"ທີ່ກຳນົດຍັງບໍ່ມີ"

#: kio/kio/global.cpp:694
msgid ""
"The requested file could not be created because a file with the same name "
"already exists."
msgstr ""
"ບໍ່ສາມາດສ້າງແຟ້ມທີ່ຮ້ອງຂໍ"
"ມາໄດ້ "
"ເນື່ອງຈາກມີແຟ້ມເຊິ່ງມີຊື່"
"ດຽວກັນຢູ່ແລ້ວ"

#: kio/kio/global.cpp:696
msgid "Try moving the current file out of the way first, and then try again."
msgstr ""
"ລອງທຳການຍ້າຍແຟ້ມປັດຈຸບັນອ"
"ອກໄປກ່ອນ "
"ແລ້ວລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:698
msgid "Delete the current file and try again."
msgstr ""
"ລຶບແຟ້ມທີ່ໃຊ້ໃນປັດຈຸບັນ "
"ແລະລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:699
msgid "Choose an alternate filename for the new file."
msgstr ""
"ເລືອກຊື່ແຟ້ມເປັນຊື່ອື່ນ "
"ສຳຫລັບແຟ້ມໃຫມ່"

#: kio/kio/global.cpp:704
msgid ""
"The requested directory could not be created because a directory with the "
"same name already exists."
msgstr ""
"ບໍ່ສາມາດສ້າງໄດເຣກທໍລີທີ່ຮ"
"້ອງຂໍມາໄດ້ "
"ເນື່ອງຈາກມີໄດເຣກທໍລີຊື່ດຽ"
"ວກັນນີ້ຢູ່ແລ້ວ"

#: kio/kio/global.cpp:706
msgid "Try moving the current directory out of the way first, and then try again."
msgstr ""
"ລອງຍ້າຍໄດເຣກທໍລີປັດຈຸບັນອ"
"ອກໄປກ່ອນ "
"ແລ້ວລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:708
msgid "Delete the current directory and try again."
msgstr ""
"ລຶບໄດເຣກທໍລີປັດຈຸບັນກ່ອນ "
"ແລະລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:709
msgid "Choose an alternate name for the new directory."
msgstr ""
"ເລືອກຊື່ໃຫມ່ສຳຫລັບໄດເຣກທໍ"
"ລີໃຫມ່"

#: kio/kio/global.cpp:713
msgid "Unknown Host"
msgstr "ໂຮສຕ໌ທີ່ໍບໍ່ຮູ້ຈັກ"

#: kio/kio/global.cpp:714
msgid ""
"An unknown host error indicates that the server with the requested name, "
"<strong>%1</strong>, could not be located on the Internet."
msgstr ""
"ເກີດຄວາມຜິດພາດຈາກໂຮສຕ໌ທີ່"
"ບໍ່ຮູ້ຈັກ ສະແດງວ່າ "
"ເຊີບເວີຊື່ "
"<strong>%1</strong>ທີ່ຮ້ອງຂໍມາ "
"ບໍ່ສາມາດຫາຕຳແຫນ່ງເທິງອິນເ"
"ຕ່ເນຕໄດ້"

#: kio/kio/global.cpp:717
msgid "The name that you typed, %1, may not exist: it may be incorrectly typed."
msgstr ""
"ຊື່ %1 ທີ່ທ່ານພີມມາ "
"ອາດຈະບໍ່ມີຢູ່ "
"ຫລືອາດຈະເກີດຈາກການພີມຜິດ"

#: kio/kio/global.cpp:724
msgid "Access Denied"
msgstr ""
"ໄດ້ຮັບການປະຕິເສດໃຫ້ເຂົ້າໃ"
"ຊ້"

#: kio/kio/global.cpp:725
msgid "Access was denied to the specified resource, <strong>%1</strong>."
msgstr ""
"ໄດ້ຮັບການປະຕິເສດໃນການໃຊ້ງ"
"ານຊັບພະຍາກອນ <strong>%1</strong>"

#: kio/kio/global.cpp:727 kio/kio/global.cpp:943
msgid "You may have supplied incorrect authentication details or none at all."
msgstr ""
"ທ່ານອາດຈະລືມໃສ່ລາຍລະອຽດຫລ"
"ືໃສ່ລາຍລະອຽດບໍ່ຖືກຕ້ອງສຳຫ"
"ລັບການກວດສອບສິດ"

#: kio/kio/global.cpp:729 kio/kio/global.cpp:945
msgid "Your account may not have permission to access the specified resource."
msgstr ""
"ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ຂຽ"
"ນໄປຍັງຊັບພະຍາກອນນີ້"

#: kio/kio/global.cpp:731 kio/kio/global.cpp:947 kio/kio/global.cpp:959
msgid ""
"Retry the request and ensure your authentication details are entered "
"correctly."
msgstr ""
"ລອງເຮັດສິ່ງຮ້ອງຂໍມາ "
"ແລະກວດສອບໃຫ້ແນ່ໃຈວ່າ "
"ໄດ້ຕື່ມລາຍລະອຽດສ່ວນການກວດ"
"ສອບສິດ ຖຶກຕ້ອງແລ້ວ"

#: kio/kio/global.cpp:737
msgid "Write Access Denied"
msgstr "ໄດ້ຮັບການປະຕິເສດໃນການຂຽນ"

#: kio/kio/global.cpp:738
msgid ""
"This means that an attempt to write to the file <strong>%1</strong> was "
"rejected."
msgstr ""
"ໄດ້ຮັບການປະຕິເສດໃຫ້ທຳການຂ"
"ຽນໄປຍັງແຟ້ມ <strong>%1</strong>"

#: kio/kio/global.cpp:745
msgid "Unable to Enter Directory"
msgstr ""
"ບໍ່ສາມາດເຂົ້າໄປຍັງໄດເຣກທໍ"
"ລີໄດ້"

#: kio/kio/global.cpp:746
msgid ""
"This means that an attempt to enter (in other words, to open) the requested "
"directory <strong>%1</strong> was rejected."
msgstr ""
"ໄດ້ຮັບການປະຕິເສດໃນການເຂົ້"
"າໄປຍັງ (ຫລື ເປີດໃຊ້) "
"ໄດເຣກທໍລີ <strong>%1</strong> "
"ທີ່ຮ້ອງຂໍມາ"

#: kio/kio/global.cpp:754
msgid "Directory Listing Unavailable"
msgstr ""
"ບໍ່ສາມາດເອີ້ນເບິ່ງພາຍໃນໄດ"
"ເຣກທໍລີໄດ້"

#: kio/kio/global.cpp:755
msgid "Protocol %1 is not a Filesystem"
msgstr "ໂປຣໂຕຄອລ %1 ບໍ່ແມ່ນລະບົບແຟ້ມ"

#: kio/kio/global.cpp:756
msgid ""
"This means that a request was made which requires determining the contents "
"of the directory, and the KDE program supporting this protocol is unable to "
"do so."
msgstr ""
"ສິ່ງທີ່ຮ້ອງຂໍມາ "
"ຕ້ອງການເອີ້ນເບິ່ງເນື້ນຫາພ"
"າຍໃນໄດເຣກທໍລີ ແລະໂປຣແກຣມ KDE "
"ທີ່ສະຫນັບສະຫນຸນໂປຣໂຕຄອລນີ"
"້ ບໍ່ສາມາດເຮັດເຊັ່ນນັ້ນໄດ້"

#: kio/kio/global.cpp:764
msgid "Cyclic Link Detected"
msgstr "ກວດສອບພົບລິງແບບວົນຮອບ"

#: kio/kio/global.cpp:765
msgid ""
"UNIX environments are commonly able to link a file or directory to a "
"separate name and/or location. KDE detected a link or series of links that "
"results in an infinite loop - i.e. the file was (perhaps in a roundabout "
"way) linked to itself."
msgstr ""
"ຕາມປົກະຕິ "
"ສະພາບແວດລ້ອມຂອງລະບົບຢູນິກ"
"ຊ໌ ສາມາດທຳການລິງແຟ້ມ "
"ຫລືໄດເຣກທໍລີ ໄປເປັນຊື່ອື່ນ "
"ແລະ/ຫລືໃນຕຳແໜ່ງອື່ນໆ ໄດ້  "
"ເຊິ່ງ KDE ໄດ້ກວດພົບລິງ "
"ຫລືຊຸດຂອງລິງ "
"ໃນແບບວົນຮອບບໍ່ຮູ້ຈົບ - "
"ເຊັ່ນ "
"ແຟ້ມທີ່ທຳການລິງໄປຍັງຕົວມັ"
"ນເອງ ເປັນຕົ້ນ"

#: kio/kio/global.cpp:769 kio/kio/global.cpp:791
msgid ""
"Delete one part of the loop in order that it does not cause an infinite "
"loop, and try again."
msgstr ""
"ລຶບສ່ວນຫນຶ່ງຂອງການວົນຮອບ "
"ໃນລຳດັບທີ່ຈະທຳໃຫ້ມັນບໍເປັ"
"ນການວົນຮອບບໍ່ຮູ້ຈົບ "
"ແລ້ວລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:778
msgid "Request Aborted By User"
msgstr "ຕ້ອງການຍົກເລີກໂດຍຜູ້ໃຊ້"

#: kio/kio/global.cpp:779 kio/kio/global.cpp:1072
msgid "The request was not completed because it was aborted."
msgstr ""
"ບໍ່ສາມາດເຮັດສິ່ງທີ່ຮ້ອງຂໍ"
"ມາໃຫ້ສຳເລັດໄດ້ "
"ເນື່ອງຈາກມັນຖືກຍົກເລີກເສຍ"
"ກ່ອນ"

#: kio/kio/global.cpp:781 kio/kio/global.cpp:975 kio/kio/global.cpp:1074
msgid "Retry the request."
msgstr ""
"ພະຍາຍາມເຮັດສິ່ງທີ່ຮ້ອງຂໍມ"
"າ"

#: kio/kio/global.cpp:785
msgid "Cyclic Link Detected During Copy"
msgstr ""
"ພົບລິງແບບວົນຮອບຂະນະທຳການຄ"
"ັດລອກ"

#: kio/kio/global.cpp:786
msgid ""
"UNIX environments are commonly able to link a file or directory to a "
"separate name and/or location. During the requested copy operation, KDE "
"detected a link or series of links that results in an infinite loop - i.e. "
"the file was (perhaps in a roundabout way) linked to itself."
msgstr ""
"ຕາມປົກະຕິ "
"ສະພາບແວດລ້ອມຂອງລະບົບຢູນິກ"
"ຊ໌ ສາມາດທຳການລິງແຟ້ມ "
"ຫລືໄດເຣກທໍລີ ໄປເປັນຊື່ອື່ນ "
"ແລະ/ຫລືໃນຕຳແໜ່ງອື່ນໆ ໄດ້ "
"ເຊິ່ງລະຫວ່າງທຳການຄັດລອກ KDE "
"ໄດ້ກວດພົບລິງຫລືຊຸດຂອງລິງ "
"ໃນແບບວົນຮອບບໍ່ຮູ້ຈົບ - "
"ເຊັ່ນ "
"ແຟ້ມທີ່ທຳການລິງໄປຍັງຕົວມັ"
"ນເອງ ເປັນຕົ້ນ"

#: kio/kio/global.cpp:796
msgid "Could Not Create Network Connection"
msgstr ""
"ບໍ່ສາມາດສ້າງການເຊື່ອມຕໍ່ເ"
"ຄືອຂ່າຍໄດ້"

#: kio/kio/global.cpp:797
msgid "Could Not Create Socket"
msgstr "ບໍ່ສາມາດສ້າງຊັອກເກັຕໄດ້"

#: kio/kio/global.cpp:798
msgid ""
"This is a fairly technical error in which a required device for network "
"communications (a socket) could not be created."
msgstr ""
"ນີ້ເປັນຂໍ້ຜິດພາດຕາມປົກະຕິ "
"ທີ່ບໍ່ສາມາດສ້າງອຸປະກອນ "
"ສຳຫລັບການສື່ສານໃນເຄືອຂ່າຍ "
"(ຊັອກເກັຕ) ຕາມຕ້ອງການໄດ້"

#: kio/kio/global.cpp:800 kio/kio/global.cpp:913 kio/kio/global.cpp:924
#: kio/kio/global.cpp:933
msgid ""
"The network connection may be incorrectly configured, or the network "
"interface may not be enabled."
msgstr ""
"ການສື່ສານແບບເຄືອຂ່າຍ "
"ອາດຈະຍັງບໍ່ໄດ້ຖືກປັບແຕ່ງຢ"
"່າງຖືກຕ້ອງ "
"ຫລືອຸປະກອນເຄືອຂ່າຍອາດຈະຍັ"
"ງບໍ່ເປີດໃຊ້ງານ"

#: kio/kio/global.cpp:806
msgid "Connection to Server Refused"
msgstr ""
"ການເຊື່ອມຕໍ່ໄປຍັງເຊີບເວີຖ"
"ືກປະຕິເສດ"

#: kio/kio/global.cpp:807
msgid ""
"The server <strong>%1</strong> refused to allow this computer to make a "
"connection."
msgstr ""
"ເຊີບເວີ <strong>%1</strong> "
"ປະຕິເສດການຂໍອະນຸຍາດເຂົ້າໃ"
"ຊ້ງານຂອງຄອມພິວເຕີນີ້"

#: kio/kio/global.cpp:809
msgid ""
"The server, while currently connected to the Internet, may not be configured "
"to allow requests."
msgstr ""
"ເຊີບເວີ "
"ເຊິ່ງເຊື່ອມຕໍ່ຢູ່ກັບລະບົບ"
"ອິນເຕີເນຕໃນປັດຈຸບັນ "
"ອາດຈະຍັງບໍ່ໄດ້ປັບແຕ່ງໃຫ້ຮ"
"ັບການເຊື່ອມຕໍ່ທີ່ຮ້ອງຂໍໄປ"

#: kio/kio/global.cpp:811
msgid ""
"The server, while currently connected to the Internet, may not be running "
"the requested service (%1)."
msgstr ""
"ເຊີບເວີ "
"ເຊິ່ງເຊື່ອມຕໍ່ຢູ່ກັບລະບົບ"
"ອິນເຕີເນຕໃນປັດຈຸບັນ "
"ອາດຈະຍັງບໍ່ໄດ້ປັບແຕ່ງໃຫ້ຮ"
"ັບການເຊື່ອມຕໍ່ບໍລິການທີ່ຮ"
"້ອງຂໍໄປ (%1)"

#: kio/kio/global.cpp:813
msgid ""
"A network firewall (a device which restricts Internet requests), either "
"protecting your network or the network of the server, may have intervened, "
"preventing this request."
msgstr ""
"ໄຟຣ໌ວອລລ໌ຂອງລະບົບເຄືອຂ່າຍ "
"(ອຸປະກອນທີ່ທຳຫນ້າທີ່ປ້ອງກັ"
"ນການເຂົ້າໃຊ້ງານຈາກເຄືອຂ່າ"
"ຍ) "
"ອາດຈະບໍ່ອະນຸຍາດໃຫ້ມີການເຊ"
"ື່ອມຕໍ່ທີ່ຮ້ອງຂໍໄປ"

#: kio/kio/global.cpp:820
msgid "Connection to Server Closed Unexpectedly"
msgstr ""
"ການເຊື່ອມຕໍ່ໄປຍັງເຊີບເວີຢ"
"ຸດຕິຢ່າງບໍ່ຄາດຄິດ"

#: kio/kio/global.cpp:821
msgid ""
"Although a connection was established to <strong>%1</strong>"
", the connection was closed at an unexpected point in the communication."
msgstr ""
"ເຖິ່ງວ່າການເຊື່ອມຕໍ່ໄປຍັງ<s"
"trong>%1</strong> "
"ຈະເກີດຂື້ນແລ້ວແຕ່ກໍ່ເກີດກ"
"ານຍຸຕິການເຊື່ອມຕໍ່ໃນາງຈຸດ"
"ຂອງການສື່ສາມຢ່າງບໍ່ຄາດຄິດ"

#: kio/kio/global.cpp:824
msgid ""
"A protocol error may have occurred, causing the server to close the "
"connection as a response to the error."
msgstr ""
"ເກີດຂໍ້ຜິດພາດຂອງໂປຣໂຕຄອນເ"
"ນື່ອງຈາກເຊີບເວີປິດການເຊື່"
"ອມຕໍ່ຈາກການໂຕ້ຕອບທີ່ຜິດພາ"
"ດ"

#: kio/kio/global.cpp:830
#, fuzzy
msgid "URL Resource Invalid"
msgstr "ແຫລ່ງ URL ບໍ່ຖືກຕອ້ງ"

#: kio/kio/global.cpp:831
msgid "Protocol %1 is not a Filter Protocol"
msgstr ""
"ໂປໂຕຄອນ %1 "
"ບໍ່ແມ່ນໃຊ້ໂປຣໂຄດຄອນແບບຕົວ"
"ກອງ"

#: kio/kio/global.cpp:832
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator (URL) that you entered did not refer to a valid "
"mechanism of accessing the specific resource, <strong>%1%2</strong>."
msgstr ""
"ຕຳແຫນ່ງ <strong>U</strong>niversal <strong>R</strong>esource "
"<strong>L</strong>ocation (URL) "
"ບໍ່ໄດ້ອ້າງຖືງສ່ວນຂອງການເຂ"
"ົ້າຖືງສັບພະຍາກອນທີ່ກຳນົດ<stro"
"ng>%1%2</strong>"

#: kio/kio/global.cpp:837
msgid ""
"KDE is able to communicate through a protocol within a protocol. This "
"request specified a protocol be used as such, however this protocol is not "
"capable of such an action. This is a rare event, and is likely to indicate a "
"programming error."
msgstr ""
"KDE "
"ສາມາດສືສາມຫວ່າງໂປໂຕຄອນແລະ"
"ພາຍໃນໂປໂຄຄອນສື່ງທີ່ຮ້ອງຂໍ"
"ມານີ້ໄດ້ກຳນົດໂປໂຄຄອນທີ່ຈະ"
"ໃຊ້ດ້ວຍແຕ່ວ່າ "
"ໂປໂຄອນນີ້ບໍ່ມີຄວາມສາມາດໃນ"
"ການກະທຳນັ້ນ "
"ຊື່ງນີ້ເປັນເຫດການຈິ່ງແລະເ"
"ບິ່ງວ່າຈະເປັນຂໍ້ຜິດພາດຈາກ"
"ການຂຽນໂປຣແກຣມ"

#: kio/kio/global.cpp:845
msgid "Unable to Initialize Input/Output Device"
msgstr ""
"ບໍ່ສາມາດເລີ່ມການໃຊ້ອຸປະກອ"
"ນນຳເຂົ້າ/ສົ່ງອອກ"

#: kio/kio/global.cpp:846
msgid "Could Not Mount Device"
msgstr "ບໍ່ສາມາດເມາອຸປະກອນໄດ້"

#: kio/kio/global.cpp:847
msgid ""
"The requested device could not be initialized (\"mounted\"). The reported "
"error was: <strong>%1</strong>"
msgstr ""
"ບໍ່ສາມາດເລີ່ມໃຊ້ງານ(\"ເມານ\") "
"ອຸປະກອນທີ່ຮ້ອງຂໍມາໄດ້ຊື່ງ"
"ລາຍງານຄວາມຜິດພາດຄື:<strong>%1</strong>"

#: kio/kio/global.cpp:850
msgid ""
"The device may not be ready, for example there may be no media in a "
"removable media device (i.e. no CD-ROM in a CD drive), or in the case of a "
"peripheral/portable device, the device may not be correctly connected."
msgstr ""
"ອຸປະກອນອາດຈະຍັງບໍ່ພ້ອມໃຊ້"
"ງານ ຕົວຢ່າງເຊັ່ນ "
"ອາດຈະບໍ່ມີສື່ຢູ່ໃນອຸປະກອນ"
"ແບບຍ້າຍສື່ໄດ້ (ເຊັ່ນ "
"ບໍ່ມີແຜ່ນຊີດີຣອມ "
"ຢູ່ໃນໄດຣຟຊີດີ ເປັນຕົ້ນ) "
"ຫລືໃນກໍລະນີຂອງອຸປະກອນຕໍ່ພ"
"່ວງ / ອຸປະກອນແບບພົກພາ "
"ກໍອາດຈະເກີດຈາກ "
"ອຸປະກອນດັ່ງກ່າວຍັງບໍ່ໄດ້ທ"
"ຳການເຊື່ອມຕໍ່"

#: kio/kio/global.cpp:854
msgid ""
"You may not have permissions to initialize (\"mount\") the device. On UNIX "
"systems, often system administrator privileges are required to initialize a "
"device."
msgstr ""
"ທ່ານອາດຈະບໍ່ໄດ້ຮັບສິດໃຫ້ເ"
"ລີ້ມໃຊ້ງານ (\"ເມົານທ໌\") "
"ອຸປະກອນໄດ້ "
"ເທິງລະບົບຢູນິກນັ້ນ "
"ບາງຄັ້ງຜູ້ເບິ່ງແຍງລະບົບກໍ"
"ອາດຈະຫວງຫ້າມການເຂົ້າໃຊ້ງາ"
"ນອະປະກອນບາງຕົວ"

#: kio/kio/global.cpp:858
msgid ""
"Check that the device is ready; removable drives must contain media, and "
"portable devices must be connected and powered on.; and try again."
msgstr ""
"ກະລຸນາກວດສອບວ່າ "
"ອຸປະກອນພ້ອມໃ່ຊ້ງານແລ້ວ "
"ຫາກເປັນໄດຣຟທີ່ຍ້າຍສື່ໄດ້ "
"ກໍ່ຕ້ອງມີສື່ຢູ່ໃນໄດຣຟກ່ອນ "
"ແລະອຸປະກອນແບບພົກພາ "
"ກໍຕ້ອງເຊື່ອມຕໍ່ແລະເປີດແລ້"
"ວ ຈາກນັ້ນລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:864
msgid "Unable to Uninitialize Input/Output Device"
msgstr ""
"ບໍ່ສາມາດຍົກເລີກການເອີ້ນໃຊ"
"້ອຸປະກອນນຳເຂົ້າ/ສົ່ງອອກໄດ້"

#: kio/kio/global.cpp:865
msgid "Could Not Unmount Device"
msgstr ""
"ບໍ່ສາມາດຍົກເລີກການເມົານທ໌"
"ອຸປະກອນໄດ້"

#: kio/kio/global.cpp:866
msgid ""
"The requested device could not be uninitialized (\"unmounted\"). The "
"reported error was: <strong>%1</strong>"
msgstr ""
"ບໍ່ສາມາດຍົກເລີກການໃຊ້ງານ "
"(\"ຍົກເລີກການເມົານທ໌\")ອຸປະກອ"
"ນທີ່ຮ້ອງຂໍມາໄດ້ຊື່ງລາຍງານ"
"ຄວາມຜິດພາດຄື: <strong>%1</strong>"

#: kio/kio/global.cpp:869
msgid ""
"The device may be busy, that is, still in use by another application or "
"user. Even such things as having an open browser window on a location on "
"this device may cause the device to remain in use."
msgstr ""
"ອຸປະກອນຈະບໍ່ວ່າງ(ຖືກໃຊ້ງານ"
"ຢູ່) "
"ຄືອາດຈະຖືກໃຊ້ຢູ່ໂດຍແອບພິເ"
"ຄຊັ້ນຫລືຜູ້ໃຊ້ອື່ນຯ "
"ເຊັ່ນມີຫ້ນາຕ່າງບາວເຊີທີ່ຮ"
"ຽກ "
"ໃຊ້ງານເທີງຕຳແຫນ່ງຊື່ງຢູ່ເ"
"ທີງອຸປະກອນນີ້ກໍຈະເຮັດໃຫ້ອ"
"ຸປະກອນຢູ່ໃນສະຖານະຖືກໃຊ້ງາ"
"ນຢູ່"

#: kio/kio/global.cpp:873
msgid ""
"You may not have permissions to uninitialize (\"unmount\") the device. On "
"UNIX systems, system administrator privileges are often required to "
"uninitialize a device."
msgstr ""
"ທ່ານອາດຈະບໍ່ມີສິດໃນການຍົກ"
"ເລີກການໃຊ້ງານ(\"ຍົກເລີກການເ"
"ມາ\") "
"ອຸປະກອນຊື່ງເທີງລະບົບຍູນິກ"
"ນັ້ນຜູ້ດູແລລະບົບອາດຈະບໍ່ຕ"
"້ອງການໃຫ້ມີການຍົກເລີກການໃ"
"ຊ້ງານອຸປະກອນ"

#: kio/kio/global.cpp:877
msgid "Check that no applications are accessing the device, and try again."
msgstr ""
"ກະລຸນາກວດສອບວ່າບໍ່ມີແອບພິ"
"ເຄຊັ້ນຫລືຜູ້ໃຊ້ໃດກຳລັງໃຊ້"
"ງານອຸປະກອນຢູ່ແລ້ວລອງໃຫມ່ອ"
"ີກຄັ້ງ"

#: kio/kio/global.cpp:882
msgid "Cannot Read From Resource"
msgstr ""
"ບໍ່ສາມາດອ່ານຈາກສັບພະຍາກອນ"
"ໄດ້"

#: kio/kio/global.cpp:883
msgid ""
"This means that although the resource, <strong>%1</strong>, was able to be "
"opened, an error occurred while reading the contents of the resource."
msgstr ""
"ເຖືງວ່າສັບພະຍາກອນ <strong>%1</strong> "
"ຈະສາມາດເປີດໃຊ້ໄດ້ແຕ່ກໍເກີ"
"ດຄວາມຜິດພາດຂື້ນເມື່ອມີການ"
"ພະຍາຍາມອ່ານເນື້ອຫາພາຍໃນສັ"
"ບພະຍາກອນນັ້ນ"

#: kio/kio/global.cpp:886
msgid "You may not have permissions to read from the resource."
msgstr ""
"ທ່ານອາດຈະຍັງບໍ່ໄດ້ຮັບອະນຸ"
"ຍາດໃຫ້ອ່ານຈາກສັບພະຍາກອນນິ"
"້"

#: kio/kio/global.cpp:895
msgid "Cannot Write to Resource"
msgstr ""
"ບໍ່ສາມາດຂຽນໄປຍັງສັບພະຍາກອ"
"ນໄດ້"

#: kio/kio/global.cpp:896
msgid ""
"This means that although the resource, <strong>%1</strong>, was able to be "
"opened, an error occurred while writing to the resource."
msgstr ""
"ເຖີ່ງວ່າຈະສາມາດເປີດໃຊ້ງານ"
"ສັບພະຍາກອນ <strong>%1</strong> "
"ໄດ້ແຕ່ກໍເກີດຄວາມຜິດພາດຂື້"
"ນເມື່ອມີການຂຽນໄປຍັງສັບພະຍ"
"າກອນນັ້ນ"

#: kio/kio/global.cpp:899
msgid "You may not have permissions to write to the resource."
msgstr ""
"ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ຂຽ"
"ນໄປຍັງສັບພະຍາກອນ"

#: kio/kio/global.cpp:908 kio/kio/global.cpp:919
msgid "Could Not Listen for Network Connections"
msgstr ""
"ບໍ່ສາມາດຖ້າຮັບການເຊື່ອມຕໍ"
"່ຂອງເຄືອຂ່າຍໄດ້"

#: kio/kio/global.cpp:909
msgid "Could Not Bind"
msgstr "ບໍ່ສາມາດ bind ໄດ້"

#: kio/kio/global.cpp:910 kio/kio/global.cpp:921
msgid ""
"This is a fairly technical error in which a required device for network "
"communications (a socket) could not be established to listen for incoming "
"network connections."
msgstr ""
"ນີ້ເປັນຂໍ້ຜິດພາດທາງເທັກນິ"
"ກຕາມປົກກະຕິທີ່ບໍ່ສາມາດເລີ"
"່ມອຸປະກອນສຳລັບການສື່ສານຂອ"
"ງເຄືອຂ່າຍ (ຊອກເກັດ) "
"ເພື່ອຖ້າຮັບການເຊື່ອມຕໍ່ເຄ"
"ື່ອຂ່າຍທີ່ມີເຂົ້າມາໄດ້"

#: kio/kio/global.cpp:920
msgid "Could Not Listen"
msgstr ""
"ບໍ່ສາມາດຖ້າຮັບການເຊື່ີອມຕ"
"ໍ່ໄດ້"

#: kio/kio/global.cpp:930
msgid "Could Not Accept Network Connection"
msgstr ""
"ບໍ່ສາມາດຍອກຮັບການເຊື່ອມຕໍ"
"່ເຄືອຂ່າຍໄດ້"

#: kio/kio/global.cpp:931
msgid ""
"This is a fairly technical error in which an error occurred while attempting "
"to accept an incoming network connection."
msgstr ""
"ນີ້ເປັນຂໍ້ຜິດພາດທາງເທັກນິ"
"ກຕາມປົກກະຕິທີ່ຈະເກີດຄວາມຜ"
"ິດພາດຂື້້ນເມື່ອພະຍາຍາມຈະຍ"
"ອມຮັຫບ "
"ການເຊື່ອມຕໍ່ລະບົບເຄືອຂ່າຍ"
"ທີ່ມີເຂົ້າມາ"

#: kio/kio/global.cpp:935
msgid "You may not have permissions to accept the connection."
msgstr ""
"ທ່ານອາດຈະບໍ່ໄດ້ຮັບອະນຸຍາດ"
"ໃຫ້ສາມາດຮັບການເຊື່ອມຕໍ່"

#: kio/kio/global.cpp:940
#, c-format
msgid "Could Not Login: %1"
msgstr "ບໍ່ສາມາດລອກອິນ: %1 ໄດ້"

#: kio/kio/global.cpp:941
msgid "An attempt to login to perform the requested operation was unsuccessful."
msgstr ""
"ຄວາມພະຍາຍາມໃນການລອກອິນເພື"
"່ອປະຕິບັດສິ່ງທີ່ຮ້ອງຂໍບໍ່"
"ສຳເລັດ"

#: kio/kio/global.cpp:952
msgid "Could Not Determine Resource Status"
msgstr ""
"ບໍ່ສາມາດຮຽກສະຖານະຂອງສັບພະ"
"ຍາກອນໄດ້"

#: kio/kio/global.cpp:953
msgid "Could Not Stat Resource"
msgstr ""
"ບໍ່ສາມາດຫາສະຖານະຂອງສັບພະຍ"
"າກອນໄດ້"

#: kio/kio/global.cpp:954
msgid ""
"An attempt to determine information about the status of the resource "
"<strong>%1</strong>, such as the resource name, type, size, etc., was "
"unsuccessful."
msgstr ""
"ການພະຍາຍາມຂໍ້ມູນກ່ຽວກັບສະ"
"ຖານະຂອງສັບພະຍາກອນ<strong>%1</strong> "
"ເຊັ່ນ ຊື່ ປະເພດ ຂະຫນາດ "
"ເປັນຕົ້ນ ບໍ່ສຳເລັດ"

#: kio/kio/global.cpp:957
msgid "The specified resource may not have existed or may not be accessible."
msgstr ""
"ສັບພະຍາກອນທີ່ກຳນົດຍັງບໍ່ມ"
"ີຫລືບໍ່ສາມາດເຂົ້າໃຊ້ງານໄດ"
"້"

#: kio/kio/global.cpp:965
msgid "Could Not Cancel Listing"
msgstr ""
"ບໍ່ສາມາດຍົກເລີກການຄອຍຮັບກ"
"ານເຊື່ອມຕໍ່ໄດ້"

#: kio/kio/global.cpp:966
msgid "FIXME: Document this"
msgstr ""
"ແກ້ໄຂຂ້ອຍ: "
"ສ້າງເອກະສານທີ່ນີ້"

#: kio/kio/global.cpp:970
msgid "Could Not Create Directory"
msgstr "ບໍ່ສາມາດສ້າງໄດເລັກທໍລີໄດ້"

#: kio/kio/global.cpp:971
msgid "An attempt to create the requested directory failed."
msgstr ""
"ລົ້ມເຫລວໃນການພະຍາຍາມສ້າງໄ"
"ດເລັກທໍລີທີ່ຮ້ອງຂໍມາ"

#: kio/kio/global.cpp:972
msgid "The location where the directory was to be created may not exist."
msgstr ""
"ຕຳແຫນ່ງທີ່ໄດເລັກທໍລີຈະຖືກ"
"ສ້າງຍັງບໍ່ມີຢ"

#: kio/kio/global.cpp:979
msgid "Could Not Remove Directory"
msgstr "ບໍ່ສາມາດລືບໄດເລັກທໍລີໄດ້"

#: kio/kio/global.cpp:980
msgid "An attempt to remove the specified directory, <strong>%1</strong>, failed."
msgstr ""
"ລົ້ມເຫລວໃນການພະຍາຍາມລຶບໄດ"
"ເລັກທໍລີ <strong>%1</strong>"

#: kio/kio/global.cpp:982
msgid "The specified directory may not exist."
msgstr ""
"ໄດເລັກທໍລີທີ່ກຳນົດຍັງບໍ່ມ"
"ີຢູ່"

#: kio/kio/global.cpp:983
msgid "The specified directory may not be empty."
msgstr ""
"ໄດເລັກທໍລີທີ່ກຳນົດອາດຈະບໍ"
"່ແມ່ນໄດເລັກທໍລີວ່າງ"

#: kio/kio/global.cpp:986
msgid "Ensure that the directory exists and is empty, and try again."
msgstr ""
"ກະລຸູນາກວດສອບວ່າມີໄດເລັກທ"
"ໍລີຢູ່ແລະເປັນໄດເລັກທໍລີວ່"
"າງຈາກນັ້ນລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:991
msgid "Could Not Resume File Transfer"
msgstr ""
"ບໍ່ສາມາດກັບໄປທຳການຮັບສົ່ງ"
"ແຟ້ມຕໍ່ໄດ້"

#: kio/kio/global.cpp:992
msgid ""
"The specified request asked that the transfer of file <strong>%1</strong>"
" be resumed at a certain point of the transfer. This was not possible."
msgstr ""
"ສິ່ງທີ່ຮ້ອງຂໍທີ່ລະບຸມາໄດ້"
"ຖາມຖືງການກັບມາທຳງານຕໍ່ຍັງ"
"ຈຸດທີ່ທຳການຮັບສົ່ງແຟ້ມ<strong>"
"%1</strong> ຄ້າງໄວ້ "
"ປາກົດວ່າບໍ່ສາມາດທຳງານໄດ້"

#: kio/kio/global.cpp:995
msgid "The protocol, or the server, may not support file resuming."
msgstr ""
"ໂປໂຕຄອນຫລືເຊີບເວີອາດຈະບໍ່"
"ສະນັບສະນຸນການທຳງານຄ້າງຢູ່"
"ກັບແຟ້ມ"

#: kio/kio/global.cpp:997
msgid "Retry the request without attempting to resume transfer."
msgstr ""
"ພະຍາຍາມເຮັດສິ່ງທີ່ຮ້ອງຂໍໃ"
"ຫມ່ໂດຍບໍ່ກັບມາທຳງານຕໍ່ໃນຈ"
"ຸດທີ່ຄ້າງໄວ້"

#: kio/kio/global.cpp:1002
msgid "Could Not Rename Resource"
msgstr ""
"ບໍ່ສາມາດປ່ຽນຊື່ສັບພະຍາກອນ"
"ໄດ້"

#: kio/kio/global.cpp:1003
msgid "An attempt to rename the specified resource <strong>%1</strong> failed."
msgstr ""
"ລົ້ມເຫລວໃນການພະຍາຍາມປ່ຽນຊ"
"ື່ສັບພະຍາກອນ <strong>%1</strong>"

#: kio/kio/global.cpp:1011
msgid "Could Not Alter Permissions of Resource"
msgstr ""
"ບໍ່ສາມາດປ່ຽນສິດທີອະນຸຍາດຂ"
"ອງສັບພະຍາກອນໄດ້"

#: kio/kio/global.cpp:1012
msgid ""
"An attempt to alter the permissions on the specified resource "
"<strong>%1</strong> failed."
msgstr ""
"ລົ້ມເຫລວໃນການປ່ຽນສິດທີ່ອະ"
"ນຸຍາດຂອງສັບພະຍາກອນ<strong>%1</strong> "
"ທີ່ກຳນົດ"

#: kio/kio/global.cpp:1019
msgid "Could Not Delete Resource"
msgstr "ບໍ່ສາມາດລືບສັບພະຍາກອນໄດ້"

#: kio/kio/global.cpp:1020
msgid "An attempt to delete the specified resource <strong>%1</strong> failed."
msgstr ""
"ລົ້ມເຫລວໃນການພະຍາຍາມລືບສັ"
"ບພະຍາກອນ <strong>%1</strong>"

#: kio/kio/global.cpp:1027
msgid "Unexpected Program Termination"
msgstr ""
"ກະລຸນາຈົບການທຳງານຢ່າງບໍ່ຄ"
"າດຄິດ"

#: kio/kio/global.cpp:1028
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has unexpectedly terminated."
msgstr ""
"ໂປຣແກຣມເທີງຄອມພິວເຕີຂອງທ່"
"ານຊື່ງມີການໃຊ້ງານໂປຣໂຕຄອນ<s"
"trong>%1</strong> "
"ຈົບການທຳງານຢ່າງບໍ່ຄາດຄິດ"

#: kab/addressbook.cc:420 kab/addressbook.cc:1068 kio/kio/global.cpp:1036
msgid "Out of Memory"
msgstr "ຫນ່ວຍຄວາມຈຳບໍ່ພງງພໍ"

#: kio/kio/global.cpp:1037
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol could not obtain the memory required to "
"continue."
msgstr ""
"ໂປຣແກຣມເທີງຄອມພິວເຕີຂອງທ່"
"ານຊື່ງການໃຊ້ງານໂປຣໂຕຄອນ "
"<strong>%1</strong> "
"ບໍ່ສາມາດທຳງານຕໍ່ໄດ້ເນື່ອງ"
"ຈາກໜວ່ຍຄວາມຈຳທີ່ຕ້ອງການໃຊ"
"້ມີບໍ່ພຽງພໍ"

#: kio/kio/global.cpp:1045
msgid "Unknown Proxy Host"
msgstr "ບໍ່ຮູ້ຈັກໂຫສພອກຊີ"

#: kio/kio/global.cpp:1046
msgid ""
"While retrieving information about the specified proxy host, "
"<strong>%1</strong>, an Unknown Host error was encountered. An unknown host "
"error indicates that the requested name could not be located on the Internet."
msgstr ""
"ລະຫວ່າງຮັບຂໍ້ມູນກຽ່ວກັບໂຫ"
"ສພອກຊີ <strong>%1</strong> "
"ທີ່ກຳນົດເກີດຄວາມຜິດພາດເນື"
"່ອງຈາກບໍ່ຮູ້ຈັກໂຫສຂື້ນຊື່"
"ງຫມາຍຖືງວ່າບໍ່ "
"ສາມາດຄົ້ນຫາໂຫສຊື່ັ່ດັ່ງກ່"
"າວຫລື "
"ໂຫສດັ່ງກາ່ວອາດຈະບໍ່ມີຢູ່ເ"
"ທີງອິນເຕີເນັດ"

#: kio/kio/global.cpp:1050
msgid ""
"There may have been a problem with your network configuration, specifically "
"your proxy's hostname. If you have been accessing the Internet with no "
"problems recently, this is unlikely."
msgstr ""
"ຫາກກ່ອນຫນ້ານີ້ທ່ານເຄີຍສາມ"
"າດເຂົ້າໃຊ້ງານອິນເຕີເນັດໄດ"
"້ນີ້ອາດຈະເປັນປັນຫາທີ່ເກີດ"
"ຈາກການ "
"ປບັແຕ່ງລະບົບເຄືອຂ່າຍຂອງທ່"
"ານໂດຍສະເພາະສ່ວນຊື່ໂຫສຂອງພ"
"ອກຊີ"

#: kio/kio/global.cpp:1054
msgid "Double-check your proxy settings and try again."
msgstr ""
"ໂປດກວດສອບການຕັ້ງຄ່າພອກຊີຂ"
"ອງທ່ານຢ່າງຮອບຄອບແລ້ວລອງໃຫ"
"ມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:1059
msgid "Authentication Failed: Method %1 Not Supported"
msgstr ""
"ການກວດສອບສິດລົ້ມເຫລວບໍ່ສະ"
"ນັບສະນຸນການກວດສອບก %1"

#: kio/kio/global.cpp:1061
#, c-format
msgid ""
"Although you may have supplied the correct authentication details, the "
"authentication failed because the method that the server is using is not "
"supported by the KDE program implementing the protocol %1."
msgstr ""
"ເຖີງວ່າທ່ານຈະໄດ້ຕື່ມສ່ວນລ"
"າຍລະອຽດຂອງການກວດສອບສິດໄວ້"
"ຢ່າງຖືກຕ້ອງແລ້ວກໍຕາມ "
"ແຕ່ກໍເກີດຄວາມຜິດພາດໃນການກ"
"ວດສອບສິດຂື້ນເນື່ອງຈາກວິທີ"
"ການທີ່ເຊີບເວີໃຊ້ບໍ່ໄດ້ຮັບ"
"ການສະນັບ "
"ສະນຸນໃຫ້ໃຊ້ຈາກໂປໂຕຄອນ  %1 "
"ຂອງໂປຣແກຣ KDE "

#: kio/kio/global.cpp:1065
msgid ""
"Please file a bug at <a "
"href=\"http://bugs.kde.org/\">http://bugs.kde.org/</a> to inform the KDE "
"team of the unsupported authentication method."
msgstr ""
"ກະລຸນາລາຍຄວາມຜິດພາດໄປທີ่ <a "
"href=\"http://bugs.kde.org/\">http://bugs.kde.org/</a> "
"ເພື່ອແຈ້ງໃຫ້ທີ່ມ KDE "
"ໄດ້ຮູ້ເຖີງວີທີ່ການກວດສອບສ"
"ິດທີ່ຍັງບໍ່ສະນັບສະນຸນ"

#: kio/kio/global.cpp:1071
msgid "Request Aborted"
msgstr ""
"ສິ່ງທີ່ຮ້ອງຂໍມາຖືກຍົກເລີກ"
"ແລ້ວ"

#: kio/kio/global.cpp:1078
msgid "Internal Error in Server"
msgstr "ເກີດຂໍ້ຜິດພາດພາຍໃນເຊີບເວີ"

#: kio/kio/global.cpp:1079
msgid ""
"The program on the server which provides access to the <strong>%1</strong> "
"protocol has reported an internal error: %0."
msgstr ""
"ໂປຣແກຣມເທີງເຊີບເວີຊື່ງຕ້ອ"
"ງການໃຊ້ງານໂປຣໂຕຄອນ <strong>%1</strong> "
"ໄດ້ລາຍງານຄວາມຜິດພາດພາຍໃນວ"
"່າ: %0"

#: kio/kio/global.cpp:1082
msgid ""
"This is most likely to be caused by a bug in the server program. Please "
"consider submitting a full bug report as detailed below."
msgstr ""
"ນີ້ເບີ່ງຄືກັບຈະເປັນປັນຫາທ"
"ີ່ເກີດຈາກຂໍ້ຜິດພາດຂອງໂປຣແ"
"ກຣມເຊີບເວີ "
"ກະລຸນາພິຈະລະນາສົ່ງລາຍລະອຽ"
"ດການເກີດຂໍ້ຜິດພາດທີ່ສົມບູ"
"ນດັງລາຍລະອຽດດ້ານລຸ່ມນີ້"

#: kio/kio/global.cpp:1085
msgid "Contact the administrator of the server to advise them of the problem."
msgstr ""
"ກະລຸນາຕິດຕໍ່ຜູ້ດູແລລະບົບຂ"
"ອງເຊີບເວີເພື່ອແຈ້ງໃຫ້ຮູ້ຖ"
"ືງປັນຫາທີ່ເກີດຂື້ນ"

#: kio/kio/global.cpp:1087
msgid ""
"If you know who the authors of the server software are, submit the bug "
"report directly to them."
msgstr ""
"ຫາກທ່ານຮູ້ວ່າ "
"ໃຜເປັນຜູ້ຂຽນໂປຣແກຣມເຊີບເວ"
"ີນີ້ "
"ໃຫ້ທຳການລາຍງານຄວາມຜິດພາດໄ"
"ປຍັງເຂົາໂດຍຕົງ"

#: kio/kio/global.cpp:1092
msgid "Timeout Error"
msgstr "ຂໍ້ຜິດພາດຈາກການຫມົດເວລາ"

#: kio/kio/global.cpp:1093
msgid ""
"Although contact was made with the server, a response was not received "
"within the amount of time allocated for the request as "
"follows:"
"<ul>"
"<li>Timeout for establishing a connection: %1 seconds</li>"
"<li>Timeout for receiving a response: %2 seconds</li>"
"<li>Timeout for accessing proxy servers: %3 seconds</li></ul>Please note "
"that you can alter these timeout settings in the KDE Control Center, by "
"selecting Network -> Preferences."
msgstr ""
"ແມ້ວ່າຈະມີການສ້າງການເຊື່ອ"
"ມຕໍ່ກັບເຊີບເວີແລ້ວ "
"ແຕ່ກໍບໍ່ໄດ້ຮັບການຕອບຮັບພາ"
"ຍໃນຊ່ວງເວລາທີ່ກຳນົດສຳລັບກ"
"ານຮ້ອງຂໍດັ່ງຕໍ່ໄປນີ້:"
"<ul>"
"<li>ໝົດເວລາໃນການເລີ່ມທຳການເຊ"
"ື່ອມຕໍ່: %1 "
"ວິນາທີ</li>"
"<li>"
"ໝົດເວລາໃນການຄອຍການຕອບຮັບ: %2 "
"ວິນາທີ</li>"
"<li>ໝົດເວລາໃນການເຂົ້າໃຊ້ງານເ"
"ຊີບເວີພອກຊີ: %3 วินาที</li></ul> "
"ເຄັດລັບ: "
"ທ່ານສາມາດຕັ້ງຄ່າຊວ່ງເວລາເ"
"ຫລົ່ານີ້ໄດ້ທີ ສູນຄວບຄຸມ KDE "
"ໂດຍເລືອກ ລະບົບເຄືອຂ່າຍ-> "
"ປັບແຕ່ງ"

#: kio/kio/global.cpp:1104
msgid "The server was too busy responding to other requests to respond."
msgstr ""
"ເຊີບເວີບໍ່ວ່າງທີ່ຈະຕອບກັບ"
"ມາຍັງສ່ວນທີ່ຣ້ອງຂໍເຂົ້່າມ"
"າ"

#: kio/kio/global.cpp:1110
msgid "Unknown Error"
msgstr "ຄວາມຜິດພາດທີ່ບໍ່ຮູ້ຈັກ"

#: kio/kio/global.cpp:1111
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has reported an unknown error: %2."
msgstr ""
"ໂປຣແກຣມຄອມພິວເຕີຂອງທ່ານຊື"
"່ງໃຊ້ງານໂປຣໂຕຄອນ <strong>%1</strong> "
"ໄດ້ເກີດຄວາມຜິດພາດທີ່ບໍຮູ້"
"ຈັກ: %2"

#: kio/kio/global.cpp:1119
msgid "Unknown Interruption"
msgstr ""
"ບໍ່ຮູ້ຈັກການອີນເຕີເນັດທີ່"
"ເກີດຂື້ນ"

#: kio/kio/global.cpp:1120
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has reported an interruption of an unknown "
"type: %2."
msgstr ""
"ໂປຣແກຣມເທີງອິນເຕີເນັດຂອງທ"
"່ານຊື່ງໃຊ້ງານໂປຣໂຕຄອນ "
"<strong>%1</strong> "
"ໄດ້ລາຍງານຄວາມຜິດພາດຂອງການ"
"ອິນເຕີລັບທີ່ບໍ່ຮູ້ຈັກ: %2"

#: kio/kio/global.cpp:1128
msgid "Could Not Delete Original File"
msgstr ""
"ບໍ່ສາມາດລືບແຟ້ມດັ່ງເດີມໄດ"
"้້"

#: kio/kio/global.cpp:1129
msgid ""
"The requested operation required the deleting of the original file, most "
"likely at the end of a file move operation. The original file "
"<strong>%1</strong> could not be deleted."
msgstr ""
"ປະຕິບັດການທີ່ຮ້ອງຂໍມາຕ້ອງ"
"ການຈະລືບແຟ້ມດັ່ງເດີມຄືກັບ"
"ເມືອສິ້ນສຸດການຍ້າຍແຟ້ມ "
"ແຕ່ບໍ່ສາມາດລືບແຟ້ມດັ່ງເດີ"
"ມ<strong>%1</strong> ໄດ້"

#: kio/kio/global.cpp:1138
msgid "Could Not Delete Temporary File"
msgstr ""
"ບໍ່ສາມາດລືບແຟ້ມຊົ່ວຄາວໄດ້"
"้"

#: kio/kio/global.cpp:1139
msgid ""
"The requested operation required the creation of a temporary file in which "
"to save the new file while being downloaded. This temporary file "
"<strong>%1</strong> could not be deleted."
msgstr ""
"ປະຕີບັດການທີ່ຣ້ອງຂໍມາຕ້ອງ"
"ການຈະລຶບແຟ້ມຊົ່ວຄາວເພື່ອບ"
"ັນທືກເປັນແຟ້ມໃຫມ່ເມືອ "
"ດາວໂລດແລ້ວແຕ່ບໍ່ສາມາດລືບແ"
"ຟ້ມຊົ່ວຄາວ <strong>%1</strong> ໄດ້"

#: kio/kio/global.cpp:1148
msgid "Could Not Rename Original File"
msgstr ""
"ບໍ່ສາມາດປ່ຽນຊື່ແຟ້ມດັ່ງເດ"
"ີມໄດ້"

#: kio/kio/global.cpp:1149
msgid ""
"The requested operation required the renaming of the original file "
"<strong>%1</strong>, however it could not be renamed."
msgstr ""
"ປະຕິບັດການທີ່ຮ້ອງຂໍມາຕ້ອງ"
"ການຈະປ່ຽນຊື່ແຟ້ມດັ່ງເກົ່າ<s"
"trong>%1</strong>"
"ແຕ່ບໍ່ສາມາດປ່ຽນຊື່ໄດ້แต่ไ"
"ม่สามารถเปลี่ยน"

#: kio/kio/global.cpp:1157
msgid "Could Not Rename Temporary File"
msgstr ""
"ບໍ່ສາມາດປ່ຽນຊື່ແຟ້ມຊົ່ວຄາ"
"ວໄດ້"

#: kio/kio/global.cpp:1158
msgid ""
"The requested operation required the creation of a temporary file "
"<strong>%1</strong>, however it could not be created."
msgstr ""
"ປະຕິບັດການທີ່ຣ້ອງຂໍມາຕ້ອງ"
"ການຈະສ້າງແຟ້ມຊົ່ວຄາວ<strong>"
"%1</strong>ແຕ່ບໍ່ສາມາດສ້າງໄດ้້"

#: kio/kio/global.cpp:1166
msgid "Could Not Create Link"
msgstr "ບໍ່ສາມາດສ້າງລີງໄດ້"

#: kio/kio/global.cpp:1167
msgid "Could Not Create Symbolic Link"
msgstr ""
"ບໍ່ສາມາດສ້າງລີງແບບສັນຍາລັ"
"ກໄດ້"

#: kio/kio/global.cpp:1168
msgid "The requested symbolic link %1 could not be created."
msgstr ""
"ບໍ່ສາມາດສ້າງລີງແບບສັນຍາລັ"
"ກ %1 ທີ່ຮ້ອງຂໍໄດ້"

#: kio/kio/global.cpp:1175
msgid "No Content"
msgstr "ເນື້ອຫາ"

#: kio/kio/global.cpp:1180
msgid "Disk Full"
msgstr "ດິສເຕັມ"

#: kio/kio/global.cpp:1181
msgid ""
"The requested file <strong>%1</strong> could not be written to as there is "
"inadequate disk space."
msgstr ""
"ບໍ່ສາມາດຂຽນໄປຍັງແຟ້ມ<strong>"
"%1</strong>"
"ຕາມຕ້ອງການໄດ້ເນື່ອງຈາກອາດ"
"ຈະຍັງບໍ່ມີສິດໃນ "
"ການຂ້າໃຊ້ແລະຂຽນໄປໄດ້"

#: kio/kio/global.cpp:1183
msgid ""
"Free up enough disk space by 1) deleting unwanted and temporary files; 2) "
"archiving files to removable media storage such as CD-Recordable discs; or "
"3) obtain more storage capacity."
msgstr ""
"Free up enough disk space by 1) deleting unwanted and temporary files; 2) "
"archiving files to removable media storage such as CD-Recordable discs; or "
"3) obtain more storage capacity."

#: kio/kio/global.cpp:1190
#, fuzzy
msgid "Source and Destination Files Identical"
msgstr ""
"ແຟ້ມຕົ້ນທາງແລະປາຍທາງເປັນແ"
"ຟ້ມດ່ຽວກັນ\n"
"%1"

#: kio/kio/global.cpp:1191
#, fuzzy
msgid ""
"The operation could not be completed because the source and destination "
