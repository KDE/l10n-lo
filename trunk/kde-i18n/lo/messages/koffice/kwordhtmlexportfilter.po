#: ExportDialog.cc:40
msgid "KWord's HTML Export Filter"
msgstr ""
"ຕົວກ່ອງສົ່ງອອກເປັນ HTML ສຳຫລັບ"
"KWord"

#: ExportFilter.cc:581
msgid "Untitled Document"
msgstr "ເອກະສານທີ່ຍັງບໍ່ມີຊື່"

#: rc.cpp:1
msgid "HTML Export Dialog"
msgstr "ກ່ອງສົ່ງອອກ HTML"

#: rc.cpp:2
msgid "Encoding"
msgstr "ຊຸດລະຫັດອັກຂະລະ"

#: rc.cpp:3
msgid "UTF-&8"
msgstr "UTF-&8"

#: rc.cpp:4
msgid "&Other encoding:"
msgstr "ຊຸດລະຫັດອັກຂະລະອື່ໆ:"

#: rc.cpp:5
msgid "&Local encoding"
msgstr "ຊຸດລະຫັດອັກຂະລະຂອງລະບົບ"

#: rc.cpp:6
msgid "Mode"
msgstr "ໂຫມດ"

#: rc.cpp:7
msgid "L&ight: Convert to strict (X)HTML"
msgstr "ງ່າຍ:ແປງເປັນ(X)HTML ຢ່າງງ່າຍ"

#: rc.cpp:8
msgid ""
"Convert mainly the document structure (Recommended for exporting to browsers "
"with limited capabilities)"
msgstr ""
"ແປງໃຫ້ມີໂຄງສ້າງຫລກໆຂອງເອກະສານ"
"(ແນະນຳໃຫ້ໃຊ້ສຳຫລັບສົ່ງອອກໄປຫາບລາວເຊີຣຸ່ນເກົ່າທີມີຄວາມສາມາດຈຳກັດ)"

#: rc.cpp:9
msgid "&Basic: Convert to transitional (X)HTML"
msgstr ""
"ພື້ນຖານ:ແປງເປັນ(X)HTML "
"ຂັ້ນພື້ນຖານ"

#: rc.cpp:10
msgid ""
"Convert most of the document (Recommended for re-importing in KWord or for "
"exporting to older browsers)"
msgstr ""
"ແປງໃຫ້ເປັນເອກະສານຂັ້ນພື້ນຖານ (ແນະນຳໃຫ້ໃຊ້ສຳຫລັບນຳເຂົ້າໄປຫາ "
"KWord ໃຫມ່ຫລືສົ່ງອອກໄປຫາບລາວເຊີຣຸ່ນເກົ່າ)"

#: rc.cpp:11
msgid "&Enhanced: Convert to (X)HTML with CSS"
msgstr ""
"ຂັ້ນກ້າວຫນ້າ:ແປງເປັນ(X)HTML "
"ໂດຍໃຊ້ CSS"

#: rc.cpp:12
msgid ""
"Convert as much as possible of the KWord document (Recommended for exporting "
"to other modern word processors or to modern browsers)"
msgstr ""
"ແປງໃຫ້ເປັນເອກະສານKWord "
"ໃຫ້ຫລາຍທີ່ສຸດເທົ່າທີ່ຈະເຮັດໄດ້ "
"(ແນະນຳໃຫ້ໃຊ້ສຳຫລັບສົ່ງອອກໄປຫາໂປລແກລມປະເມີນຜົນຄຳໃຫມ່ໆ ຫລືບລາວເຊີຣໃຫມ່ໆ ))"

#: rc.cpp:13
msgid "&Export information about author"
msgstr "ສົ່ງອອກຂໍ້ມູນກຽ່ວກັບຜູ້ຂຽນ"

#: rc.cpp:14
msgid "Document Type"
msgstr "ປະເພດເອກະສານ"

#: rc.cpp:15
msgid "&HTML 4.01"
msgstr "&HTML 4.01"

#: rc.cpp:16
msgid "HTML 4.01 (For older HTML user agents) "
msgstr ""
"HTML 4.01 (ສຳຫລັບບລາວເຊີຣ HTML "
"ລຸ່ນເກົ່າ) "

#: rc.cpp:17
msgid "&XHTML 1.0"
msgstr "&XHTML 1.0"

#: rc.cpp:18
msgid "XHTML 1.0"
msgstr "XHTML 1.0"

