#: ExportDialog.cc:38
msgid "KWord's Plain Text Export Filter"
msgstr "-ຕົວກ່ອງສົ່ອອກຂໍ້ຄວາມທຳມະດາຂອງ KWord"

#: ImportDialog.cc:35
msgid "KWord's Plain Text Import Filter"
msgstr "ໂຕກ່ອງນຳເຂົ້າຂໍ້ຄວາມທຳມະດາຂອງKWord"

#: rc.cpp:1
msgid "Plain Text Export Dialog"
msgstr "ກ່ອງສົ່ງອອກຂໍ້ຄວາມທຳມະດາ"

#: rc.cpp:2 rc.cpp:11
msgid "Encoding"
msgstr "ຊຸດລະຫັດອັກຂະລະ"

#: rc.cpp:3 rc.cpp:12
msgid "UTF-&8"
msgstr "UTF-&8"

#: rc.cpp:4 rc.cpp:13
msgid "&Local encoding"
msgstr "ຊຸດລະຫັດອັກຂະລະຂອງລະບົບ"

#: rc.cpp:5 rc.cpp:14
msgid "&Other encoding:"
msgstr "ຊຸດລະຫັດອັກຂະລະອື່ໆ:"

#: rc.cpp:6
msgid "End of Line"
msgstr "ຈົບເເຖວເເບບ"

#: rc.cpp:7
msgid "Line &feed only"
msgstr "ຂື້ນແຖວໃຫມ່ເທັ່ານັ້ນ"

#: rc.cpp:8
msgid "&Both: line feed and carriage return"
msgstr ""
"ທັງຄູ່:"
"ຂື້ແຖວໃຫມ່ແລະເຂ່ຍ"

#: rc.cpp:9
msgid "&Carriage return only"
msgstr "ປັດເຂ່ຍເທົ່ານັ້ນ"

#: rc.cpp:10
msgid "Plain Text Import Dialog"
msgstr "ກ່ອງນຳເຂົ້າຂໍ້ຄວາມທຳມະດາ"

#: rc.cpp:15
msgid "End of Paragraph"
msgstr "ຈົບຢໍ້ຫນາ້ແບບ"

#: rc.cpp:16
msgid "&As is: At the end of line"
msgstr ""
"&ຫາກ:"
"ຢູ່ທີ່ຕຳແຫນ່ງຈົບແຖວ"

#: rc.cpp:17
msgid "&Sentence: If the end of line is the end of a sentence"
msgstr ""
"&ປະໂຫຍກ:"
"ຫາກຈົບແຖວເປັນສ່ວນຈົບປະໂຫຍກ"

#: rc.cpp:18
msgid "Old &method: If the line is empty or has less than 40 characters"
msgstr "ວິທີເ&ກົ່າ:ຫາກແຖວວ່າງຫລືຫລາຍກວ່າ 40 ອັກຂະຫລະ"

