#: kocryptexport.cc:155 kocryptimport.cc:147
msgid "There was an internal error preparing the passphrase."
msgstr ""
"ມີການກະກຽມກຸ່ມຄໍາເວົ້າທີ່"
"ຜິດພາດຢູ່ພາຍໃນ"

#: kocryptexport.cc:156 kocryptexport.cc:171 kocryptexport.cc:266
msgid "Encrypted Document Export"
msgstr "ຂະບວນການສົ່ງເອກະສານອອກ"

#: kocryptexport.cc:170
msgid "There was an internal error preparing the cipher."
msgstr ""
"ມີການກະກຽມລະຫັດລັບຂອງຂໍ້ຜ"
"ິດພາດພາຍໃນ "

#: kocryptexport.cc:265
msgid "Internal error writing file. Please file a bug report."
msgstr ""
"ການຂຽນແຟ້ມຂໍ້ຜິດພາດພາຍໃນ "
"ໃຫ້ລາຍງານແຟ້ມແມງຕ່າງໆ"

#: kocryptimport.cc:148 kocryptimport.cc:160 kocryptimport.cc:178
#: kocryptimport.cc:192 kocryptimport.cc:206 kocryptimport.cc:327
msgid "Encrypted Document Import"
msgstr ""
"ຂະບວນການນໍາເອົາເອກະສານເຂົ"
"້າ"

#: kocryptimport.cc:159
msgid "There was an internal error in the cipher code."
msgstr ""
"ມີຂໍ້ຜິດພາດຢູ່ພາຍໃນລະຫັດລ"
"ັບ "

#: kocryptimport.cc:177
msgid "This is the wrong document type or the document is corrupt."
msgstr ""
"ນີ້ແມ່ນຊະນິດເອກະສານທີ່ຜິດ"
"ພາດ ຫລື ເອກະສານທີ່ເປື້ອນ "
"ຫລື ເຊື່ອມ"

#: kocryptimport.cc:191 kocryptimport.cc:205
msgid "I don't understand this version of the file format."
msgstr ""
"ຂ້ອຍບໍ່ສາມາດເຂົ້າໃຈບົດແປນ"
"ີ້ຂອງຮູບແບບແຟ້ມ"

#: kocryptimport.cc:326
msgid "This document is either corrupt or has been tampered with."
msgstr ""
"ເອກະສານນີ້ມັນເຊື່ອມເຊັ່ນດ"
"ຽວກັນ ຫລື ໄດ້ມີການເຊື່ອງ "
"ຫລື ຄວບຄຸມ"

#: pwdprompt.cc:50
msgid "Enter the passphrase for the document:"
msgstr ""
"ໃຫ້ກົດກຸ່ມຄໍາເວົ້າສໍາຫລັບ"
"ເອກະສານ"

#: pwdprompt.cc:52
msgid "Enter a passphrase for the document:"
msgstr ""
" ກົດ ຫນື່ງ "
"ກຸ່ມຄໍາເວົ້າສໍາຫລັບເອກະສາ"
"ນ:                                                   "
