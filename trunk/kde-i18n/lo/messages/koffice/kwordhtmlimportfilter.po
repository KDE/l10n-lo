#: rc.cpp:1
msgid "HTML Import Dialog"
msgstr "ກ້ອງນຳເຂົ້າ HTML"

#: rc.cpp:2
msgid "Character Set"
msgstr "ຊຸລະຫັດອັກຂະລະ"

#: rc.cpp:3
msgid "&Hint for character set:"
msgstr ""
"&ຂໍແນະນຳສຳລັບຊຸດລະຫັດັກຂະລ"
"ະ"

#: rc.cpp:4
msgid "&Hint"
msgstr "&ຂໍແະນຳ"

#: rc.cpp:5
msgid "Do &not use the hint (recommended)"
msgstr "ບໍ&ໃຫ້ຂໍແນະນຳ (ແນະນຳໃຫ້ໃຊ້!)"

#: rc.cpp:6
msgid "Use hint only as &fall back"
msgstr ""
"&ໃຊ້ຂໍແນະນຳເມື່ອຜີດພາດທໍນັ"
"້ນ"

#: rc.cpp:7
msgid "Force the use of the hint (for buggy files)"
msgstr ""
"ບັງຄົບໃຫ້ໃຊ້ຂໍແນະນຳ(ສຳລັບແ"
"ຟ້ມທີ່ມີຂໍ້ຜີດພາດ) "
