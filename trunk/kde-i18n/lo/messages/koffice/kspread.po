msgstr "ຈຳນວນເຊີງຊ້ອນ"

#: xml_doc.cc:457
msgid "The IMAGINARY(string) returns the imaginary coefficient of a complex."
msgstr ""
"The IMAGINARY(ຕົວອັກສອນ) "
"ສົ່ງຄ່າຕົວສຳປະສິດຈາກຄອມເປ"
"ັກ"

#: xml_doc.cc:458
msgid "IMAGINARY(string)"
msgstr "IMAGINARY(ຕົວອັກສອນ)"

#: xml_doc.cc:459
msgid "IMAGINARY(\"1.2+3.4i\") returns 3.4"
msgstr "IMAGINARY(\"1.2+3.4i\") ຈະໄ້ດ້ຄ່າ 3.4"

#: xml_doc.cc:460
msgid "IMAGINARY(\"1.2\") returns 0 "
msgstr "IMAGINARY(\"1.2\") ຈະໄດ້ຄ່າ 0 "

#: xml_doc.cc:462
msgid "The IMREAL(string) returns the real coefficient of a complex."
msgstr ""
"The IMREAL(ຕົວອັກສອນ) "
"ສົ່ງຄ່າສຳປະສິດຕົວແທ້ຈາກຄອ"
"ມເປັກ"

#: xml_doc.cc:463
msgid "IMREAL(string)"
msgstr "IMREAL(ຕົວອັກສອນ)"

#: xml_doc.cc:464
msgid "IMREAL(\"1.2+3.4i\") returns 1.2"
msgstr "IMREAL(\"1.2+3.4i\") ຈະໄດ້ຄ່າ 1.2"

#: xml_doc.cc:465
msgid "IMREAL(\"1.2i\") returns 0 "
msgstr "IMREAL(\"1.2i\") ຈະໄດ້ຄ່າ 0 "

#: xml_doc.cc:467
msgid "The IMCOS(string) returns the cosine of a complex number."
msgstr ""
"The IMCOS(ຕົວອັກສອນ) "
"ສົ່ງຄ່າໂກສຊິນ "
"ຈາກຄ່າຕົວເລກຄອມເປັກ"

#: xml_doc.cc:468
msgid "IMCOS(string)"
msgstr "IMCOS(ຕົວອັກສອນ)"

#: xml_doc.cc:469
msgid "IMCOS(\"1+i\") returns \"0.83373-0.988898i\""
msgstr "IMCOS(\"1+i\") ຈະໄດ້ຄ່າ \"0.83373-0.988898i\""

#: xml_doc.cc:470
msgid "IMCOS(\"12i\") returns 81 377.4 "
msgstr "IMCOS(\"12i\") ຈະໄດ້ຄ່າ 81 377.4 "

#: xml_doc.cc:472
msgid "The IMSIN(string) function returns the sine of a complex number."
msgstr ""
"The IMSIN(ຕົວອັກສອນ) "
"ສົ່ງຄ່າຊິນໃນຄອມເປັກຕົວເລກ"

#: xml_doc.cc:473
msgid "IMSIN(string)"
msgstr "IMSIN(ຕົວອັກສອນ)"

#: xml_doc.cc:474
msgid "IMSIN(\"1+i\") returns \"1.29846+0.634964i\""
msgstr "IMSIN(\"1+i\") ຈະໄດ້ຄ່າ \"1.29846+0.634964i\""

#: xml_doc.cc:475
msgid "IMSIN(\"1.2\") returns -0.536573 "
msgstr "IMSIN(\"1.2\") ຈະໄດ້ຄ່າ -0.536573 "

#: xml_doc.cc:477
msgid "The IMEXP(string) returns the exponential of a complex number."
msgstr ""
"The IMEXP(ຕົວອັກສອນ) "
"ສົ່ງຄ່າກັບໃນການຕັ້ງຄ່າຈາກ"
"ຕົວເລກຄອມເປັກ"

#: xml_doc.cc:478
msgid "IMEXP(string)"
msgstr "IMEXP(ຕົວອັກສອນ)"

#: xml_doc.cc:479
msgid "IMEXP(\"2-i\") returns \"3.99232-6.21768i\""
msgstr "IMEXP(\"2-i\") ຈະໄດ້ຄ່າ \"3.99232-6.21768i\""

#: xml_doc.cc:480
msgid "IMEXP(\"12i\") returns \"0.843854-0.536573i\" "
msgstr "IMEXP(\"12i\") ຈະໄດ້ຄ່າ \"0.843854-0.536573i\" "

#: xml_doc.cc:482
msgid "The IMLN(string) returns the natural logarithm of a complex number."
msgstr ""
"The IMLN(ຕົວອັກສອນ) "
"ກັບຄືນຄ່າທຳມະຊາດຈາກຕົວເລກ"
"ຄອມເປັກ"

#: xml_doc.cc:483
msgid "IMLN(string)"
msgstr "IMLN(ຕົວອັກສອນ)"

#: xml_doc.cc:484
msgid "IMLN(\"3-i\") returns \"1.15129-0.321751i\""
msgstr "IMLN(\"3-i\") ຈະໄດ້ຄ່າ \"1.15129-0.321751i\""

#: xml_doc.cc:485
msgid "IMLN(\"12\") returns 2.48491 "
msgstr "IMLN(\"12\") ຈະໄດ້ຄ່າ 2.48491 "

#: xml_doc.cc:487
msgid "The IMSQRT(string) returns the square root of a complex number."
msgstr ""
"The IMSQRT(ຕົວອັກສອນ) "
"ສົ່ງຄ່າຮາກຂັ້ນສອງຈາກຄອມເປ"
"ຣັກຕົວເລກ"

#: xml_doc.cc:488
msgid "IMSQRT(string)"
msgstr "IMSQRT(ຕົວອັກສອນ)"

#: xml_doc.cc:489
msgid "IMSQRT(\"1+i\") returns \"1.09868+0.45509i\""
msgstr "IMSQRT(\"1+i\") ຈະໄດ້ຄ່າ \"1.09868+0.45509i\""

#: xml_doc.cc:490
msgid "IMSQRT(\"1.2i\") returns \"0.774597+0.774597i\" "
msgstr "IMSQRT(\"1.2i\") ຈະໄດ້ຄ່າ \"0.774597+0.774597i\" "

#: xml_doc.cc:492
msgid "Power"
msgstr "ຍົກກຳລັງ"

#: xml_doc.cc:493
msgid "The IMPOWER(string) returns a complex number raised to a power."
msgstr ""
"The IMPOWER(ຕົວອັກສອນ) "
"ສົ່ງຄ່າຄອມເປັກຕົວເລກຂື້ນກ"
"ຳລັງ"

#: xml_doc.cc:494
msgid "IMPOWER(string)"
msgstr "IMPOWER(ຕົວອັກສອນ)"

#: xml_doc.cc:495
msgid "IMPOWER(\"4-i\";2) returns \"15-8i\""
msgstr "IMPOWER(\"4-i\";2) ຈະໄດ້ຄ່າ \"15-8i\""

#: xml_doc.cc:496
msgid "IMPOWER(\"1.2\";2) returns 1.44 "
msgstr "IMPOWER(\"1.2\";2) ຈະໄດ້ຄ່າ 1.44 "

#: xml_doc.cc:502
msgid "The IMSUM() returns the sum of several complex numbers of form x+yi."
msgstr ""
"The IMSUM() "
"ສົ່ງກັບການບວກຄອມເປຣັກຕົວເ"
"ລກທຳມະດາຈາກ x+yi."

#: xml_doc.cc:503
msgid "IMSUM(value;value;...)"
msgstr "IMSUM(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:504
msgid "IMSUM(1.2;\"3.4+5i\") returns \"4.6+5i\""
msgstr "IMSUM(1.2;\"3.4+5i\") ຈະໄດ້ຄ່າ\"4.6+5i\""

#: xml_doc.cc:505
msgid "IMSUM(1.2;\"1i\") returns \"1.2+i\""
msgstr "IMSUM(1.2;\"1i\") ຈະໄດ້ຄ່າ \"1.2+i\""

#: xml_doc.cc:511
msgid "The IMDIV() returns the division of several complex numbers of form x+yi."
msgstr ""
"The IMDIV() "
"ສົ່ງກັບການລົບຄອມເປຣັກຕົວເ"
"ລກທຳມະດາຈາກ x+yi."

#: xml_doc.cc:512
msgid "IMDIV(value;value;...)"
msgstr "IMDIV(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:513
msgid "IMDIV(1.2;\"3.4+5i\") returns \"0.111597-0.164114i\""
msgstr "IMDIV(1.2;\"3.4+5i\") ຈະໄດ້ຄ່າ \"0.111597-0.164114i\""

#: xml_doc.cc:514
msgid "IMDIV(\"12+i\";\"12-i\") returns \"0.986207+0.16551i\""
msgstr "IMDIV(\"12+i\";\"12-i\") ຈະໄດ້ຄ່າ \"0.986207+0.16551i\""

#: xml_doc.cc:520
msgid "The IMSUB() returns the difference of several complex numbers of form x+yi."
msgstr ""
"The IMSUB() "
"ສົ່ງກັບການແຕກຕ່າງຄອມເປຣັກ"
"ຕົວເລກທຳມະດາຈາກ x+yi."

#: xml_doc.cc:521
msgid "IMSUB(value;value;...)"
msgstr "IMSUB(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:522
msgid "IMSUB(1.2;\"3.4+5i\") returns \"-2.2-5i\""
msgstr "IMSUB(1.2;\"3.4+5i\") ຈະໄດ້ຄ່າ \"-2.2-5i\""

#: xml_doc.cc:523
msgid "IMSUB(1.2;\"1i\") returns \"1.2-i\""
msgstr "IMSUB(1.2;\"1i\") ຈະໄດ້ຄ່າ \"1.2-i\""

#: xml_doc.cc:529
msgid "The IMPRODUCT() returns the product of several complex numbers of form x+yi."
msgstr ""
"The IMPRODUCT() "
"ສົ່ງກັບຄອມເປຣັກຕົວເລກທຳມະ"
"ດາຈາກ x+yi."

#: xml_doc.cc:530
msgid "IMPRODUCT(value;value;...)"
msgstr "IMPRODUCT(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:531
msgid "IMPRODUCT(1.2;\"3.4+5i\") returns \"4.08+6i\""
msgstr "IMPRODUCT(1.2;\"3.4+5i\") ຈະໄດ້ຄ່າ \"4.08+6i\""

#: xml_doc.cc:532
msgid "IMPRODUCT(1.2;\"1i\") returns \"+1.2i\""
msgstr "IMPRODUCT(1.2;\"1i\") ຈະໄດ້ຄ່າ \"+1.2i\""

#: xml_doc.cc:534
msgid ""
"The IMCONJUGATE(complex number) returns the conjugate of a complex number of "
"form x+yi."
msgstr ""
"The IMCONJUGATE(ຕົວເລກຄອມເປຣັກ) "
"ສົ່ງກັບໄວຍາກອນຂອງຄອມເປຣັກ"
"ຕົວເລກທຳມະດາຈາກ x+yi."

#: xml_doc.cc:535
msgid "IMCONJUGATE(complex number)"
msgstr "IMCONJUGATE(ຈຳນວນເຊີງຊ້ອນ)"

#: xml_doc.cc:536
msgid "IMCONJUGATE(\"1.2+5i\") returns \"1.2-5i\""
msgstr "IMCONJUGATE(\"1.2+5i\") ຈະໄດ້ຄ່າ \"1.2-5i\""

#: xml_doc.cc:537
msgid "IMCONJUGATE(\"-i\") returns \"i\""
msgstr "IMCONJUGATE(\"-i\") ຈະໄດ້ຄ່າ \"i\""

#: xml_doc.cc:538
msgid "IMCONJUGATE(\"12\") returns \"12\""
msgstr "IMCONJUGATE(\"12\") ຈະໄດ້ຄ່າ \"12\""

#: xml_doc.cc:540
msgid ""
"The IMARGUMENT(complex number) returns the argument of a complex number of "
"form x+yi."
msgstr ""
"The IMARGUMENT(ຕົວເລກຄອມເປຣັກ) "
"ສົ່ງກັບໂຕໂຕ້ກັບຂອງຄອມເປຣັ"
"ກຕົວເລກທຳມະດາຈາກ x+yi."

#: xml_doc.cc:541
msgid "IMARGUMENT(complex number)"
msgstr "IMARGUMENT(ຈຳນວນເຊີງຊ້ອນ)"

#: xml_doc.cc:542
msgid "IMARGUMENT(\"1.2+5i\") returns 0.6072"
msgstr "IMARGUMENT(\"1.2+5i\") ຈະໄດ້ຄ່າ 0.6072"

#: xml_doc.cc:543
msgid "IMARGUMENT(\"-i\") returns -1.57079633 "
msgstr "IMARGUMENT(\"-i\") ຈະໄດ້ຄ່າ -1.57079633 "

#: xml_doc.cc:544
msgid "IMARGUMENT(\"12\") returns \"#Div/0\""
msgstr "IMARGUMENT(\"12\") ຈະໄດ້ຄ່າ \"#Div/0\""

#: xml_doc.cc:546
msgid "The IMABS(complex number) returns the norm of a complex number of form x+yi."
msgstr ""
"The IMABS(ຕົວເລກຄອມເປຣັກ) "
"ສົ່ງກັບຫັລກເກນຂອງຄອມເປຣັກ"
"ຕົວເລກທຳມະດາຈາກ x+yi."

#: xml_doc.cc:547
msgid "IMABS(complex number)"
msgstr "IMABS(ຈຳນວນເຊີງຊ້ອນ)"

#: xml_doc.cc:548
msgid "IMABS(\"1.2+5i\") returns 5.1419"
msgstr "IMABS(\"1.2+5i\") ຈະໄດ້ຄ່າ 5.1419"

#: xml_doc.cc:549
msgid "IMABS(\"-i\") returns 1"
msgstr "IMABS(\"-i\") ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:550
msgid "IMABS(\"12\") returns 12"
msgstr "IMABS(\"12\") ຈະໄດ້ຄ່າ 12"

#: xml_doc.cc:551 xml_doc.cc:552 xml_doc.cc:558 xml_doc.cc:559 xml_doc.cc:971
#: xml_doc.cc:972 xml_doc.cc:977 xml_doc.cc:982 xml_doc.cc:988 xml_doc.cc:993
#: xml_doc.cc:994 xml_doc.cc:999 xml_doc.cc:1005 xml_doc.cc:1199
#: xml_doc.cc:1205 xml_doc.cc:1214 xml_doc.cc:1221
msgid "Floating point value"
msgstr "ຄ່າຈຳນວນທົດສະນິຍົມ"

#: xml_doc.cc:553
msgid ""
"The DELTA() function returns 1 if x equals y, otherwise returns 0. y "
"defaults to 0."
msgstr ""
"ຟັງຊັ້ນ DELTA() ຈະຄືນຄ່າເປັນ 1 "
"ຫາກຄ່າ x ມີຄ່າເທົ່າກັບ y "
"ບໍ່ເຊັ່ນນັ້ນຈະຄືນຄ່າເປັນ 0"

#: xml_doc.cc:554
msgid "DELTA(x; y)"
msgstr "DELTA(x; y)"

#: xml_doc.cc:555
msgid "DELTA(1.2; 3.4) returns 0"
msgstr "DELTA(1.2;3.4) ຈະໄດ້ຄ່າ 0"

#: xml_doc.cc:556
msgid "DELTA(3; 3) returns 1"
msgstr "DELTA(3;3) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:557
msgid "DELTA(1; TRUE) returns 1"
msgstr "DELTA(3;3) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:560
msgid ""
"The GESTEP() function returns 1 if x greater or equals y, otherwise returns "
"0. y defaults to 0."
msgstr ""
"ຟັງຊັ້ນ DELTA() ຈະຄືນຄ່າເປັນ 1 "
"ຫາກຄ່າ x ມີຄ່າເທົ່າກັບ y "
"ບໍ່ເຊັ່ນນັ້ນຈະຄືນຄ່າເເປັນ 0"

#: xml_doc.cc:561
msgid "GESTEP(x; y)"
msgstr "GESTEP(x; y)"

#: xml_doc.cc:562
msgid "GESTEP(1.2; 3.4) returns 0"
msgstr "DELTA(1.2;3.4) ຈະໄດ້ຄ່າ 0"

#: xml_doc.cc:563
msgid "GESTEP(3; 3) returns 1"
msgstr "DELTA(3;3) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:564
msgid "GESTEP(0.4; TRUE) returns 0"
msgstr "MAX(12.5;2) ຈະໄດ້ຄ່າ 12.5"

#: xml_doc.cc:565
msgid "GESTEP(4; 3) returns 1"
msgstr "GESTEP(4; 3) ຈະໄດ້ 1"

#: xml_doc.cc:566
msgid "Financial"
msgstr "ການເງິນ"

#: xml_doc.cc:567 xml_doc.cc:575 xml_doc.cc:581 xml_doc.cc:587 xml_doc.cc:595
#: xml_doc.cc:604 xml_doc.cc:611 xml_doc.cc:619 xml_doc.cc:637
msgid "Settlement"
msgstr "ກັນຍາ"

#: xml_doc.cc:568 xml_doc.cc:576 xml_doc.cc:582 xml_doc.cc:588 xml_doc.cc:612
#: xml_doc.cc:620 xml_doc.cc:638
msgid "Maturity"
msgstr "ຄວາມຈະເລີນ"

#: xml_doc.cc:569 xml_doc.cc:613
msgid "Investment"
msgstr "ອອ້ມ"

#: xml_doc.cc:570 xml_doc.cc:577 xml_doc.cc:583
msgid "Discount rate"
msgstr "ອັດຕາຂອງເລກທີ່ບໍ່ໄດ້ນັບ"

#: xml_doc.cc:571
msgid "Basis"
msgstr "ເລກຖານ"

#: xml_doc.cc:572
msgid ""
"The RECEIVED function returns the amount received at the maturity date for a "
"invested security. Basis is the type of day counting you want to use: 0: US "
"30/360 (default), 1: real days, 2: real days/360, 3: real days/365 or 4: "
"European 30/365. The settlement date must be before maturity date."
msgstr ""
"The RECEIVED "
"ຟັງຊັ້ນນີ້ຈະສົ່ງຄ່າລະຫວ່າ"
"ງການຮັບໃນມື້ທີ່ກຳນົດຂອງ "
"ການປ້ອງການ . "
"ພື້ນຖານແມ່ນພິມມື້ທີ່ນັບຕາ"
"ມທີ່ເຈົ້າຕ້ອງການ 0: US 30/360 (default), 1: "
"ມື້ຈິງ, 2: ມື້ຈິງ/360, 3: ມື້ຈິງ/365 or "
"4: ຍູໂລບ 30/365. "
"ຕັ້ງມື້ໄວ້ນັ້ນຕ້ອງແມ່ນເຖີ"
"່ງທີ່ກຳນົດ."

#: xml_doc.cc:573
msgid "RECEIVED(settlement; maturity; investment; discount; basis)"
msgstr ""
"RECEIVED(ການແກ້ປັນຫາ; ຄວາມສົມບູນ; "
"ຈຳນວນ; ບໍ່ນັບ; ສ່ວນສຳຄັນ)"

#: xml_doc.cc:574
msgid "RECEIVED(\"2/28/2001\"; \"8/31/2001\"; 1000; 0.05; 0)returns 1,025.787"
msgstr "DAYS(\"2002-02-22\"; \"2002-02-26\") ຈະໄດ້ຄ່າ 4"

#: xml_doc.cc:578
msgid ""
"The TBILLEQ functions returns the bond equivalent for a treasury bill. The "
"maturity date must be after the settlement date but within 365 days."
msgstr ""
"The TBILLEQ ສົ່ງຄ່າເລຍ "
"ມື້ທີ່ກັບນົດ ແມ່ນຕ້ອງ 365 ມື້"

#: xml_doc.cc:579
msgid "TBILLEQ(settlement; maturity; discount)"
msgstr ""
"TBILLEQ(ການແກ້ປັນຫາ; "
"ຄວາມສົມບູນ.ບໍ່ນັບ;)"

#: xml_doc.cc:580
msgid "TBILLEQ(\"2/28/2001\"; \"8/31/2001\"; 0.1) returns 0.1068"
msgstr "TBILLEQ(\"2/28/2001\"; \"8/31/2001\"; 0.1) returns 0.1068"

#: xml_doc.cc:584
msgid ""
