#: xml_doc.cc:768
msgid "LEVEL_COUPON(face value;rate;years)"
msgstr ""
"LEVEL_COUPON(ລາຄາທີ່ກຳນົດໄວ້;ອັດຕາ;"
"ປີ)"

#: xml_doc.cc:769
msgid "LEVEL_COUPON(1000;.13;2;4;.1) equals 1096.95"
msgstr "LEVEL_COUPON(1000;.13;2;4;.1) ເທົ່າກັບ 1096.95"

#: xml_doc.cc:770 xml_doc.cc:776 xml_doc.cc:783 xml_doc.cc:791
msgid "Cost"
msgstr "ລາຄາ"

#: xml_doc.cc:771 xml_doc.cc:777 xml_doc.cc:784 xml_doc.cc:792
msgid "Salvage"
msgstr "ເງີນຊົດເຊີຍ"

#: xml_doc.cc:772 xml_doc.cc:778 xml_doc.cc:785 xml_doc.cc:793
msgid "Life"
msgstr "ການຄອງຊີບ"

#: xml_doc.cc:773
msgid ""
"The SLN() function will determine the straight line depreciation of an asset "
"for a single period. Cost is the amount you paid for the asset. Salvage is "
"the value of the asset at the end of the period. Life is the number of "
"periods over which the asset is depreciated. SLN divides the cost evenly "
"over the life of an asset."
msgstr ""
"ໜ້າທີ່ຂອງ SLN() "
"ຈະຊອກຫາເສັ້ນສະແດງຂອງການເສ"
"ື່ອມລາຄາຂອງຊັບ "
"ສິນໃນບັນຊີງົບດູນທີ່ຢູ່ໃນຊ"
"່ວງເວລາຂອງລາຄາແມ່ນຈຳນວນເງ"
"ີນທີ່ທ່ານຈ່າຍ "
"ຊົດເຊີຍໃນສັບສິນບັນຊີງົບດູ"
"ນນັ້ນເອງເຊິ່ງເປັນຄ່າໃນຊ່ວ"
"ງເວລາສຸດທ້າຍແລະ "
"ຕົວເລກຂອງມັນກວມເອົາໃນຊ່ວງ"
"ເວລາຂອງການເສື່ອມຫຼຸດລາຄາໃ"
"ນສັບສິນ ບັນຊີງົບດູນ "
"SLNຫານໃຫ້ລາຄາຂອງຸກຊ່ວງເຫດກາ"
"ນ."

#: xml_doc.cc:774
msgid "SLN(cost; salvage value; life)"
msgstr ""
"SLN(ລາຄາ;ເງີນຊົດເຊີຍ;ການຄອງຊີ"
"ບ)"

#: xml_doc.cc:775
msgid "SLN(10000;700;10) equals 930"
msgstr "SLN(10000;700;10) ມີຄ່າເທົ່າກັບ 930"

#: xml_doc.cc:780
msgid ""
"The SYD() function will calculate the sum-of-years digits depreciation for "
"an asset based on its cost, salvage value, anticipated life, and a "
"particular period. This method accelerates the rate of the depreciation, so "
"that more depreciation expense occurs in earlier periods than in later ones. "
"The depreciable cost is the actual cost minus the salvage value. The useful "
"life is the number of periods (typically years) over which the asset is "
"depreciated."
msgstr ""
"ໜ້າທີ່ຂອງ "
"SYD()ແມ່ນຄຳນວນຫາຜົນລວມຈຳນວນປີ"
"ຖ້ວນໃນການເສື່ອມ "
"ລຸດລາຄາບັນຊີຊັບສັບສິນທີ່ມ"
"ີຄ່ານ້ອຍ,ຄ່າເງີນຊົດເຊີຍ,ການ"
"ຄາດຄະເນການ "
"ຄອງຊີບ,ແລະໂດຍສະເພາະໃນຊ່ວງເ"
"ວລາໃດໜື່ງ.ນີ້ແມ່ນວິທີການທີ"
"່ເຮັດໃຫ້ "
"ອັດຕາການເສື່ອມຫຼຸດລາຄາມີກ"
"ານເພີ່ມຂື້ນຢ່າງໄວ, "
"ດັ່ງນັ້ນຖ້າຍິ່ງມີການ "
"ລຸດລາຄາການຈ່າຍໄວໂພດຈະເຮັດ"
"ໃຫ້ມັນບວກກັບຄ່າເງີນຊົດເຊີ"
"ຍ. "
"ເຊີ່ງຕົວເລກໃນສັບສິນບັນຊີງ"
"ົດດູນຈະເປັນັະໂຫຍດຕໍ່ການຄອ"
"ງຊີບ.  "

#: xml_doc.cc:781
msgid "SYD(cost; salvage value; life; period)"
msgstr ""
"SYD(ລລາຄາ; ເງີນຊດເຊີຍ; "
"ການຄອງຊີບ; ຊ່ວງເວລາ)"

#: xml_doc.cc:782
msgid "SYD(5000; 200; 5; 2) equals 1280"
msgstr "SYD(5000; 200; 5; 2) ມີຄ່າເທົ່າກັບ 1280"

#: xml_doc.cc:787
msgid "Factor"
msgstr "ເສດສ່ວນ"

#: xml_doc.cc:788
msgid ""
"The DDB() function calculates the depreciation of an asset for a given "
"period using the arithmetic-declining method. The factor is optional, if "
"omitted it is assumed to be 2. All the parameter must be greater than zero."
msgstr ""
"ໜ້າທີ່ຂອງ "
"DDB()ແມ່ນຄຳນວນຫາຄ່າສ່ວນລົດໃນສ"
"ັບສິສບັນຊີງົບດູນ "
"ໂດຍນຳໃຊ້ການຄິດໄລ່ທາງຄະນິດ"
"ສາດເຂົ້າມາຊ່ວຍ.ແລະຖ້າໃນກໍລ"
"ະນີທີ່ "
"ເປັນເລກເສດສ່ວນມັນຈະສົມມຸດ"
"ເປັນ2.ແລະຂອບເຂດທັງໝົດຈະໃຫຍ່"
"ກວ່າ0."

#: xml_doc.cc:789
msgid "DDB(cost; salvage value; life; period [;factor])"
msgstr ""
"DDB(ລາຄາ; ຄ່າເງີນຊົດເຊີຍ; "
"ຄ່າຄອງຊີບ; ຊ່ວງເວລາ "
"[;ເສດສ່ວນ])"

#: xml_doc.cc:790
msgid "DDB(75000;1;60;12;2) returns 1721.81"
msgstr "DB(8000;400;6;3;2) ມີຄ່າເທົ່າກັບ 1783.41"

#: xml_doc.cc:796
msgid ""
"The DB() function will calculate the depreciation of an asset for a given "
"period using the fixed-declining balance method. Month is optional, if "
"omitted it is assumed to be 12."
msgstr ""
"ໜ້າທີ່ຂອງ DB() "
"ແມ່ນຄຳນວນຫາສ່ວນລົດໃນສັບສິ"
"ນບັນຊີງົບດູນ "
"ໂດຍນຳໃຊ້ການແກ້ໄຂການຊັ່ງຊາ."
"ຕົວເລືອກທີ່ເປັນເດືອນມັນຈະ"
"ສົມມຸດ ໃຫ້ເປັນ12."

#: xml_doc.cc:797
msgid "DB(cost; salvage value; life; period [;month])"
msgstr ""
"DB(ລາຄາ; ຄ່າເງີນຊົດເຊີຍ; "
"ຄ່າຄອງຊີບ; ຊ່ວງເວລາ [;ເດືອນ])"

#: xml_doc.cc:798
msgid "DB(8000;400;6;3) equals 1158.40"
msgstr "DB(8000;400;6;3)  ມີຄ່າເທົ່າກັບ 1158.40"

#: xml_doc.cc:799
msgid "DB(8000;400;6;3;2) equals 1783.41"
msgstr "DB(8000;400;6;3;2) ມີຄ່າເທົ່າກັບ 1783.41"

#: xml_doc.cc:801
msgid ""
"The EURO() function converts one Euro to a given national currency in the "
"European monetary union. Currency is one of the following:ATS (Austria), BEF "
"(Belgium), DEM (Germany), ESP (Spain), FIM (Finland), FRF (France), GRD "
"(Greece), IEP (Ireland), ITL (Italy), LUF (Luxembourg), NLG (Netherlands), "
"or PTE (Portugal).  "
msgstr ""
"ໜ້າທີ່ຂອງ "
"EURO()ແມ່ນປ່ຽນແປງເງີນເອີໂຣເຊີ"
"່ງເງີນຕາພາຍໄນໃນສະຫະ "
"ພາບເອີໂຣ. "
"ເງີນຕາແມ່ນໜື່ງໃນຂໍ້ກຳນົດຮ"
"່ວມກັນລະຫວ່າງ:ATS(ອົດສະຕາລີ),  "
"BEF(ເບລຢຽມ), DEM (ເຢຍລະມັນ), ESP "
"(ສະເປນ), FIM  (ຟິນແລນ), FRF (ຝຣັ່ງ), "
"GRD(ເກລັກ), IEP (ໄອແລນ), ITL (ອີຕາລີ), LUF "
"(ລຸກຊຳບວກ), NLG (ເນເທີແລນ),ຫຼື  PTE "
"(ປອກຕຸຍການ)"

#: xml_doc.cc:802
msgid "EURO(currency)"
msgstr "EURO(ເງິນຕາ)"

#: xml_doc.cc:803
msgid "EURO(\"DEM\") equals 1.95583"
msgstr "EURO(\"DEM\") ມີຄ່າເທົ່າກັບ 1.95583"

#: xml_doc.cc:806
msgid ""
"The N() function converts a value to a number. If value is or refers to a "
"number, this function returns the number. If value is True, this function "
"returns 1. If a value is a date, this function returns the serial number of "
"that date. Anything else will cause the function to return 0."
msgstr ""
"ໜ້າທີ່ຂອງ "
"N()ແມ່ນແປງຄ່າຂອງຕວເລກ.ຖ້າແມ່"
"ນການໃຫ້ຄ່າຫຼືອ້າງອິງ "
"ເຖິງຕົວເລກມັນກໍ່ຈະໃຫ້ຄ່າເ"
"ປັນຕົວເລກ.ຖ້າໃຫ້ຄ່າຖືກມັນກ"
"ໍ່ຈະໄດ້ຄ່າເປັນ1 . "
"ຖ້າຄ່າແມ່ນວັນທີ,ມັນກໍ່ຈະໄດ"
"້ຄ່າທີ່ເປັນຕົວເລກລຽນຂອງວັ"
"ນທີ.ສ່ວນໂຕອື່ນ "
"ຈະໃຫ້ຄ່າເປັນເລກລຽງ."

#: xml_doc.cc:807
msgid "N(value)"
msgstr "N(ຄ່າ)"

#: xml_doc.cc:808
msgid "N(3.14) returns 3.14"
msgstr "N(3.14) ຈະໄດ້ຄ່າ 3.14"

#: xml_doc.cc:809
msgid "N(\"7\") returns 0 (because \"7\" is text)"
msgstr ""
"N(\"7\") ຈະໄດ້ຄ່າ 0 (ເນື່ອງຈາກ\"7\" "
"ເປັນຂໍ້ຄວາມ)"

#: xml_doc.cc:810
msgid "Type of information"
msgstr "ຊະນິດຂອງຂໍ້ມູນ"

#: xml_doc.cc:811
msgid ""
"The INFO() function returns information about the current operating "
"environment. Parameter type specifies what type of information you want to "
"return. It is one of the following: \"directory\" returns the path of the "
"current directory, \"numfile\" returns the number of active documents, "
"\"release\" returns the version of KSpread as text, \"recalc\" returns the "
"current recalculation mode: \"Automatic\" or \"Manual\", \"system\" returns "
"the name of the operating environment, \"osversion\" returns the current "
"operating system."
msgstr ""
"ໜ້າທີ່ຂອງ "
"INFO()ແມ່ນຈະໃຫ້ຂໍ້ມູນຂອງການໝູ"
"ນວຽນເງີນຕາ. "
"ຊະນິດຂອບເຂດແມ່ນຂໍ້ມູນທີ່ທ"
"່ານຕ້ອງການຈະໃຫ້ເປັນ, "
"ເຊີ່ງແມ່ນຂໍ້ມູນ "
"ດັ່ງຂ້າງລຸ່ມນີ້:\"directory\"ແມ່ນຈະ"
"ໃຫ້ຄ່າເລັກນ້ອຍຂອງການ "
"ຮັກສາເງີນຕາ,\"numfile\"ແມ່ນຕົວເລກ"
"ຂອງເອກະສານການ "
"ເຮັດວຽກ,\"release\"ແມ່ນໃຫ້ແບບຂອງKSpre"
"adດັ່ງໃນຂໍ້ຄວາມ ,\"recalc\" "
"ໃຫ້ແບບການຄິດໄລ່ເງີນຕາຄຶນ: "
"\"Automatic\" ຫຼື\"Manual\", \"system\" "
"ໃຫ້ຊື່ຂອງສະພາບເວດລ້ອມ "
"ຂອງການທຳງານ, \"osversion\"ໃຫ້ເງີນຕາ"

#: xml_doc.cc:812
msgid "INFO(type)"
msgstr "INFO(ຊະນິດ)"

#: xml_doc.cc:813 xml_doc.cc:818 xml_doc.cc:823 xml_doc.cc:828 xml_doc.cc:833
#: xml_doc.cc:838 xml_doc.cc:843 xml_doc.cc:848 xml_doc.cc:853 xml_doc.cc:858
#: xml_doc.cc:863
msgid "Any value"
msgstr "ຄ່າໃດຯ"

#: xml_doc.cc:814
msgid ""
"The ISLOGICAL() function returns True if the parameter is a boolean value. "
"Otherwise it returns False."
msgstr ""
"ໜ້າທີ່ຂອງ "
"ISLOGICAL()ແມ່ນຈະຖືກຖ້າຂອບເຂດແມ່ນ"
"ຄ່າຂອງບູລິນ "
"ອີກຢ່າງໜື່ງມັນກໍ່ຈະໃຫ້ຄ່າ"
"ຜິດ"

#: xml_doc.cc:815
msgid "ISLOGICAL(x)"
msgstr "ISLOGICAL(x)"

#: xml_doc.cc:816
msgid "ISLOGICAL(A1>A2) returns True"
msgstr "ISLOGICAL(A1>A2) ຈະໄດ້ຄ່າ True"

#: xml_doc.cc:817
msgid "ISLOGICAL(12) returns False"
msgstr "ISLOGICAL(12) ຈະໄດ້ຄ່າ False"

#: xml_doc.cc:819
msgid ""
"The ISBLANK() function returns True if the parameter is empty. Otherwise it "
"returns False."
msgstr ""
"ໜ້າທີ່ຂອງ "
"ISBLNK()ແມ່ນຈະໃຫ້ຄ່າຖືກຖ້າຂອບເຂ"
"ດຫວາງເປົ່າ. "
"ອີກຢ່າງໜື່ງມັນກໍ່ຈະໃຫ້ຄ່າ"
"ຜິດ"

#: xml_doc.cc:820
msgid "ISBLANK(x)"
msgstr "ISBLANK(x)"

#: xml_doc.cc:821
msgid "ISBLANK(A1) returns True if A1 is empty"
msgstr ""
"ISBLANK(A1) ຈະໃຫ້ຄ່າTrue ຖ້າ A1 "
"ຫວ່າງເປົ່າ"

#: xml_doc.cc:822
msgid "ISBLANK(A1) returns False if A1 holds a value"
msgstr ""
"ISBLANK(A1) ຈະໃຫ້ຄ່າ False ຖ້າA1 "
"ແມ່ນມີການຖືຄ່າ"

#: xml_doc.cc:824
msgid ""
"The ISNUMBER() function returns True if the parameter is a numerical value. "
"Otherwise it returns False."
msgstr ""
"ຟັງຊັ້ນ EXACT() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າ True "
"ຫາກຂໍ້ຄວາມທັງສອງຕົວເທົ່າກ"
"ັນ "
"ບໍ່ເຊັ່ນນັ້ນກໍຈະຄືນຄ່າມາເ"
"ປັນ False"

#: xml_doc.cc:825
msgid "ISNUMBER(x)"
msgstr "ISNUMBER(x)"

#: xml_doc.cc:826
msgid "ISNUMBER(12) returns True"
msgstr "ISLOGICAL(A1>A2) ຈະໄດ້ຄ່າ True"

#: xml_doc.cc:827
msgid "ISNUMBER(hello) returns False"
msgstr "ISTIME(\"ສະບາຍດີ\") ຈະໄດ້ຄ່າ False"

#: xml_doc.cc:829
msgid ""
"The ISTIME() function returns True if the parameter is a time value. "
"Otherwise it returns False."
msgstr ""
"ໜ້າທີ່ຂອງ "
"ISTME()ແມ່ນຈະໃຫ້ຄ່າຖືກຖ້າຂອບເຂ"
"ດແມ່ນຄ່າຂອງເວລາ.ອີກຢ່າງໜື່"
"ງມັນກໍ່ຈະໃຫ້ຄ່າຜິດ"

#: xml_doc.cc:830
msgid "ISTIME(x)"
msgstr "ISTIME(x)"

#: xml_doc.cc:831
msgid "ISTIME(\"12:05\") returns True"
msgstr "ISTIME(\"12:05\") ສົ່ງຄ່າກັບຄືນ"

#: xml_doc.cc:832
msgid "ISTIME(\"hello\") returns False"
msgstr "ISTIME(\"ສະບາຍດີ\") ຈະໄດ້ຄ່າ False"

#: xml_doc.cc:834
msgid ""
"The ISDATE() function returns True if the parameter is a date value. "
"Otherwise it returns False"
msgstr ""
"ຟັງຊັນຂອງ ISDATE() "
