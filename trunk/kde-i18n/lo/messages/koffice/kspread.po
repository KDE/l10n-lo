"ຫາກຄ່າ x ມີຄ່າເທົ່າກັບ y "
"ບໍ່ເຊັ່ນນັ້ນຈະຄືນຄ່າເເປັນ 0"

#: xml_doc.cc:492
msgid "GESTEP(x; y)"
msgstr "GESTEP(x; y)"

#: xml_doc.cc:493
msgid "GESTEP(1.2; 3.4) returns 0"
msgstr "DELTA(1.2;3.4) ຈະໄດ້ຄ່າ 0"

#: xml_doc.cc:494
msgid "GESTEP(3; 3) returns 1"
msgstr "DELTA(3;3) ຈະໄດ້ຄ່າ 1"

