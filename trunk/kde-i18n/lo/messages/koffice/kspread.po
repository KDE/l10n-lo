msgstr ""
"ຟັງຊັ້ນ DEC2OCT() "
"ຈະຄືນຄ່າມາເປັນຄ່າໃນຮູບແບບເລກຖານແປດ"

#: xml_doc.cc:1173
msgid "RANDBERNOULLI(x)"
msgstr "RANDBERNOULLI(x)"

#: xml_doc.cc:1174
msgid "RANDBERNOULLI(0.45)"
msgstr "RANDBERNOULLI(0.45)"

#: xml_doc.cc:1175
msgid "Bottom value"
msgstr "Bottom value"

#: xml_doc.cc:1176
msgid "Top value"
msgstr "Top value"

#: xml_doc.cc:1177
msgid ""
"The RANDBETWEEN() function returns a pseudo-random number between bottom and "
"top value. If bottom > top this function returns Err."
msgstr "RANDBETWEEN() ຟັງຊັ້ນນີ້ຈະສົ່ງຄ່າກັບສຸ່ມຂອງຄ່າຕົວເລກຕົວຕຳ່ສຸດແລະຄ່າສູງສຸດ > ຄ່າສູງສຸດຂອງຟັງຊັ້ນຈະສົ່ງຄ່າຜິດພາດ."

#: xml_doc.cc:1178
msgid "RANDBETWEEN(bottom;top)"
msgstr "RANDBETWEEN(bottom;top)"

#: xml_doc.cc:1179
msgid "RANDBETWEEN(12;78) equals for example 61.0811..."
msgstr "RANDBETWEEN(12;78) equals for example 61.0811..."

#: xml_doc.cc:1181
msgid "Multiple"
msgstr "ຄູນຄ່າ"

#: xml_doc.cc:1182
msgid ""
"The MROUND() function returns the value rounded to the specified multiple. "
"The value and the multiple must have the same sign"
msgstr ""
"ຟັງຊັ້ນ SECONDS() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າເປັນຄ່າຈຳນວນວິນາທີຂອງເວລາທີກຳນົດ"

#: xml_doc.cc:1183
msgid "MROUND(value; multiple)"
msgstr "LCD(ຄ່າ;ຄ່າ;)"

#: xml_doc.cc:1184
msgid "MROUND(1.252; 0.5) equals 1.5"
msgstr "ROUND(1.252;2) ມິຄ່າເທົ່າກັບ1.25"

#: xml_doc.cc:1185
msgid "MROUND(-1.252; -0.5) equals -1.5"
msgstr "ROUND(-1.252;0) ມິຄ່າເທົ່າກັບ -1"

#: xml_doc.cc:1187 xml_doc.cc:1196 xml_doc.cc:1203
msgid "Digits"
msgstr "Digits"

#: xml_doc.cc:1188
msgid ""
"The ROUND(value;[digits]) function returns value rounded. Digits is the "
"number of digits to which you want to round that number. If digits is zero "
"or omitted, value is rounded up to the nearest integer. If digits is smaller "
"than zero, the corresponding integer part of the number is rounded."
msgstr "ROUND(value;[digits]) ຟັງຊັ້ນນີ້ຈະສົ່ງຄ່າກັບຈະສົ່ງຄ່າອ້ອມຮອບ. ຄ່າດິຈິແມ່ນຄ່າຕົວເລກຂອງດີິຈິກັບທ່ານທີ່ຕ້ອງການຂອງຕົວເລກ. ຖ້າດິຈິແມ່ນ 0ຫລື ຄ່າລະເວັ້ນ, ຄ່າແມ່ນຈະສົງຄ່າຖ້ິວນເພີ່ມຂື້ນ.ຖ້າຄ່າດິຈິນ້ອຍກວ່າ 0, ກົງກັບຄ່າຖ້ວນສ່ວນຫນື່ງຂອງຄ່າຕົວເລກແມ່ນອ້ອມ."

#: xml_doc.cc:1189
msgid "ROUND(value;[digits])"
msgstr "ROUND(value;[digits])"

#: xml_doc.cc:1190
msgid "ROUND(1.252;2) equals 1.25"
msgstr "ROUND(1.252;2) ມິຄ່າເທົ່າກັບ 1.25"

#: xml_doc.cc:1191
msgid "ROUND(-1.252;2) equals -1.25"
msgstr "ROUND(-1.252;2) ມິຄ່າເທົ່າກັບ -1.25"

#: xml_doc.cc:1192
msgid "ROUND(1.258;2) equals 1.26"
msgstr "ROUND(1.258;2) equals 1.26"

#: xml_doc.cc:1193
msgid "ROUND(-12.25;-1) equals -10"
msgstr "ROUND(-12.25;-1) ມິຄ່າເທົ່າກັບ -10"

#: xml_doc.cc:1194
msgid "ROUND(-1.252;0) equals -1"
msgstr "ROUND(-1.252;0) ມິຄ່າເທົ່າກັບ -1"

#: xml_doc.cc:1197
msgid ""
"The ROUNDUP(value;[digits]) function returns value rounded up. Digits is the "
"number of digits to which you want to round that number. If digits is zero "
"or omitted, value is rounded up to the nearest integer."
msgstr "ROUNDUP(value;[digits]) ຟັງຊັ້ນນີ້ຈະສົ່ງຄ່າກັບຂື້ນຂອງຄ່າອ້ອມຂື້ນ.ດິຈິແມ່ນຄ່າຕົວເລກກັບທ່ານທີ່ຕ້ອງຄ່າເລົ່ານັ້ນ.ຖ້າດິຈິແມ່ນຄ່າ 0ຫລື ຄ່າຍົກເວັ້ນ,ຄ່າອ້ອມແມ່ນຂື້ນກັບຄ່າຖວ້ນທີ່ໃກ້ຄຽງສຸດ."

#: xml_doc.cc:1198
msgid "ROUNDUP(value;[digits])"
msgstr "ROUNDUP(value;[digits])"

#: xml_doc.cc:1199
msgid "ROUNDUP(1.252;2) equals 1.26"
msgstr "ROUNDUP(1.252;2) equals 1.26"

#: xml_doc.cc:1200
msgid "ROUNDUP(-1.252;2) equals -1.25"
msgstr "ROUNDUP(-1.252;2) equals -1.25"

#: xml_doc.cc:1201
msgid "ROUNDUP(-1.252) equals -1"
msgstr "ROUNDUP(-1.252) equals -1"

#: xml_doc.cc:1204
msgid ""
"The ROUNDDOWN(value;[digits]) function returns value rounded down. Digits is "
"the number of digits to which you want to round that number. If digits is "
"zero or omitted, value is rounded down to the nearest integer."
msgstr "ROUNDDOWN(value;[digits]) ຟັງຊັ້ນນີ້ຈະສົ່ງຄ່າກັບແບບອ້ອມລົງ.ດິຈິແມ່ນຄ່າຕົວເລກຂອງທ່ານທີ່ຕ້ອງການຄ່ານີ້.ຖ້າຄ່າດິຈິແມ່ນ 0ຫລື ຄ່າຍົກເວັ້ນ ."

#: xml_doc.cc:1205
msgid "ROUNDDOWN(value;[digits])"
msgstr "ROUNDDOWN(value;[digits])"

#: xml_doc.cc:1206
msgid "ROUNDDOWN(1.252;2) equals 1.25"
msgstr "ROUNDDOWN(1.252;2) equals 1.25"

#: xml_doc.cc:1207
msgid "ROUNDDOWN(-1.252;2) equals -1.26"
msgstr "ROUNDDOWN(-1.252;2) equals -1.26"

#: xml_doc.cc:1208
msgid "ROUNDDOWN(-1.252) equals -2"
msgstr "ROUNDDOWN(-1.252) ມິຄ່າເທົ່າກັບ -2"

#: xml_doc.cc:1209
msgid "Nth term"
msgstr "Nth term"

#: xml_doc.cc:1210
msgid ""
"Function FIB calculates the Nth term of a Fibonacci sequence (1, 1, 2, 3, 5, "
"8, 13, 21...), in which each number, after the first two, is the sum of the "
"two numbers immediately preceding it. @FIB(0) is defined to be 0."
msgstr ""
" FIB ຟັງຊັ້້ນນີ້ແມ່ນການຄິດໄລ່ Nth ຂອງຮາກ  (1, 1, 2, 3, 5, "
"8, 13, 21...), ໃນແຕ່ລະຕົວເລກ, ຫລັງຈາກຄ່າທຳອິດຂອງຕົວທີ່ສອງ, ແມ່ນການບວກຂອງສອງສອງຕົວເລກ. @FIB(0) ແມ່ນໃຫ້ຄ່າເປັນ 0."

#: xml_doc.cc:1211
msgid "FIB(n)"
msgstr "FIB(n)"

#: xml_doc.cc:1212
msgid "FIB(9) returns 34"
msgstr "FIB(9) ຈະໄດ້ຄ່າ 34"

#: xml_doc.cc:1213
msgid "FIB(26) returns 121393"
msgstr "FIB(26) ຈະໄດ້ຄ່າ 121393"

#: xml_doc.cc:1214
msgid "Numerator"
msgstr "Numerator"

#: xml_doc.cc:1215
msgid "Denumerator"
msgstr "Denumerator"

#: xml_doc.cc:1216
msgid "Function QUOTIENT returns the integer portion of numerator/denumerator."
msgstr "Function QUOTIENT ສົ່ງຄ່າຖ້ວນ ເຊີງໄດ້ຈາກ ຄ່າເສດ/ຕົວສ່ວນ."

#: xml_doc.cc:1217
msgid "QUOTIENT(numerator;denumerator)"
msgstr "QUOTIENT(ຄ່າເສດ;ຕົວສ່ວນ)"

#: xml_doc.cc:1218
msgid "QUOTIENT(21;4) returns 5"
msgstr "QUOTIENT(21;4) ຈະໄດ້ຄ່າ 5"

#: xml_doc.cc:1219
msgid "Lookup & Reference"
msgstr "ອ້າງອີງ:"

#: xml_doc.cc:1220
msgid "Row Number"
msgstr "ຕົວເລກ"

#: xml_doc.cc:1221
msgid "Column Number"
msgstr "ຈຳນວນທີສອງ"

#: xml_doc.cc:1222
msgid "Absolute Number (optional)"
msgstr "Absolute Number (optional)"

#: xml_doc.cc:1223
msgid "A1 Style (optional)"
msgstr "ຕົວເລືອກຂໍ້ຄວາມ"

#: xml_doc.cc:1224
msgid "Sheet Name"
msgstr "ປ່ຽນຊື່ແຜ່ນງານ"

#: xml_doc.cc:1225
msgid ""
"The ADDRESS creates a cell address.        Parameter: Row is the row number  "
"      Column is the column number                Absolute number specifies "
"the type of reference:        1 or omitted Absolute         2 Absolute row; "
"relative column         3 Relative row; absolute column         4 Relative   "
"               A1 Style specifies the style of the address to return. If A1 "
"is set to TRUE         (default) the address is returned in A1 style if it "
"is set to FALSE in R1C1 style.          Sheet name is the text specifying "
"the name of the sheet.       "
msgstr ""
"ADDRESS ສ້າງເຊລທີ່ຢູ່.ພາລາມີເຕ: ແຖວແມ່ນຕົວເລກຂອງແຖວ ,ຖັນແມ່ນຕົວເລກຂອງຖັນ ຄ່າສົມບູນ"
":        1 ຫລື ຄ່າຍົກເວັ້ນຄ່າສົມບູນ 2 ຄ່າສົມບູນຂອງແຖວ; "
"ທຽບຄຽງຂອງຖັນ 3 ທຽບຄຽງແຖວ; ຄ່າສົມບູນຂອງຖັນ 4 ທຽບຄຽງ"
"               A1 ແບບທີ່ກຳນົດແບບຂອງຄ່າທີ່ຢູ່ຈະສົ່ງກັບ.ຖ້າ A1 "
"ແມ່ນຕັ້ງຄ່າ TRUE         (default) ທີ່ຢູ່ແມ່ນສົ່ງຄ່າໃນ A1 style ຖ້າມັນແມ່ນຕັ້ງຄ່າເປັນ FALSE ໃນ R1C1 .          ຊື່ຊິດແມ່ນຂໍ້ຄວາມທີ່ເປັນຊື່ສະເພາະຂອງຊີດ.       "

#: xml_doc.cc:1226
msgid "ADDRESS(row; col; absolue; style; sheet name)"
msgstr "ADDRESS(row; col; absolue; style; sheet name)"

#: xml_doc.cc:1227
msgid "ADDRESS(6; 4) returns $D$6"
msgstr "LCD(6;4) ຈະໄດ້ຄ່າ 2"

#: xml_doc.cc:1228
msgid "ADDRESS(6; 4; 2) returns D$6"
msgstr "DIV(20;2;2) ຈະໄດ້ຄ່າ 5"

#: xml_doc.cc:1229
msgid "ADDRESS(6; 4; 2; FALSE; \"Sheet1\") returns Sheet1!R6C[4]"
msgstr "ADDRESS(6; 4; 2; FALSE; \"Sheet1\") returns Sheet1!R6C[4]"

#: xml_doc.cc:1230
msgid "ADDRESS(6; 4; 1; FALSE; \"Sheet1\") returns Sheet1!R6C4"
msgstr "ADDRESS(6; 4; 1; FALSE; \"Sheet1\") returns Sheet1!R6C4"

#: xml_doc.cc:1231
msgid "ADDRESS(6; 4; 4; TRUE; \"Sheet1\") returns Sheet1!D6"
msgstr "ADDRESS(6; 4; 4; TRUE; \"Sheet1\") returns Sheet1!D6"

#: xml_doc.cc:1232 xml_doc.cc:1243 xml_doc.cc:1248 xml_doc.cc:1253
#: xml_doc.cc:1259 xml_doc.cc:1264
msgid "Reference"
msgstr "ອ້າງອີງ:"

#: xml_doc.cc:1233
msgid ""
"Returns the number of areas in the reference string. An area can be asingle "
"cell or a set of cells."
msgstr ""
"ສົ່ງຄ່າຕົວເລກຂອງເນື້ອທີ່ໃນຄ່າຕົວອັກສອນ. ເນື້ອທີ່ແມ່ນຄ່າເຊລດ່ຽວ ຫລື ຕັ້ງຄ່າເຊລ."
"2310 COLUMN ແມ່ນວີທີ່ທີ່ສົ່ງຄ່າແຖວກັບເພື່ອໃຫ້ເຊລ,ຖ້າບໍ່ມີຄ່າພາລາມີເຕີແມ່ນທີ່ລະບຸໄວ້ໃນຖັນຂອງການແບ່ງແຊລທີ່ສົ່ງຄ່າກັບ."

#: xml_doc.cc:1234
msgid "AREAS(reference)"
msgstr "ຄຸນສົມບັດ"

#: xml_doc.cc:1235
msgid "AREAS(A1) returns 1"
msgstr "CARX(12;0) ຈະໄດ້ຄ່າ 12"

#: xml_doc.cc:1236
msgid "AREAS((A1; A2:A4)) returns 2"
msgstr "CARX(12;0) ຈະໄດ້ຄ່າ 12"

#: xml_doc.cc:1237
msgid "Index"
msgstr "ການຍັບ"

#: xml_doc.cc:1238
msgid "Arguments"
msgstr "Arguments"

#: xml_doc.cc:1239
msgid "Returns the parameter specified by the index."
msgstr ""
"ຟັງຊັ້ນ CHAR() "
"ຈະຄືນຄ່າເປັນອັກຂະລະທີ່ມີລະຫັດຕົວເລກກົງກັບທີ່ກຳນົດ"

#: xml_doc.cc:1240
msgid "CHOOSE(index, parameter1, parameter2,...)"
msgstr "CHOOSE(index, parameter1, parameter2,...)"

#: xml_doc.cc:1241
msgid "CHOOSE(1, \"1st\", \"2nd\") returns \"1st\""
msgstr "OCT2HEX(\"12\") ຈະໄດ້ຄ່າ \"a\""

#: xml_doc.cc:1242
msgid "CHOOSE(2, 3, 2, 4) returns 2"
msgstr "LCM(2;3;4) ຈະໄດ້ຄ່າ 12"

#: xml_doc.cc:1244
msgid ""
"The COLUMN function returns the column of given cell reference. If no "
"parameter is specified the column of the current cell gets returned."
msgstr ""
"The COLUMN function returns the column of given cell reference. If no "
"parameter is specified the column of the current cell gets returned."

#: xml_doc.cc:1245
msgid "COLUMN(reference)"
msgstr "ຄຸນສົມບັດ"

#: xml_doc.cc:1246
msgid "COLUMN(A1) returns 1"
msgstr "COUNT(5) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:1247
msgid "COLUMN(D2) returns 4"
msgstr "COUNT(5) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:1249
msgid "The COLUMNS function returns the number of columns in a reference."
msgstr ""
"ຟັງຊັ້ນ SECONDS() "
"ຈະຄືນຄ່າກັບມາເປນັຄ່າເປັນຄ່າຈຳນວນວິນາທີຂອງເວລາທີ່ກຳນົດ"

#: xml_doc.cc:1250
msgid "COLUMNS(reference)"
msgstr "ຄຸນສົມບັດ"

#: xml_doc.cc:1251
msgid "COLUMNS(A1:C3) returns 3"
msgstr "COUNT(5) ຈະໄດ້ຄ່າ1"

#: xml_doc.cc:1252
msgid "COLUMNS(D2) returns 1"
msgstr "COUNT(5) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:1254
msgid "A1 style (optional)"
msgstr "ຕົວເລືອກຂໍ້ຄວາມ"

#: xml_doc.cc:1255
msgid ""
"Returns the content of the cell specified by the reference text. The second "
"parameter is optional."
msgstr "ສົ່ງກັບຂອງເຊລທີ່ລະບຸໂດຍທີີສົ່ງມອບຂໍ້ຄວາມ.ພາລາມີເຕີທີ່ສອງຂອງການເລືອກ."

#: xml_doc.cc:1256
msgid "INDIRECT(referenceText, a1 style)"
msgstr "INDIRECT(referenceText, a1 style)"

#: xml_doc.cc:1257
msgid "INDIRECT(A1), A1 contains \"B1\", and B1 1 => returns 1"
msgstr "INDIRECT(A1), A1 contains \"B1\", and B1 1 => returns 1"

#: xml_doc.cc:1258
msgid "INDIRECT(\"A1\"), returns content of A1"
msgstr "BIN2DEC(\"1010\") ຈະໄດ້ຄ່າ 10 "

#: xml_doc.cc:1260
msgid ""
"The ROW function returns the row of given cell reference. If no parameter is "
"specified the row of the current cell gets returned."
msgstr "ROWແມ່ນວີທີ່ການສົ່ງແຖວເພື່ອໃຫ້ເຊລສົ່ງໃຫ້,ຖ້າບໍ່ມີຕົວແປແມ່ນລະບຸໄວ້ໃນແຖວຂອງການແບ່ງເຊລ."

#: xml_doc.cc:1261
msgid "ROW(reference)"
msgstr "ຄຸນສົມບັດ"

#: xml_doc.cc:1262
msgid "ROW(A1) returns 1"
msgstr "COUNT(5) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:1263
msgid "ROW(D2) returns 2"
msgstr "CARX(12;0) ຈະໄດ້ຄ່າ 12"

#: xml_doc.cc:1265
msgid "The ROWS function returns the number of rows in a reference."
msgstr ""
"HOURSຟັງຊັ້ນ () "
"ຈະຄືນຄ່າກັບມາເປັນຊົ່ວໂມງຂອງຄ່າເວລາທີ່ກຳນົດ"

#: xml_doc.cc:1266
msgid "ROWS(reference)"
msgstr "ຄຸນສົມບັດ"

#: xml_doc.cc:1267
msgid "ROWS(A1:C3) returns 3"
msgstr "HOURS(\"10:5:2\") ຈະໄດ້ຄ່າ10"

#: xml_doc.cc:1268
msgid "ROWS(D2) returns 1"
msgstr "COUNT(5) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:1269
msgid "Statistical"
msgstr "ຄ່າສະຖິຕິ"

#: xml_doc.cc:1270 xml_doc.cc:1271 xml_doc.cc:1272 xml_doc.cc:1273
#: xml_doc.cc:1278 xml_doc.cc:1279 xml_doc.cc:1280 xml_doc.cc:1281
#: xml_doc.cc:1286 xml_doc.cc:1287 xml_doc.cc:1288 xml_doc.cc:1289
msgid "Float"
msgstr "ຮູບແບບ"

#: xml_doc.cc:1274
msgid "The SKEW function returns an estimate for skewness of a distribution"
msgstr ""
"ຟັງຊັ້ນ LEN() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າຄວາມຍາຍຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1275
msgid "SKEW(number; number2; ...)"
msgstr "SKEW(number; number2; ...)"

#: xml_doc.cc:1276
msgid "SKEW(range)"
msgstr "SKEW(range)"

#: xml_doc.cc:1277
msgid "SKEW(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.9768"
msgstr "SKEW(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.9768"

#: xml_doc.cc:1282
msgid "The SKEWP function returns the population skewness of a distribution"
msgstr ""
"ຟັງຊັ້ນ LEN() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າຄວາມຍາວຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1283
msgid "SKEWP(number; number2; ...)"
msgstr "SKEWP(number; number2; ...)"

#: xml_doc.cc:1284
msgid "SKEWP(range)"
msgstr "SKEWP(range)"

#: xml_doc.cc:1285
msgid "SKEWP(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.6552"
msgstr "SKEWP(11.4; 17.3; 21.3; 25.9; 40.1) returns 0.6552"

#: xml_doc.cc:1290
msgid "The MODE function returns the most frequently occuring value in the data set."
msgstr ""
"ຟັງຊັ້ນ LEN() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າຄວາມຍາວຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1291
msgid "MODE(number; number2; ...)"
msgstr "MODE(number; number2; ...)"

#: xml_doc.cc:1292
msgid "MODE(range)"
msgstr "IMPOWER(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1293
msgid "MODE(12; 14; 12; 15) returns 12"
msgstr "MAX(12;5;7) ຈະໄດ້ຄ່າ 12"

#: xml_doc.cc:1294 xml_doc.cc:1299 xml_doc.cc:1304 xml_doc.cc:1309
msgid "Cell range of values"
msgstr "ຊ່ວງຂອງຄ່າໃດຯ"

#: xml_doc.cc:1295 xml_doc.cc:1300
msgid "Second cell range of values"
msgstr "ຄ່າວັນທີ່ຕົວທີ່ສອງ"

#: xml_doc.cc:1296
msgid ""
"The CORREL function calculates the correlation coefficient of two cell "
"ranges."
msgstr ""
"ຟັງຊັ້ນ CHAR() "
"ຈະຄືນຄ່າເປັນອັກຂະລະທີ່ມີລະຫັດຕົວເລກກົງກັບທີ່ກຳນົດ"

#: xml_doc.cc:1297
msgid "CORREL(range1; range2)"
msgstr "CORREL(range1; range2)"

#: xml_doc.cc:1298
msgid "CORREL(A1:A3; B1:B3)"
msgstr "CORREL(A1:A3; B1:B3)"

#: xml_doc.cc:1301
msgid "The COVAR function calculates the covariance of two cell ranges."
msgstr ""
"ຟັງຊັ້ນ CHAR() "
"ຈະຄືນຄ່າເປັນອັກຂະລະທີ່ມີລະຫັດເລກກົງກບັທີ່ກຳນົດ"

#: xml_doc.cc:1302
msgid "COVAR(range1; range2)"
msgstr "ປ່ຽນຄ່າມຸມ"

#: xml_doc.cc:1303
msgid "COVAR(A1:A3; B1:B3)"
msgstr "COVAR(A1:A3; B1:B3)"

#: xml_doc.cc:1305
msgid "Position (from the largest)"
msgstr "ຕຳແຫນ່ງຂອງຕົວອັກສອນທີ່ຈະແທນທີ"

#: xml_doc.cc:1306
msgid "The LARGE function returns the k-th largest value from the data set."
msgstr ""
"ຟັງຊັ້ນ LEN() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າຄວາມຍາວຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1307
msgid "LARGE(range; k)"
msgstr "LARGE(range; k)"

#: xml_doc.cc:1308
msgid "A1: 3, A2: 1, A3: 5 => LARGE(A1:A3; 2) returns 3"
msgstr "A1: 3, A2: 1, A3: 5 => LARGE(A1:A3; 2) returns 3"

#: xml_doc.cc:1310
msgid "Position (from the smallest)"
msgstr "Position (from the smallest)"

#: xml_doc.cc:1311
msgid "The SMALL function returns the k-th smallest value from the data set."
msgstr ""
"ຟັງຊັ້ນ LEN() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າຄວາມຍາຍຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1312
msgid "SMALL(range; k)"
msgstr "SMALL(range; k)"

#: xml_doc.cc:1313
msgid "A1: 3, A2: 1, A3: 5 => SMALL(A1:A3; 1) returns 1"
msgstr "A1: 3, A2: 1, A3: 5 => SMALL(A1:A3; 1) returns 1"

#: xml_doc.cc:1314
msgid "Number to be normalized"
msgstr "ຈຳນວນແຟ້ມທີ່ເຄີຍຣຽກໃຊ້:"

#: xml_doc.cc:1315
msgid "Mean of the Distribution"
msgstr "Mean of the Distribution"

#: xml_doc.cc:1317
msgid "The STANDARDIZE function calculates a normalized value."
msgstr ""
"ຟັງຊັ້ນ CHAR() "
"ຈະຄືນຄ່າເປັນອັກຂະລະທີ່ມີລະຫວ່າງຕົວເລກກົງກັບທີ່ກຳນົດ"

#: xml_doc.cc:1318
msgid "STANDARDIZE(x; mean, stdev)"
msgstr "STANDARDIZE(x; mean, stdev)"

#: xml_doc.cc:1319
msgid "STANDARDIZE(4; 3; 7) returns 0.1429"
msgstr "STANDARDIZE(4; 3; 7) returns 0.1429"

#: xml_doc.cc:1325
msgid ""
"The KURT() function calculates an unbiased estimate of the kurtosis of a "
"data set. You have to provide at least 4 values, otherwise an error is "
"returned."
msgstr "KURT() ແມ່ນການຄິດໄລ່ສົ່ງຄ່າປະມານຂອງເຄີທໍສິດເພື່ອຕັງຄ່າມື້. ທ່ານມີປະມານ 4 ຄ່າ,ຄ່າອື່ນອີກແມ່ນສົ່ງຄ່າຜິດພາດ."

#: xml_doc.cc:1326
msgid "KURT(value; value;...)"
msgstr "XOR(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1327
msgid "KURT(A1:A5)"
msgstr "KURT(A1:A5)"

#: xml_doc.cc:1328
msgid "KURT(21; 33; 54; 23) returns 1.344239"
msgstr "ROUND(1.252;2) ມິຄ່າເທົ່າກັບ 1.25"

#: xml_doc.cc:1334
msgid ""
"The KURTP() function calculates an population kurtosis of a data set. You "
"have to provide at least 4 values, otherwise an error is returned."
msgstr "KURTP() ແມ່ນການຄິດໄລ່ຜົນລະເມື່ອງຂອງເຄເຊີຈາກການຕັ້ງຂໍ້ມູນ. ທ່ານມີ 4 ຄ່າຫາກຄ່າອື່້ນແມ່ນຜິດພາດ."

#: xml_doc.cc:1335
msgid "KURTP(value; value;...)"
msgstr "XOR(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1336
msgid "KURTP(A1:A5)"
msgstr "KURTP(A1:A5)"

#: xml_doc.cc:1337
msgid "KURTP(21; 33; 54; 23) returns -1.021"
msgstr "ROUND(1.252;2) ມີຄ່າເທົ່າກັບ 1.25"

#: xml_doc.cc:1343
msgid "The DEVSQ() function calculates the sum of squares of deviations."
msgstr ""
"ຟັງຊັ້ນ CHAR() "
"ຈະຄືນຄ່າເປັນອັກຂະລະທີ່ມີລະຫວ່າງຕົວເລກກົງກັບທີ່ກຳນົດ"

#: xml_doc.cc:1344
msgid "DEVSQ(value; value;...)"
msgstr "STDDEV(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1345
msgid "DEVSQ(A1:A5)"
msgstr "DEVSQ(A1:A5)"

#: xml_doc.cc:1346
msgid "DEVSQ(21; 33; 54; 23) returns 684.75"
msgstr "DIV(20;2;2) ຈະໄດ້ຄ່າ 5"

#: xml_doc.cc:1347
msgid "Number of success in the sample"
msgstr "ຈຳນວນຕົວອັກສອນທີ່ຈະແທນທີ"

#: xml_doc.cc:1348 xml_doc.cc:1378 xml_doc.cc:1404
msgid "Number of trials"
msgstr "ຈຳນວນຂອງການທົດລອງ"

#: xml_doc.cc:1349
msgid "Number of success overall"
msgstr "ຈຳນວນຕົວອັກສອນທີ່ຈະແທນທີ"

#: xml_doc.cc:1350
msgid "Population size"
msgstr "ຂະຫນາດປະຊາກອນ"

#: xml_doc.cc:1351
msgid "The HYPGEOMDIST function returns the hypergeometric distribution."
msgstr ""
"ຟັງຊັ້ນ LEN() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າຄວາມຍາວຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1352
msgid "HYPGEOMDIST(x; n; M; N)"
msgstr "HYPGEOMDIST(x; n; M; N)"

#: xml_doc.cc:1353
msgid "HYPGEOMDIST(2; 5; 6; 20) returns 0.3522"
msgstr "TDIST(12;5;1) ຈະໄດ້ຄ່າ 0.000035"

#: xml_doc.cc:1359
msgid ""
"GEOMEAN returns the geometric mean of the given arguments. This is equal to "
"the Nth root of the product of the terms."
msgstr ""
" GEOMEAN ແມ່ນຜົນທີ່ໄດ້ອອກມາຂອງເລຂາຄະແມ່ນຖືກຕ້ອງມັນເທົ່າກັບ"
"ຜົນໄດ້ຮັບຮາກຂັ້ນ N ຂອງຕຳນວນໃນຄະນິດສາດ"

#: xml_doc.cc:1360
msgid "GEOMEAN(value; value;...)"
msgstr "MEDIAN(ຄ່່າ;ຄ່າ;...)"

#: xml_doc.cc:1361
msgid "GEOMEAN(A1:A5)"
msgstr "GEOMEAN(A1:A5)"

#: xml_doc.cc:1362
msgid "GEOMEAN(21; 33; 54; 23) returns 30.45886"
msgstr "POLA(12;0) ຈະໄດ້ຄ່າ 0.78539816"

#: xml_doc.cc:1368
msgid ""
"The HARMEAN function calculates the harmonic mean of theN data points (N "
"divided by the sum of the inverses of the data points)."
msgstr "HARMEAN ແມ່ນຫນ້າທີ່ການຄິດໄລ່ຮາໂມນິກຫມາຍເຖີງຈຸດຂໍ້ມູນໃນ N  (ຂໍ້ມູນຈຸດກົງກັນແມ່ນໄດ້ຈຳແນກຜົນບວກຂອງ N )"

#: xml_doc.cc:1369
msgid "HARMEAN(value; value;...)"
msgstr "MEDIAN(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1370
msgid "HARMEAN(A1:A5)"
msgstr "HARMEAN(A1:A5)"

#: xml_doc.cc:1371
msgid "HARMEAN(21; 33; 54; 23) returns 28.588"
msgstr "MAX(12.5;2) ຈະໄດ້ຄ່າ 12.5"

#: xml_doc.cc:1372 xml_doc.cc:1405
msgid "Number of failures"
msgstr "ຄວາມລົ້ມເຫລວຂອງຈຳນວນ"

#: xml_doc.cc:1373 xml_doc.cc:1379
msgid "Number of successful trials"
msgstr " ຈຳນວນຂອງການທົດລອງແມ່ນສຳເລັດ "

#: xml_doc.cc:1374 xml_doc.cc:1380
msgid "Probability of success"
msgstr "ຄວາມເປັນໄດ້ຂອງຄວາມສຳເລັດ"

#: xml_doc.cc:1375
msgid "The NEGBINOMDIST function returns the negative binomial distribution."
msgstr ""
"ຟັງຊັ້ນ LEN() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າຄວາມຍາຍຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1376
msgid "NEGBINOMDIST(failures; success; prob_of_success)"
msgstr "NEGBINOMDIST(failures; success; prob_of_success)"

#: xml_doc.cc:1377
msgid "NEGBINOMDIST(2;5;0.55) returns 0.152872629"
msgstr "TDIST(12;5;1) ຈະໄດ້ຄ່າ 0.000035"

#: xml_doc.cc:1381
msgid ""
"The BINO function returns the binomial distribution. The first parameter is "
"the number of trials, the second parameter is the number of successes, and "
"the third is the probability of success. The number of trials should be "
"greater than the number of successes and the probability should be smaller "
"or equal to 1."
msgstr ""
"BINO ແມ່ນການຂຽນເລກຖານສອງແມ່ນຫນ້າທີ່ສົ່ງອອກ. ຈຳນວນຂອງການທົດລອງຄັ້ງທຳອິດແມ່ນພາລາມີເຕີ, ຈຳນວນຂອງຜົນສຳເລັດຄັ້ງທີ່ສອງແມ່ນພາລາມີເຕີ, ແລະເປັນໄປໄດ້ຄວາມສຳເລັດແມ່ນທີ່ສາມ. ແລະນວນຂອງການທົດຄວນຈະເປັນຂັ້ນກ່ວາຈຳນວນຂອງຜົນສຳເລັດ ແລະ ຄວາມເປັນໄປໄດ້ແມ່ນຄວນຈະນ້ອຍກ່ວາ "
"ຫລືເທົ່າກັບ 1."

#: xml_doc.cc:1382
msgid "BINO(trials;success;prob_of_success)"
msgstr "BINO(trials;success;prob_of_success)"

#: xml_doc.cc:1383
msgid "BINO(12;9;0.8) returns 0.236223201"
msgstr "BINO(12;9;0.8) returns 0.236223201"

#: xml_doc.cc:1384 xml_doc.cc:1385 xml_doc.cc:1389 xml_doc.cc:1390
#: xml_doc.cc:1394 xml_doc.cc:1395 xml_doc.cc:1399 xml_doc.cc:1400
msgid "Value (array)"
msgstr "ຄ່າ (ອາເລ)"

#: xml_doc.cc:1386
msgid ""
"The SUMPRODUCT() function (SUM(X*Y)) returns the sum of the product of these "
"values. The number of values in the two arrays should be equal. Otherwise "
"this function returns Err."
msgstr "ແມ່ນ SUMPRODUCT() ຫນ້າທີ່ (SUM(X*Y)) ການກັບຄື່ນມາສຳລັບຜົນທີ່ໄດ້ແມ່ນເປັນຄ່າບວກ . ສຳລັບຈຳນວນຄ່າຂອງສອງລູກສອນນີ້ຄວນຈະເປັນເທົ່າ. ນອກຈາກນີ້ຫນ້າທີ່ຂອງ Err ຈະກັບຄືນມາ."

#: xml_doc.cc:1387
msgid "SUMPRODUCT(array1;array2)"
msgstr "SUMPRODUCT(array1;array2)"

#: xml_doc.cc:1388
msgid "SUMPRODUCT(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 31"
msgstr "SUMPRODUCT(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 31"

#: xml_doc.cc:1391
msgid ""
"The SUMX2PY2() function (SUM(X^2+Y^2)) returns the sum of the squares of "
"these values. The number of values in the two arrays should be equal. "
"Otherwise this function returns Err."
msgstr ""
"ແມ່ນ SUMX2PY2() ຫນ້າທີ່ (SUM(X^2+Y^2)) ສຳລັບກຳລັງຄ່າຂອງຜົນບວກແມ່ນຈະກັບຄື່ນມາ. ສຳລັບຈຳນວນຄ່າຂອງສອງລູກສອນແມ່ນຄວນຈະເປັນເທົ່າ. "
"ນອກຈາກນີ້ຫນ້າທີ່ຂອງ  Err. ແມ່ນມັນຈະກັບຄື່ນມາ"

#: xml_doc.cc:1392
msgid "SUMX2PY2(array1;array2)"
msgstr "SUMX2PY2(array1;array2)"

#: xml_doc.cc:1393
msgid "SUMX2PY2(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 63"
msgstr "SUMX2PY2(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 63"

#: xml_doc.cc:1396
msgid ""
"The SUMX2MY2() function (SUM(X^2-Y^2)) returns the difference of the squares "
"of these values. The number of values in the two arrays should be equal. "
"Otherwise this function returns Err."
msgstr ""
"ແມ່ນ SUMX2MY2() ຫນ້າທີ່ (SUM(X^2-Y^2)) ສຳລັບຄ່າຄວາມແຕກຕ່າງຂອງຜົນກຳລັງແມ່ນຈະກັບຄືນມາ. ຈຳນວນຄ່າຂອງສອງລູກສອນແມ່ນຄວນະເປັນເທົ່າ. "
"ນອກຈາກນີ້ຫນ້າທີ່ຂອງ Err ຈະກັບຄືນມາ."

#: xml_doc.cc:1397
msgid "SUMX2MY2(array1;array2)"
msgstr "SUMX2MY2(array1;array2)"

#: xml_doc.cc:1398
msgid "SUMX2MY2(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns -5"
msgstr "SUMX2MY2(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns -5"

#: xml_doc.cc:1401
msgid ""
"The SUM2XMY() function (SUM((X-Y)^2)) returns the square of the differences "
"of these values. The number of values in the two arrays should be equal. "
"Otherwise this function returns Err."
msgstr ""
"ແມ່ນ SUM2XMY() ຫນ້າທີ່ (SUM((X-Y)^2)) ສຳລັບຄ່າຄວາມແຕກຕ່າງຂອງຜົນກຳລັງແມ່ນມັນຈະກັບຄືນມາ. ຈຳນວນຄ່າຂອງສອງລູກສອນແມ່ນຄວນຈະເປັນເທົ່າ. "
"ນອກຈາກນີ້ຫນ້າທີ່ຂອງ Err ຈະກັບຄືນມາ."

#: xml_doc.cc:1402
msgid "SUM2XMY(array1;array2)"
msgstr "SUM2XMY(array1;array2)"

#: xml_doc.cc:1403
msgid "SUM2XMY(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 1"
msgstr "SUM2XMY(A1:A2;B1:B2) with A1=2, A2=5, B1=3 and B2=5, returns 1"

#: xml_doc.cc:1406
msgid "Probability of failure"
msgstr "ຄວາມເປັນໄປໄດ້ຂອງຄວາມລົ້ມເຫລວ"

#: xml_doc.cc:1407
msgid ""
"The INVBINO function returns the negative binomial distribution. The first "
"parameter is the number of trials, the second parameter is the number of "
"failures, and the third is the probability of failure. The number of trials "
"should be larger than the number of failures and the probability should be "
"smaller or equal to 1."
msgstr ""
"ແມ່ນ INVBINO ການຍອນກັບກຸ່ມຄຳສັ່ງຕໍ່ກັບການແບ່ງໃນການຂຽນເລກຖານສອງໃນຮູບແບບປະຕິເສດ. "
"ຄັ້ງທຳອິດ"
"ແມ່ນການທົດລອງຂອງຈຳນວນພາລາມີເຕີ, ການທົດລອງລົ້ມເຫລວຂອງຈຳນວນພາລາມີເຕີແມ່ນຄັ້ງທີ່ສອງ , "
"ແລະອາດເປັນໄປໄດ້ໃນການທົດລອງຄັ້ງທີ່ສາມ. ສຳລັບຈຳນວນທົດລອງຄວນຈະກ້ວາງກ່ວາຈຳນວນທີ່ບໍ່ເປັນໄປໄດ້ແລະມັນຄວນອາດຈະເປັນຄ່ານ້ອຍລົງຫລືເທົ່າກັບ 1."

#: xml_doc.cc:1408
msgid "INVBINO(trials;failure;prob_of_failure)"
msgstr "INVBINO(trials;failure;prob_of_failure)"

#: xml_doc.cc:1409
msgid "INVBINO(12;3;0.2) returns 0.236223201"
msgstr "INVBINO(12;3;0.2) returns 0.236223201"

#: xml_doc.cc:1410 xml_doc.cc:1416
msgid "Total number of elements"
msgstr "ຈຳນວນທັງຫມົດຂອງອຸປະກອນ"

#: xml_doc.cc:1411
msgid "Number of elements to choose"
msgstr "ຈຳນວນພື້ນຖານຂອງການເລືອກແມ່ນ "

#: xml_doc.cc:1412
msgid ""
"The COMBIN() function calculates the count of possible combinations. The "
"first parameter is the total count of elements. The second parameter is the "
"count of elements to choose. Both parameters should be positive and the "
"first parameter should not be less than the second. Otherwise the function "
"returns an error."
msgstr ""
"  COMBIN() ຫນ້າທີ່ຄິດໄລ່ຂອງການນັບແມ່ນເປັນໄປໄດ້ທີ່ເອົາມາຮ່ວມກັນ. "
"ຄັ້ງທຳອິດແມ່ນພື້ນຖານທັງຫມົດຂອງການນັບພາລາມີເຕີ.  "
"ພື້ນຖານຂອງການນັບແລະການເລືອກພາລາມີເຕີແມ່ນເທື່ອທີ່ສອງ. ພາລາມີເຄີທັງສອງນີ້້ຄວນຈະເປັນທີ່ຕັ້ງແລະພາລາມີເຕີຄັ້້ງທຳອິດຈະບໍ່ນ້ອຍກ່ວາຄັ້ງທີ່ສອງ."
"ນອກຈາກນີ້ການກັບຄືນມາຫນ້າທີ່ຂອງມັນຈະຜິດພາດ."

#: xml_doc.cc:1413
msgid "COMBIN(total;chosen)"
msgstr "COMBIN(total;chosen)"

#: xml_doc.cc:1414
msgid "COMBIN(12;5) returns 792"
msgstr "COMBIN(12;5) returns 792"

#: xml_doc.cc:1415
msgid "COMBIN(5;5) returns 1"
msgstr "COMBIN(5;5) returns 1"

#: xml_doc.cc:1417
msgid "Number of elements to permutate"
msgstr "ພື້ນຖານຂອງຈຳນວນການປ່ັຽນແປງຂອງ "

#: xml_doc.cc:1418
msgid ""
"The PERMUT() function returns the number of permutations. The first "
"parameter is the number of elements, and the second parameter is the number "
"of elements used in the permutation."
msgstr "ແມ່ນ PERMUT() ຈຳນວນຫນ້າທີ່ຂອງການປ່ຽນແປງແມ່ນຈະກັບຄື່ນມາ. ແມ່ນຈຳນວນພື້ນຖານຂອງພາລາມີເຕີ, ພື້ນຖາານຂອງການປ່ຽນແປງແມ່ນໃຊ້ພາລາມີເຕີເທື່ອສອງ."

#: xml_doc.cc:1419
msgid "PERMUT(total;permutated)"
msgstr "PERMUT(total;permutated)"

#: xml_doc.cc:1420
msgid "PERMUT(8;5) equals 6720"
msgstr "PERMUT(8;5) equals 6720"

#: xml_doc.cc:1421
msgid "PERMUT(1;1) equals 1"
msgstr "PERMUT(1;1) equals 1"

#: xml_doc.cc:1427
msgid ""
"The AVERAGE() function calculates the average of all the values given as "
"parameters. You can calculate the average of a range AVERAGE(A1:B5) or a "
"list of values like AVERAGE(12;5;12.5)."
msgstr "ຂອງ AVERAGE() ແມ່ນຫນ້າທີ່ຂອງການຄິດໄລ່ຄ່າສະເລ່ຍເພື່ອໃຫ້ຄ່າທີ່ຄືກັນຂອງພາລາມີເຕີ.  ທ່ານສາມາດຄິດໄລ່ຄ່າສະເລ່ຍຂອງ AVERAGE(A1:B5) ຄືກັນກັບຄ່າຂອງບັນຊີ AVERAGE(12;5;12.5)."

#: xml_doc.cc:1428
msgid "AVERAGE(value;value;...)"
msgstr "AVERAGE(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1429
msgid "AVERAGE(12;5;7) equals 8"
msgstr "AVERAGE(12;5;7) ມີຄ່າເທົ່າກັບ 8"

#: xml_doc.cc:1430
msgid "AVERAGE(12.5;2) equals 7.25"
msgstr "AVERAGE(12.5;2) ມີຄ່າເທົ່າກັບ 7.25"

#: xml_doc.cc:1432 xml_doc.cc:1743 xml_doc.cc:1744 xml_doc.cc:1745
#: xml_doc.cc:1746 xml_doc.cc:1747 xml_doc.cc:1751 xml_doc.cc:1752
#: xml_doc.cc:1753 xml_doc.cc:1754 xml_doc.cc:1755
msgid "String values"
msgstr "ຂໍ້ຄວາມ"

#: xml_doc.cc:1433
msgid ""
"The AVERAGEA() calculates the average of the given arguments. Numbers, text "
"and logical values are included in the calculation too. If the cell contains "
"text or the argument evaluates to FALSE, it is counted as value zero (0). If "
"the argument evaluates to TRUE, it is counted as one (1). Note that empty "
"cells are not counted."
msgstr "ແມ່ນ AVERAGEA() ການຄິດໄລ່ຄ່າແມ່ນໃຫ້ຄວາມເປັນຈີ່ງ. ຫລາຍຈຳນວນ, ຂໍ້ຄວາມ ແລະ ຄ່າໂລຈິກແມ່ນຄ່າທີ່ຄິດໄລ່ລວມຄືກັນ. ຖ້າເຊວບັນຈຸຂໍ້ຄວາມຫລືຄ່າຄວາມເປັນຈີ່ງທີ່ຜິດ, ແມ່ນມັນຈະນັບຄ່າສູນ (0). ຖ້າຄ່າຄວາມເປັນຈີ່ງຖືກ, ມັນຈະນັບເປັນຫນື່ງ (1). ດັ່ງນັ້ນຄ່າເຊວຈະບໍ່ຫວ່າງຫລືບໍ່ນັບ."

#: xml_doc.cc:1434
msgid "AVERAGEA(value;value;...)"
msgstr "AVERAGEA(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1435
msgid "AVERAGEA(11.4;17.3;\"sometext\";25.9;40.1) equals 18.94"
msgstr "AVERAGEA(11.4;17.3;\"sometext\";25.9;40.1) equals 18.94"

#: xml_doc.cc:1441
msgid ""
"The AVEDEV() function calculates the average of the absolute deviations of a "
"data set from their mean."
msgstr "ແມ່ນ AVEDEV() ແມ່ນຫນ້າທີ່ກາຄິດໄລ່ຄ່າສະເລ່ຍທີ່ສົມບູນສຳລັບຈາກການແບ່ງຊຸດຂໍ້ຄວາມຂອງເຂົາເຈົ້າ."

#: xml_doc.cc:1442
msgid "AVEDEV(value;value;...)"
msgstr "AVEDEV(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1443
msgid "AVEDEV(11.4;17.3;21.3;25.9;40.1) returns 7.84"
msgstr "AVEDEV(11.4;17.3;21.3;25.9;40.1) returns 7.84"

#: xml_doc.cc:1444
msgid "AVEDEV(A1:A5) ..."
msgstr "AVEDEV(A1:A5) ..."

#: xml_doc.cc:1445
msgid "Floating point value or range of values"
msgstr "ຈຸດຄ່າຂອງການໄຫລ່ ຫລື ໄລ່ຍະຂອງຄ່າ"

#: xml_doc.cc:1446 xml_doc.cc:1447 xml_doc.cc:1448 xml_doc.cc:1449
msgid "Floating point values or range of values"
msgstr "ຈຸດຄ່າຂອງການໄຫລ່ ຫລື ໄລ່ຍະຂອງຄ່າ"

#: xml_doc.cc:1450
msgid ""
"The MEDIAN() function calculates the median of all the values given as "
"parameters. You can calculate the median of a range like MEDIAN(A1:B5) or a "
"list of values like MEDIAN(12; 5; 12.5). Blank cells will be considered as a "
"zero, and cells with text will be ignored."
msgstr "ແມ່ນ MEDIAN() ຫນ້າທີ່ການຄິດໄລ່ແມ່ນໄດ້ແບ່ງຄ່າທັງຫມົດໃຫ້ກັບພາລາມີເຕີິ. ທ່ານສາມາດຄິດໄລ່ການແບ່ງໄລຍະຄືກັບ  MEDIAN(A1:B5) ຫລື ຄ່າຫນື່ງຂອງບັນຊີເທົາກັບ MEDIAN(12; 5; 12.5). ຊ່ອງຫວ່າງຂອງຄ່າເຊວມັນຈະເປັນການກວດສອບເລກສູນ, ແລະ ຄ່າເຊວກັບຂໍ້ຄວາມແມ່ນຈະບໍ່ຮັບຮູ້."

#: xml_doc.cc:1451
msgid "MEDIAN(value;value;...)"
msgstr "MEDIAN(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1452
msgid "MEDIAN(12; 5; 5.5) equals 5.5"
msgstr "MEDIAN(12; 5; 5.5) ມີຄ່າເທົ່າກັບ 5.5"

#: xml_doc.cc:1453
msgid "MEDIAN(12; 7; 8;2) equals 7.5"
msgstr "MEDIAN(12; 7; 8;2) ມີຄ່າເທົ່າກັບ 7.5"

#: xml_doc.cc:1459
msgid "The VAR() function calculates the estimates variance based on a sample."
msgstr ""
"ຟັງຊັ້ນ CHAR() "
"ຈະຄືນຄ່າເປັນອັກຂະລະທີ່ມີລະຫັດຕົວເລກກົງກັບທີ່ກຳນົດ"

#: xml_doc.cc:1460
msgid "VAR(value;value;...)"
msgstr "XOR(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1461
msgid "VAR(12;5;7) equals 13"
msgstr "AVERAGE(12;5;7) ມີຄ່າເທົ່າກັບ 8"

#: xml_doc.cc:1462
msgid "VAR(15;80;3) equals 1716.333..."
msgstr "VARIANCE(15;80;3) ມີຄ່າເທົ່າກັບ 1144.22..."

#: xml_doc.cc:1463
msgid "VAR(6;7;8) equals 1"
msgstr "AVERAGE(12;5;7) ມີຄ່າເທົ່າກັບ 8"

#: xml_doc.cc:1469
msgid "The VARA() function calculates the variance based on a sample."
msgstr ""
"ຟັງຊັ້ນ CHAR() "
"ຈະຄືນຄ່າເປັນອັກຂະລະທີ່ມີລະຫວ່າງລະຫດັຕົວເລກກົງກັບທີ່ກຳນົດ"

#: xml_doc.cc:1470
msgid "VARA(value;value;...)"
msgstr "XOR(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1471
msgid "VARA(12;5;7) equals 13"
msgstr "AVERAGE(12;5;7) ມີຄ່າເທົ່າກັບ 8"

#: xml_doc.cc:1472
msgid "VARA(15;80;3) equals 1716.333..."
msgstr "VARIANCE(15;80;3) ມີຄ່າເທົ່າກັບ 1144.22..."

#: xml_doc.cc:1473
msgid "VARA(6;7;8) equals 1"
msgstr "AVERAGE(12;5;7) ມີຄ່າເທົ່າກັບ 8"

#: xml_doc.cc:1479
msgid "The VARP() function calculates the variance based on an entire population."
msgstr "ແມ່ນ VARP() ແມ່ນພື້ນຖານການຄິດໄລ່ຫນ້າທີ່ຂອງປະຊາກອນທີ່ອົບພະຍົກເຂົ້າມາ."

#: xml_doc.cc:1480
msgid "VARP(value;value;...)"
msgstr "XOR(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1481
msgid "VARP(12;5;7) equals 8.666..."
msgstr "AVERAGE(12;5;7) ມີຄ່າເທົ່າກັບ 8"

#: xml_doc.cc:1482
msgid "VARP(15;80;3) equals 1144.22..."
msgstr "VARIANCE(15;80;3) ມີຄ່າເທົ່າກັບ 1144.22..."

#: xml_doc.cc:1483
msgid "VARP(6;7;8) equals 0.6666667..."
msgstr "TANH(0.8) ມີຄ່າເທົ່າກັບ 0.66403677"

#: xml_doc.cc:1489
msgid ""
"The VARPA() function calculates the variance based on an entire population. "
"Text and boolean values that evaluate to FALSE are counted as 0, boolean "
"value that avaluate to TRUE are counted as 1."
msgstr ""
"ແມ່ນ VARPA() ແມ່ນພື້ນຖານການຄິດໄລ່ຫນ້າທີ່ຂອງປະຊາກອນທີ່ອົບພະຍົກເຂົ້າມາ. "
"ຂໍ້ຄວາມ ແລະ ຄ່າບູລີນແມ່ນຄ່າທີ່ຜິດພາດແມ່ນການນັບເລກສູນ,(0) ຄ່າບູລີນແມ່ນຄ່າທີ່ຖືກນັ້ນແມ່ນການນັບເລກຫນື່ງ (1)."

#: xml_doc.cc:1490
msgid "VARPA(value;value;...)"
msgstr "XOR(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1491
msgid "VARPA(12;5;7) equals 8.666..."
msgstr "AVERAGE(12;5;7) ມີຄ່າເທົ່າກັບ 8"

#: xml_doc.cc:1492
msgid "VARPA(15;80;3) equals 1144.22..."
msgstr "VARIANCE(15;80;3) ມີຄ່າເທົ່າກັບ 1144.22..."

#: xml_doc.cc:1493
msgid "VARPA(6;7;8) equals 0.6666667..."
msgstr "TANH(0.8) ມີຄ່າເທົ່າກັບ 0.66403677"

#: xml_doc.cc:1499
msgid ""
"Estimates standard deviation based on a sample. The standard deviation is a "
"measure of how widely values are dispersed from the average value."
msgstr ""
"ການປ່່ຽນແປງທີ່ມາດຕະຖານຂອງການຕີລາຄາໄດ້ຕັ້ງຮູບແບບໃນຕົວຢ່າງ.ການຫັນເຫທີ່ມາດຕະຖານແມ່ນການຫັນ"
"ເຫທີ່ມາດຕະຖານແມ່ນການວັດແທກຂອງຄ່າທີ່ໃຊ້ກັນຢ່າງກວ້າງຂວາງໄດ້ຖືກແຍກອອກຈາກຄ່າສະເລ່ຍ"

#: xml_doc.cc:1500
msgid "STDEV(value;value;...)"
msgstr "STDDEV(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1501
msgid "STDEV(6;7;8) equals 1"
msgstr "SIGN(5) ມີຄ່າເທົ່າກັບ 1"

#: xml_doc.cc:1507
msgid ""
"Estimates standard deviation based on a sample. The standard deviation is a "
"measure of how widely values are dispersed from the average value. If a "
"referenced cell contains text or contains the boolean value FALSE, it is "
"counted as 0. If the boolean value is TRUE it is counted as 1."
msgstr ""
"ການປ່່ຽນແປງທີ່ມາດຕະຖານຂອງການຕີລາຄາໄດ້ຕັ້ງຮູບແບບໃນຕົວຢ່າງ.ການຫັນເຫທີ່ມາດຕະຖານແມ່ນການຫັນ"
"ເຫທີ່ມາດຕະຖານແມ່ນການວັດແທກຂອງຄ່າທີ່ໃຊ້ກັນຢ່າງກວ້າງຂວາງໄດ້ຖືກແຍກອອກຈາກຄ່າສະເລ່ຍ. ຖ້າການອ້າງອິງເຊລ໌ໜຶ່ງບັນຈຸເອົາເຕັກຫລືບັນຈຸເອົາຄ່າບູລິນFALSE,ມັນແມ່ນການທ່ີ່ຖືກນັບເອົາເປັນສູນ0.ຖ້າຄ່າບູລິນເປັນ TRUEມັນໄດ້ຖຶືກນັບເປັນໜຶ່ງ 1."

#: xml_doc.cc:1508
msgid "STDEVA(value;value;...)"
msgstr "STDDEV(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1509
msgid "STDEVA(6; 7; A1; 8) equals 1, if A1 is empty"
msgstr "SIGN(5) ມີຄ່າເທົ່າກັບ 1"

#: xml_doc.cc:1510
msgid "STDEVA(6; 7; A1; 8) equals 3.109, if A1 is TRUE"
msgstr "SIGN(5) ມີຄ່າເທົ່າກັບ 1"

#: xml_doc.cc:1516
msgid "Calculates standard deviation based on an entire population"
msgstr "ການຫັນເຫແບບມາດຕະຖານຂອງການຄຳນວນໄດ້ຕັ້ງຮາກຖານຢູ່່ໃນການນຳເຂົ່າຂອງຂໍ້ມູນຕ່າງໆ"

#: xml_doc.cc:1517
msgid "STDEVP(value;value;...)"
msgstr "STDDEV(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1518
msgid "STDEVP(6;7;8) equals 0.816497..."
msgstr "PI() ມີຄ່າເທົ່າກັບ 3.141592654..."

#: xml_doc.cc:1524
msgid ""
"Calculates standard deviation based on an entire population. If a referenced "
"cell contains text or contains the boolean value FALSE, it is counted as 0. "
"If the boolean value is TRUE it is counted as 1."
msgstr ""
"ການຫັນເຫແບບມາດຕະຖານຂອງການຄຳນວນໄດ້ຕັ້ງຮາກຖານຢູ່່ໃນການນຳເຂົ່າຂອງຂໍ້ມູນຕ່າງໆ. ຖ້າການອ້າງອິງ"
"ເຖິງເຕັກຂອງການບັນຈຸເຊລຫລືບັນຈຸເອົາຄ່າບູລິນ FALSE,ໃນກໍລະນີນີ້ມັນໄດ້ຖືກນັບເປັນໜື່ງ 0. ຖ້າຄ່າບູລິນເປັນ TRUEມັນໄດ້ຖຶືກນັບເປັນໜຶ່ງ 1."

#: xml_doc.cc:1525
msgid "STDEVPA(value;value;...)"
msgstr "STDDEV(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1526
msgid "STDEVPA(6; 7; A1; 8) equals 0.816497..., if A1 is empty"
msgstr "PI() ມີຄ່າເທົ່າກັບ 3.141592654..."

#: xml_doc.cc:1527
msgid "STDEVPA(6; 7; A1; 8) equals 2.69..., if A1 is TRUE"
msgstr "PI() ມີຄ່າເທົ່າກັບ 3.141592654..."

#: xml_doc.cc:1528
msgid "STDEVPA(6; 7; A1; 8) equals 3.11..., if A1 is FALSE"
msgstr "PI() ມີຄ່າເທົ່າກັບ 3.141592654..."

#: xml_doc.cc:1529
msgid ""
"The number for which the integral value of standard normal distribution is "
"to be calculated."
msgstr "ໝາຍເລກສຳລັບຄ່າສັງຄະນິດຂອງເຄືອຂ່າຍມາດຕະຖານປົກກະຕິແມ່ນໄດ້ຖືກຄຳນວນ"

#: xml_doc.cc:1530
msgid ""
"This function returns the integral values for the standard normal cumulative "
"distribution."
msgstr "ກຸ່ມຄຳສັ່ງນີ້ໄດ້ນຳເອົາຄ່າສັງຄະນິດສຳລັບເຄືອຂ່າຍການສະສົມປົກກະຕິແບບມາດຕະຖານກັບໄປຄືນ"

#: xml_doc.cc:1531
msgid "GAUSS(value)"
msgstr "GAUSS(value)"

#: xml_doc.cc:1532
msgid "GAUSS(0.25) equals 0.098706"
msgstr "GAUSS(0.25) ມີຄ່າເທົ່າກັບ 0.098706"

#: xml_doc.cc:1533
msgid "The number for which the standard normal distribution is to be calculated."
msgstr "ໝາຍເລກສຳລັບຄ່າສັງຄະນິດຂອງເຄືອຂ່າຍມາດຕະຖານປົກກະຕິແມ່ນໄດ້ຖືກຄຳນວນ"

#: xml_doc.cc:1534
msgid ""
"This function returns value of the distribution function for          a "
"standard normal distribution."
msgstr "ກຸ່ມຄຳສັ່ງນີ້ໄດ້ນຳເອົາຄ່າສັງຄະນິດສຳລັບເຄືອຂ່າຍການສະສົມປົກກະຕິແບບມາດຕະຖານກັບໄປຄືນ"

#: xml_doc.cc:1535
msgid "PHI(value)"
msgstr "PHI(ຄ່າ)"

#: xml_doc.cc:1536
msgid "PHI(0.25) equals 0.386668"
msgstr "PHI(0.25) ມີຄ່າເທົ່າກັບ 0.386668"

#: xml_doc.cc:1538 xml_doc.cc:1546
msgid "Alpha parameter"
msgstr "ພາຣາແມັດເຕີອານຟ"

#: xml_doc.cc:1539 xml_doc.cc:1547
msgid "Beta parameter"
msgstr "ພາຣາແມັດເຕີເບຕາ"

#: xml_doc.cc:1540
msgid "Cumulated flag"
msgstr "ແຟລັກການສະສົມ"

#: xml_doc.cc:1541
msgid ""
"          Calculates the gamma distribution. If the last parameter          "
"(cumulated) is 0, it calculates the density function; if it's 1, the         "
" distribution is returned. The first three parameters must be positive.      "
"  "
msgstr ""
" ຄຳນວນຕົວແທນກາມາ.ຖ້າພາຣາແມັດເຕີສຸດທ້າຍ"
"(ການສະສົມ) ແມ່ນສູນ 0,ມັນໄດ້ຄິດໄລ່ກຸ່ມຄຳສັ່ງຂອງຄວາມໄວ;ຖ້າໝາຍເລກໜື່ງ 1 ແມ່ນມັນ,ຕົວແທນຈຳໜ່າຍ"
"ົດຖືກສົ່ງກັບ.ສາມພາຣາແມັກເຕີທຳອິດຈະຕ້ອງເປັນທີ່ຕ້ງໄດ້.     "

#: xml_doc.cc:1542
msgid "GAMMADIST(number;alpha;beta;cumulated)"
msgstr "GAMMADIST(number;alpha;beta;cumulated)"

#: xml_doc.cc:1543
msgid "GAMMADIST(0.758;0.1;0.35;1) equals 0.995450"
msgstr "GAMMADIST(0.758;0.1;0.35;1) equals 0.995450"

#: xml_doc.cc:1544
msgid "GAMMADIST(0.758;0.1;0.35;0) equals 0.017179"
msgstr "GAMMADIST(0.758;0.1;0.35;0) ມີຄ່າເທົ່າກັບ 0.017179"

#: xml_doc.cc:1549
msgid "End"
msgstr "ຈົບ"

#: xml_doc.cc:1550
msgid ""
"          Returns the cumulative beta probability density function.          "
"The last two parameters are optional. They set the lower and upper          "
"bounds, otherwise defaulting to 0.0 and 1.0 respectively.        "
msgstr ""
"ຍ້ອນກັບເບຕາຂອງການສະສົມທີ່ອາດຈະເປັນກຸ່ມຄຳສັ່ງຂອງຄວາມໄວໄດ້.          "
"ສອງພາຣາແມັດເຕີສຸູດທ້າຍແມ່ນກ່ຽວກັບໜ້າວຽກ.ພວກມັນໄດ້ຕັ້ງບໍລິເວນທີ່ຕຳ່ກວ່າແລະສູງກວ່າ,ອີກຢ່າງໜຶ່ງມັນກໍ່ຈະເປັນ  0.0 and ແລະ1.0 ໂດຍປະຣິຍາຍ.        "

#: xml_doc.cc:1551
msgid "BETADIST(number;alpha;beta;start;end)"
msgstr "BETADIST(number;alpha;beta;start;end)"

#: xml_doc.cc:1552
msgid "BETADIST(0.2859;0.2606;0.8105) equals 0.675444"
msgstr "BETADIST(0.2859;0.2606;0.8105) equals 0.675444"

#: xml_doc.cc:1553
msgid "BETADIST(0.2859;0.2606;0.8105;0.2;0.9) equals 0.537856"
msgstr "BETADIST(0.2859;0.2606;0.8105;0.2;0.9) equals 0.537856"

#: xml_doc.cc:1555
msgid ""
"          Returns the Fisher transformation for x and creates a function "
"close to a normal distribution.        "
msgstr "ກັັບໃປທີ່ ການແປງຄ່າສຳລັບ x ແລະ ສ້າງໜ້າທີ່  ປິດ ການແຈກຈ່າຍທໍາມະດາ. "

#: xml_doc.cc:1556
msgid "FISHER(number)"
msgstr "FISHER(number)"

#: xml_doc.cc:1557
msgid "FISHER(0.2859) equals 0.294096"
msgstr "FISHER(0.2859) ມີຄ່າເທົ່າກັບ 0.294096"

#: xml_doc.cc:1558
msgid "FISHER(0.8105) equals 1.128485"
msgstr "FISHER(0.8105) ມີຄ່າເທົ່າກັບ 1.128485"

#: xml_doc.cc:1560
msgid ""
"          Returns the inverse of the Fisher transformation for x and creates "
"a function close to a normal distribution.        "
msgstr "  ກັັບໃປທີ່ ການແປງຄ່າກັບສຳລັບ x ແລະ ສ້າງໜ້າທີ່  ປິດ ການແຈກຈ່າຍທໍາມະດາ.      "

#: xml_doc.cc:1561
msgid "FISHERINV(number)"
msgstr "FISHERINV(ຕົວເລກ)"

#: xml_doc.cc:1562
msgid "FISHERINV(0.2859) equals 0.278357"
msgstr "FISHERINV(0.2859) ມີຄ່າເທົ່າກັບ 0.278357"

#: xml_doc.cc:1563
msgid "FISHERINV(0.8105) equals 0.669866"
msgstr "FISHERINV(0.8105) ມີຄ່າເທົ່າກັບ 0.669866"

#: xml_doc.cc:1564 xml_doc.cc:1588 xml_doc.cc:1595 xml_doc.cc:1603
#: xml_doc.cc:1613 xml_doc.cc:1617 xml_doc.cc:1630 xml_doc.cc:1636
#: xml_doc.cc:1642
msgid "number"
msgstr "ຕົວເລກ"

#: xml_doc.cc:1565
msgid "linear middle of the distribution"
msgstr "  ເສັ້ນຊື່ກາງຂອງການແຈກຈ່າຍ"

#: xml_doc.cc:1566
msgid "standard deviation of the distribution"
msgstr "    ມາດຕະຖານການຫັນເຫຂອງການແຈກຈ່າຍ"

#: xml_doc.cc:1567 xml_doc.cc:1590 xml_doc.cc:1598 xml_doc.cc:1619
msgid "0 = density, 1 = distribution"
msgstr "0 = density, 1 = distribution"

#: xml_doc.cc:1568
msgid ""
"          Returns the normal cumulative distribution.           Number is "
"the value of the distribution based on which the normal distribution is to "
"be calculated.          MV is the linear middle of the distribution.         "
" STD is the standard deviation of the distribution.          K = 0 "
"calculates the density function; K = 1 calculates the distribution.        "
msgstr ""
"  ກັບໄປທີ່ການແຈກຈ່າຍທຳມະດາທີ່ເພີ່ມຂື້ນ .ຕົວເລກແມ່ນຄ່າຂອງການແຈກຈ່າຍພື້ນຖານຊື່ງການແຈກຈ່າຍທຳມະດາແມ່ນຈະຕ້ອງຖືກຄິດໄລ່.  MVແມ່ນເສັ້ນຊື່ກາງຂອງການຄິດໄລ່.    "
" STD ແມ່ນມາດຕະຖານການຫັກເຫຂອການແຈກຈ່າຍ.   K = 0 ຄິດໄລ່ຄວາມແໜ້ນຂອງໜ້າທີ່; K = 1ຄິດໄລ່ການແຈກຈ່າຍ.        "

#: xml_doc.cc:1569
msgid "NORMDIST(Number;MV;STD;K)"
msgstr "NORMDIST(Number;MV;STD;K)"

#: xml_doc.cc:1570
msgid "NORMDIST(0.859;0.6;0.258;0) equals 0.934236"
msgstr "NORMDIST(0.859;0.6;0.258;0) equals 0.934236"

#: xml_doc.cc:1571
msgid "NORMDIST(0.859;0.6;0.258;1) equals 0.842281"
msgstr "NORMDIST(0.859;0.6;0.258;1) equals 0.842281"

#: xml_doc.cc:1572 xml_doc.cc:1607
msgid ""
"probability value for which the standard logarithmic distribution is to be "
"calculated"
msgstr "ຄ່າຄວາມໜ້າຈະເປັນສຳລັບ ຄ່າມາດຕະຖານຂອງ ການແຈກຈ່າຍlog  ຈະຖືກຄິດໄລ່"

#: xml_doc.cc:1573 xml_doc.cc:1579
msgid "mean value of the standard logarithmic distribution"
msgstr "ຄວາມໝາຍຂອງ ມາດຕະຖານ ຂອງການແຈກຈ່າຍ log "

#: xml_doc.cc:1574 xml_doc.cc:1580
msgid "standard deviation of the standard logarithmic distribution"
msgstr "ການແຈກຈ່າຍມາດຕະຖານການຫັນເຫຂອງ log "

#: xml_doc.cc:1575
msgid "          Returns the cumulative lognormal distribution.        "
msgstr "ກັບໄປທີ່ການແຈກຈ່າຍ log ທຳມະດາທີ່ເພີ່ມຂື້ນ.    "

#: xml_doc.cc:1576
msgid "LOGNORMDIST(Number;MV;STD)"
msgstr "LOGNORMDIST(Number;MV;STD)"

#: xml_doc.cc:1577
msgid "LOGNORMDIST(0.1;0;1) equals 0.01"
msgstr "LOGNORMDIST(0.1;0;1) equals 0.01"

#: xml_doc.cc:1578
msgid "probability"
msgstr "ຄວາມເປັນໄປໄດ້"

#: xml_doc.cc:1581
msgid "Calculates the inverse of the lognormal cumulative distribution."
msgstr " ຄິດໄລ່ການແຈກຈ່າຍກັບຂອງ log ທຳມະດາທີ່ເພີ່ມຂື້ນ. "

#: xml_doc.cc:1582
msgid "LOGINV(p; mean; stdev)"
msgstr "LOGINV(p; mean; stdev)"

#: xml_doc.cc:1583
msgid "LOGINV(0.1;0;1) equals 0.2776"
msgstr "NOMINAL(0.08;12) ມີຄ່າເທົ່າກັບ 0.0772"

#: xml_doc.cc:1584
msgid "value to which the standard normal distribution is calculated"
msgstr "ຄ່າການແຈກຈ່າຍມາດຕະຖານແມ່ນຖືກຄິດໄລ່"

#: xml_doc.cc:1585
msgid "          Returns the standard normal distribution.        "
msgstr " ກັບໄປທີ່ການແຈກຈ່າຍມາດຕະຖານທຳມະດາ.     "

#: xml_doc.cc:1586
msgid "NORMSDIST(Number)"
msgstr "NORMSDIST(ຕົວເລກ)"

#: xml_doc.cc:1587
msgid "NORMSDIST(1) equals 0.84"
msgstr "NORMSDIST(1) equals 0.84"

#: xml_doc.cc:1589
msgid "lambda parameter"
msgstr "ແລບດ້າ ພາລາມີເຕີ"

#: xml_doc.cc:1591
msgid ""
"          Returns the exponential distribution.          The lambda "
"parameter must be positive.          Cumulative = 0 calculates the density "
"function; cumulative = 1 calculates the distribution.        "
msgstr ""
"ກັບໄປທີ່ການແຈກຈ່າຍ the exponential . ຄ່າ The lambda "
"ຕ້ອງເປັນຄ່າບວກ . ເພີ່ມຂື້ນ = 0 ຄິດໄລ່ຄວາມແໜ້ນຂອງໜ້າທີ່;ເພີ່ມຂື້ນ = 1ຄິດໄລ່ການແຈກຈ່າຍ .    "

#: xml_doc.cc:1592
msgid "EXPONDIST(number;lambda;cumulative)"
msgstr "EXPONDIST(number;lambda;cumulative)"

#: xml_doc.cc:1593
msgid "EXPONDIST(3;0.5;0) equals 0.111565"
msgstr "EXPONDIST(3;0.5;0) ມີຄ່າເທົ່າກັບ 0.111565"

#: xml_doc.cc:1594
msgid "EXPONDIST(3;0.5;1) equals 0.776870"
msgstr "EXPONDIST(3;0.5;1) equals 0.776870"

#: xml_doc.cc:1596
msgid "alpha parameter"
msgstr "alpha parameter"

#: xml_doc.cc:1597
msgid "beta parameter"
msgstr "beta parameter"

#: xml_doc.cc:1599
msgid ""
"          Returns the Weibull distribution.          The alpha and beta "
"parameters must be positive, the number (first          parameter) must be "
"non-negative.          Cumulative = 0 calculates the density function; "
"cumulative = 1 calculates the distribution.        "
msgstr ""
"        ກັບໄປທີ່ການແຈກຈ່າຍ the Weibull.  ຄ່າ  The alpha and beta "
"ຕ້ອງເປັນຄ່າບວກ, ຕົວເລກ (ຄ່າທຳອິດ)ຕ້ອງບໍ່ເປັນຄ່າລົບ.ເພີ່ມຂື້ນ = 0 ຄິດໄລ່ຄວາມໜາແໜນຂອງໜ້າທີ່; "
"ເພີ່ມຂຶ້ນ = 1 ຄິດໄລ່ການແຈກຈ່າຍ.       "

#: xml_doc.cc:1600
msgid "WEIBULL(number;alpha;beta;cumulative)"
msgstr "WEIBULL(number;alpha;beta;cumulative)"

#: xml_doc.cc:1601
msgid "WEIBULL(2;1;1;0) equals 0.135335"
msgstr "WEIBULL(2;1;1;0) equals 0.135335"

#: xml_doc.cc:1602
msgid "WEIBULL(2;1;1;1) equals 0.864665"
msgstr "WEIBULL(2;1;1;1) equals 0.864665"

#: xml_doc.cc:1604
msgid ""
"          Returns the inverse of the standard normal cumulative          "
"distribution. The number must be between 0 and 1 (non-inclusive).        "
msgstr ""
"        ກັບໄປທີ່ການແຈກຈ່າຍການເພີ່ມຂື້ນຂອງມາດຕະຖານທຳມະດາຂອງຄ່າກົງກັນຂ້າມ          "
". ຕົວເລກຕ້ອງຢູ່ລະຫວ່າງ 0 ແລະ 1 (ບໍ່ນັບທັງໝົດ).     "

#: xml_doc.cc:1605
msgid "NORMSINV(Number)"
msgstr "NORMSINV(ຕົວເລກ)"

#: xml_doc.cc:1606
msgid "NORMSINV(0.908789) returns 1.3333"
msgstr "NORMSINV(0.908789) returns 1.3333"

#: xml_doc.cc:1608
msgid "middle value in the normal distribution"
msgstr "ການແຈກຈ່າຍທຳມະດາຢູ່ໃນຄ່າກາງ"

#: xml_doc.cc:1609
msgid "standard deviation of the normal distribution"
msgstr "ການແຈກຈ່າຍທຳມະດາຂອງມາດຕະຖານການຫັນເຫ"

#: xml_doc.cc:1610
msgid ""
"          Returns the inverse of the normal cumulative distribution. The "
"number          must be between 0 and 1 (non-inclusive) and STD must be "
"positive.        "
msgstr "     ກັບໄປທີ່ການແຈກຈ່າຍການເພີ່ມຂຶ້ນທຳມະດາຂອງຄ່າກົງກັນຂ້າມ.ຕົວເລກຕ້ອງຢູ່່ລະຫວາ່ງ 0 ແລະ 1 (ບໍ່ນັບທັງໝົດ)  ແລະ   STD ຕ້ອງເປັນຄ່າບວກ.         "

#: xml_doc.cc:1611
msgid "NORMINV(number;MV;STD)"
msgstr "NORMINV(number;MV;STD)"

#: xml_doc.cc:1612
msgid "NORMINV(0.9;63;5) equals 69.41"
msgstr "NORMINV(0.9;63;5) equals 69.41"

#: xml_doc.cc:1614
msgid ""
"          Returns the natural logarithm of the gamma function: G(x). The "
"number          parameter must be positive.        "
msgstr "   ກັບໄປທີ່ log ທຳມະຊາດ ຂອງໜ້າທີ່ຂອງ the gamma : G(x). ຄ່າຕົວເລກຕອ້ງເປນຄ່າບວກ"

#: xml_doc.cc:1615
msgid "GAMMALN(Number)"
msgstr "GAMMALN(ຕົວເລກ)"

#: xml_doc.cc:1616
msgid "GAMMALN(2) returns 0"
msgstr "GAMMALN(2) ຈະໄດ້ຄ່າ 0"

#: xml_doc.cc:1618
msgid "lambda parameter (the middle value)"
msgstr "ຄ່າ lambda  (ຄ່າກາງ)"

#: xml_doc.cc:1620
msgid ""
"          Returns the Poisson distribution.          The lambda and number "
"parameters must be positive.          Cumulative = 0 calculates the density "
"function; cumulative = 1 calculates the distribution.        "
msgstr "ກັບໄປທີ່ການແຈກຈ່າຍ the Poisson. ຄ່າ The lambda ແລະຄ່າຕົວເລກຕ້ອງເປັນບວກ.          ເພີ່ມຂື້ນ = 0 ຄິດໄລ່ຄວາມໜາແໜ້ໜຂອງໜ້າທີ່; ເພີ່ມຂື້ນ = 1ຄິດໄລ່ການແຈກຈ່າຍ.       "

#: xml_doc.cc:1621
msgid "POISSON(number;lambda;cumulative)"
msgstr "POISSON(number;lambda;cumulative)"

#: xml_doc.cc:1622
msgid "POISSON(60;50;0) equals 0.020105"
msgstr "POISSON(60;50;0) equals 0.020105"

#: xml_doc.cc:1623
msgid "POISSON(60;50;1) equals 0.927840"
msgstr "POISSON(60;50;1) equals 0.927840"

#: xml_doc.cc:1624
msgid "level of the confidence interval"
msgstr "ລະດັບຄວາມແຕກຕ່າງ"

#: xml_doc.cc:1625
msgid "standard deviation for the total population"
msgstr "ມາດຕະຖານການຫັນເຫ ສຳລັບ ພົນລະເມືອງໂດຍລວມ"

#: xml_doc.cc:1626
msgid "size of the total population"
msgstr "ຂະຫນາດລວມຂອງຜົນລະເມືອງ"

#: xml_doc.cc:1627
msgid ""
"          Returns the confidence interval for a population mean. The alpha "
"parameter          must be between 0 and 1 (non-inclusive), stddev must be "
"positive and          size must be greater or equal to 1.        "
msgstr " ກັບໄປທີ່ຄວາມແຕກຕ່າງສຳລັບການສະເລ່ຍພົນລະເມືອງ . ຄ່າ The alpha ຕ້ອງຢູ່ລະຫວາ່ງ 0 ແລະ 1 (ບໍ່ນັບທັງໝົດ), stddev ຕ້ອງເປັນຄ່າບວກ ແລະ ຂະໜາດຕ້ອງໃຫ່ຍກວ່າ ຫຼື ເທົ່າກັບ 1.     "

#: xml_doc.cc:1628
msgid "CONFIDENCE(alpha;stddev;size)"
msgstr "CONFIDENCE(alpha;stddev;size)"

#: xml_doc.cc:1629
msgid "CONFIDENCE(0.05;1.5;100) equals 0.294059"
msgstr "CONFIDENCE(0.05;1.5;100) equals 0.294059"

#: xml_doc.cc:1631
msgid "degrees of freedom for the t-distribution"
msgstr "ລະດັບບໍ່ມີຂໍ້ຈຳກັດ the t-ການແຈກຈ່າຍ"

#: xml_doc.cc:1632
msgid "mode (1 or 2)"
msgstr "mode (1 or 2)"

#: xml_doc.cc:1633
msgid ""
"          Returns the t-distribution.           Mode = 1 returns the "
"one-tailed test, Mode = 2 returns the two-tailed test.        "
msgstr "  ກັບໄປທີ່ the t-ການແຈກຈ່າຍ.    Mode = 1ກັບໄປທີການກວດສອບ ນື່ງ, Mode = 2 ກັບໄປທີ່ການກວດສອບ ສອງ.       "

#: xml_doc.cc:1634
msgid "TDIST(number;degrees_freedom;mode)"
msgstr "TDIST(number;degrees_freedom;mode)"

#: xml_doc.cc:1635
msgid "TDIST(12;5;1) returns 0.000035"
msgstr "TDIST(12;5;1) ຈະໄດ້ຄ່າ 0.000035"

#: xml_doc.cc:1637
msgid "degrees of freedom 1"
msgstr "degrees of freedom 1"

#: xml_doc.cc:1638
msgid "degrees of freedom 2"
msgstr "degrees of freedom 2"

#: xml_doc.cc:1639
msgid "          Returns the f-distribution.        "
msgstr "    ກັບໄປທີ່ the f-ການແຈກຈ່າຍ.  "

#: xml_doc.cc:1640
msgid "FDIST(number;degrees_freedom_1;degrees_freedom_2)"
msgstr "FDIST(number;degrees_freedom_1;degrees_freedom_2)"

#: xml_doc.cc:1641
msgid "FDIST(0.8;8;12) yields 0.61"
msgstr "FDIST(0.8;8;12) yields 0.61"

#: xml_doc.cc:1643
msgid "degrees of freedom"
msgstr "degrees of freedom"

#: xml_doc.cc:1644
msgid ""
"          Returns the probability value from the indicated Chi square that a "
"hypothesis is confirmed. CHIDIST compares the Chi square value to be given "
"for a random sample that is calculated from the sum of (observed "
"value-expected value)^2/expected value for all values with the theoretical "
"Chi square distribution and determines from this the probability of error "
"for the hypothesis to be tested.        "
msgstr ""
"  ກັບໄປທີ່ຄາ່ຄວາມໜ້າຈະເປັນຈາກກຳນົດກຳລັງສອງ Chi ຊື່ງ a "
"hypothesis ຖືກຢືນຢັນ. CHIDIST ປຽບທຽບ ຄ່າກຳລັງສອງຂອງthe Chiທີ່ຈະໃຫ້ ສຳລັບຕົວຢ່າງຊຸ່ມເລືອກຊຶ່ງຖືກຄິດໄລ່ຈາກຜົນລວມຂອງ (ສັງເກດຄ່າ-expected value)^2/expected value ສຳລັບຄ່າທັງໝົດກັບກົດເກນ "
"ການແຈກຈ່າຍກຳລັງສອງຂອງChi ແລະ ກຳນົດຄ່າຈາກຄວາມໜ້າຈະເປັນນີ້ຂອງຄວາມຜິດພາດ ສຳລັບ the hypothesis ຈະເປັນການກວດສອບ.        "

#: xml_doc.cc:1645
msgid "CHIDIST(number;degrees_freedom)"
msgstr "CHIDIST(ຕົວເລກ;ມູມອົງສາອິດສະລະ)"

#: xml_doc.cc:1646
msgid "CHIDIST(13.27;5) returns 0.021"
msgstr "CHIDIST(13.27;5) ຈະໄດ້ຄ່າ 0.021"

#: xml_doc.cc:1649 xml_doc.cc:1655
msgid "Decimals"
msgstr "Decimals"

#: xml_doc.cc:1650
msgid ""
"The DOLLAR() function converts a number to text using currency format, with "
"the decimals rounded to the specified place. Although the name is DOLLAR, "
"this function will do the conversion according to the current locale."
msgstr ""
"The DOLLAR()ການປ່ຽນກູ່ມຄຳສັ່ງຕົວເລກໜື່ງຕໍ່ກັບຮູບແບບປະຈຸບັນຂອງການໃຊ້ເຕັກ,ດ້ວຍເລກຖານສິບຕໍ່ກັບສະຖານທີ່ສະເພາະ.ຕະ‍ຫລອດຊືແມ່ນດອນລາ"
"ກຸ່ມຄຳສັ່ງນີ່້ຈະທຳການປ່ຽນແປງໂດຍອີງຕາມສະຖານທີ່ເກີດໃນປະຈຸບັນ"

#: xml_doc.cc:1651
msgid "DOLLAR(number;decimals)"
msgstr "DOLLAR(number;decimals)"

#: xml_doc.cc:1652
msgid "DOLLAR(1403.77) returns \"$ 1,403.77\""
msgstr "DOLLAR(1403.77) ຈະໄດ້ຄ່າ \"$ 1,403.77\""

#: xml_doc.cc:1653
msgid "DOLLAR(-0.123;4) returns \"$-0.1230\""
msgstr "DOLLAR(-0.123;4) ຈະໄດ້ຄ່າ \"$-0.1230\""

#: xml_doc.cc:1656
msgid "No_commas"
msgstr "No_commas"

#: xml_doc.cc:1657
msgid ""
"The FIXED() function rounds a number to the specified number of decimals, "
"formats the number in decimal format string, and returns the result as text. "
"If decimals is negative, number is rounded to the left of the decimal point. "
"If you omit decimals, it is assumed to be 2. If optional parameter no_commas "
"is True, thousand separators will not show up."
msgstr ""
"The FIXED()ກຸ່ມຄຳສັ່ງກວມເອົາໝາຍເລກຕໍ່ກັບໝາຍເລກສະເພາະຂອງເລກຖານສິບ, "
"ຮູບແບບໝາຍເລກໃນການເຊື່ອມຕໍ່ຮູບແບບເລກຖານສິບ,ແລະການສົ່ງຜົນຮັບກັບຄືນໄປທີ່ເຕັກ. "
"ຖ້່່າເລກຖານສິບປະຕິເສດ,ໝາຍເລກໄດ້ຖືກກວມເອົາຕັ່ງແຕ່ເບື້ອງຊ້າຍຂອງທີ່ຕັ້ງເລກຖານສິບ. "
"ຖ້າເລກຖານສິບອະນຸຍາດ,ມັນຈະຖືກສົມມຸດວ່າເປັນເລກສອງ.ຖ້າພາຣາເມັດເຕີບໍ່ມີຄຳສັ່ງແມ່ນຄວາມຈິງ,ຕົວແຍກໜຶ່ງພັນຕົວຈະບໍ່ສະແດງອອກ."

#: xml_doc.cc:1658
msgid "FIXED(number;decimals;no_commas)"
msgstr "FIXED(number;decimals;no_commas)"

#: xml_doc.cc:1659
msgid "FIXED(1234.567;1) returns \"1,234.6\""
msgstr "FIXED(1234.567;1) ຈະໄດ້ຄ່າ \"1,234.6\""

#: xml_doc.cc:1660
msgid "FIXED(1234.567;1;FALSE) returns \"1234.6\""
msgstr "FIXED(1234.567;1;FALSE) ຈະໄດ້ຄ່າ \"1234.6\""

#: xml_doc.cc:1661
msgid "FIXED(44.332) returns \"44.33\""
msgstr "FIXED(44.332) ຈະໄດ້ຄ່າ \"44.33\""

#: xml_doc.cc:1662
msgid "Text for which you want to substitute"
msgstr "ເຕັກສຳລັບຕົວທີ່ທ່ານຕ້ອງການຈະແຍກອອກເຮັດໜ້າທ່ີ່ແທນ"

#: xml_doc.cc:1663
msgid "Part of text you want to replace"
msgstr "ພາກສ່ວນຂອງເຕັກທີ່່ທ່ານຕ້ອງການຈະນຳເອົາໄປແທນ"

#: xml_doc.cc:1664
msgid "New text which will be replacement"
msgstr "ຂໍ້ຄວາມໃຫມ່ຈະທຳການປ່ຽນໃຫມ່"

#: xml_doc.cc:1665
msgid "Occurrence of replacement"
msgstr "ຈະປາກົດປ່ຽນແປງ"

#: xml_doc.cc:1666
msgid ""
"The SUBSTITUTE() substitutes new_text for old_text in a text string. If "
"instance_num is specified, only that instance of old_text is replaced. "
"Otherwise, every occurrence of old_text is changed to new_text. Use "
"SUBSTITUTE when you want to replace specific text, use REPLACE when you want "
"to replace any text that occurs in a specific location."
msgstr ""
"The SUBSTITUTE() ເຕັກໃໝ່ທີ່ເປັນຕົວແທນສຳລັບເຕັກເກົ່າໃນການຂໍ້ຄວາມຕົວອັກສອນ.ຖ້າໝາຍເລກຕົວເລກຕົວຢ່າງຖືກເຈາະຈົງ,ພຽງແຕ່ວ່າໄປ"
"ແທນທີ່ເປັນຕົວຢ່າງຂອງເຕັກເກົ່າທີ່ຖືກນຳໄປແທນ. "
"ອີກຢ່າງໜຶ່ງ,ທຸກໆເຫດການຂອງເຕັກເກົ່າທີ່ຖືກປ່ຽນແປງໄປເປັນເຕັກໃໝ່.ໃຊ້"
"SUBSTITUTE ເມື່ອທ່້ານຕ້ອງການແທນບ່ອນເຕັກສະເພາະ,ໃຊ້REPLACEເມື່ອທ່ານຕ້ອງການແທນບ່ອນຫລາຍໆເຕັກທີ່ເກີດຂື່້ນໃນຕຳ"
"ແໜ່ງສະເພາະ"
"ຕໍ່ກັ�"

#: xml_doc.cc:1667
msgid "SUBSTITUTE(text; old_text; new_text; instance_num)"
msgstr "SUBSTITUTE(text; old_text; new_text; instance_num)"

#: xml_doc.cc:1668
msgid "SUBSTITUTE(\"Cost Data\";\"Cost\";\"Sales\") returns \"Sales Data\""
msgstr "SUBSTITUTE(\"Cost Data\";\"Cost\";\"Sales\") returns \"Sales Data\""

#: xml_doc.cc:1669
msgid "SUBSTITUTE(\"Qtr 1, 2001\";\"1\";\"3\";1) returns \"Qtr 3, 2001\""
msgstr "SUBSTITUTE(\"Qtr 1, 2001\";\"1\";\"3\";1) returns \"Qtr 3, 2001\""

#: xml_doc.cc:1670
msgid "SUBSTITUTE(\"Qtr 1, 2001\";\"1\";\"3\";4) returns \"Qtr 3, 2003\""
msgstr "SUBSTITUTE(\"Qtr 1, 2001\";\"1\";\"3\";4) returns \"Qtr 3, 2003\""

#: xml_doc.cc:1671 xml_doc.cc:1716
msgid "The text you want to find"
msgstr "ຂໍ້ຄວາມໃດທີ່ເຈົ້າຕ້ອງການຫາ"

#: xml_doc.cc:1672 xml_doc.cc:1717
msgid "The text which may contain find_text"
msgstr "ຂໍ້ຄວາມຈະບັນຈຸ find_text"

#: xml_doc.cc:1673
msgid "Specified index to start the search"
msgstr "ດັດສະນີສະເພາະເພື່ອເລີ່ມຊອກຫາ"

#: xml_doc.cc:1674
msgid ""
"The SEARCH() function finds one text string (find_text) within another text "
"string (within_text) and returns the number of the starting point of "
"find_text, from the leftmost character of within_text."
msgstr ""
"The SEARCH()ກຸ່ມຄຳສັ່ງໄດ້ຊອກເຕັກຕົວອັກສອນໜຶ່ງເຕັກ(find_text)ດ້ວຍເຕັກຕົວອັກສອນອື່ນໆ "
"(within_text)ແລະນຳເອົາໝາຍເລກຂອງການລິເລີ່ມຈຸູດການຊອກຫາເຕັກ,ຈາກຕົວອັກສອນສ່ວນໃຫບ່ຂອງ within_text."

#: xml_doc.cc:1675
msgid ""
"You can use wildcard characters, question mark (?) and asterisk (*). A "
"question mark matches any single character, an asterisk matches any "
"sequences of characters."
msgstr ""
"ທ່ານສາມາດໃຊ້ຕົົວອັກສອນວິວຄາຣດ,ເຄື່ອງໝາຍຖາມ(?)ແລະເຄື່ອງໝາຍດອກຈັນ(*).ເຄື່ອງໝາຍຄຳຖາມໜຶ່ງຈະ"
"ເຂົ້າກັບຫລາຍໆຕົວອັກສອນດ່ຽວ"
",ແລະເຄື່ອງໝາຍດອກຈັນໜື່ງຈະເຂົ້າກັບຫລາຍໆລຳດັບຂອງຕົວອັກສອນ."

#: xml_doc.cc:1676
msgid ""
"Parameter start_num specifies the character at which to start the search. "
"The first character is character number 1. If start_num is omitted, it is "
"assumed to be 1. SEARCH does not distinguish between uppercase and lowercase "
"letters."
msgstr ""
"ພາຣາແມັດເຕີ start_num ໄດ້ເຈາະຈົງຕົວອັກສອນໄປທີ່ການເລີ່ມຕົ້ນເພື່ອຊອກຫາ. "
"ຕົວອັກສອນທຳອິດແມ່ນໝາຍເລກໜື່ງ.ຖ້າstart_num ໄດ້ຖືກຍອມຮັບເອົາ,ມັນຈະຖື່ກສົມມຸດຂື້ນເປັນໝາຍເລກໜື່ງ,"
"ມັນໄດ້ຖືກສົມມຸດໃຫ້ເປັນໝາຍເລກໜຶ່ງ. SEARCHບໍ່ໄດ້ທຳການແບ່ງແຍກລະຫວ່າງຕົວອັກສອນໃນກໍລະນີທີ່ສູງກວ່າແລະຕຳ່ກວ່າ."

#: xml_doc.cc:1677
msgid "SEARCH(find_text;within_text;start_num)"
msgstr "SEARCH(find_text;within_text;start_num)"

#: xml_doc.cc:1678
msgid "SEARCH(\"e\";\"Statements\";6) returns 7"
msgstr "SEARCH(\"e\";\"Statements\";6) returns 7"

#: xml_doc.cc:1679
msgid "SEARCH(\"margin\";\"Profit Margin\") returns 8"
msgstr "SEARCH(\"margin\";\"Profit Margin\") returns 8"

#: xml_doc.cc:1681
msgid ""
"The T() function returns the text referred to by value. If value is, or "
"refers to, text then T returns value. If value does not refer to text then T "
"returns empty text."
msgstr ""
"ກຸ່ມຄຳສັ່ງ T() ນຳເອົາການອ້າງອີງເຕັກກັບຄືນໂດຍຄ່າ.ຖ້າຄ່າຫາກເປນັກຸ່ມຄຳສັ່ງ,ຫລືອ້າງອິ່ງເຖິງ,ເຕັກຫລັງຈາກນັ້ນຄຳສັ່ງ T      ໄດ້ນຳເອົາຄ່າກັບຄືນ.ຖ້າວ່າຄ່າຫາກບໍ່ອ້າງອີງເຖິງເຕັກຈາກນັ້ນຄຳສັ່ງ T "
"ໄດ້ນຳເອົາເຕັກເປົ່່າຫວ່າງກັບຄືນ."

#: xml_doc.cc:1682
msgid "T(value)"
msgstr "T(ຄ່າ)"

#: xml_doc.cc:1683
msgid "T(\"KOffice\") returns \"KOffice\""
msgstr "T(\"KOffice\") ຈະໄດ້ຄ່າ \"KOffice\""

#: xml_doc.cc:1684
msgid "T(1.2) returns \"\" (empty text)"
msgstr "T(1.2) returns \"\" (empty text)"

#: xml_doc.cc:1686
msgid "The TEXT() function converts a value to text."
msgstr ""
"ຟັງຊັ້ນ TEXT() "
"ໃຊ້ສຳລັບແປງຄ່າຕົວເລກເປັນຂໍ້ຄວາມ"

#: xml_doc.cc:1687
msgid "TEXT(value)"
msgstr "TEXT(ຄ່າ)"

#: xml_doc.cc:1688
msgid "TEXT(1234.56) returns \"1234.56\""
msgstr "TEXT(1234.56) ຈະໄດ້ຄ່າ \"1234.56\""

#: xml_doc.cc:1689
msgid "TEXT(\"KSpread\") returns \"KSpread\""
msgstr "TEXT(\"KSpread\") ຈະໄດ້ຄ່າ \"KSpread\""

#: xml_doc.cc:1690 xml_doc.cc:1702 xml_doc.cc:1703 xml_doc.cc:1734
#: xml_doc.cc:1739
msgid "String"
msgstr "ຂໍ້ຄວາມ"

#: xml_doc.cc:1691
msgid ""
"The PROPER() function converts the first letter of each word to uppercase "
"and the rest of the letters to lowercase."
msgstr ""
" ກຸ່ມຄຳສ່ັງ PROPER()ໄດ້ທຳການປ່່ຽນແປງອັກສອນທຳອິດຂອງແຕ່ລະຄຳສັບເພື່ອໄປສູ່ກໍລະນີທີ່ສູງກວ່າ"
"ແລະສ່ວນຂອງອັກສອນເພື່ອໄປສູ່ກໍລະນີທີ່ສູງກວ່າ."

#: xml_doc.cc:1692
msgid "PROPER(string)"
msgstr "PROPER(string)"

#: xml_doc.cc:1693
msgid "PROPER(\"this is a title\") returns \"This Is A Title\""
msgstr "PROPER(\"this is a title\") ຈະໄດ້ຄ່າ \"This Is A Title\""

#: xml_doc.cc:1694
msgid "First String"
msgstr "ຂໍ້ຄວາມທຳອິດ"

#: xml_doc.cc:1695
msgid "String to compare with"
msgstr "ຂໍ້ຄວາມທີຈະປ່ຽບທຽບດ້ວຍ"

#: xml_doc.cc:1696
msgid "Compare case-sensitive (true/false)?"
msgstr "ປຽບທຽບໂດຍພິຈະລະນາຕົວພິມດ້ິວຍ (ຈິງ/ເທັດ)?"

#: xml_doc.cc:1697
msgid ""
"The COMPARE() function returns 0 if the two strings are equal; -1 if the "
"first one is lower in value than the second one; otherwise it returns 1."
msgstr ""
"ຟັງຊັ້ນ COMPARE() "
"ຈະຄືນຄ່າກັບມາເປັນ 0 "
"ຫາກຂໍ້ຄວາມທັງສອງເທົ່າກັນ; -1 "
"ຫາກຂໍ້ຄວາມທຳອິດນອ້ຍກວ່າຄ່າໃນຂໍ້ຄວາມທີ່ສອງ; "
"ແລະຄືນຄ່າເປັນ 1 "
"ໃນກໍລະນີນອກເຫນືອຈາກນີ້"

#: xml_doc.cc:1698
msgid "COMPARE(string1; string2; true|false)"
msgstr "COMPARE(ຂໍ້ຄວາມ1; ຂໍ້ຄວາມ2; true|false)"

#: xml_doc.cc:1699
msgid "COMPARE(\"KOffice\"; \"KOffice\"; true) returns 0"
msgstr "COMPARE(\"KOffice\"; \"KOffice\"; true) ຈະໄດ້ຄ່າ 0"

#: xml_doc.cc:1700
msgid "COMPARE(\"koffice\"; \"KOffice\"; true) returns 1"
msgstr "COMPARE(\"koffice\"; \"KOffice\"; true) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:1701
msgid "COMPARE(\"kspread\"; \"KOffice\"; false) returns 1"
msgstr "COMPARE(\"kspread\"; \"KOffice\"; false) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:1704
msgid ""
"The EXACT() function returns True if these two strings are equal. Otherwise, "
"it returns False."
msgstr ""
"ຟັງຊັ້ນ EXACT() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າ True "
"ຫາກຂໍ້ຄວາມທັງສອງຕົວເທົ່າກັນບໍ່ເຊັ່ນນັ້ນກໍຈະຄືນຄ່າມາເປັນ False"

#: xml_doc.cc:1705
msgid "EXACT(string1;string2)"
msgstr "EXACT(ຂໍ້ຄວາມ1;ຂໍ້ຄວາມ2)"

#: xml_doc.cc:1706
msgid "EXACT(\"KOffice\";\"KOffice\") returns True"
msgstr "EXACT(\"KOffice\";\"KOffice\") ຈະໄດ້ວ່າ True"

#: xml_doc.cc:1707
msgid "EXACT(\"KSpread\";\"KOffice\") returns False"
msgstr "EXACT(\"KSpread\";\"KOffice\") ຈະໄດ້ຄ່າ False"

#: xml_doc.cc:1708
msgid "Text which you want to replace some characters"
msgstr "ຂໍ້ຄວາມທີ່ທ່ານຕ້ອງການຈະແທນທີ່ດ້ວຍຕົວອັກສອນບາງຕົວ"

#: xml_doc.cc:1709
msgid "Position of the characters to replace"
msgstr "ຕຳແຫນ່ງຂອງຕົວອັກສອນທີ່ຈະແທນທີ"

#: xml_doc.cc:1710
msgid "Number of characters to replace"
msgstr "ຈຳນວນຕົວອັກສອນທີ່ຈະແທນທີ"

#: xml_doc.cc:1711
msgid "The text that will replace characters in old text"
msgstr "ຂໍ້ຄວາມຈະແທນທີ່ຕົວອັກສອນໃນຂໍ້ຄວາມເດີມ"

#: xml_doc.cc:1712
msgid ""
"The REPLACE() function replaces part of a text string with a different text "
"string."
msgstr ""
"ຟັງຊັ້ນ REPLACE() "
"ໃຊ້ໃນການຄົ້ນຫາຂໍ້ຄວາມບາງສ່ວນ"
"ແລະແທນທີ່ຂໍ້ຄວາມທີ່ພົບດ້ວຍຂໍ້ຄວາມໃຫມ່"

#: xml_doc.cc:1713
msgid "REPLACE(text;position;length;new_text)"
msgstr "REPLACE(ຂໍ້ຄວາມ;ຕຳແຫນ່ງ;ຄວາມຍາວ;ຂໍຄວາມໃຫມ່)"

#: xml_doc.cc:1714
msgid "REPLACE(\"abcdefghijk\";6;5;\"-\") returns \"abcde-k\""
msgstr "REPLACE(\"abcdefghijk\";6;5;\"-\") ຈະໄດ້ຄ່າ \"abcde-k\""

#: xml_doc.cc:1715
msgid "REPLACE(\"2002\";3;2;\"03\") returns \"2003\""
msgstr "REPLACE(\"2002\";3;2;\"03\") ຈະໄດ້ຄ່າ \"2003\""

#: xml_doc.cc:1718
msgid "Specifies index to start the search"
msgstr "ກຳນົດຕຳແຫນ່ງທີ່ຈະໃຊ້ເລີ່ມຄົ້ນຫາ"

#: xml_doc.cc:1719
msgid ""
"The FIND() function finds one text string (find_text) within another text "
"string (within_text) and returns the number of the starting point of "
"find_text, from the leftmost character of within_text."
msgstr ""
"ຟັງຊັ້ນ FIND() "
"ໃຊ້ສຳລັບຄົ້ນຫາຂໍ້ຄວາມແລກ"
"(ຂໍ້ຄວາມທີ່ຈະຄົ້ນຫາ) "
"ພາຍໃນຂໍ້ຄວາມທີ່ສອງ"
"(ຂໍ້ຄວາມທີ່ຈະຄົ້ນຫາພາຍໃນ) "
"ແລະຄືນຄ່າກັບມາເປັນຕຳແຫນ່ງທຳອິດທີຄົ້ນພົບ"

#: xml_doc.cc:1720
msgid ""
"Parameter start_num specifies the character at which to start the search. "
"The first character is character number 1. If start_num is omitted, it is "
"assumed to be 1."
msgstr ""
"Parameter start_num specifies the character at which to start the search. "
"The first character is character number 1. If start_num is omitted, it is "
"assumed to be 1."

#: xml_doc.cc:1721
msgid ""
"You can also use function SEARCH, but unlike SEARCH, FIND is case-sensitive "
"and does not allow wildcard characters."
msgstr ""
"You can also use function SEARCH, but unlike SEARCH, FIND is case-sensitive "
"and does not allow wildcard characters."

#: xml_doc.cc:1722
msgid "FIND(find_text;within_text;start_num)"
msgstr "FIND(ຂໍ້ຄວາມທີຈະຄົ້ນຫາ ຂໍ້ຄວາມທີຈະຄົ້ນຫາພາຍໃນ ເລີ່ມທີ່ຕຳແຫນ່ງ)"

#: xml_doc.cc:1723
msgid "FIND(\"KOf\";\"KOffice\") returns 1"
msgstr "FIND(\"KOf\";\"KOffice\") ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:1724
msgid "FIND(\"i\";\"KOffice\") returns 5"
msgstr "FIND(\"i\";\"KOffice\") ຈະໄດ້ຄ່າ 5"

#: xml_doc.cc:1725
msgid "FIND(\"K\";\"KSpread in KOffice\";4) returns 12"
msgstr "FIND(\"K\";\"KSpread in KOffice\";4) ຈະໄດ້ຄ່າ 12"

#: xml_doc.cc:1726 xml_doc.cc:1760 xml_doc.cc:1767 xml_doc.cc:1774
#: xml_doc.cc:1785 xml_doc.cc:1791 xml_doc.cc:1795 xml_doc.cc:1799
#: xml_doc.cc:1804
msgid "Source string"
msgstr "ຂໍ້ຄວາມຕົ້ນສະບັບ"

#: xml_doc.cc:1727
msgid "Position"
msgstr "ຕຳແຫນ່ງ"

#: xml_doc.cc:1728
msgid "Length"
msgstr "ຄວາມຍາວ"

#: xml_doc.cc:1729
msgid ""
"The MID() function returns a substring that contains 'length' characters of "
"the string, starting at 'position' index."
msgstr ""
"ຟັງຊັ້ນ MID() "
"ຈະຄື່ນຄ່າກັບມາເປັນຂໍ້ຄວາມບາງສວ່ນເລີ່ມຕັ້ງແຕ່ "
"'ຕຳແຫນ່ງ' ທີ່ມີ 'ຄວາມຍາວ' "
"ຈາກຂໍ້ຄວາມຕົ້ນສະບັບ"

#: xml_doc.cc:1730
msgid "MID(text;position;length)"
msgstr "MID(ຂໍ້ຄວາມ;ຕຳແຫນ່ງ;ຄວາມຍາວ)"

#: xml_doc.cc:1731
msgid "MID(text;position)"
msgstr "MID(ຂໍ້ຄວາມ; ຕຳແຫນ່ງ)"

#: xml_doc.cc:1732
msgid "MID(\"KOffice\";2;3) returns \"Off\""
msgstr "MID(\"KOffice\";2;3) ຈະໄດ້ຄ່າ \"Off\""

#: xml_doc.cc:1733
msgid "MID(\"KOffice\";2) returns \"Office\""
msgstr "MID(\"KOffice\";2) ຈະໄດ້ຄ່າ \"Office\""

#: xml_doc.cc:1735
msgid "The LEN() function returns the length of the string."
msgstr ""
"ຟັງຊັ້ນ LEN() "
"່ຈະຄືນຄ່າກັບມາເປັນຄ່າຄວາມຍາຍຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1736
msgid "LEN(text)"
msgstr "LEN(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1737
msgid "LEN(\"hello\") returns 5"
msgstr "LEN(\"hello\") ຈະໄດ້ຄ່າ 5"

#: xml_doc.cc:1738
msgid "LEN(\"KSpread\") returns 7"
msgstr "LEN(\"KSpread\") ຈະໄດ້ຄ່າ 7"

#: xml_doc.cc:1740
msgid "The TRIM() function returns text with only single spaces between words."
msgstr ""
"ຟັງຊັ້ນ TRIM() "
"ຈະຄືນຄ່າກັບມາເປັນຂໍ້ຄວາມທີ່ມີຊ່ອງວ່າງດ່ຽວຯ ລະຫວ່າງຄຳ"

#: xml_doc.cc:1741
msgid "TRIM(text)"
msgstr "TRIM(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1742
msgid "TRIM(\" hello    KSpread   \") returns \"hello KSpread\""
msgstr "TRIM(\" hello    KSpread   \") ຈະໄດ້ຄ່າ \"hello KSpread\""

#: xml_doc.cc:1748
msgid ""
"The CONCATENATE() function returns a string which is the concatenation of "
"the strings passed as parameters."
msgstr ""
"ຟັງຊັ້ນ CONCATENATE() "
"ຈະຄືນຄ່າກັບມາເປັນຂໍ້ຄວາມທີ່ໄດ້ຈາກການລວມຂໍ້ຄວາມທີ່ສົ່ງມາເປັນພາລາມິເຕີ"

#: xml_doc.cc:1749
msgid "CONCATENATE(value;value;...)"
msgstr "CONCATENATE(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1750
msgid "CONCATENATE(\"KSpread\";\"KOffice\";\"KDE\") returns \"KSpreadKOfficeKDE\""
msgstr ""
"CONCATENATE(\"KSpread\";\"KOffice\";\"KDE\") ຈະໄດ້ຄ່າ "
"\"KSpreadKOfficeKDE\""

#: xml_doc.cc:1756
msgid ""
"The JOIN() function returns a string which is the concatenation of the "
"strings passed as parameters."
msgstr ""
"ຟັງຊັ້ນ JOIN() "
"ຈະຄືນຄ່າກັບມາເປັນຂໍ້ຄວາມທີ່ເກີດຈາກການລວມກັນຂອງຂໍ້ຄວາມທີ່ສົ່ງມາໃຫ້"

#: xml_doc.cc:1757
msgid ""
"This function is obsolete and will be removed in a later version of KSpread. "
"It is provided only for compatibility. Please use the CONCATENATE function "
"instead."
msgstr ""
"ຟັງຊັ້ນນີ້ແມ່ນລ້າສະໄໝແລະຈະຖືກຍົກເລີກຂອງເວີຊັ້ນ KSpread "
"ມັນແມ່ນການຈັດຫາພຽງໂຕທີ່ເຂົ້າກັນ.ກະລຸນາໃຊ້ ຟັງຊັ້ນ CONCATENATE"

#: xml_doc.cc:1758
msgid "JOIN(value;value;...)"
msgstr "JOIN(ຄ່າ;ຄ່າ;...)"

#: xml_doc.cc:1759
msgid "JOIN(\"KSpread\";\"KOffice\";\"KDE\") returns \"KSpreadKOfficeKDE\""
msgstr ""
"JOIN(\"KSpread\";\"KOffice\";\"KDE\") ຈະໄດ້ຄ່າ"
"\"KSpreadKOfficeKDE\""

#: xml_doc.cc:1761 xml_doc.cc:1768
msgid "Amount of characters"
msgstr "ຈຳນວນລວມຂອງອັກຂະລະ"

#: xml_doc.cc:1762
msgid ""
"The RIGHT() function returns a substring that contains the 'length' "
"rightmost characters of the string. The whole string is returned if 'length' "
"exceeds the length of the string."
msgstr ""
"ຟັງຊັ້ນ RIGHT() "
"ຈະຄືນຄ່າກັບມາເປັນຂໍ້ຄວາມທີ່ມີ 'ຄວາມຍາວ' "
"ນັບຈາກດ້ານຂວາຂອງ ຂໍ້ຄວາມແລະຈະຄືນມາທັງຂໍ້ຄວາມຫາກ "
"'ຄວາມຍາວ' "
"ມີຄ່າຫລາຍກວ່າຄວາມຍາວຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1763
msgid "RIGHT(text;length)"
msgstr "RIGHT(ຂໍ້ຄວາມ;ຄວາມຍາວ)"

#: xml_doc.cc:1764
msgid "RIGHT(\"hello\";2) returns \"lo\""
msgstr "RIGHT(\"hello\";2) ຈະໄດ້ຄ່າ \"lo\""

#: xml_doc.cc:1765
msgid "RIGHT(\"KSpread\";10) returns \"KSpread\""
msgstr "RIGHT(\"KSpread\";10) ຈະໄດ້ຄ່າ \"KSpread\""

#: xml_doc.cc:1766
msgid "RIGHT(\"KSpread\") returns \"d\""
msgstr "RIGHT(\"KSpread\") ຈະໄດ້ຄ່າ \"d\""

#: xml_doc.cc:1769
msgid ""
"The LEFT() function returns a substring that contains the 'length' leftmost "
"characters of the string. The whole string is returned if 'length' exceeds "
"the length of the string."
msgstr ""
"ຟັງຊັ້ນ LEFT() "
"ຈະຄືນຄ່າຂໍ້ຄວາມທີ່ມີ"
"'ຄວາມຍາວ' "
"ນັບຈາກດ້ານຊ້າຍຂອງຂໍ້ຄວາມທີ່ສົ່ງມາ"
"ແລະຈະຄືນມາທັງຂໍ້ຄວາມຫາກ"
"'ຄວາມຍາວ' "
"ມີຄ່າຫລາຍກວ່າຄວາມຍາວຂອງຂໍ້ຄວາມ"

#: xml_doc.cc:1770
msgid "LEFT(text;length)"
msgstr "LEFT(ຂໍ້ຄວາມ;ຄວາມຍາວ)"

#: xml_doc.cc:1771
msgid "LEFT(\"hello\";2) returns \"he\""
msgstr "LEFT(\"hello\";2) ຈະໄດ້ຄ່າ \"he\""

#: xml_doc.cc:1772
msgid "LEFT(\"KSpread\";10) returns \"KSpread\""
msgstr "LEFT(\"KSpread\";10) ຈະໄດ້ຄ່າ\"KSpread\""

#: xml_doc.cc:1773
msgid "LEFT(\"KSpread\") returns \"K\""
msgstr "LEFT(\"KSpread\") ຈະໄດ້ຄ່າ\"K\""

#: xml_doc.cc:1775
msgid "Count of repetitions"
msgstr "ຈຳນວນທີ່ໃຫ້ເຮັດຊຳ້"

#: xml_doc.cc:1776
msgid ""
"The REPT() function repeats the first parameter as often as told by the "
"second parameter."
msgstr ""
"The REPT() function repeats the first parameter as often as told by the "
"second parameter."

#: xml_doc.cc:1777
msgid "REPT(text;count)"
msgstr "REPT(text;count)"

#: xml_doc.cc:1778
msgid "REPT(\"KSpread\";3) returns \"KSpreadKSpreadKSpread\""
msgstr "REPT(\"KSpread\";3) returns \"KSpreadKSpreadKSpread\""

#: xml_doc.cc:1780
msgid ""
"The ROT() function encrypts text by replacing each letter with the one 13 "
"places along in the alphabet. If the 13th position is beyond the letter Z, "
"it begins again at A (rotation)."
msgstr ""
"The ROT() function encrypts text by replacing each letter with the one 13 "
"places along in the alphabet. If the 13th position is beyond the letter Z, "
"it begins again at A (rotation)."

#: xml_doc.cc:1781
msgid ""
"By applying the encryption function again to the resulting text, you can "
"decrypt the text."
msgstr ""
"By applying the encryption function again to the resulting text, you can "
"decrypt the text."

#: xml_doc.cc:1782
msgid "ROT(Text)"
msgstr "ROT(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1783
msgid "ROT(\"KSpread\") returns \"XFcernq\""
msgstr "ROT(\"KSpread\") ຈະໄດ້ \"XFcernq\""

#: xml_doc.cc:1784
msgid "ROT(\"XFcernq\") returns \"KSpread\""
msgstr "ROT(\"XFcernq\") ຈະໄດ້ \"KSpread\""

#: xml_doc.cc:1786
msgid ""
"The TOGGLE() function changes lowercase characters to uppercase and "
"uppercase characters to lowercase."
msgstr ""
"ຟັງຊັ້ນ TOGGLE() "
"ໃຊ້ໃນການສະລັບຕົວພິມຂອງຂໍ້ຄວາມ"
"ຈາກຕົວພິມນ້ອຍແລະກາຍເປັນຕົວພິມໃຫຍ່ແລະຈາກຕົວພິມໃຫຍ່ຈະ "
"ກາຍເປັນຕົວພິມນອ້ຍ"

#: xml_doc.cc:1787
msgid "TOGGLE(text)"
msgstr "TOGGLE(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1788
msgid "TOGGLE(\"hello\") returns \"HELLO\""
msgstr "TOGGLE(\"hello\") ຈະໄດ້ \"HELLO\""

#: xml_doc.cc:1789
msgid "TOGGLE(\"HELLO\") returns \"hello\""
msgstr "TOGGLE(\"HELLO\") ຈະໄດ້ \"hello\""

#: xml_doc.cc:1790
msgid "TOGGLE(\"HeLlO\") returns \"hElLo\""
msgstr "TOGGLE(\"HeLlO\") ຈະໄດ້ \"hElLo\""

#: xml_doc.cc:1792
msgid "The CLEAN() function removes every non-printable character from the string"
msgstr ""
"ຟັງຊັ້ນ CLEAN() "
"ໃ້ໍຊ້ໃນການລືບອັກຂະລະທີ່ບໍ່ສາມາດພິມໄດ້ທັງຫມົດອອກຈາກຂໍ້ຄວາມ"

#: xml_doc.cc:1793
msgid "CLEAN(text)"
msgstr "CLEAN(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1794
msgid "CLEAN(AsciiToChar(7) + \"HELLO\") returns \"HELLO\""
msgstr "CLEAN(AsciiToChar(7) + \"HELLO\") ຈະໄດ້ \"HELLO\""

#: xml_doc.cc:1796
msgid "The SLEEK() function removes all spaces from the string."
msgstr ""
"ຟັງຊັ້ນ SLEEK() "
"ໃຊ້ໃນການລືບຊ່ອງວ່າທັງຫມົດອອກຈາກຂໍ້ຄວາມ"

#: xml_doc.cc:1797
msgid "SLEEK(text)"
msgstr "SLEEK(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1798
msgid "SLEEK(\"This is   some  text \") returns \"Thisissometext\""
msgstr "SLEEK(\"This is   some  text \") ຈະໄດ້ \"Thisissometext\""

#: xml_doc.cc:1800
msgid "The UPPER() function converts a string to upper case."
msgstr ""
"ຟັງຊັ້ນ UPPER() "
"ໃຊ້ແປງຂໍ້ຄວາມໃຫ້ເປັນຕົວພິມໃຫຍ່ທັງໝົດ"

#: xml_doc.cc:1801
msgid "UPPER(text)"
msgstr "UPPER(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1802
msgid "UPPER(\"hello\") returns \"HELLO\""
msgstr "UPPER(\"hello\") ຈະໄດ້ \"HELLO\""

#: xml_doc.cc:1803
msgid "UPPER(\"HELLO\") returns \"HELLO\""
msgstr "UPPER(\"HELLO\") ຈະໄດ\"HELLO\""

#: xml_doc.cc:1805
msgid "The LOWER() function converts a string to lower case."
msgstr ""
"ຟັງຊັ້ນ LOWER() "
"ໃຊ້ແປງຂໍ້ຄວາມໃຫ້ເປັນຕົວພິມນ້ອຍທັງຫມົດ"

#: xml_doc.cc:1806
msgid "LOWER(text)"
msgstr "LOWER(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1807
msgid "LOWER(\"hello\") returns \"hello\""
msgstr "LOWER(\"hello\") ຈະໄດ້ \"hello\""

#: xml_doc.cc:1808
msgid "LOWER(\"HELLO\") returns \"hello\""
msgstr "LOWER(\"HELLO\") ຈະໄດ້ \"hello\""

#: xml_doc.cc:1809
msgid "Character Code"
msgstr "ລະຫັດອັກຂະລະ"

#: xml_doc.cc:1810
msgid "The CHAR() function returns the character specified by a number."
msgstr ""
"ຟັງຊັ້ນ CHAR() "
"ຈະຄືນຄ່າເປັນອັກຂະລະທີ່ີມີລະຫັດຕົວເລກກົງກບັທີ່ກຳນົດ"

#: xml_doc.cc:1811
msgid "CHAR(code)"
msgstr "CHAR(ລະຫັດ)"

#: xml_doc.cc:1812
msgid "CHAR(65) returns \"A\""
msgstr "CHAR(65) ຈະໄດ້ຄ່າ \"A\""

#: xml_doc.cc:1814
msgid ""
"The CODE() function returns a numeric code for the first character in a text "
"string."
msgstr ""
"ຟັງຊັ້ນ CODE() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າລະຫັດຕົວເລກຂອງອັກຂະລະທຳອິດໃນຂໍ້ຄວາມ"

#: xml_doc.cc:1815
msgid "CODE(text)"
msgstr "CODE(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1816
msgid "CODE(\"KDE\") returns 75"
msgstr "CODE(\"KDE\") ຈະໄດ້ຄ່າ 75"

#: xml_doc.cc:1818
msgid "Converts text string that represents a value to the real value.  "
msgstr "ແປງຂໍ້ຄວາມທີ່ມີລັກສະນະເປັນຄ່າຕົວເລກໃຫ້ເປັນຄ່າຕົວເລກຈືງ"

#: xml_doc.cc:1819
msgid "VALUE(text)"
msgstr "VALUE(ຂໍ້ຄວາມ)"

#: xml_doc.cc:1820
msgid "VALUE(\"14.03\") returns 14.03"
msgstr "VALUE(\"14.03\") ຈະໄດ້ຮັບຄ່າ 14.03"

#: xml_doc.cc:1821
msgid "Trigonometric"
msgstr "ຕິໂກມິຕິ"

#: xml_doc.cc:1823
msgid "The COS() function returns the cosine of x, where x is given in radians."
msgstr ""
"ຟັງຊັ່ນ COS() ຈະຄືນຄ່າ cosine ຂອງ x, "
"ໂດຍ x ມີຫນ່ວຍເປັນເຣດ່ຽນ"

#: xml_doc.cc:1824
msgid "COS(Float)"
msgstr "COS(ເລກທົດນິຍົມ)"

#: xml_doc.cc:1825
msgid "COS(0) equals 1.0"
msgstr "COS(0) ມີຄ່າເທົ່ກັບ 1.0"

#: xml_doc.cc:1826
msgid "COS(PI()/2) equals 0"
msgstr "COS(PI()/2) ມີຄ່າເທົ່າກັບ 0.0"

#: xml_doc.cc:1828
msgid "The SIN() function returns the sine of x, where x is given in radians."
msgstr ""
"ຟັງຊັ້ນ SIN() ຈະຄືນຄ່າ sine ຂອງ x, "
"ໂດຍທີ x ມີໜວ່ຍເປັນເຣດ່ຽນ"

#: xml_doc.cc:1829
msgid "SIN(Float)"
msgstr "SIN(ເລກທົດນິຍົມ)"

#: xml_doc.cc:1830
msgid "SIN(0) equals 0"
msgstr "SIN(0) ມີຄ່າເທົ່າກັບ 0"

#: xml_doc.cc:1831
msgid "SIN(PI()/2) equals 1"
msgstr "SIN(PI()/2) ມີຄ່າເທົ່າກັບ 1"

#: xml_doc.cc:1833
msgid "The TAN() function returns the tangent of x, where x is given in radians."
msgstr ""
"ຟັງຊັ້ນ TAN() ຈະຄືນຄ່າ tangent ຂອງ x, "
"ໂດຍທີ່ x ມີໜວ່ຍເປັນເຣດຽນ"

#: xml_doc.cc:1834
msgid "TAN(Float)"
msgstr "TAN(ເລກທົດນິຍົມ)"

#: xml_doc.cc:1835
msgid "TAN(0.7) equals 0.84228838"
msgstr "TAN(0.7) ມີຄ່າເທົ່າກບັ 0.84228838"

#: xml_doc.cc:1836
msgid "TAN(0) equals 0"
msgstr "TAN(0) ມີຄ່າເທົ່າກັບ 0"

#: xml_doc.cc:1838
msgid ""
"The ACOS() function returns the arc cosine in radians and the value is "
"mathematically defined to be 0 to PI (inclusive)."
msgstr ""
"ຟັງຊັ້ນ ACOS() ຈະຄືນຄ່າ arc cosine "
"ໃນໜ່ວຍໃນໜວ່ຍລາດ່ຽນໂດຍຄ່າທີ່ໄດ້ນັ້ນເປັນຄ່າເລກຄະນິດທີ່ຢູ່ລະຫວ່າງ 0 ເຖິ່ງຄ່າ PI"

#: xml_doc.cc:1839
msgid "ACOS(Float)"
msgstr "ACOS(ເລກທົດສະນິຍົມ)"

#: xml_doc.cc:1840
msgid "ACOS(0.8) equals 0.6435011"
msgstr "ACOS(0.8) ມີຄ່າເທົ່າກັບ 0.6435011"

#: xml_doc.cc:1841
msgid "ACOS(0) equals 1.57079633"
msgstr "ACOS(0) ມິຄ່າເທົ່າກັບ 1.57079633"

#: xml_doc.cc:1843
msgid ""
"The ASIN() function returns the arc sine in radians and the value is "
"mathematically defined to be -PI/2 to PI/2 (inclusive)."
msgstr ""
"ຟັງຊັ້ນ ASIN() ຈະຄືນຄ່າ arc sine "
"ໃນໜ່ວຍລາດຽໜໂດຍຄ່າທີ່ໄດ້ນັ້ນ"
"ເປັນຄ່າເລກຄະນິດທີ່ຢູ່ລະຫວ່າງ -PI/2 ถึงค่า PI/2"

#: xml_doc.cc:1844
msgid "ASIN(Float)"
msgstr "ASIN(ເລກທົດສະນິຍົມ)"

#: xml_doc.cc:1845
msgid "ASIN(0.8) equals 0.92729522"
msgstr "ASIN(0.8) ມິຄ່າເທົ່າກັບ 0.92729522"

#: xml_doc.cc:1846
msgid "ASIN(0) equals 0"
msgstr "ASIN(0) ມິຄ່າເທົ່າກັບ 0"

#: xml_doc.cc:1848
msgid ""
"The ATAN() function returns the arc tangent in radians and the value is "
"mathematically defined to be -PI/2 to PI/2 (inclusive)."
msgstr ""
"ຟັງຊັ້ນ ATAN() ຈະຄືນຄ່າ arc tangent "
"ໃນໜ່ວຍລາດຽນໂດຍຄ່າທີ່ໄດ້ນັ້ນໂດຍຄ່າທີ່ໄດ້ນັ້ນເປັນຄ່າເລກຄະນິດທີ່ລະຫວ່າງ "
"-PI/2 ถึงค่า PI/2"

#: xml_doc.cc:1849
msgid "ATAN(Float)"
msgstr "ATAN(ເລກທົດນິຍົມ)"

#: xml_doc.cc:1850
msgid "ATAN(0.8) equals 0.67474094"
msgstr "ATAN(0.8) ມິຄ່າເທົ່າກັບ 0.67474094"

#: xml_doc.cc:1851
msgid "ATAN(0) equals 0"
msgstr "ATAN(0) ມິຄ່າເທົ່າກັບ 0"

#: xml_doc.cc:1853
msgid ""
"The COSH() function returns the hyperbolic cosine of x, which is defined "
"mathematically as (exp(x) + exp(-x)) / 2."
msgstr ""
"ຟັງຊັ້ນ COSH() ຈະຄືນຄ່າ hyperbolic cosine "
"ຂອງ x, "
"ໂດຍນິຍາມທາງຄະນິດສາດຄື"
"(exp(x) + exp(-x)) / 2"

#: xml_doc.cc:1854
msgid "COSH(Float)"
msgstr "COSH(ເລກທົດນິຍົມ)"

#: xml_doc.cc:1855
msgid "COSH(0.8) equals 1.33743495"
msgstr "COSH(0.8) ມິຄ່າເທົ່າກັບ 1.33743495"

#: xml_doc.cc:1856
msgid "COSH(0) equals 1"
msgstr "COSH(0) ມິຄ່າເທົ່າກັບ 1"

#: xml_doc.cc:1858
msgid ""
"The SINH() function returns the hyperbolic sine of x, which is defined "
"mathematically as (exp(x) - exp(-x)) / 2."
msgstr ""
"ຟັງຊັ້ນ SINH() ຈະຄືນຄ່າ hyperbolic sine "
"ຂອງ x "
"ໂດຍນິຍາມທາງຄະນິດສາດຄື "
"(exp(x) - exp(-x)) / 2"

#: xml_doc.cc:1859
msgid "SINH(Float)"
msgstr "SINH(ເລກທົດນິຍົມ)"

#: xml_doc.cc:1860
msgid "SINH(0.8) equals 0.88810598"
msgstr "SINH(0.8) ມິຄ່າເທົ່າກັບ 0.88810598"

#: xml_doc.cc:1861
msgid "SINH(0) equals 0"
msgstr "SINH(0) ມິຄ່າເທົ່າກັບ 0"

#: xml_doc.cc:1863
msgid ""
"The TANH() function returns the hyperbolic tangent of x, which is defined "
"mathematically as sinh(x)/cosh(x)."
msgstr ""
"ຟັງຊັ້ນ TANH() ຈະຄືນຄ່າ hyperbolic tangent "
"ຂອງ x, ໂດຍນິຍາມ "
"ທາງຄະນິດສາດຄື sinh(x)/cosh(x)"

#: xml_doc.cc:1864
msgid "TANH(Float)"
msgstr "TANH(ເລກທົດສະນິຍົມ)"

#: xml_doc.cc:1865
msgid "TANH(0.8) equals 0.66403677"
msgstr "TANH(0.8) ມິຄ່າເທົ່າກັບ 0.66403677"

#: xml_doc.cc:1866
msgid "TANH(0) equals 0"
msgstr "TANH(0) ມິຄ່າເທົ່າກັບ 0"

#: xml_doc.cc:1868
msgid ""
"The ACOSH() function calculates the inverse hyperbolic cosine of x. That is "
"the value whose hyperbolic cosine is x. If x is less than 1.0, acosh() "
"returns not-a-number (NaN) and errno is set."
msgstr ""
"ຟັງຊັ້ນ ACOSH() ໃຊ້ຄຳນວນຫາຄ່າ "
"inverse hyperbolic cosine ຂອງ x "
"ໂດຍຕົວທີ່ເປັນຄ່າ hyperbolic cosine ຄື "
"x ຫາກ x ນອ້ຍກວ່າ 1.0, ACOSH() "
"ຈະຄືນຄ່າມາເປັນ NaN "
"(ບໍ່ແມ່ນຕົວເລກ - Not a Number) "
"ແລະມີການຕັ້ງຄ່າ errno"

#: xml_doc.cc:1869
msgid "ACOSH(Float)"
msgstr "ACOSH(ເລກທົດສະນິຍົມ)"

#: xml_doc.cc:1870
msgid "ACOSH(5) equals 2.29243167"
msgstr "ACOSH(5) ມິຄ່າເທົ່າກັບ 2.29243167"

#: xml_doc.cc:1871
msgid "ACOSH(0) equals NaN"
msgstr "ACOSH(0) ມິຄ່າເທົ່າກັບ NaN"

#: xml_doc.cc:1873
msgid ""
"The ASINH() function calculates the inverse hyperbolic sine of x; that is "
"the value whose hyperbolic sine is x."
msgstr ""
"ຟັງຊັ້ນ ASINH() ໃຊ້ຄຳນວນຫາຄ່າ"
"inverse hyperbolic sine ຂອງ x ໂດຍຄ່າທີ່ເປັນ"
"hyperbolic sine ຄື x"

#: xml_doc.cc:1874
msgid "ASINH(Float)"
msgstr "ASINH(ເລກທົດສະນິຍົມ)"

#: xml_doc.cc:1875
msgid "ASINH(0.8) equals 0.73266826"
msgstr "ASINH(0.8) ມິຄ່າເທົ່າກັບ 0.73266826"

#: xml_doc.cc:1876
msgid "ASINH(0) equals 0"
msgstr "ASINH(0) ມິຄ່າເທົ່າກັບ 0"

#: xml_doc.cc:1878
msgid ""
"The ATANH() function calculates the inverse hyperbolic tangent of x; that is "
"the value whose hyperbolic tangent is x. If the absolute value of x is "
"greater than 1.0, ATANH() returns not-a-number (NaN)."
msgstr ""
"ຟັງຊັ້ນ ATANH() ໃຊ້ຄຳນວນຫາຄ່າ "
"inverse hyperbolic tangent ຂອງ x "
"ໂດຍຄ່າທີ່ເປັນ hyperbolic tangent ຄື x "
"ຫາກຄ່າສົມບູນຂອງ x ຫລາຍກວ່າ 1.0 "
"ແລ້ວ ATANH() "
"ຈະຄືນຄ່າມາເປັນບໍ່ແມ່ນຕົວເລກ - Not a Number"

#: xml_doc.cc:1879
msgid "ATANH(Float)"
msgstr "ATANH(ເລກທົດສະນິຍົມ)"

#: xml_doc.cc:1880
msgid "ATANH(0.8) equals 1.09861229"
msgstr "ATANH(0.8) ມິຄ່າເທົ່າກັບ 1.09861229"

#: xml_doc.cc:1881
msgid "ATANH(0) equals 0"
msgstr "ATANH(0) ມິຄ່າເທົ່າກັບ 0"

#: xml_doc.cc:1884
msgid ""
"This function calculates the arc tangent of the two variables x and y. It is "
"similar to calculating the arc tangent of y/x, except that the signs of both "
"arguments are used to determine the quadrant of the result."
msgstr ""
"ຟັງຊັ້ນນີ້ ໃຊ້ຄຳນວນຫາຄ່າ"
"arc tangent ຂອງຕົວແປ x ແລະ y "
"ຊື່ງຄາ້ຍກັບ ການຄຳນວນຫາຄ່າ "
"arc tangent ของ y/x "
"ຍົກເວັ້ນແຕ່ເຄືອງຫມາຍຂອງຕົວແປທັງສອງນັ້ນຈະຖືກໃຊ້ພິຈະລະນາຄ່ານໜື່ງ "
"ສວ່ນສີຂອງຜົນລັບທີ່ໄດ້"

#: xml_doc.cc:1885
msgid "ATAN2(value;value)"
msgstr "ATAN2(ຄ່າ;ຄ່າ;)"

#: xml_doc.cc:1886
msgid "ATAN2(0.5;1.0) equals 1.107149"
msgstr "ATAN2(0.5;1.0) ມິຄ່າເທົ່າກັບ 1.107149"

#: xml_doc.cc:1887
msgid "ATAN2(-0.5;2.0) equals 1.815775"
msgstr "ATAN2(-0.5;2.0) ມິຄ່າເທົ່າກັບ 1.815775"

#: xml_doc.cc:1889
msgid "This function transforms a radian angle to a degree angle."
msgstr "ຟັງຊັ້ນນີ້ໃຊ້ແປງຄ່າຈາກມູມທີ່ມີໜວ່ຍລາດຽນໄປເປັນມູມໃນໜວ່ຍອົງສາ"

#: xml_doc.cc:1890
msgid "DEGREES(Float)"
msgstr "DEGREE(ເລກທົດນິຍົມ)"

#: xml_doc.cc:1891
msgid "DEGREES(0.78) equals 44.69"
msgstr "DEGREE(0.78) ມີຄ່າເທົ່າກັບ 44.69"

#: xml_doc.cc:1892
msgid "DEGREES(1) equals 57.29"
msgstr "DEGREE(1) ມິຄ່າເທົ່າກັບ 57.29"

#: xml_doc.cc:1893
msgid "Angle (degrees)"
msgstr "ມູມ (ອົງສາ)"

#: xml_doc.cc:1894
msgid "This function transforms a degree angle to a radian angle."
msgstr "ຟັງຊັ້ນນີ້ໃ້ຊ້ແປງຄ່າຈາກມູມທີ່ມີໜ່ວຍເປັນອົງສາລາດຽນໄປເປັນມູມໃນໜ່ວຍລາດຽນ"

#: xml_doc.cc:1895
msgid "RADIANS(Float)"
msgstr "RADIAN(ເລກທົດນິຍົມ)"

#: xml_doc.cc:1896
msgid "RADIANS(75) equals 1.308"
msgstr "RADIAN(75) ມິຄ່າເທົ່າກັບ 1.308"

#: xml_doc.cc:1897
msgid "RADIANS(90) equals 1.5707"
msgstr "RADIAN(90) ມິຄ່າເທົ່າກັບ 1.5707"

#: xml_doc.cc:1898
msgid "The PI() function returns the value of PI."
msgstr "ຟັງຊັ້ນ PI() ຈະຄືນຄ່າ PI ມາໃຫ້"

#: xml_doc.cc:1899
msgid "PI()"
msgstr "PI()"

#: xml_doc.cc:1900
msgid "PI() equals 3.141592654..."
msgstr "PI() ມິຄ່າເທົ່າກັບ 3.141592654..."

