msgid "Conversion"
msgstr "ການແປງຄ່າ"

#: xml_doc.cc:2 xml_doc.cc:14
msgid "Bool value to convert"
msgstr "ຄ່າຕັກກະທີ່ຈະແປງ"

#: xml_doc.cc:3
msgid ""
"The BOOL2STRING() function returns a string value for a given boolean value. "
"This method is intended for using a boolean in methods which require a string"
msgstr ""
"ຟັງຊັ້ນ BOOL2STRING() "
"ຈະສົ່ງຄ່າກັບມາເປັນຂໍ້ຄວາມ"
"ສຳລັບຄ່າຕັກກະທີ່ສົ່ງໄປຊື່"
"ງວີທີ່ການນີ້ມັກໃຊ້ກັບວິທີ "
"ທາງຕັກກະທີຕ້ອງການຄ່າແບບຂໍ"
"້ຄວາມ"

#: xml_doc.cc:4
msgid "BOOL2STRING(value)"
msgstr "BOOL2STRING(ຄ່າ)"

#: xml_doc.cc:5
msgid "BOOL2STRING(true) returns \"True\""
msgstr ""
"BOOL2STRING(ຄວາມຈີງ) "
"ຈະຄືນຄ່າກັບມາເປັນ\"ຄວາມຈີງ\""

#: xml_doc.cc:6
msgid "BOOL2STRING(false) returns \"False\""
msgstr ""
"BOOL2STRING(ຜິດ) "
"ຈະຄືນຄ່າກັບມາເປັນ\"ຜິດ\""

#: xml_doc.cc:7
msgid "upper(BOOL2STRING(find(\"nan\";\"banana\"))) returns TRUE"
msgstr ""
"ຍົກ(BOOL2STRING(ຊອກ(\"ນານ\";\"ບານານາ\"))) "
"ູຄືນຄ່າກັບມາເປນັ ຄວາມຈີງ"

#: xml_doc.cc:8
msgid "Integer value to convert"
msgstr "ຄ່າຈຳນວນເຕັມທີ່ຈະແປງ"

#: xml_doc.cc:9
msgid ""
"The INT2BOOL() function returns a boolean value for a given integer number. "
"This method is intended for using an integer in methods which require a "
"boolean. It only accepts 0 or 1. If any other value is given, false is "
"returned."
msgstr ""
"ຟັງຊັ້ນ INT2BOOL() "
"ສົ່ງຄ່າບູລີນກັບສຳລັບໃຫ້ຄ່"
"າຖ້ວນ.ນີ້ແມ່ນວິທີການທີ່ຕ້ອ"
"ງໃຈ "
"ເພືອ່ໃຊ້ຄ່າຖ້ວນໃນວິທີການເ"
"ພື່ອໃຊ້ຄ່າບູລິນພຽງແຕ່ 0 ຫລື "
"1 ຖ້າຄ່າອື່ນຈະໃຫ້ຄ່າ ແມ່ນ "
"ຖືກ ຫລື ຜິດ"

#: xml_doc.cc:10
msgid "INT2BOOL(value)"
msgstr "INT2BOOL(ຄ່າ)"

#: xml_doc.cc:11
msgid "INT2BOOL(1) returns true"
msgstr "INT2BOOL(1) ຈະໄດ້ຄ່າ ຄວາມຈີງ"

#: xml_doc.cc:12
msgid "INT2BOOL(0) returns false"
msgstr "INT2BOOL(0) ຈະໄດ້ຄ່າ ຜິດ"

#: xml_doc.cc:13
msgid "OR(INT2BOOL(1); false) returns true"
msgstr "OR(INT2BOOL(1); ຜິດ) ຈະໄດ້ຄ່າ ຄວາມຈີງ"

#: xml_doc.cc:15
msgid ""
"The BOOL2INT() function returns an integer value for a given boolean value. "
"This method is intended for using a boolean value in methods which require "
"an integer."
msgstr ""
" BOOL2INT() "
"ຟງັຊັ້ນນີ້ຈະສົ່ງຄ່າຖ້ວນກັ"
"ບເພື່ອໃຫ້ຄ່າເປັນບູລິນ.ວິທີ"
"່ການນີ້ແມ່ນ "
"ເພື່ອໃຊ້ຄ່າບູລິນໃນກັບຄ່າຖ"
"້ວນ."

#: xml_doc.cc:16
msgid "BOOL2INT(value)"
msgstr "BOOL2INT(ຄ່າ)"

#: xml_doc.cc:17
msgid "BOOL2INT(True) returns 1"
msgstr "BOOL2INT(ຄວາມຈີງ) ຈະໄດ້ຄ່າ 1"

#: xml_doc.cc:18
msgid "BOOL2INT(False) returns 0"
msgstr "BOOL2INT(ຜິດ) ຈະໄດ້ຄ່າ 0"

#: xml_doc.cc:19
msgid "number to convert into string"
msgstr "ຈຳນວນທີ່ຈະແປງເປັນຂໍ້ຄວາມ"

#: xml_doc.cc:20
msgid ""
"The NUM2STRING() function returns a string value for a given number. This "
"method is intended for using a number in methods which require a string"
msgstr ""
" NUM2STRING() "
"ຟັງຊັ້ນນີ້ຈະສົ່ງຄ່າເປັນຕົ"
"ວອັກສອນເພື່ອໃຫ້ຄ່າເປັນຕົວ "
"ເລກ.ວິທີການນີ້ຈະໃຊ້ເພື່ອຕົ"
"ວເລກໃນຄ່າຕົວອັກສອນ"

#: xml_doc.cc:21
msgid "NUM2STRING(value)"
msgstr "NUM2STRING(ຄ່າ)"

#: xml_doc.cc:22
msgid "NUM2STRING(10) returns \"10\""
msgstr "NUM2STRING(10) ຈະໄດ້ຄ່າ \"10\""

#: xml_doc.cc:23
msgid "NUM2STRING(2.05) returns \"2.05\""
msgstr "NUM2STRING(2.05) ຈະໄ້ດ້ຄ່າ \"2.05\""

#: xml_doc.cc:24
msgid "=find(\"101\";NUM2STRING(A1)) (A1 = 2.010102) returns True"
msgstr ""
"=ຊອກຫາ(\"101\";NUM2STRING(A1)) (A1 = 2.010102) "
"ຈະໄດ້ຄ່າ True"

#: xml_doc.cc:25
msgid "A one character string to convert"
msgstr ""
"ຂໍ້ຄວາມຫນື່ງອັກຂະລະທີ່ຈະແ"
"ປງ"

#: xml_doc.cc:26
msgid "The CHARTOASCII() function returns the ASCII code for the given character."
msgstr ""
"ຊ໌າໂທຣດII() "
"ຟັງຊັ້ນນີ້ຈະສົ່ງຄ່າ ACCII "
"ເພື່ອໃຫ້ເປັນຕົວສັນຍາລັກ."

#: xml_doc.cc:27
msgid "CHARTOASCII(value)"
msgstr "ໍໍຊ໌າໂທຣດII(ຄ່າ)"

#: xml_doc.cc:28
msgid "CHARTOASCII(\"v\") returns 118"
msgstr "ຊ໌າໂທຣດII(\"v\") ຈະໄດ້ຄ່າ 118"

#: xml_doc.cc:29
msgid "CHARTOASCII(r) is an error. The character must be in quotes."
msgstr ""
"ຊ໌າໂທຣດII(r) "
"ບໍ່ຖືກຕ້ອງອັກຂະລະຕ້ອງມີເຄ"
"ື່ອງຫມາຍອ້ອມຮອບ"

#: xml_doc.cc:30
msgid "The ASCII values to convert"
msgstr "ຄ່າແອສສະກີຈະແປງ"

#: xml_doc.cc:31
msgid "The ASCIITOCHAR() function returns the character for each given ASCII code"
msgstr ""
"ຟັງຊັ້ນ ASCIITOCHAR() "
"ຈະຄຶນຄ່າກັບມາເປັນອັກຂະລະລ"
"ະຫັດແອສກີທີ່ກຳນົດ"

#: xml_doc.cc:32
msgid "ASCIITOCHAR(value)"
msgstr "ASCIITOCHAR(ຄ່າ)"

#: xml_doc.cc:33
msgid "ASCIITOCHAR(118) returns \"v\""
msgstr "ASCIITOCHAR(118) ຈະໄດ້ຄ່າ \"v\""

#: xml_doc.cc:34
msgid "ASCIITOCHAR(75; 68; 69) returns \"KDE\""
msgstr "ASCIITOCHAR(75; 68; 69) ຈະໄດ້ຄ່າ \"KDE\""

#: xml_doc.cc:35 xml_doc.cc:41
msgid "Value in X"
msgstr "ຄ່າຂອງ X"

#: xml_doc.cc:36 xml_doc.cc:42
msgid "Value in Y"
msgstr "ຄ່າຂອງ Y"

#: xml_doc.cc:37
msgid ""
"The POLR() function returns the radius corresponding to the position of a "
"point in a cartesian landmark."
msgstr ""
"ຟັງຊັ້ນ POLR() "
"ຈະຄືນຄ່າລະຫັດມີທີ່ກົງກັບຕ"
"ຳແຫນ່ງຂອງຈຸດໃນພື້ນທີ່ຄາທີ"
"່ຂຽນ"

#: xml_doc.cc:38
msgid "POLR(X;Y)"
msgstr "POLR(X;Y)"

#: xml_doc.cc:39
msgid "POLR(12;12) returns 16.9705"
msgstr "POLR(12;12) ຈະໄດ້ຄ່າ 16.9705"

#: xml_doc.cc:40
msgid "POLR(12;0) returns 12"
msgstr "POLR(12;0) ຈະໄ້ດ້ຄ່າ 12"

#: xml_doc.cc:43
msgid ""
"The POLA() function returns the angle (in radians) corresponding to the "
"position of a point in a cartesian landmark."
msgstr ""
"ຟັງຊັ້ນ POLA() "
