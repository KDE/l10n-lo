#: xml_doc.cc:157
msgid "Method (optional)"
msgstr "ຕົວເລືອກຂໍ້ຄວາມ"

#: xml_doc.cc:158
msgid ""
"The WEEKDAY() function returns the weekday of given date. If the method is 1 "
"(default) WEEKDAY() returns 1 for sunday, 2 for monday,.. If the method is "
"2, monday is 1, tuesday 2, ... and if the method is 3 WEEKDAY() returns 0 "
"for monday, 1 for tuesday,..."
msgstr ""
"ວັນໃນອາທີດ() ຟັງຊັ້ນຈະກັບຄືອາທິດແລະໃຫ້ມື້ ຖ້າສູດແມ່ນ 1 "
" (ບໍ່ສາມາດປະຕິບັດຕາມ) ວັນໃນອາທິດ() ຈະກັບຄືນ "
"1 ສຳລັບວັນທິດ, 2 ສຳລັບວັນຈັນ,.. ຖ້າລະບົບເປັນ "
"2, ວັນຈັນ ແມ່ນ 1, ວັນຄານ 2, ... ແລະຖ້າສູດແມ່ນ "
" 3 ວັນໃນອາທິດ() ສົ່ງຄ່າກັບ 0 "
"ສຳລັບ ວັນຈັນ , 1 ສຳລັບ ວັນຄານ,..."

#: xml_doc.cc:159
msgid "WEEKDAY(date; method)"
msgstr "ວັນໃນອາທິດ(ວັນທີ2; ວັນທີ1; ໂຫມດ)"

#: xml_doc.cc:160
msgid "WEEKDAY(\"2002-02-22\"; 2) returns 5"
msgstr "ວັນໃນອາທິດ(\"2002-02-22\"; \"2002-02-26\") ຈະໄດ້ຄ່າ 4"

#: xml_doc.cc:161
msgid "Date1"
msgstr "ວັນທີ1"

#: xml_doc.cc:162
msgid "Date2"
msgstr "ວັນທີ2"

#: xml_doc.cc:163
msgid "Method"
msgstr "ຄວາມຍາວ"

#: xml_doc.cc:164
msgid ""
"The DAYS360() function returns the number of days from date1 to date2 using "
"a 360-day calendar in which all months are assumed to have 30 days. If "
"method is false (default) the US method will be used, the european otherwise."
msgstr ""
"ວັນ360() ຟັງຊັ້ນສົ່ງຄ່າຕົວເລກຂອງມືຕາກ ມື1 ເຖິງ ມື2 "
"ໃຊ້ 360-ມື້ ປະຕິທິນໃນແຕ່ລະເດື່ອນ ແມ່ນມີ 30ມື .ຖ້າວິທີແມ່ນ ຜິດ "
"(ບໍ່ສາມາດປະຕິບັດຕາມ) ວິທີ USແມ່ນຈະເປັນການໃຊ້ ,ສ່ວນຍູໂລບແມ່ນແນວອື່ນ"

#: xml_doc.cc:165
msgid "DAYS360(date1; date2; method)"
msgstr "ວັນ360 (ວັນທີ2; ວັນທີ1; ໂຫມດ)"

#: xml_doc.cc:166
msgid "DAYS360(\"2/22/2002\", \"4/21/2002\", FALSE) returns 59"
msgstr "ວັນ360(\"2002-02-22\"; \"2002-02-26\") ຈະໄດ້ຄ່າ 4"

#: xml_doc.cc:168
msgid ""
"The TIMEVALUE() function returns a number (between 0 and 1) representing the "
"time of day."
msgstr ""
"ຄ່າເວລາ() ຟັງຊັ້ນນີ້ຈະສົ່ງຄ່າຕົວເລກ (ລະຫວ່າງ 0 ແລະ 1) "
"ເວລາຂອງມື້"

#: xml_doc.cc:169
msgid "TIMEVALUE(time)"
msgstr "ຄ່າເວລາ(ເວລາ)"

#: xml_doc.cc:170
msgid "TIMEVALUE(\"10:05:02\") returns 0.42"
msgstr "ຄ່າເວລາ(\"10:5:2\") ຈະໄດ້ຄ່າ 5"

#: xml_doc.cc:172
msgid "The DATEVALUE function returns a number representing the day."
msgstr ""
"ຟັງຊັ້ນ ວັນຂອງປີ() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າເລກບວກຂອງປິ (1...365)"

#: xml_doc.cc:173
msgid "DATEVALUE(date)"
msgstr "ຄ່າວັນ(ວັນ)"

#: xml_doc.cc:174
msgid "DATEVALUE(\"2/22/2002\") returns 37309"
msgstr "ຄ່າວັນ(\"2/22/2002\") ຈະກັບຄືນໄປທີ່ 37309"

#: xml_doc.cc:176 xml_doc.cc:182
msgid "Months"
msgstr "ເດືອນ"

#: xml_doc.cc:177
msgid ""
"The EDATE functions returns the date that is specified by a given date and a "
"number of months before or after that date."
msgstr "EDATE ຟັງຊັ້ນນີ້ກັບຄືນມື້ໂດຍໃຫ້ມື້ ແລະ ຕົວເລກຂອງເດື່ອນກອ່ນຫລືຫລັງມື້"

#: xml_doc.cc:178
msgid "EDATE(date; months)"
msgstr "ວັນ(ປີ;ເດືອນ;ວັນທີ)"

#: xml_doc.cc:179
msgid "EDATE(\"2/22/2002\"; 3) returns \"5/22/2002\""
msgstr "EDATE(\"2/22/2002\";3) ຈະກັບຄ່າເປັນ \"5/22/2002\""

#: xml_doc.cc:180
msgid "EDATE(\"3/31/2002\"; -1) returns \"2/28/2002\""
msgstr "EDATE(\"3/31/2002\";-1) ຈະກັບຄ່າເປັນ \"2/28/2002\""

#: xml_doc.cc:183
msgid ""
"The EOMONTH functions returns the last day in the month specified by a date "
"and the number of months from that date."
msgstr ""
"ຟັງຊັ້ນ SECONDS() "
"ຈະຄຶນຄ່າກັບມາເປັນຄ່າປັນຄ່າຈຳນວນວິນາທີຂອງເວລາທີ່ກຳນົດ"

#: xml_doc.cc:184
msgid "EOMONTH(date; months)"
msgstr "EOMONTHS(ວັນທີ2; ວັນທີ1; ໂຫມດ)"

#: xml_doc.cc:185
msgid "EOMONTH(\"2/22/2002\"; 3) returns \"5/31/2002\""
msgstr "EOMONTH(\"2/22/2002\";3) ຈະກັບຄ່າເປັນ \"5/31/2002\""

#: xml_doc.cc:186
msgid "EOMONTH(\"3/12/2002\"; -1) returns \"2/28/2002\""
msgstr "EOMONTH(\"3/12/2002\"; -1) ຈະກັບຄ່າເປັນ \"2/28/2002\""

#: xml_doc.cc:187
msgid "EOMONTH(\"3/12/2002\"; 0) returns \"3/31/2002\""
msgstr "EOMONTH(\"3/12/2002\";0) ຈະກັບຄ່າເປັນ \"3/31/2002\""

#: xml_doc.cc:189
msgid ""
"The YEAR functions returns the year of a date. If no parameter is specified "
"the current year gets returned."
msgstr ""
"ຟັງຊັ້ນ EXACT() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າ ຄວາມຈີງ "
"ຫາກຂໍ້ຄວາມທັງສອນຕົວເທົ່າກັນ"
"ບໍ່ເຊັ່ນນັ້ນກໍຈະຄືນຄ່າມາເປັນຄ່າຜິດ"

#: xml_doc.cc:190
msgid "YEAR(date)"
msgstr "ປີ(ວັນທີ່)"

#: xml_doc.cc:191
msgid "YEAR(\"2/22/2002\") returns 2002"
msgstr "ປີ(\"2/22/2002\") ຈະກັບຄ່າເປັນ 2002"

#: xml_doc.cc:192
msgid "YEAR(2323.1285) returns 1906"
msgstr "ປີ(2323.1285) ຈະກັບຄ່າເປັນ 1906"

#: xml_doc.cc:194
msgid ""
"The MONTH functions returns the month of a date. If no parameter is "
"specified the current month gets returned."
msgstr ""
"MONTH ຟັງຊັ້ນສົ່ງຄ່າມື້ຂອງເດື່ອນ ຖ້າບໍ່ມີຄ່າພາລາມິເຕີ້ແມ່ນຈະແພ່ໃຫ້ເດືີອນ "
"ແລະກັບຄືນ"

#: xml_doc.cc:195
msgid "MONTH(date)"
msgstr "ເດືອນ(ວັນທີ່)"

#: xml_doc.cc:196
msgid "MONTH(\"2/22/2002\") returns 2"
msgstr "ັເດືອນ(\"2/22/2002\") ຈະກັບຄ່າເປັນ 2"

#: xml_doc.cc:197
msgid "MONTH(2323.1285) returns 5"
msgstr "MONTH(5) ຈະໄດ້ຄ່າ ພືດສະພາຄົມ"

#: xml_doc.cc:199
msgid ""
"The DAY functions returns the day of a date. If no parameter is specified "
"the current day gets returned."
msgstr ""
"ຟັງຊັ້ນ DATE() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າຮູບແບບວັນທີຕາມທພາສາທີ່ທ່ານຕັ້ງໄວ້"

#: xml_doc.cc:200
msgid "DAY(date)"
msgstr "ວັນ(ວັນທີ່)"

#: xml_doc.cc:201
msgid "DAY(\"2/22/2002\") returns 22"
msgstr "ວັນ(\"2/22/2002\") ຈະກັບຄ່າເປັນ 22"

#: xml_doc.cc:202
msgid "DAY(2323.1285) returns 11"
msgstr "ວັນ(2323.1285) ຈະກັບຄ່າເປັນ 11"

#: xml_doc.cc:204
msgid ""
"The HOUR functions returns the hour of a time. If no parameter is specified "
"the current hour gets returned."
msgstr ""
"ຟັງຊັ້ນ EXACT() "
"ຈະຄື່ນຄ່າກັບມາເປັນຄ່າ True "
"ຫາກຂໍ້ຄວາມທັງສອງຕົວເທົ່າກັນ"
"ບໍ່ເຊັ່ນນັ້ນກໍຈະຄື່ນຄ່າມາເປັນ False"

#: xml_doc.cc:205
msgid "HOUR(time)"
msgstr "ຊົ່ວໂມງ(ເວລາ)"

#: xml_doc.cc:206
msgid "HOUR(\"22:10:12\") returns 22"
msgstr "ຊົ່ວໂມງ(\"22:10:12\") ຈະກັບຄ່າເປັນ 22"

#: xml_doc.cc:207
msgid "HOUR(0.1285) returns 3"
msgstr "ຊົ່ວໂມງ(0.1285) ຈະກັບຄ່າເປັນ3"

#: xml_doc.cc:209
msgid ""
"The MINUTE functions returns the minutes of a time. If no parameter is "
"specified the current minute is returned."
msgstr ""
"ຟັງຊັ້ນ EXACT() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າ ຄວາມຈີງ "
"ຫາກຂໍ້ຄວາມທັງສອງໂຕເທົ່າກັນ"
"ບໍ່ເຊັ່ນນັ້ນກໍຈະຄືນຄ່າມາເປັນ ຄ່າຜິດ"

#: xml_doc.cc:210
msgid "MINUTE(time)"
msgstr "ນາທີ(ເວລາ)"

#: xml_doc.cc:211
msgid "MINUTE(\"22:10:12\") returns 10"
msgstr "ນາທີ(\"22:10:12\") ຈະກັບຄ່າເປັນ 10"

#: xml_doc.cc:212
msgid "MINUTE(0.1234) returns 57"
msgstr "ນາທີ(0.1234) ຈະກັບຄ່າເປັນ 57"

#: xml_doc.cc:214
msgid ""
"The SECOND functions returns the seconds of a time. If no parameter is "
"specified the current second is returned."
msgstr ""
"ຟັງຊັ້ນ EXACT() "
"ຈະຄື່ນຄ່າກັບມາເປັນຄ່າ ຄວາມຈີງ "
"ຫາກາຂໍ້ຄວາມທັງສອງຕົວເທົ່າກັນ"
"ບໍ່ເຊັ່ນນັ້ນກໍ່ຈະຄືນຄ່າມາເປັນ ຄ່າຜິດ"

#: xml_doc.cc:215
msgid "SECOND(time)"
msgstr "ວິນາທີ(ເວລາ)"

#: xml_doc.cc:216
msgid "SECOND(\"22:10:12\") returns 12"
msgstr "ວິນາທີ(\"22:10:12\") ຈະກັບຄ່າເປັນ 12"

#: xml_doc.cc:217
msgid "SECOND(0.1234) returns 42"
msgstr "ວິນາທີ(0.1234) ຈະກັບຄ່າເປັນ 42"

#: xml_doc.cc:218 xml_doc.cc:225 xml_doc.cc:232 xml_doc.cc:239
msgid "First (earlier) date value"
msgstr "ທຳອິດ (ລ່າສຸດ) ຄ່າວັນທີ່"

#: xml_doc.cc:219 xml_doc.cc:226 xml_doc.cc:233 xml_doc.cc:240
msgid "Second date value"
msgstr "ຄ່າວັນທີ່ຕົວທີ່ສອງ"

#: xml_doc.cc:220 xml_doc.cc:227 xml_doc.cc:234
msgid "Calculation mode"
msgstr "ໂຫມດການຄຳນວນ"

#: xml_doc.cc:221
msgid ""
"The WEEKS() function returns the difference between two dates in weeks.The "
"third parameter indicates the calculation mode: if the mode is 0, WEEKS() "
"returns the maximal possible number of weeks between those days. If the mode "
"is 1, it only returns the number of whole weeks in between."
msgstr ""
" ຟັງຊັນ WEEKS() ຈະກາຍເປັນຄວາມແຕກຕ່າງລະຫວ່າງສອງວັນໃນໜື່ງອາທິດ. "
"ພາລາມິເຕີຕົວທີ່ສາມຈະສະແດງໃຫ້ເຫັນການຄິດໄລ່ໂມດ .ຖ້າໂມດເປັນ0 "
"ອາທິດ()ຖ້າເປັນໄປໄດ້ຈະກາຍເປັນຄ່າສູງສຸດຂອງຕົວເລກໃນອາທິດລະຫວ່າງ "
"ວັນເລົ່ານັ້ນ.ຖ້າໂມດເປັນ 1 ມັນພຽງແຕ່ກາຍເປັນຕົວເລກທັງໝົດຂອງ "
"ອາທິດ "

#: xml_doc.cc:222
msgid "WEEKS(date2; date1; mode)"
msgstr "ອາທິດ(ວັນທີ2; ວັນທີ1; ໂຫມດ)"

#: xml_doc.cc:223
msgid ""
"WEEKS(\"2002-02-18\"; \"2002-02-26\"; 0) returns 1, because there is one "
"week and 1 day in between"
msgstr ""
"ອາທິດ(\"2002-02-18\"; \"2002-02-26\"; 0) ຈະໄດ້ຄ່າ 1 "
"ເນື່ອງຈາກເປັນຊ່ວງຫນື່ງສັບດາແລະ 1 ມື້"

#: xml_doc.cc:224
msgid ""
"WEEKS(\"2002-19-02\"; \"2002-19-02\"; 1) returns 0, because there is not a "
"whole week in between, starting at the first day of the week (monday or "
"sunday, depending on your local settings)"
msgstr ""
"ອາທິດ(\"2002-19-02\"; \"2002-19-02\"; 1) "
"ສົ່ງຄ່າ 0 ຄືນ ເພາະວ່າບໍ່ີ້ແມ່ນທັງຫມົດໃນລະຫວ່າງອາທິດ ເລີ່ມຕົ້ນມ "
"ື້ທຳອິດຂອງອາທິດ(ເດືອນ ຫລື ອາທິດ)"

#: xml_doc.cc:228
msgid ""
"The MONTHS() function returns the difference between two dates in months.The "
"third parameter indicates the calculation mode: if the mode is 0, MONTHS() "
"returns the maximal possible number of months between those days. If the "
"mode is 1, it only returns the number of complete months in between."
msgstr ""
"MONTHS() ຟັງຊັ້ນສົ່ງຄ່າຕາ່ງລະຫວ່າງສອງມຶ້ໃນເດືອນ. "
"ຕົວທີ່3 ພາລາມິເຕິ ສະແດງໂຫມດຄິດໄລ່ ຖ້າໂຫມດເປັນ 0 MONTHS() "
"ສົ່ງຄ່າໃຫຍ່ ຫາກຕົວເລກທີ່ເປັນໄປໄດ້ຂອງເດືອນລະຫວ່າງມື້ເຫລ່ານັ້ນ "
"ຖ້າໂຫມດເປັນ 1 ມັນພຽງແຕ່ສົ່ງຕົວເລກລະຫວ່າງເດື່ອນ"

#: xml_doc.cc:229
msgid "MONTHS(date2; date1; mode)"
msgstr "MONTHS(ວັນທີ2; ວັນທີ1; ໂຫມດ)"

#: xml_doc.cc:230
msgid ""
"MONTHS(\"2002-01-18\"; \"2002-02-26\"; 0) returns 1, because there is 1 "
"month and 8 days in between"
msgstr ""
"MONTHS(\"2002-01-18\"; \"2002-02-26\"; 0) ຈະໄດ້ຄ່າ 1 "
"ເນື່ອງຈາກຢູ່ໃນຊ່ວງ 1 "
"ເດືອ່ນກັບອີກ 8 ມື້"

#: xml_doc.cc:231
msgid ""
"MONTHS(\"2002-01-19\"; \"2002-02-26\"; 1) returns 0, because there is not a "
"whole month in between, starting at the first day of the month"
msgstr ""
"MONTHS(\"2002-01-19\"; \"2002-02-26\"; 1) ຈະໄ້ດ້ຄ່າ 0 "
"ເນື່ອງຈາກຍັງບໍ່ຄົບເດື່ອນຈາກຄ່າທີ່ໃຫ້"
"ໂດຍນັບຈາກມື້ທຳອິດຂອງຄ່າທຳອິດທີ່ໃຫ້"

#: xml_doc.cc:235
msgid ""
"The YEARS() function returns the difference between two dates in years. The "
"third parameter indicates the calculation mode: if the mode is 0, YEARS() "
"returns the maximal possible number of years between those days. If the mode "
"is 1, it only returns whole years, starting at the 1st Jan and ending on the "
"31st Dec."
msgstr ""
"YEARS() ຟັງຊັ້ນສົ່ງຄ່າຕາ່ງລະຫວ່າງສອງມຶ້ໃນເດືອນ. "
"ຕົວທີ່3 ພາລາມິເຕິ ສະແດງໂຫມດຄິດໄລ່ ຖ້າໂຫມດເປັນ 0 YEARS() "
"ສົ່ງຄ່າໃຫຍ່ ຫາກຕົວເລກທີ່ເປັນໄປໄດ້ຂອງເດືອນລະຫວ່າງມື້ເຫລ່ານັ້ນ "
"ຖ້າໂຫມດເປັນ 1 ມັນພຽງແຕ່ສົ່ງຕົວເລກລະຫວ່າງເດື່ອນ"

#: xml_doc.cc:236
msgid "YEARS(date2; date1; mode)"
msgstr "YEARS(ວັນທີ2; ວັນທີ1; ໂຫມດ)"

#: xml_doc.cc:237
msgid ""
"YEARS(\"2001-02-19\"; \"2002-02-26\"; 0) returns 1, because there is one "
"year and 7 days in between"
msgstr ""
"YEARS(\"2001-02-19\"; \"2002-02-26\"; 0) ຈະໄດ້ຄ່າ 1 "
"ເນື່ອງຈາກຫ່າງກັນເປັນເວລາ 1 "
"ປີ ກັບອີກ 7 ມື້"

#: xml_doc.cc:238
msgid ""
"YEARS(\"2002-02-19\"; \"2002-02-26\"; 1) returns 0, because there is not a "
"whole year in between, starting at the first day of the year"
msgstr ""
"YEARS(\"2002-02-19\"; \"2002-02-26\"; 1) ຈະໄດ້ຄ່າ 0 "
"ເນືອງຈາກຊ່ວງເວລາທີ່ໃຫ້ຍັງບໍ່ເຖີ່ງຫນື່ງປີນັບຈາກມື້ທຳອິດຂອງຄ່າທຳອິດທີໃຫ້"

#: xml_doc.cc:241
msgid "The DAYS() function returns the difference between two dates in days."
msgstr "DAYS() ຟັງຊັ້ນນີ້ຈະສົ່ງຄ່າຕ່າງລະຫວ່າງສອງມື້ໃນມື້"

#: xml_doc.cc:242
msgid "DAYS(date2; date1)"
msgstr "DAYS(ວັນທີ2; ວັນທີ1)"

#: xml_doc.cc:243
msgid "DAYS(\"2002-02-22\"; \"2002-02-26\") returns 4"
msgstr "DAYS(\"2002-02-22\"; \"2002-02-26\") ຈະໄດ້ຄ່າ 4"

#: xml_doc.cc:244 xml_doc.cc:251
msgid "Year"
msgstr "ປີ"

#: xml_doc.cc:245 xml_doc.cc:252 xml_doc.cc:716
msgid "Month"
msgstr "ເດືອນ"

#: xml_doc.cc:246 xml_doc.cc:253
msgid "Day"
msgstr "ວັນ"

#: xml_doc.cc:247
msgid "The DAYOFYEAR() function returns the number of the day in the year (1...365)."
msgstr ""
"ຟັງຊັ້ນ DAYOFYEAR() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າເລກມື້ນຂອງປີ (1...365)"

#: xml_doc.cc:248
msgid "DAYOFYEAR(year;month;date)"
msgstr "DAYOFYEAR(ປີ;ເດືອນ;ວັນທີ)"

#: xml_doc.cc:249
msgid "DAYOFYEAR(2000;12;1) returns 336"
msgstr "DAYOFYEAR(2000;12;1) ຈະໄດ້ຄ່າ 336"

#: xml_doc.cc:250
msgid "DAYOFYEAR(2000;2;29) returns 60"
msgstr "DAYOFYEAR(2000;2;29) ຈະໄດ້ຄ່າ 60"

#: xml_doc.cc:254
msgid "The DATE() function returns the date formatted with local parameters."
msgstr ""
"ຟັງຊັ້ນ DATE() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າຮູບແບບວັນທີຕາມພາສາທີທ່ານຕັ້ງໄວ້"

#: xml_doc.cc:255
msgid "DATE(year;month;date)"
msgstr "DATE(ປີ;ເດື່ອນ;ວັນທີ)"

#: xml_doc.cc:256
msgid "DATE(2000;5;5) returns Friday 05 May 2000"
msgstr "DATE(2002;8;6) ຈະໄດ້ຄ່າ ອ. 6 ສ.ຄ.2002"

#: xml_doc.cc:260
msgid "The TIME() function returns the time formatted with local parameters."
msgstr ""
"ຟັງຊັ້ນ TIME() "
"ຈະຄື້ນຄ່າກັບມາເປັນຮູບແບບເວລາຕາມພາສາທີ່ທ່ານຕັ້ງໄວ້"

#: xml_doc.cc:261
msgid "TIME(hours;minutes;seconds)"
msgstr "TIME(ຊົ່ວໂມງ;ນາທີ;ວິນາທີ)"

#: xml_doc.cc:262
msgid "TIME(10;2;2) returns 10:02:02"
msgstr "TIME(10;2;2) ຈະໄດ້ຄ່າ 10:02:02"

#: xml_doc.cc:263
msgid "TIME(10;70;0) returns 11:10:0"
msgstr "TIME(10;2;2) ຈະໄດ້ຄ່າ 10:02:02"

#: xml_doc.cc:264
msgid "TIME(10;-40;0) returns 9:20:0"
msgstr "TIME(10;2;2) ຈະໄດ້ຄ່າ 10:02:02"

#: xml_doc.cc:266
msgid "The HOURS() function returns the value of the hours in a time expression."
msgstr "HOURSຟັງຊັ້ນ () ຈະຄືນຄ່າກັບມາເປັນຊົ່ວໂມງຂອງຄ່າເວລາທີ່ກຳນົດ"

#: xml_doc.cc:267
msgid "HOURS(time)"
msgstr "HOURS(ເວລາ)"

#: xml_doc.cc:268
msgid "HOURS(\"10:5:2\") returns 10"
msgstr "HOURS(\"10:5:2\") ຈະໄດ້ຮັບ 10"

#: xml_doc.cc:269 xml_doc.cc:273 xml_doc.cc:278 xml_doc.cc:282
msgid "year"
msgstr "ປີ"

#: xml_doc.cc:270
msgid "The function isLeapYear() returns True if the given year is leap."
msgstr ""
"ຟັງຊັ້ນ ISLEAPYEAR() "
"ຈະຄືນຄ່າເປັນຈືງຫາກປີທີ່ກຳນົດເປັນປອະທິມາສ"

#: xml_doc.cc:271
msgid "ISLEAPYEAR(year)"
msgstr "ISLEAPYEAR(ປີ)"

#: xml_doc.cc:272
msgid "ISLEAPYEAR(2000) returns True"
msgstr "ISLEAPYEAR(2000) ຈະໄດ້ຄ່າເປັນຈືງ"

#: xml_doc.cc:274
msgid "month"
msgstr "ເດືອນ"

#: xml_doc.cc:275
msgid ""
"The function DAYSINMONTH() returns number of days in the given year and "
"month."
msgstr ""
"ຟັງຊັ້ນ DAYSINMONTH() "
"ຈະຄືນຄ່າກັບມາເປັນຈຳນວນຂອງວັນແລະປີທີ່ກຳນົດ"

#: xml_doc.cc:276
msgid "DAYSINMONTH(year;month)"
msgstr "DAYSINMONTH(ປີ;ເດືອນ)"

#: xml_doc.cc:277
msgid "DAYSINMONTH(2000;2) returns 29"
msgstr "DAYSINMONTH(2000;2) ຈະໄດ້ຄ່າ 29"

#: xml_doc.cc:279
msgid "The function DAYSINYEAR() returns the number of days in the given year."
msgstr ""
"ຟັງຊັ້ນ DAYSINYEAR() "
"ຈະຄືນຄ່າກັບມາເປັນຈຳນວນວັນໃນປີທີ່ກຳນົດ"

#: xml_doc.cc:280
msgid "DAYSINYEAR(year)"
msgstr "DAYSINYEAR(ປີ)"

#: xml_doc.cc:281
msgid "DAYSINYEAR(2000) returns 366"
msgstr "DAYSINYEAR(2000) ຈະໄດ້ຄ່າ 366"

#: xml_doc.cc:283
msgid "The function WEEKSINYEAR() returns the number of weeks in the given year."
msgstr ""
"ຟັງຊັ້ນ WEEKSINYEAR() "
"ຈະຄື່ນຄ່າກັບມາເປັນຈຳນວນຂອງສັບດາທີ່ມີໃນປີທີ່ກຳນົດ"

#: xml_doc.cc:284
msgid "WEEKSINYEAR(year)"
msgstr "WEEKSINYEAR(ປີ)"

#: xml_doc.cc:285
msgid "WEEKSINYEAR(2000) returns 52"
msgstr "WEEKSINYEAR(2000) ຈະໄດ້ຄ່າ 52"

#: xml_doc.cc:287
msgid "The MINUTES() function returns the value of the minutes in a time expression."
msgstr ""
"ຟັງຊັ້ນ MINUTES() "
"ຈະຄື່ນຄ່າກັບມາເປັນຄ່ານາທີຂອງຄ່າເວລາທີ່ກຳນົດ"

#: xml_doc.cc:288
msgid "MINUTES(time)"
msgstr "MINUTES(ເວລາ)"

#: xml_doc.cc:289
msgid "MINUTES(\"10:5:2\") returns 5"
msgstr "MINUTES(\"10:5:2\") ຈະໄດ້ຄ່າ 5"

#: xml_doc.cc:291
msgid "The SECONDS() function returns the value of the seconds in a time expression."
msgstr ""
"ຟັງຊັ້ນ SECONDS() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າເປັນຄ່າຈຳນວນວິນາທີຂອງເວລາທີກຳນົດ"

#: xml_doc.cc:292
msgid "SECONDS(time)"
msgstr "SECONDS(ເວລາ)"

#: xml_doc.cc:293
msgid "SECONDS(\"10:5:2\") returns 2"
msgstr "SECONDS(\"10:5:2\") ຈະໄດ້ຄ່າ2"

#: xml_doc.cc:294
msgid "Number of day in week (1..7)"
msgstr "ຈຳນວນຂອງວັນໃນສັບດາ (1..7)"

#: xml_doc.cc:295
msgid ""
"The DAYNAME() function returns the name of the day of the week (1..7). In "
"some countries the first day of the week is Monday, while in others the "
"first day of the week is Sunday."
msgstr ""
"ຟັງຊັ້ນ DAY() "
"ຈະຄືນຄ່າກັບມາເປັນຊື່ຂອງວັນໃນສັບດາ(1..7) "
"ໂດຍໃນບາງປະເທດນັ້ນວັນເລີ່ມສັບດາອາດຈະເປັນວນຈັນໃນຂະນະທີ່ໃນຫລາຍແປະເພທດຈະ "
"ເປັນວັນອາທິດ"

#: xml_doc.cc:296
msgid "DAYNAME(weekday)"
msgstr "DAY(ມື້ໃນສັບດາ)"

#: xml_doc.cc:297
msgid "DAYNAME(1) returns Monday (if the week starts on Monday)"
msgstr ""
"DAY(1) "
"ຈະຄືນຄ່າກັບມາເປັນຈັນ"
"(ຫາກກຳນົດໃຫ້ເລີມສັບດາດ້ວຍວັນຈັນ)"

#: xml_doc.cc:298
msgid "Number of month (1..12)"
msgstr "ເລກຂອງເດື່ອນ (1..12)"

#: xml_doc.cc:299
msgid "The MONTHNAME() function returns the name of the month (1...12)."
msgstr ""
"ຟັງຊັ້ນMONTH() "
"ຈະຄືນຄ່າກັບມາເປັນຊື່ຂອງເດືອນ (1...12)"

#: xml_doc.cc:300
msgid "MONTHNAME(number)"
msgstr "MONTH(ຕົວເລກ)"

#: xml_doc.cc:301
msgid "MONTHNAME(5) returns May"
msgstr "MONTH(5) ຈະໄດ້ຄ່າ ພືດສະພາຄົມ"

#: xml_doc.cc:302
msgid ""
"The CURRENTDATE() function returns the current date formatted with local "
"parameters."
msgstr ""
"ຟັງຊັ້ນ CURRENTDATE() "
"ຈະຄື່ນຄ່າກັບມາເປັນຄ່າຕາມແບບວັນທີ່ຕາມພາສາທີ່ຕັ້ງໄວ້"

#: xml_doc.cc:303
msgid "CURRENTDATE()"
msgstr "CURRENTDATE()"

#: xml_doc.cc:304
msgid "CURRENTDATE() returns \"Saturday 13 April 2002\""
msgstr ""
"CURRENTDATE() ຈະໄດ້ຄ່າ"
"\"ວັນອັງຄານທີ່ 6 ສິງຫາຄົມ ຄ.ສ.2002\""

#: xml_doc.cc:305
msgid ""
"The TODAY() function returns the current date formatted with local "
"parameters. It is identical with SHORTCURRENTDATE and provided for "
"compatibility with other applications."
msgstr ""
"TODAY() ຟັງຊັ້ນຈະສົ່ງຄ່າມືກັບຕົວພາລາມິເຕິ້ຕົວນີ້.SHORTCURRENTDATE "
"ແລະບັນຈຸໃນແອບພິເຄຊັ້ນອື້ນຯ"

#: xml_doc.cc:306
msgid "TODAY()"
msgstr "TODAY()"

#: xml_doc.cc:307
msgid "TODAY() returns \"Saturday 13 April 2002\""
msgstr ""
"CURRENTDATE() ຈະໄດ້ຄ່າ"
"\"ວັນອັງຄານທີ່ 6 ສິງຫາຄົມ ຄ.ສ.2002\""

#: xml_doc.cc:308
msgid ""
"The NOW() function returns the current date formatted with local parameters. "
"It is identical with CURRENTDATETIME and provided for compatibility with "
"other applications."
msgstr ""
"ືNOW() ຟັງຊັ້ນຈະສົ່ງຄ່າມືກັບຕົວພາລາມິເຕິ້ຕົວນີ້.CURRENTDATETIMEE "
"ແລະບັນຈຸໃນແອບພິເຄຊັ້ນອື້ນຯ"

#: xml_doc.cc:309
msgid "NOW()"
msgstr "ືNOW()"

#: xml_doc.cc:310
msgid "NOW() returns \"Saturday 13 April 2002 19:12:01\""
msgstr ""
"CURRENTDATETIME() ຈະໄດ້ຄ່າ"
"\"ວັນອັງຄານທີ 6 ສິງຫາຄົມ ຄ.ສ.2002 "
"13:00:01\""

#: xml_doc.cc:311
msgid ""
"The SHORTCURRENTDATE() function returns the current date formatted with "
"local parameters."
msgstr ""
"ຟັງຊັ້ນ SHORTCURRNTDATE() "
"ຈະຄື່ນຄ່າກັບມາເປັນຄ່າຕາມຮູບແບບວັນທີ່ຕາມພາສາທີ່ຕັ້ງໄວ້"

#: xml_doc.cc:312
msgid "SHORTCURRENTDATE()"
msgstr "SHORTCURRENTDATE()"

#: xml_doc.cc:313
msgid "SHORTCURRENTDATE() returns \"04/13/02\""
msgstr "SHORTCURRENTDATE() ຈະໄດ້ຄ່າ \"06/08/02\""

#: xml_doc.cc:314
msgid ""
"The CURRENTDATETIME() function returns the current date and time formatted "
"with local parameters."
msgstr ""
"ຟັງຊັ້ນ CURRENTDATETIME() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າວັນແລະເວລາປະຈຸບັນໂດຍມີຮູບແບບຕາມພາສາທ້ອງຖິ່ນ"

#: xml_doc.cc:315
msgid "CURRENTDATETIME()"
msgstr "CURRENTDATETIME()"

#: xml_doc.cc:316
msgid "CURRENTDATETIME() returns \"Saturday 13 April 2002 19:12:01\""
msgstr ""
"CURRENTDATETIME() ຈະໄດ້ຄ່າ"
"\"ວັນອັງຄາມທີ 6 ສິງຫາຄົມ ຄ.ສ.2002 "
"13:00:01\""

#: xml_doc.cc:317
msgid ""
"The CURRENTTIME() function returns the current time formatted with local "
"parameters."
msgstr ""
"ຟັ້ງຊັ້ນ CURRENTTIME() "
"ຈະຄືນຄ່າກັບມາເປັນຄ່າເວລາປະຈຸບັນໂດຍມີຮັູບແບບຕາມພາສາທັ້ອງຖິ່ນ"

#: xml_doc.cc:318
msgid "CURRENTTIME()"
msgstr "CURRENTTIME()"

#: xml_doc.cc:319
msgid "CURRENTTIME() returns \"19:12:01\""
msgstr "CURRENTTIME() ຈະໄດ້ຄ່າ\"19:12:01\""

#: xml_doc.cc:320
msgid "Engineering"
msgstr "ທາງວິສະວະກຳ"

#: xml_doc.cc:321 xml_doc.cc:326 xml_doc.cc:331 xml_doc.cc:336 xml_doc.cc:341
#: xml_doc.cc:346 xml_doc.cc:351 xml_doc.cc:356 xml_doc.cc:361 xml_doc.cc:366
#: xml_doc.cc:371 xml_doc.cc:376
msgid "The value to convert"
msgstr "ຄ່າທີ່ຈະແປງ"

#: xml_doc.cc:322
msgid "The DEC2BIN() function returns the value formatted as a binary number."
msgstr ""
"ຟັງຊັ້ນ DEC2BIN() "
"ຈະຄືນຄ່າມາເປັນຄ່າໃນຮູບແບບເລກຖານສອງ"

#: xml_doc.cc:323
msgid "DEC2BIN(value)"
msgstr "DEC2BIN(ຄ່າ)"

#: xml_doc.cc:324
msgid "DEC2BIN(12) returns \"1100\""
msgstr "DEC2BIN(12) ຈະໄດ້ຄ່າ\"1100\""

#: xml_doc.cc:325
msgid "DEC2BIN(55) returns \"110111\""
msgstr "DEC2BIN(55) ຈະໄດ້ຄ່າ \"110111\""

#: xml_doc.cc:327
msgid "The DEC2HEX() function returns the value formatted as a hexadecimal number."
msgstr ""
"ຟັງຊັ້ນ DEC2HEX() "
"ຈະຄືນຄ່າມາເປັນຄ່າໃນຮູບແບບເລກຖານສິບຫົກ"

#: xml_doc.cc:328
