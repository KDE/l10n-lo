"Timeout on server\n"
"%1"
msgstr ""
"ຫມົດເວລາເທີງເຊີບເວີ\n"
"%1"

#: kio/kio/global.cpp:331
#, c-format
msgid ""
"Unknown error\n"
"%1"
msgstr ""
"ບໍ່ຮູ້ຈັກຂໍ້ຜິດພາດ\n"
"%1"

#: kio/kio/global.cpp:334
#, c-format
