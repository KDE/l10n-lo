"Error. Out of Memory.\n"
"%1"
msgstr ""
"ຜິດພາດຫນ່ວຍຄວາມຈຳບໍ່ພຽງພໍ\n"
"%1"

#: kio/kio/global.cpp:316
#, c-format
msgid ""
"Unknown proxy host\n"
"%1"
msgstr ""
"ບໍ່ຮູ້ຈັກໂຫສພອກຊີ\n"
"%1"

#: kio/kio/global.cpp:319
