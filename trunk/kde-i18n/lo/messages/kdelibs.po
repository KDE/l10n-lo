msgid "set XIM server."
msgstr "ຕັ້ງຄ່າເຊີບເວີຣ໌ XIM"

#: kdecore/kapplication.cpp:1175
msgid "disable XIM."
msgstr "ປິດການໃຊ້ງານ XIM"

#: kdecore/kapplication.cpp:1178
msgid "forces the application to run as QWS Server."
msgstr "ບັງຄັບໃຫ້ແອັບພລິເຄຊັນທຳງານແບບເຊີບເວີຣ໌ QWS"

