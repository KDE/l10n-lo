msgstr "ຕົວຊ່ວຍເພີ່ມເຄື່ອງພິມ"

#: kdeprint/management/kmwizard.cpp:168
msgid "Modify printer"
msgstr "ແກ້ໄຂເຄື່ອງພິມ"

#: kdeprint/management/kmwizard.cpp:193
