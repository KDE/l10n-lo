msgstr "ຂໍ້ມູນຄິວຂອງເຊີບເວີ LPD"

#: kdeprint/management/kmwlpd.cpp:46
msgid ""
"<p>Enter the information concerning the remote LPD queue. This wizard will "
"check them before continuing.</p>"
msgstr ""
"<p>ໃສ່ຂໍ້່ມູນກ່ງວກັບຄິວເຄື່ອງພິມໄລຍະໄກLPD "
"ແລະວິຊາດດ໌ນີ້"
"ຈະທຳການກວດສອບມັນ"
"ກ່ອນທີ່ຈະທຳງານຕໍ່ໄປ</p>"

#: kdeprint/management/kmwlpd.cpp:56
msgid "Some information is missing!"
msgstr "ຂໍ້ມູນບາງສ່ວນສູນຫາຍໄປ!"

#: kdeprint/management/kmwlpd.cpp:63
msgid "Can't find queue %1 on server %2! Do you want to continue anyway?"
msgstr ""
"ບໍ່ສາມາດຄົ້ນຫາຄິວ %1 ເທິງ %2 ໄດ້!"
"ທ່ານຕ້ອງການທຳຕໍ່ໄປຫລືບໍ່?"

#: kdeprint/management/kmwname.cpp:36
msgid "General Information"
msgstr "ຂໍ້ມູນທົ່ວໄປ"

#: kdeprint/management/kmwname.cpp:39
msgid ""
"<p>Enter the information concerning your printer or class. <b>Name</b> is "
"mandatory, <b>Location</b> and <b>Description</b>"
" are not (they may even not be used on some systems).</p>"
msgstr ""
"<p>ໃ່ສ່ຂໍ້ມູນກ່ງວກັບເຄື່ອງພິມຫລືຄລາດສ໌ຂອງທ່ານ"
"ຊຶ່ງຢ່າງຫນ້ອຍຕ້ອງຕື່ມ"
"<b>ຊື່</b> ສ່ວນ <b>ຕຳແຫນ່ງ</b> ແລະ"
"<b>ລາຍລະອງດ</b> ບໍ່ຖືກຕ້ອງ"
"(ອາດຈະບໍ່ໃຊ້ເທິງລະບົບ)</p>"

#: kdeprint/management/kmwname.cpp:50
msgid "You must supply at least a name!"
msgstr "ທ່ານຕ້ອງຕື່ມຢ່າງຫນ້ອຍຫນຶ່ງຊື່"

#: kdeprint/management/kmwname.cpp:58
msgid ""
"This is usually not a good idea to include spaces in printer name. This may "
"prevent your printer from working correctly. The wizard can strip all spaces "
"from the string you entered, resulting in %1. What do you want to do?"
msgstr ""
"ເປັນຄວາມຄິດທີ່ບໍ່ດີທີ່ຈະໃຫ້ຊື່ເຄື່ອງພິມ"
"ຊ່ອງວ່າ"
"ເພຣາະອາດຈະທຳໃຫ້ເຄື່ອງພິມ"
"ຂອງທ່ານທຳງານໄດ້ບໍ່ຖືກຕ້ອງ"
"ໂດຍຕົວຊ່ວຍເຫລືອນີ້"
"ສາມາດລົບຊ່ອງວ່າງທີ່ມີ"
"ອອກໄປຈາກຊື່ທີ່ທ່ານຕື່ມໄວ້"
"ໄດ້, ໂດຍຈະມີຜົນເປັນ%1"
"ທ່ານຕ້ອງການຈະເຮັດຫຍັງ?"

#: kdeprint/management/kmwname.cpp:64
msgid "Strip"
msgstr "ລົບຊ່ອງວ່າງ"

#: kdeprint/management/kmwpassword.cpp:38
