"ບໍ່ຮູ້ຈັກອິນເທີຣັບ\n"
"%1"

#: kio/kio/global.cpp:345
msgid ""
"Could not delete original file %1.\n"
"Please check permissions."
msgstr ""
"ບໍ່ສາມາດລືບແຟ້ມຕົ້ນສະບັບ %1 ໄດ้້\n"
"ໂປຣດກວດສອບສິດຂອງທ່ານ"

#: kio/kio/global.cpp:348
msgid ""
"Could not delete partial file %1.\n"
"Please check permissions."
msgstr ""
"ບໍ່ສາມາດລືບແຟ້ມບາງສ່ວນ %1 ໄດ້\n"
"ກະລຸນາກວດສອບສິດຂອງທ່ານ"

#: kio/kio/global.cpp:351
msgid ""
"Could not rename original file %1.\n"
"Please check permissions."
msgstr ""
"ບໍ່ສາມາດປ່ຽນຊື່ເກົ່າຂອງແຟ້ມ %1 ໄດ້\n"
"ກະລຸນາກວດສອບສິດຂອງທ່ານ"

#: kio/kio/global.cpp:354
msgid ""
"Could not rename partial file %1.\n"
"Please check permissions."
msgstr ""
"ບໍ່ສາມາດປ່ຽນຊື່ແຟ້ມບາງສ່ວນ %1 ໄດ້\n"
"ກະລຸນາກວດສອບສິດຂອງທ່ານນ"

#: kio/kio/global.cpp:357
msgid ""
"Could not create symlink %1.\n"
"Please check permissions."
msgstr ""
"ບໍ່ສາມາດສ້າງລິງ %1 ໄດ້\n"
"ກະລຸນາກວດສອບສິດຂອງທ່ານ"

#: kio/kio/global.cpp:363
msgid ""
"Could not write file %1.\n"
"Disk full."
msgstr ""
"ບໍ່ສາມາດຂຽນແຟ້ມ \"%1\" ໄດ້\n"
"ເນື່ອງຈາກດິສເຕັມ"

#: kio/kio/global.cpp:366
#, c-format
msgid ""
"The source and destination are the same file.\n"
"%1"
msgstr ""
"ແຟ້ມຕົ້ນທ່າງແລະປາຍທາງເປັນແຟ້ມດ່ຽວກັນ\n"
"%1"

#: kio/kio/global.cpp:372
msgid "%1 is required by the server, but is not available."
msgstr "ເຊີເວີຕ້ອງການ %1 ແຕ່ມັນຍັງບໍ່ມີຢູ່"

#: kio/kio/global.cpp:374
msgid "Access to restricted port in POST denied"
msgstr "Accesst to restricted port in POST denied"

#: kio/kio/global.cpp:377
msgid ""
"Unknown error code %1\n"
"%2\n"
"Please send a full bug report at http://bugs.kde.org."
msgstr ""
"ບໍ່ຮູ້ຈັກຂໍ້ຜິດພາດລະຫັດ %1\n"
"%2\n"
"ກະລຸນາສົ່ງລາຍງານຄວາມຜິດພາດຄົບຖ້ວນ ໄປຍັງ http://bugs.kde.org"

#: kio/kio/global.cpp:400 kio/kio/global.cpp:482
msgid "(unknown)"
msgstr "(ບໍ່ຮູ້ຈັກ)"

#: kio/kio/global.cpp:412
msgid "<b>Technical Reason</b>: "
msgstr "<b>ເຫດຜົນທາງເທັກນິກ</b>: "

#: kio/kio/global.cpp:413
msgid "</p><p><b>Details of the Request</b>:"
msgstr ""
"</p>"
"<p><b>ລາຍລະອຽດຂອງສິ່ງຮ້ອງຂໍ</b>:"

#: kio/kio/global.cpp:414
msgid "</p><ul><li>URL: %1</li>"
msgstr "</p><ul><li>URL: %1</li>"

#: kio/kio/global.cpp:416
msgid "<li>Protocol: %1</li>"
msgstr "<li>ໂປຣໂຕຄອນ: %1</li>"

#: kio/kio/global.cpp:418
msgid "<li>Date and Time: %1</li>"
msgstr "<li>ມື້ແລະເວລາ: %1</li>"

#: kio/kio/global.cpp:419
msgid "<li>Additional Information: %1</li></ul>"
msgstr "<li>ລາຍລະອຽດເພີ່ມເຕີ່ມ: %1</li></ul>"

#: kio/kio/global.cpp:421
msgid "<p><b>Possible Causes</b>:</p><ul><li>"
msgstr "<p><b>ອາດຈະເນືອງມາຈາກ</b>:</p><ul><li>"

#: kio/kio/global.cpp:426
msgid "<p><b>Possible Solutions</b>:</p><ul><li>"
msgstr ""
"<p><b>ໂຊລູຊັນທີ່ເປັນໄປໄດ້</b>:</p>"
"<ul><li>"

#: kio/kio/global.cpp:492
msgid ""
"Contact your appropriate computer support system, whether the system "
"administrator, or technical support group for further assistance."
msgstr ""
"ຕິດຕໍ່ຜູ້ໃຫ້ບໍລິການດູແລລະບົບຄອມພິວເຕີຂອງທ່ານຊື່ງາດຈະເປັນຜູ້ດູແລລະບົບຫລືບໍລິການທາງເທັກນິດໃນການຂໍ "
"ຄຳແນະນຳ"

#: kio/kio/global.cpp:495
msgid "Contact the administrator of the server for further assistance."
msgstr "ຕິດຕໍ່ຜູ້ດູແລລະບົບ ຫລືບໍລິການທາງເທັກນິກໃນການຂໍຮັບຄຳແນະນຳ"

#: kio/kio/global.cpp:498
msgid "Check your access permissions on this resource."
msgstr "ໂປດກວດສອບສິດທີ່ໄດ້ຮັບອະນຸຍາດໃຊ້ສັບພະຍາກອນນີ້ຂອງທ່ານ"

#: kio/kio/global.cpp:499
msgid ""
"Your access permissions may be inadequate to perform the requested operation "
"on this resource."
msgstr "ສິດທີ່ໄດ້ຮັບອະນຸຍາດທ່ານອາດຈະບໍ່ພຽງພໍໃນການທຳປະຕິບັດການເທີງສັບພະຍາກອນນີ້"

#: kio/kio/global.cpp:501
msgid "The file may be in use (and thus locked) by another user or application."
msgstr ""
"ແຟ້ມອາດຈະຖືກໃຊ້ຢູ່(ແລະອາດຖືກລອກໄວ້) "
"ໂດຍຜູ້ໃຊ້ຫລືແອບພິເຄຊັ້ນ"

#: kio/kio/global.cpp:503
msgid ""
"Check to make sure that no other application or user is using the file or "
"has locked the file."
msgstr "ໂປດກວດສອບໃຫ້ແນ່ໃຈວ່າບໍ່ມີແອບພິເຄຊັ້ນຫລືຜູ້ໃຊ້ໃດກຳລັງໃຊ້ງານແຟ້ມຫລືລອກແຟ້ມໄວ້ຢູ່ຫລືບໍ่່"

#: kio/kio/global.cpp:505
msgid "Although unlikely, a hardware error may have occurred."
msgstr "ແມມວ່າອາດຈະບໍ່ຄືກັນແລະອາດຈະເກີດຄວາມຜິດພາດທາງຮາດແວຂື້ນໄດ້"

#: kio/kio/global.cpp:507
msgid "You may have encountered a bug in the program."
msgstr "ທ່ານອາດຈະເຂົ້າຖື່ງສ່ວນທີ່ເປັນຄວາມຜິດພາດຂອງໂປຣແກຣ"

#: kio/kio/global.cpp:508
msgid ""
"This is most likely to be caused by a bug in the program. Please consider "
"submitting a full bug report as detailed below."
msgstr ""
"ນີ້ອາດຈະຄ້າຍກັບຂໍ້ຜິດພາດ (ບັກ) ໃນໂປຣແກຣມ"
"ໂປດພິຈະລະນາລາຍງານຄວາມຜິດພາດໃນລາຍອຽດດ້ານລຸ່ມນີ້"

#: kio/kio/global.cpp:510
msgid ""
"Update your software to the latest version. Your distribution should provide "
"tools to update your software."
msgstr ""
"ໃນອັບເດດຊອບແວໄປເປັນລຸ່ນລ່າສຸດນັ້ນ"
"ດິສທິບິວຊັ້ນຂອງທ່ານ"
"ມັກຈະມີເຄື່ອງມືສຳລັບໃຊ້ອັບເດດໃຫ້ຢູ່ແລ້ວ"

#: kio/kio/global.cpp:512
msgid ""
"When all else fails, please consider helping the KDE team or the third party "
"maintainer of this software by submitting a high quality bug report. If the "
"software is provided by a third party, please contact them directly. "
"Otherwise, first look to see if the same bug has been submitted by someone "
"else by searching at the <a href=\"http://bugs.kde.org/\">KDE bug reporting "
"website</a>. If not, take note of the details given above, and include them "
"in your bug report, along with as many other details as you think might help."
msgstr ""
"ຫາກມີຂໍ້ຜິດພາດຫລືອື່ນຯ ໂປດຊ່ວຍເລຫືອທີ KDE "
"ຫລືຜູຸ້ດູແລອື່ນຯຂອງຊອບແວນີ້"
"ດ້ວຍການລາຍງານຄວາມຜິດພາດດ້ວຍລາຍລະອຽດຄວາມຜິດພາດທີ່ສົມບູນ "
"ຫາກຊອບແວມາຈາກຜູຸ້ສ້າງອື່ມຯ "
"ໂປດຕິດຕໍ່ຜູ້ສ້າງຊອບແວໂດຍຕົງໂດຍກ່ອນອື້ນ "
"ໃຫ້ກວດສອບການລາຍງານຄວາມຜິດພາດກ່ອນຯທີ່ເວັບໄຊ <a "
"href=\"http://bugs.kde.org/\">ລາຍງານຂໍ້ຜິດພາດ KDE</a> "
"ວ່າມີການລາຍງານຜິດພາດດ່ຽວກັນນີ້ມາກ່ອນຫລືບໍ່ຫາກຍັງບໍ່ມີໃຫ້ລວບລວມລາຍລະອຽດທີີໃຫ້ດ້ານເທີງ "
"ແລະລວມມັນເຂົ້າກັບລາຍງານຄວາມຜິດພາດຂອງທ່ານຫລືລາຍລະອຽດອື່ນຯທີ່ທ່ານເຫັນວ່າມີປະໂຫຍດ "
"ໃນການແກ້ໄຂຄວາມຜິດພາດ"

#: kio/kio/global.cpp:520
msgid "There may have been a problem with your network connection."
msgstr "ອາດຈະມີປັນຫາການເຊື່ອມຕໍ່ກັບລະບົບເຄືອຂ່າຍຂອງທ່ານ"

#: kio/kio/global.cpp:523
msgid ""
"There may have been a problem with your network configuration. If you have "
"been accessing the Internet with no problems recently, this is unlikely."
msgstr ""
"ອາດຈະມີປັນຫາເນື່ອງມາຈາກການປັບແຕ່ງລະບົບເຄືອຂ່າຍຂອງທ່ານ ຫາກທ່ານເຄີຍສາມາດເຂົ້່າໃຊ້ງານອິນເຕີ "
"ເນັກໂດຍບໍ່ມີປັນຫາກມາກ່ອນ"

#: kio/kio/global.cpp:526
msgid ""
"There may have been a problem at some point along the network path between "
"the server and this computer."
msgstr "ມັນອາດຈະມີປັນຫາໃນບາງຈຸດໃນເສັ້່ນທາງສືສານລະຫວ່າງເຊີບເວີແລະຄອມພິວເຕີນີ້"

#: kio/kio/global.cpp:528
msgid "Try again, either now or at a later time."
msgstr "ໂປດລອງໃຫມ່ອີກຄັ້ງໃນຕອນ ຫລືໃນພາຍຫລັງ"

#: kio/kio/global.cpp:529
msgid "A protocol error or incompatibility may have occurred."
msgstr "ໂປໂຕຄອນຜິດພາດຫລືອາດຈະເກີດການເຂົ້າກັນບໍ່ໄດ້ຂື້ນມາ"

#: kio/kio/global.cpp:530
msgid "Ensure that the resource exists, and try again."
msgstr "ໂປດແນ່ໃຈວ່າທັບພະຍາກອນຍັງມີຢູ່ແລະລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:531
msgid "The specified resource may not exist."
msgstr "ທັບພະຍາກອນທີ່ກຳນົດອາດຈະຍັງບໍ່ມີ"

#: kio/kio/global.cpp:532
msgid "You may have incorrectly typed the location."
msgstr "ທ່ານອາດຈະພິມຕຳແຫນ່ງທີ່ຢູ່ບໍ່ຖືກຕ້ອງ"

#: kio/kio/global.cpp:533
msgid "Double-check that you have entered the correct location and try again."
msgstr "ໂປດກວດສອບຊຳ້ວ່າທ່ານໄດ້ເຕີ່ມຕຳແໜ່ງທີ່ຢູ່ທີ່ຖືກຕ້ອງແລ້ວແລະລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:535
msgid "Check your network connection status."
msgstr "ໂປດກວດສອບສະຖານະການເຊື່ອມຕໍ່ລະບົບເຄືອຂ່າຍຂອງທ່ານ"

#: kio/kio/global.cpp:539
msgid "Cannot Open Resource For Reading"
msgstr "ບໍ່ສາມາດເປີດໃຊ້ພະຍາກອນເພື່ອທຳການອ່ານໄດ້"

#: kio/kio/global.cpp:540
msgid ""
"This means that the contents of the requested file or directory "
"<strong>%1</strong> could not be retrieved, as read access could not be "
"obtained."
msgstr ""
"ບໍ່ສາມາດຮຽກຂໍເນື້ອຫາຂອງແຟ້ມທີ່ຕ້ອງການຫລືໄດເລັກທໍລີ<strong>%1</strong> "
"ໄດ້ເນື່ອງຈາກບໍ່ມີສິດໃນການອ່ານ"

#: kio/kio/global.cpp:543
msgid "You may not have permissions to read the file or open the directory."
msgstr "ທ່ານຍັງບໍ່ມີສິດໃນການອ່ານແຟ້ມຫລືເປີດໃຊ້ໄດເລັກທໍລີນີ້"

#: kio/kio/global.cpp:549
msgid "Cannot Open Resource For Writing"
msgstr "ບໍ່ສາມາດເປີດທັບພະຍາກອນເພື່ອທຳການຂຽນໄດ້"

#: kio/kio/global.cpp:550
msgid ""
"This means that the file, <strong>%1</strong>, could not be written to as "
"requested, because access with permission to write could not be obtained."
msgstr ""
"ບໍ່ສາມາດຂຽນໄປຍັງແຟ້ມ"
"<strong>%1</strong>ຕາມຕ້ອງການໄດ້ເນືອງຈາກ"
"ອາດຈະຍັງບໍ່ມີສິດໃນການເຂົ້າໃຊ້ແລະຂຽນໄປໄດ້"

#: kio/kio/global.cpp:558
msgid "Cannot Initiate the %1 Protocol"
msgstr ""
"ບໍ່ສາມາດເລີ່ມໂປໂຕຄອນ %1 "
"ໄດ້"

#: kio/kio/global.cpp:559
msgid "Unable to Launch Process"
msgstr "ບໍ່ສາມາດຮຽກທຳງານໂປຣເຊສໄດ້"

#: kio/kio/global.cpp:560
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol could not be started. This is usually due to "
"technical reasons."
msgstr ""
"ບໍ່ສາມາດເລີ່ມໂປຣແກຣມເທີງຄອມພິວເຕີຂອງທ່ານທີ່ຕ້ອງການເຂົ້າໃຊ້ງານໂປຣໂຕຄອນ<strong>%1</strong> ໄ້ດ້"
"ໍືຊື່ງອາດຈະເກີດຈາກປັນຫາທາງເທັກນິກ"

#: kio/kio/global.cpp:563
msgid ""
"The program which provides compatibility with this protocol may not have "
"been updated with your last update of KDE. This can cause the program to be "
"incompatible with the current version and thus not start."
msgstr ""
"ໂປຣແກຣມທີ່ຕ້ອງການຄວາມເຂົ້າກັນໄດ້ກັບໂປຣໂຕຄອນນີ້ອາດຈະຍັງບໍ່ໄດ້ປັບປຸງ "
"ເປັນໃຫ້ເປັນລຸ້ນໃຫມ່ຕາມ KDE "
"ຂອງທ່ານ"
"ໍືຊື່ງອາດຈະເຮັດໃຫ້ເກີດຄວາມເຂົ້າກນັບໍ່ໄດ້ກັບໂປຣແຣກມລຸ້ນປະຈຸບັນທີ່ທ່ານໃຊ້ຢູ່ແລະບໍ່ສາມາດທຳງານໄດ້"

#: kio/kio/global.cpp:571
msgid "Internal Error"
msgstr "ຂໍ້ຜິດພາດພາຍໃນ"

#: kio/kio/global.cpp:572
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has reported an internal error."
msgstr "ເກີດຄວາມຜິດພາດພາຍໃນຈາກໂປຣແກຣບົນຄອມພິວເຕີຂອງທ່ານຊື່ງຕ້ອງການເຂົ້າໃຊ້ງານໂປຣໂຕຣຄອນ <strong>%1</strong>"

#: kio/kio/global.cpp:580
msgid "Inproperly Formatted URL"
msgstr ""
"ຮູບແບບ URL "
"ບໍ່ຖືກຕ້ອງຫລືສົມບູນ "

#: kio/kio/global.cpp:581
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator (URL) that you entered was not properly formatted. "
"The format of a URL is generally as "
"follows:"
"<blockquote><strong>"
"protocol://user:password@www.example.org:port/directory/filename.extension?qu"
"ery=value</strong></blockquote>"
msgstr ""
"ຕຳແຫນ່ງຂອງ<strong>U</strong>niversal "
"<strong>R</strong>esource <strong>L</strong>ocation (URL) "
"ທີ່ທ່ານເຕີ່ມ"
"ອາດຈະບໍ່ຖືກຕ້ອງຫລືສົມບູນ ຊື່ງຮູບແບບຂອງຕາມປົກກະຕິຄື URL "
":"
"<blockquote><strong>ໂປຣໂຕຄອນ://ຜູ້ໃຊ້@ລະຫັດຜ່ານ:ໂຫສ.ຊື່:ພອດ/"
"ໄດເລັກທໍລີ/ຊື່ແຟ້ມ.ສວນ່ຂະຫຍາຍ"
"?ຕົວແປ=ຄ່າ</strong></blockquote>"

#: kio/kio/global.cpp:590
#, c-format
msgid "Unsupported Protocol %1"
msgstr "ບໍ່ສະນັບສະນຸນໂປຣໂຕຄອນ %1"

#: kio/kio/global.cpp:591
msgid ""
"The protocol <strong>%1</strong> is not supported by the KDE programs "
"currently installed on this computer."
msgstr ""
"ໂປຣໂຕຄອນ <strong>%1</strong> "
"ຍັງບໍ່ໄດ້ຮັບການສະນັບສະນຸນຈາກໂປຣແກຣມ KDE ຕົວປະຈຸບັນທີ່ຕິດຕັ້ງໃນຄອມພິວເຕີນີ้້"

#: kio/kio/global.cpp:594
msgid "The requested protocol may not be supported."
msgstr "ບໍ່ສະນັບສະນຸນໂປໂຕຄອນທີ່ຮ້ອງຂໍມາ"

#: kio/kio/global.cpp:595
msgid ""
"The versions of the %1 protocol supported by this computer and the server "
"may be incompatible."
msgstr ""
"ລຸ້ນຂອງໂປໂຕຄອນ %1 "
"ທີ່ໄດ້ຮັບການສະນັບສະນຸນໂດຍຄອມພິວເຕີນີ້ແລະເຊີບເວີອາດຈະເຂົ້າກັນລໍ່ໄດ້່"

#: kio/kio/global.cpp:597
msgid ""
"You may perform a search on the Internet for a KDE program (called a "
"kioslave or ioslave) which supports this protocol. Places to search include "
"<a href=\"http://apps.kde.com/\">http://apps.kde.com/</a> and <a "
"href=\"http://freshmeat.net/\">http://freshmeat.net/</a>."
msgstr ""
"ທ່ານສາມາດຄົ້ນຫາຂໍ້ມູນເທີງອິນເຕີເນັດດ້ວຍໂປຣແກຣຂອງ KDE "
"(ທີ່ຮຽກວ່າ kioslave ຫລື ioslave) ຊື່ງສະນັບສະນຸນໂປໂຕຄອນນີ້ຊື່ງສະຖານສຳລັບຄົ້ນຫາຈະຮວມຖືງ <a href=\"http://apps.kde.com/\">http://apps.kde.com/</a> "
"ແລະ <a href=\"http://freshmeat.net/\">http://freshmeat.net/</a>"

#: kio/kio/global.cpp:606
msgid "URL Does Not Refer to a Resource."
msgstr ""
"ຕຳແຫນ່ງ URL "
"ບໍ່ໄດ້ອ້າງຖື່ງແຫລ່ງທີ່ມາ"

#: kio/kio/global.cpp:607
msgid "Protocol is a Filter Protocol"
msgstr "ໂປຣໂຕຄອນເປັນໂປຣໂຕຄອນແບບຕົວກອງ"

#: kio/kio/global.cpp:608
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator (URL) that you entered did not refer to a specific "
"resource."
msgstr ""
"ຕຳແຫນ່ງ <strong>U</strong>niversal <strong>R</strong>esource "
"<strong>L</strong>ທີ່ທ່ານຕື່ມ"
"ບໍ່ໄດ້ອ້າງອີງຖືງແຫລ່ງ"

#: kio/kio/global.cpp:611
msgid ""
"KDE is able to communicate through a protocol within a protocol; the "
"protocol specified is only for use in such situations, however this is not "
"one of these situations. This is a rare event, and is likely to indicate a "
"programming error."
msgstr ""
"KDE ສາມາດສື່ສານກັນໄດ້ ຜ່ານທາງໂປຣໂຕຄອລຊ້ອນໂປຣໂຕຄອບ "
"ເຊິ່ງຈະກຳນົດໃຊ້ໂປຣໂຕຄອບສະເພາະກັບແຕ່ລະສະຖານະການ ຢ່າງໃດກໍຕາມ ມັນກໍບໍ່ໄດ້ມີພຽງຫນຶ່ງຕົວສຳຫລັບສະຖານະການນີ້ "
"ນີ້ເປັນເຫດການຈິງ ແລະເບິ່ງຄືຈະເປັນຄວາມຜິດພາດໃນການຂຽນໂປຣແກຣມ"

#: kio/kio/global.cpp:619
#, c-format
msgid "Unsupported Action: %1"
msgstr "ບໍ່ສະຫນັບສະຫນຸນການກະທຳ: %1"

#: kio/kio/global.cpp:620
msgid ""
"The requested action is not supported by the KDE program which is "
"implementing the <strong>%1</strong> protocol."
msgstr ""
"ການກະທຳທີ່ຮ້ອງຂໍມາ ບໍ່ສະຫນັບສະຫນຸນໂດຍໂປຣແກຣມ KDE "
"ເຊິ່ງເປັນຕົວກຳນົດໂປຣໂຕຄອລ "
"<strong>%1</strong>"

#: kio/kio/global.cpp:623
msgid ""
"This error is very much dependent on the KDE program. The additional "
"information should give you more information than is available to the KDE "
"input/output architecture."
msgstr ""
"ຂໍ້ຜິດພາດນີ້ ຂຶ້ນຢູ່ກັບໂປຣແກຣມ KDE "
"ເປັນຢ່າງຫລາຍ ເຊິ່ງລາຍລະອຽດເພີ້ມເຕີມ ຄວນຈະມີລາຍລະອຽດຫລາຍກວ່າທີ່ມີຢູ່ ໃນສ່ວນສະຖາປັດຕະຍະກຳ "
"input/output ຂອງ KDE "

#: kio/kio/global.cpp:626
msgid "Attempt to find another way to accomplish the same outcome."
msgstr "ກຳລັງຫາທາງອື່ນເພື່ອໃຫ້ໄດ້ຜົນລັບແບບດຽວກັນ"

#: kio/kio/global.cpp:631
msgid "File Expected"
msgstr "ຕ້ອງການແຟ້ມ"

#: kio/kio/global.cpp:632
msgid ""
"The request expected a file, however the directory <strong>%1</strong> was "
"found instead."
msgstr ""
"ສິ່ງທີ່ຮ້ອງຂໍມາຕ້ອງການແຟ້ມ ແຕ່ກັບພົບວ່າ  <strong>%1</strong> "
"ເປັນໄດເຣກທໍລີ"

#: kio/kio/global.cpp:634
msgid "This may be an error on the server side."
msgstr "ອາດຈະເກີດຄວາມຜິດພາດທາງຝັ່ງເຊີບເວີ"

#: kio/kio/global.cpp:639
msgid "Directory Expected"
msgstr "ຕ້ອງການໄດເຣກທໍລີ"

#: kio/kio/global.cpp:640
msgid ""
"The request expected a directory, however the file <strong>%1</strong> was "
"found instead."
msgstr ""
"ສິ່ງທີ່ຮ້ອງຂໍມາຕ້ອງການໄດເຣກທໍລີ ແຕ່ກັບພົບວ່າ  <strong>%1</strong>"
"ເປັນແຟ້ມ"

#: kio/kio/global.cpp:647
msgid "File or Directory Does Not Exist"
msgstr "ຍັງບໍ່ມີແຟ້ມຫລືໄດເຣກທໍລີ"

#: kio/kio/global.cpp:648
msgid "The specified file or directory <strong>%1</strong> does not exist."
msgstr ""
"ແຟ້ມຫລືໄດເຣກທໍລີ <strong>%1</strong> "
"ທີ່ກຳນົດຍັງບໍ່ມີ"

#: kio/kio/global.cpp:655 kio/kio/job.cpp:1350 kio/kio/job.cpp:2466
msgid "File Already Exists"
msgstr "ມີແຟ້ມນີ້ຢູ່ແລ້ວ"

#: kio/kio/global.cpp:656
msgid ""
"The requested file could not be created because a file with the same name "
"already exists."
msgstr "ບໍ່ສາມາດສ້າງແຟ້ມທີ່ຮ້ອງຂໍມາໄດ້ ເນື່ອງຈາກມີແຟ້ມເຊິ່ງມີຊື່ດຽວກັນຢູ່ແລ້ວ"

#: kio/kio/global.cpp:658
msgid "Try moving the current file out of the way first, and then try again."
msgstr "ລອງທຳການຍ້າຍແຟ້ມປັດຈຸບັນອອກໄປກ່ອນ ແລ້ວລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:660
msgid "Delete the current file and try again."
msgstr "ລຶບແຟ້ມທີ່ໃຊ້ໃນປັດຈຸບັນ ແລະລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:661
msgid "Choose an alternate filename for the new file."
msgstr "ເລືອກຊື່ແຟ້ມເປັນຊື່ອື່ນ ສຳຫລັບແຟ້ມໃຫມ່"

#: kio/kio/global.cpp:665 kio/kio/job.cpp:2218
msgid "Directory Already Exists"
msgstr "ມີໄດເຣກທໍລີນີ້ຢູ່ແລ້ວ"

#: kio/kio/global.cpp:666
msgid ""
"The requested directory could not be created because a directory with the "
"same name already exists."
msgstr "ບໍ່ສາມາດສ້າງໄດເຣກທໍລີທີ່ຮ້ອງຂໍມາໄດ້ ເນື່ອງຈາກມີໄດເຣກທໍລີຊື່ດຽວກັນນີ້ຢູ່ແລ້ວ"

#: kio/kio/global.cpp:668
msgid "Try moving the current directory out of the way first, and then try again."
msgstr "ລອງຍ້າຍໄດເຣກທໍລີປັດຈຸບັນອອກໄປກ່ອນ ແລ້ວລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:670
msgid "Delete the current directory and try again."
msgstr "ລຶບໄດເຣກທໍລີປັດຈຸບັນກ່ອນ ແລະລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:671
msgid "Choose an alternate name for the new directory."
msgstr "ເລືອກຊື່ໃຫມ່ສຳຫລັບໄດເຣກທໍລີໃຫມ່"

#: kio/kio/global.cpp:675
msgid "Unknown Host"
msgstr "ໂຮສຕ໌ທີ່ໍບໍ່ຮູ້ຈັກ"

#: kio/kio/global.cpp:676
msgid ""
"An unknown host error indicates that the server with the requested name, "
"<strong>%1</strong>, could not be located on the Internet."
msgstr ""
"ເກີດຄວາມຜິດພາດຈາກໂຮສຕ໌ທີ່ບໍ່ຮູ້ຈັກ ສະແດງວ່າ ເຊີບເວີຊື່ "
"<strong>%1</strong>ທີ່ຮ້ອງຂໍມາ ບໍ່ສາມາດຫາຕຳແຫນ່ງເທິງອິນເຕ່ເນຕໄດ້"

#: kio/kio/global.cpp:679
msgid "The name that you typed, %1, may not exist: it may be incorrectly typed."
msgstr "ຊື່ %1 ທີ່ທ່ານພີມມາ ອາດຈະບໍ່ມີຢູ່ ຫລືອາດຈະເກີດຈາກການພີມຜິດ"

#: kio/kio/global.cpp:686
msgid "Access Denied"
msgstr "ໄດ້ຮັບການປະຕິເສດໃຫ້ເຂົ້າໃຊ້"

#: kio/kio/global.cpp:687
msgid "Access was denied to the specified resource, <strong>%1</strong>."
msgstr "ໄດ້ຮັບການປະຕິເສດໃນການໃຊ້ງານຊັບພະຍາກອນ <strong>%1</strong>"

#: kio/kio/global.cpp:689 kio/kio/global.cpp:905
msgid "You may have supplied incorrect authentication details or none at all."
msgstr "ທ່ານອາດຈະລືມໃສ່ລາຍລະອຽດຫລືໃສ່ລາຍລະອຽດບໍ່ຖືກຕ້ອງສຳຫລັບການກວດສອບສິດ"

#: kio/kio/global.cpp:691 kio/kio/global.cpp:907
msgid "Your account may not have permission to access the specified resource."
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ຂຽນໄປຍັງຊັບພະຍາກອນນີ້"

#: kio/kio/global.cpp:693 kio/kio/global.cpp:909 kio/kio/global.cpp:921
msgid ""
"Retry the request and ensure your authentication details are entered "
"correctly."
msgstr "ລອງເຮັດສິ່ງຮ້ອງຂໍມາ ແລະກວດສອບໃຫ້ແນ່ໃຈວ່າ ໄດ້ຕື່ມລາຍລະອຽດສ່ວນການກວດສອບສິດ ຖຶກຕ້ອງແລ້ວ"

#: kio/kio/global.cpp:699
msgid "Write Access Denied"
msgstr "ໄດ້ຮັບການປະຕິເສດໃນການຂຽນ"

#: kio/kio/global.cpp:700
msgid ""
"This means that an attempt to write to the file <strong>%1</strong> was "
"rejected."
msgstr "ໄດ້ຮັບການປະຕິເສດໃຫ້ທຳການຂຽນໄປຍັງແຟ້ມ <strong>%1</strong>"

#: kio/kio/global.cpp:707
msgid "Unable to Enter Directory"
msgstr "ບໍ່ສາມາດເຂົ້າໄປຍັງໄດເຣກທໍລີໄດ້"

#: kio/kio/global.cpp:708
msgid ""
"This means that an attempt to enter (in other words, to open) the requested "
"directory <strong>%1</strong> was rejected."
msgstr ""
"ໄດ້ຮັບການປະຕິເສດໃນການເຂົ້າໄປຍັງ (ຫລື ເປີດໃຊ້) "
"ໄດເຣກທໍລີ <strong>%1</strong> "
"ທີ່ຮ້ອງຂໍມາ"

#: kio/kio/global.cpp:716
msgid "Directory Listing Unavailable"
msgstr "ບໍ່ສາມາດເອີ້ນເບິ່ງພາຍໃນໄດເຣກທໍລີໄດ້"

#: kio/kio/global.cpp:717
msgid "Protocol %1 is not a Filesystem"
msgstr "ໂປຣໂຕຄອລ %1 ບໍ່ແມ່ນລະບົບແຟ້ມ"

#: kio/kio/global.cpp:718
msgid ""
"This means that a request was made which requires determining the contents "
"of the directory, and the KDE program supporting this protocol is unable to "
"do so."
msgstr ""
"ສິ່ງທີ່ຮ້ອງຂໍມາ ຕ້ອງການເອີ້ນເບິ່ງເນື້ນຫາພາຍໃນໄດເຣກທໍລີ ແລະໂປຣແກຣມ KDE "
"ທີ່ສະຫນັບສະຫນຸນໂປຣໂຕຄອລນີ້ ບໍ່ສາມາດເຮັດເຊັ່ນນັ້ນໄດ້"

#: kio/kio/global.cpp:726
msgid "Cyclic Link Detected"
msgstr "ກວດສອບພົບລິງແບບວົນຮອບ"

#: kio/kio/global.cpp:727
msgid ""
"UNIX environments are commonly able to link a file or directory to a "
"separate name and/or location. KDE detected a link or series of links that "
"results in an infinite loop - i.e. the file was (perhaps in a roundabout "
"way) linked to itself."
msgstr ""
"ຕາມປົກະຕິ ສະພາບແວດລ້ອມຂອງລະບົບຢູນິກຊ໌ ສາມາດທຳການລິງແຟ້ມ ຫລືໄດເຣກທໍລີ ໄປເປັນຊື່ອື່ນ "
"ແລະ/ຫລືໃນຕຳແໜ່ງອື່ນໆ ໄດ້  "
"ເຊິ່ງ KDE ໄດ້ກວດພົບລິງ ຫລືຊຸດຂອງລິງ ໃນແບບວົນຮອບບໍ່ຮູ້ຈົບ - ເຊັ່ນ "
"ແຟ້ມທີ່ທຳການລິງໄປຍັງຕົວມັນເອງ ເປັນຕົ້ນ"

#: kio/kio/global.cpp:731 kio/kio/global.cpp:753
msgid ""
"Delete one part of the loop in order that it does not cause an infinite "
"loop, and try again."
msgstr "ລຶບສ່ວນຫນຶ່ງຂອງການວົນຮອບ ໃນລຳດັບທີ່ຈະທຳໃຫ້ມັນບໍເປັນການວົນຮອບບໍ່ຮູ້ຈົບ ແລ້ວລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:740
msgid "Request Aborted By User"
msgstr "ຕ້ອງການຍົກເລີກໂດຍຜູ້ໃຊ້"

#: kio/kio/global.cpp:741 kio/kio/global.cpp:1034
msgid "The request was not completed because it was aborted."
msgstr "ບໍ່ສາມາດເຮັດສິ່ງທີ່ຮ້ອງຂໍມາໃຫ້ສຳເລັດໄດ້ ເນື່ອງຈາກມັນຖືກຍົກເລີກເສຍກ່ອນ"

#: kio/kio/global.cpp:743 kio/kio/global.cpp:937 kio/kio/global.cpp:1036
msgid "Retry the request."
msgstr "ພະຍາຍາມເຮັດສິ່ງທີ່ຮ້ອງຂໍມາ"

#: kio/kio/global.cpp:747
msgid "Cyclic Link Detected During Copy"
msgstr "ພົບລິງແບບວົນຮອບຂະນະທຳການຄັດລອກ"

#: kio/kio/global.cpp:748
msgid ""
"UNIX environments are commonly able to link a file or directory to a "
"separate name and/or location. During the requested copy operation, KDE "
"detected a link or series of links that results in an infinite loop - i.e. "
"the file was (perhaps in a roundabout way) linked to itself."
msgstr ""
"ຕາມປົກະຕິ ສະພາບແວດລ້ອມຂອງລະບົບຢູນິກຊ໌ ສາມາດທຳການລິງແຟ້ມ ຫລືໄດເຣກທໍລີ ໄປເປັນຊື່ອື່ນ "
"ແລະ/ຫລືໃນຕຳແໜ່ງອື່ນໆ ໄດ້ ເຊິ່ງລະຫວ່າງທຳການຄັດລອກ KDE "
"ໄດ້ກວດພົບລິງຫລືຊຸດຂອງລິງ ໃນແບບວົນຮອບບໍ່ຮູ້ຈົບ - ເຊັ່ນ "
"ແຟ້ມທີ່ທຳການລິງໄປຍັງຕົວມັນເອງ ເປັນຕົ້ນ"

#: kio/kio/global.cpp:758
msgid "Could Not Create Network Connection"
msgstr "ບໍ່ສາມາດສ້າງການເຊື່ອມຕໍ່ເຄືອຂ່າຍໄດ້"

#: kio/kio/global.cpp:759
msgid "Could Not Create Socket"
msgstr "ບໍ່ສາມາດສ້າງຊັອກເກັຕໄດ້"

#: kio/kio/global.cpp:760
msgid ""
"This is a fairly technical error in which a required device for network "
"communications (a socket) could not be created."
msgstr "ນີ້ເປັນຂໍ້ຜິດພາດຕາມປົກະຕິ ທີ່ບໍ່ສາມາດສ້າງອຸປະກອນ ສຳຫລັບການສື່ສານໃນເຄືອຂ່າຍ (ຊັອກເກັຕ) ຕາມຕ້ອງການໄດ້"

#: kio/kio/global.cpp:762 kio/kio/global.cpp:875 kio/kio/global.cpp:886
#: kio/kio/global.cpp:895
msgid ""
"The network connection may be incorrectly configured, or the network "
"interface may not be enabled."
msgstr "ການສື່ສານແບບເຄືອຂ່າຍ ອາດຈະຍັງບໍ່ໄດ້ຖືກປັບແຕ່ງຢ່າງຖືກຕ້ອງ ຫລືອຸປະກອນເຄືອຂ່າຍອາດຈະຍັງບໍ່ເປີດໃຊ້ງານ"

#: kio/kio/global.cpp:768
msgid "Connection to Server Refused"
msgstr "ການເຊື່ອມຕໍ່ໄປຍັງເຊີບເວີຖືກປະຕິເສດ"

#: kio/kio/global.cpp:769
msgid ""
"The server <strong>%1</strong> refused to allow this computer to make a "
"connection."
msgstr ""
"ເຊີບເວີ <strong>%1</strong> "
"ປະຕິເສດການຂໍອະນຸຍາດເຂົ້າໃຊ້ງານຂອງຄອມພິວເຕີນີ້"

#: kio/kio/global.cpp:771
msgid ""
"The server, while currently connected to the Internet, may not be configured "
"to allow requests."
msgstr "ເຊີບເວີ ເຊິ່ງເຊື່ອມຕໍ່ຢູ່ກັບລະບົບອິນເຕີເນຕໃນປັດຈຸບັນ ອາດຈະຍັງບໍ່ໄດ້ປັບແຕ່ງໃຫ້ຮັບການເຊື່ອມຕໍ່ທີ່ຮ້ອງຂໍໄປ"

#: kio/kio/global.cpp:773
msgid ""
"The server, while currently connected to the Internet, may not be running "
"the requested service (%1)."
msgstr "ເຊີບເວີ ເຊິ່ງເຊື່ອມຕໍ່ຢູ່ກັບລະບົບອິນເຕີເນຕໃນປັດຈຸບັນ ອາດຈະຍັງບໍ່ໄດ້ປັບແຕ່ງໃຫ້ຮັບການເຊື່ອມຕໍ່ບໍລິການທີ່ຮ້ອງຂໍໄປ (%1)"

#: kio/kio/global.cpp:775
msgid ""
"A network firewall (a device which restricts Internet requests), either "
"protecting your network or the network of the server, may have intervened, "
"preventing this request."
msgstr ""
"ໄຟຣ໌ວອລລ໌ຂອງລະບົບເຄືອຂ່າຍ "
"(ອຸປະກອນທີ່ທຳຫນ້າທີ່ປ້ອງກັນການເຂົ້າໃຊ້ງານຈາກເຄືອຂ່າຍ) "
"ອາດຈະບໍ່ອະນຸຍາດໃຫ້ມີການເຊື່ອມຕໍ່ທີ່ຮ້ອງຂໍໄປ"

#: kio/kio/global.cpp:782
msgid "Connection to Server Closed Unexpectedly"
msgstr "ການເຊື່ອມຕໍ່ໄປຍັງເຊີບເວີຢຸດຕິຢ່າງບໍ່ຄາດຄິດ"

#: kio/kio/global.cpp:783
msgid ""
"Although a connection was established to <strong>%1</strong>"
", the connection was closed at an unexpected point in the communication."
msgstr ""
"ເຖິ່ງວ່າການເຊື່ອມຕໍ່ໄປຍັງ"
"<strong>%1</strong> ຈະເກີດຂື້ນແລ້ວແຕ່ກໍ່ເກີດການຍຸຕິການເຊື່ອມຕໍ່ໃນາງຈຸດຂອງການສື່ສາມຢ່າງບໍ່ຄາດຄິດ"

#: kio/kio/global.cpp:786
msgid ""
"A protocol error may have occurred, causing the server to close the "
"connection as a response to the error."
msgstr "ເກີດຂໍ້ຜິດພາດຂອງໂປຣໂຕຄອນເນື່ອງຈາກເຊີບເວີປິດການເຊື່ອມຕໍ່ຈາກການໂຕ້ຕອບທີ່ຜິດພາດ"

#: kio/kio/global.cpp:792
msgid "URL Resource Invalid."
msgstr "ແຫລ່ງ URL ບໍ່ຖືກຕອ້ງ"

#: kio/kio/global.cpp:793
msgid "Protocol %1 is not a Filter Protocol"
msgstr ""
"ໂປໂຕຄອນ %1 "
"ບໍ່ແມ່ນໃຊ້ໂປຣໂຄດຄອນແບບຕົວກອງ"

#: kio/kio/global.cpp:794
msgid ""
"The <strong>U</strong>niform <strong>R</strong>esource "
"<strong>L</strong>ocator (URL) that you entered did not refer to a valid "
"mechanism of accessing the specific resource, <strong>%1%2</strong>."
msgstr ""
"ຕຳແຫນ່ງ <strong>U</strong>niversal <strong>R</strong>esource "
"<strong>L</strong>ocation (URL) "
"ບໍ່ໄດ້ອ້າງຖືງສ່ວນຂອງການເຂົ້າຖືງສັບພະຍາກອນທີ່ກຳນົດ"
"<strong>%1%2</strong>"

#: kio/kio/global.cpp:799
msgid ""
"KDE is able to communicate through a protocol within a protocol. This "
"request specified a protocol be used as such, however this protocol is not "
"capable of such an action. This is a rare event, and is likely to indicate a "
"programming error."
msgstr ""
"KDE "
"ສາມາດສືສາມຫວ່າງໂປໂຕຄອນແລະພາຍໃນໂປໂຄຄອນສື່ງທີ່ຮ້ອງຂໍມານີ້ໄດ້ກຳນົດໂປໂຄຄອນທີ່ຈະໃຊ້ດ້ວຍແຕ່ວ່າ "
"ໂປໂຄອນນີ້ບໍ່ມີຄວາມສາມາດໃນການກະທຳນັ້ນ "
"ຊື່ງນີ້ເປັນເຫດການຈິ່ງແລະເບິ່ງວ່າຈະເປັນຂໍ້ຜິດພາດຈາກການຂຽນໂປຣແກຣມ"

#: kio/kio/global.cpp:807
msgid "Unable to Initialize Input/Output Device"
msgstr "ບໍ່ສາມາດເລີ່ມການໃຊ້ອຸປະກອນນຳເຂົ້າ/ສົ່ງອອກ"

#: kio/kio/global.cpp:808
msgid "Could Not Mount Device"
msgstr "ບໍ່ສາມາດເມາອຸປະກອນໄດ້"

#: kio/kio/global.cpp:809
msgid ""
"The requested device could not be initialized (\"mounted\"). The reported "
"error was: <strong>%1</strong>"
msgstr ""
"ບໍ່ສາມາດເລີ່ມໃຊ້ງານ"
"(\"ເມານ\") "
"ອຸປະກອນທີ່ຮ້ອງຂໍມາໄດ້ຊື່ງລາຍງານຄວາມຜິດພາດຄື:"
"<strong>%1</strong>"

#: kio/kio/global.cpp:812
msgid ""
"The device may not be ready, for example there may be no media in a "
"removable media device (i.e. no CD-ROM in a CD drive), or in the case of a "
"peripheral/portable device, the device may not be correctly connected."
msgstr ""
"ອຸປະກອນອາດຈະຍັງບໍ່ພ້ອມໃຊ້ງານ ຕົວຢ່າງເຊັ່ນ "
"ອາດຈະບໍ່ມີສື່ຢູ່ໃນອຸປະກອນແບບຍ້າຍສື່ໄດ້ (ເຊັ່ນ ບໍ່ມີແຜ່ນຊີດີຣອມ "
"ຢູ່ໃນໄດຣຟຊີດີ ເປັນຕົ້ນ) "
"ຫລືໃນກໍລະນີຂອງອຸປະກອນຕໍ່ພ່ວງ / ອຸປະກອນແບບພົກພາ ກໍອາດຈະເກີດຈາກ "
"ອຸປະກອນດັ່ງກ່າວຍັງບໍ່ໄດ້ທຳການເຊື່ອມຕໍ່"

#: kio/kio/global.cpp:816
msgid ""
"You may not have permissions to initialize (\"mount\") the device. On UNIX "
"systems, often system administrator privileges are required to initialize a "
"device."
msgstr ""
"ທ່ານອາດຈະບໍ່ໄດ້ຮັບສິດໃຫ້ເລີ້ມໃຊ້ງານ (\"ເມົານທ໌\") "
"ອຸປະກອນໄດ້ ເທິງລະບົບຢູນິກນັ້ນ ບາງຄັ້ງຜູ້ເບິ່ງແຍງລະບົບກໍອາດຈະຫວງຫ້າມການເຂົ້າໃຊ້ງານອະປະກອນບາງຕົວ"

#: kio/kio/global.cpp:820
msgid ""
"Check that the device is ready; removable drives must contain media, and "
"portable devices must be connected and powered on.; and try again."
msgstr ""
"ກະລຸນາກວດສອບວ່າ ອຸປະກອນພ້ອມໃ່ຊ້ງານແລ້ວ ຫາກເປັນໄດຣຟທີ່ຍ້າຍສື່ໄດ້ "
"ກໍ່ຕ້ອງມີສື່ຢູ່ໃນໄດຣຟກ່ອນ ແລະອຸປະກອນແບບພົກພາ ກໍຕ້ອງເຊື່ອມຕໍ່ແລະເປີດແລ້ວ ຈາກນັ້ນລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:826
msgid "Unable to Uninitialize Input/Output Device"
msgstr "ບໍ່ສາມາດຍົກເລີກການເອີ້ນໃຊ້ອຸປະກອນນຳເຂົ້າ/ສົ່ງອອກໄດ້"

#: kio/kio/global.cpp:827
msgid "Could Not Unmount Device"
msgstr "ບໍ່ສາມາດຍົກເລີກການເມົານທ໌ອຸປະກອນໄດ້"

#: kio/kio/global.cpp:828
msgid ""
"The requested device could not be uninitialized (\"unmounted\"). The "
"reported error was: <strong>%1</strong>"
msgstr ""
"ບໍ່ສາມາດຍົກເລີກການໃຊ້ງານ "
"(\"ຍົກເລີກການເມົານທ໌\")ອຸປະກອນທີ່ຮ້ອງຂໍມາໄດ້ຊື່ງລາຍງານຄວາມຜິດພາດຄື: "
"<strong>%1</strong>"

#: kio/kio/global.cpp:831
msgid ""
"The device may be busy, that is, still in use by another application or "
"user. Even such things as having an open browser window on a location on "
"this device may cause the device to remain in use."
msgstr ""
"ອຸປະກອນຈະບໍ່ວ່າງ"
"(ຖືກໃຊ້ງານຢູ່) ຄືອາດຈະຖືກໃຊ້ຢູ່ໂດຍແອບພິເຄຊັ້ນຫລືຜູ້ໃຊ້ອື່ນຯ ເຊັ່ນມີຫ້ນາຕ່າງບາວເຊີທີ່ຮຽກ "
"ໃຊ້ງານເທີງຕຳແຫນ່ງຊື່ງຢູ່ເທີງອຸປະກອນນີ້ກໍຈະເຮັດໃຫ້ອຸປະກອນຢູ່ໃນສະຖານະຖືກໃຊ້ງານຢູ່"

#: kio/kio/global.cpp:835
msgid ""
"You may not have permissions to uninitialize (\"unmount\") the device. On "
"UNIX systems, system administrator privileges are often required to "
"uninitialize a device."
msgstr ""
"ທ່ານອາດຈະບໍ່ມີສິດໃນການຍົກເລີກການໃຊ້ງານ"
"(\"ຍົກເລີກການເມາ\") ອຸປະກອນ"
"ຊື່ງເທີງລະບົບຍູນິກນັ້ນຜູ້ດູແລລະບົບ"
"ອາດຈະບໍ່ຕ້ອງການໃຫ້ມີການຍົກເລີກການໃຊ້ງານອຸປະກອນ"

#: kio/kio/global.cpp:839
msgid "Check that no applications are accessing the device, and try again."
msgstr "ກະລຸນາກວດສອບວ່າບໍ່ມີແອບພິເຄຊັ້ນຫລືຜູ້ໃຊ້ໃດກຳລັງໃຊ້ງານອຸປະກອນຢູ່ແລ້ວລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:844
msgid "Cannot Read From Resource"
msgstr "ບໍ່ສາມາດອ່ານຈາກສັບພະຍາກອນໄດ້"

#: kio/kio/global.cpp:845
msgid ""
"This means that although the resource, <strong>%1</strong>, was able to be "
"opened, an error occurred while reading the contents of the resource."
msgstr ""
"ເຖືງວ່າສັບພະຍາກອນ <strong>%1</strong> "
"ຈະສາມາດເປີດໃຊ້ໄດ້ແຕ່ກໍເກີດຄວາມຜິດພາດຂື້ນເມື່ອມີການພະຍາຍາມອ່ານເນື້ອຫາພາຍໃນສັບພະຍາກອນນັ້ນ"

#: kio/kio/global.cpp:848
msgid "You may not have permissions to read from the resource."
msgstr "ທ່ານອາດຈະຍັງບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ອ່ານຈາກສັບພະຍາກອນນິ້"

#: kio/kio/global.cpp:857
msgid "Cannot Write to Resource"
msgstr "ບໍ່ສາມາດຂຽນໄປຍັງສັບພະຍາກອນໄດ້"

#: kio/kio/global.cpp:858
msgid ""
"This means that although the resource, <strong>%1</strong>, was able to be "
"opened, an error occurred while writing to the resource."
msgstr ""
"ເຖີ່ງວ່າຈະສາມາດເປີດໃຊ້ງານສັບພະຍາກອນ <strong>%1</strong> ໄດ້"
"ແຕ່ກໍເກີດຄວາມຜິດພາດຂື້ນເມື່ອມີການຂຽນໄປຍັງສັບພະຍາກອນນັ້ນ"

#: kio/kio/global.cpp:861
msgid "You may not have permissions to write to the resource."
msgstr "ທ່ານບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ຂຽນໄປຍັງສັບພະຍາກອນ"

#: kio/kio/global.cpp:870 kio/kio/global.cpp:881
msgid "Could Not Listen for Network Connections"
msgstr "ບໍ່ສາມາດຖ້າຮັບການເຊື່ອມຕໍ່ຂອງເຄືອຂ່າຍໄດ້"

#: kio/kio/global.cpp:871
msgid "Could Not Bind"
msgstr "ບໍ່ສາມາດ bind ໄດ້"

#: kio/kio/global.cpp:872 kio/kio/global.cpp:883
msgid ""
"This is a fairly technical error in which a required device for network "
"communications (a socket) could not be established to listen for incoming "
"network connections."
msgstr ""
"ນີ້ເປັນຂໍ້ຜິດພາດທາງເທັກນິກຕາມປົກກະຕິ"
"ທີ່ບໍ່ສາມາດເລີ່ມອຸປະກອນສຳລັບການສື່ສານຂອງເຄືອຂ່າຍ (ຊອກເກັດ) "
"ເພື່ອຖ້າຮັບການເຊື່ອມຕໍ່ເຄື່ອຂ່າຍທີ່ມີເຂົ້າມາໄດ້"

#: kio/kio/global.cpp:882
msgid "Could Not Listen"
msgstr "ບໍ່ສາມາດຖ້າຮັບການເຊື່ີອມຕໍ່ໄດ້"

#: kio/kio/global.cpp:892
msgid "Could Not Accept Network Connection"
msgstr "ບໍ່ສາມາດຍອກຮັບການເຊື່ອມຕໍ່ເຄືອຂ່າຍໄດ້"

#: kio/kio/global.cpp:893
msgid ""
"This is a fairly technical error in which an error occurred while attempting "
"to accept an incoming network connection."
msgstr ""
"ນີ້ເປັນຂໍ້ຜິດພາດທາງເທັກນິກຕາມປົກກະຕິທີ່ຈະເກີດຄວາມຜິດພາດຂື້້ນເມື່ອພະຍາຍາມຈະຍອມຮັຫບ "
"ການເຊື່ອມຕໍ່ລະບົບເຄືອຂ່າຍທີ່ມີເຂົ້າມາ"

#: kio/kio/global.cpp:897
msgid "You may not have permissions to accept the connection."
msgstr "ທ່ານອາດຈະບໍ່ໄດ້ຮັບອະນຸຍາດໃຫ້ສາມາດຮັບການເຊື່ອມຕໍ່"

#: kio/kio/global.cpp:902
#, c-format
msgid "Could Not Login: %1"
msgstr "ບໍ່ສາມາດລອກອິນ: %1 ໄດ້"

#: kio/kio/global.cpp:903
msgid "An attempt to login to perform the requested operation was unsuccessful."
msgstr "ຄວາມພະຍາຍາມໃນການລອກອິນເພື່ອປະຕິບັດສິ່ງທີ່ຮ້ອງຂໍບໍ່ສຳເລັດ"

#: kio/kio/global.cpp:914
msgid "Could Not Determine Resource Status"
msgstr "ບໍ່ສາມາດຮຽກສະຖານະຂອງສັບພະຍາກອນໄດ້"

#: kio/kio/global.cpp:915
msgid "Could Not Stat Resource"
msgstr "ບໍ່ສາມາດຫາສະຖານະຂອງສັບພະຍາກອນໄດ້"

#: kio/kio/global.cpp:916
msgid ""
"An attempt to determine information about the status of the resource "
"<strong>%1</strong>, such as the resource name, type, size, etc., was "
"unsuccessful."
msgstr ""
"ການພະຍາຍາມຂໍ້ມູນກ່ຽວກັບສະຖານະຂອງສັບພະຍາກອນ<strong>%1</strong> "
"ເຊັ່ນ ຊື່ ປະເພດ "
"ຂະຫນາດ ເປັນຕົ້ນ ບໍ່ສຳເລັດ"

#: kio/kio/global.cpp:919
msgid "The specified resource may not have existed or may not be accessible."
msgstr "ສັບພະຍາກອນທີ່ກຳນົດຍັງບໍ່ມີຫລືບໍ່ສາມາດເຂົ້າໃຊ້ງານໄດ້"

#: kio/kio/global.cpp:927
msgid "Could Not Cancel Listing"
msgstr "ບໍ່ສາມາດຍົກເລີກການຄອຍຮັບການເຊື່ອມຕໍ່ໄດ້"

#: kio/kio/global.cpp:928
msgid "FIXME: Document this"
msgstr "ແກ້ໄຂຂ້ອຍ: ສ້າງເອກະສານທີ່ນີ້"

#: kio/kio/global.cpp:932
msgid "Could Not Create Directory"
msgstr "ບໍ່ສາມາດສ້າງໄດເລັກທໍລີໄດ້"

#: kio/kio/global.cpp:933
msgid "An attempt to create the requested directory failed."
msgstr "ລົ້ມເຫລວໃນການພະຍາຍາມສ້າງໄດເລັກທໍລີທີ່ຮ້ອງຂໍມາ"

#: kio/kio/global.cpp:934
msgid "The location where the directory was to be created may not exist."
msgstr "ຕຳແຫນ່ງທີ່ໄດເລັກທໍລີຈະຖືກສ້າງຍັງບໍ່ມີຢ"

#: kio/kio/global.cpp:941
msgid "Could Not Remove Directory"
msgstr "ບໍ່ສາມາດລືບໄດເລັກທໍລີໄດ້"

#: kio/kio/global.cpp:942
msgid "An attempt to remove the specified directory, <strong>%1</strong>, failed."
msgstr "ລົ້ມເຫລວໃນການພະຍາຍາມລຶບໄດເລັກທໍລີ <strong>%1</strong>"

#: kio/kio/global.cpp:944
msgid "The specified directory may not exist."
msgstr "ໄດເລັກທໍລີທີ່ກຳນົດຍັງບໍ່ມີຢູ່"

#: kio/kio/global.cpp:945
msgid "The specified directory may not be empty."
msgstr "ໄດເລັກທໍລີທີ່ກຳນົດອາດຈະບໍ່ແມ່ນໄດເລັກທໍລີວ່າງ"

#: kio/kio/global.cpp:948
msgid "Ensure that the directory exists and is empty, and try again."
msgstr "ກະລຸູນາກວດສອບວ່າມີໄດເລັກທໍລີຢູ່ແລະເປັນໄດເລັກທໍລີວ່າງຈາກນັ້ນລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:953
msgid "Could Not Resume File Transfer"
msgstr "ບໍ່ສາມາດກັບໄປທຳການຮັບສົ່ງແຟ້ມຕໍ່ໄດ້"

#: kio/kio/global.cpp:954
msgid ""
"The specified request asked that the transfer of file <strong>%1</strong>"
" be resumed at a certain point of the transfer. This was not possible."
msgstr ""
"ສິ່ງທີ່ຮ້ອງຂໍທີ່ລະບຸມາໄດ້ຖາມຖືງການກັບມາທຳງານຕໍ່ຍັງຈຸດທີ່ທຳການຮັບສົ່ງແຟ້ມ"
"<strong>%1</strong> ຄ້າງໄວ້ ປາກົດວ່າບໍ່ສາມາດທຳງານໄດ້"

#: kio/kio/global.cpp:957
msgid "The protocol, or the server, may not support file resuming."
msgstr "ໂປໂຕຄອນຫລືເຊີບເວີອາດຈະບໍ່ສະນັບສະນຸນການທຳງານຄ້າງຢູ່ກັບແຟ້ມ"

#: kio/kio/global.cpp:959
msgid "Retry the request without attempting to resume transfer."
msgstr "ພະຍາຍາມເຮັດສິ່ງທີ່ຮ້ອງຂໍໃຫມ່ໂດຍບໍ່ກັບມາທຳງານຕໍ່ໃນຈຸດທີ່ຄ້າງໄວ້"

#: kio/kio/global.cpp:964
msgid "Could Not Rename Resource"
msgstr "ບໍ່ສາມາດປ່ຽນຊື່ສັບພະຍາກອນໄດ້"

#: kio/kio/global.cpp:965
msgid "An attempt to rename the specified resource <strong>%1</strong> failed."
msgstr "ລົ້ມເຫລວໃນການພະຍາຍາມປ່ຽນຊື່ສັບພະຍາກອນ <strong>%1</strong>"

#: kio/kio/global.cpp:973
msgid "Could Not Alter Permissions of Resource"
msgstr "ບໍ່ສາມາດປ່ຽນສິດທີອະນຸຍາດຂອງສັບພະຍາກອນໄດ້"

#: kio/kio/global.cpp:974
msgid ""
"An attempt to alter the permissions on the specified resource "
"<strong>%1</strong> failed."
msgstr ""
"ລົ້ມເຫລວໃນການປ່ຽນສິດທີ່ອະນຸຍາດຂອງສັບພະຍາກອນ<strong>"
"%1</strong> ທີ່ກຳນົດ"

#: kio/kio/global.cpp:981
msgid "Could Not Delete Resource"
msgstr "ບໍ່ສາມາດລືບສັບພະຍາກອນໄດ້"

#: kio/kio/global.cpp:982
msgid "An attempt to delete the specified resource <strong>%1</strong> failed."
msgstr "ລົ້ມເຫລວໃນການພະຍາຍາມລືບສັບພະຍາກອນ <strong>%1</strong>"

#: kio/kio/global.cpp:989
msgid "Unexpected Program Termination"
msgstr "ກະລຸນາຈົບການທຳງານຢ່າງບໍ່ຄາດຄິດ"

#: kio/kio/global.cpp:990
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has unexpectedly terminated."
msgstr ""
"ໂປຣແກຣມເທີງຄອມພິວເຕີຂອງທ່ານຊື່ງມີການໃຊ້ງານໂປຣໂຕຄອນ"
"<strong>%1</strong> "
"ຈົບການທຳງານຢ່າງບໍ່ຄາດຄິດ"

#: kio/kio/global.cpp:998
msgid "Out Of Memory"
msgstr "ຫນ່ວຍຄວາມຈຳບໍພຽງພໍ"

#: kio/kio/global.cpp:999
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol could not obtain the memory required to "
"continue."
msgstr ""
"ໂປຣແກຣມເທີງຄອມພິວເຕີຂອງທ່ານຊື່ງການໃຊ້ງານໂປຣໂຕຄອນ "
"<strong>%1</strong> "
"ບໍ່ສາມາດທຳງານຕໍ່ໄດ້ເນື່ອງຈາກໜວ່ຍຄວາມຈຳທີ່ຕ້ອງການໃຊ້ມີບໍ່ພຽງພໍ"

#: kio/kio/global.cpp:1007
msgid "Unknown Proxy Host"
msgstr "ບໍ່ຮູ້ຈັກໂຫສພອກຊີ"

#: kio/kio/global.cpp:1008
msgid ""
"While retrieving information about the specified proxy host, "
"<strong>%1</strong>, an Unknown Host error was encountered. An unknown host "
"error indicates that the requested name could not be located on the Internet."
msgstr ""
"ລະຫວ່າງຮັບຂໍ້ມູນກຽ່ວກັບໂຫສພອກຊີ "
"<strong>%1</strong> "
"ທີ່ກຳນົດເກີດຄວາມຜິດພາດເນື່ອງຈາກບໍ່ຮູ້ຈັກໂຫສຂື້ນຊື່ງຫມາຍຖືງວ່າບໍ່ "
"ສາມາດຄົ້ນຫາໂຫສຊື່ັ່ດັ່ງກ່າວຫລື ໂຫສດັ່ງກາ່ວອາດຈະບໍ່ມີຢູ່ເທີງອິນເຕີເນັດ"

#: kio/kio/global.cpp:1012
msgid ""
"There may have been a problem with your network configuration, specifically "
"your proxy's hostname. If you have been accessing the Internet with no "
"problems recently, this is unlikely."
msgstr ""
"ຫາກກ່ອນຫນ້ານີ້ທ່ານເຄີຍສາມາດເຂົ້າໃຊ້ງານອິນເຕີເນັດໄດ້ນີ້ອາດຈະເປັນປັນຫາທີ່ເກີດຈາກການ "
"ປບັແຕ່ງລະບົບເຄືອຂ່າຍຂອງທ່ານໂດຍສະເພາະສ່ວນຊື່ໂຫສຂອງພອກຊີ"

#: kio/kio/global.cpp:1016
msgid "Double-check your proxy settings and try again."
msgstr "ໂປດກວດສອບການຕັ້ງຄ່າພອກຊີຂອງທ່ານຢ່າງຮອບຄອບແລ້ວລອງໃຫມ່ອີກຄັ້ງ"

#: kio/kio/global.cpp:1021
msgid "Authentication Failed: Method %1 Not Supported"
msgstr "ການກວດສອບສິດລົ້ມເຫລວບໍ່ສະນັບສະນຸນການກວດສອບก %1"

#: kio/kio/global.cpp:1023
#, c-format
msgid ""
"Although you may have supplied the correct authentication details, the "
"authentication failed because the method that the server is using is not "
"supported by the KDE program implementing the protocol %1."
msgstr ""
"ເຖີງວ່າທ່ານຈະໄດ້ຕື່ມສ່ວນລາຍລະອຽດຂອງການກວດສອບສິດໄວ້ຢ່າງຖືກຕ້ອງແລ້ວກໍຕາມ "
"ແຕ່ກໍເກີດຄວາມຜິດພາດໃນການກວດສອບສິດຂື້ນເນື່ອງຈາກວິທີການທີ່ເຊີບເວີໃຊ້ບໍ່ໄດ້ຮັບການສະນັບ "
"ສະນຸນໃຫ້ໃຊ້ຈາກໂປໂຕຄອນ  %1 ຂອງໂປຣແກຣ KDE "

#: kio/kio/global.cpp:1027
msgid ""
"Please file a bug at <a "
"href=\"http://bugs.kde.org/\">http://bugs.kde.org/</a> to inform the KDE "
"team of the unsupported authentication method."
msgstr ""
"ກະລຸນາລາຍຄວາມຜິດພາດໄປທີ"
"่ <a href=\"http://bugs.kde.org/\">http://bugs.kde.org/</a> "
"ເພື່ອແຈ້ງໃຫ້ທີ່ມ KDE "
"ໄດ້ຮູ້ເຖີງວີທີ່ການກວດສອບສິດທີ່ຍັງບໍ່ສະນັບສະນຸນ"

#: kio/kio/global.cpp:1033
msgid "Request Aborted"
msgstr "ສິ່ງທີ່ຮ້ອງຂໍມາຖືກຍົກເລີກແລ້ວ"

#: kio/kio/global.cpp:1040
msgid "Internal Error in Server"
msgstr "ເກີດຂໍ້ຜິດພາດພາຍໃນເຊີບເວີ"

#: kio/kio/global.cpp:1041
msgid ""
"The program on the server which provides access to the <strong>%1</strong> "
"protocol has reported an internal error: %0."
msgstr ""
"ໂປຣແກຣມເທີງເຊີບເວີຊື່ງຕ້ອງການໃຊ້ງານໂປຣໂຕຄອນ "
"<strong>%1</strong> "
"ໄດ້ລາຍງານຄວາມຜິດພາດພາຍໃນວ່າ: %0"

#: kio/kio/global.cpp:1044
msgid ""
"This is most likely to be caused by a bug in the server program. Please "
"consider submitting a full bug report as detailed below."
msgstr ""
"ນີ້ເບີ່ງຄືກັບຈະເປັນປັນຫາທີ່ເກີດຈາກຂໍ້ຜິດພາດຂອງໂປຣແກຣມເຊີບເວີ "
"ກະລຸນາພິຈະລະນາສົ່ງລາຍລະອຽດການເກີດຂໍ້ຜິດພາດທີ່ສົມບູນດັງລາຍລະອຽດດ້ານລຸ່ມນີ້"

#: kio/kio/global.cpp:1047
msgid "Contact the administrator of the server to advise them of the problem."
msgstr "ກະລຸນາຕິດຕໍ່ຜູ້ດູແລລະບົບຂອງເຊີບເວີເພື່ອແຈ້ງໃຫ້ຮູ້ຖືງປັນຫາທີ່ເກີດຂື້ນ"

#: kio/kio/global.cpp:1049
msgid ""
"If you know who the authors of the server software are, submit the bug "
"report directly to them."
msgstr ""
"ຫາກທ່ານຮູ້ວ່າ "
"ໃຜເປັນຜູ້ຂຽນໂປຣແກຣມເຊີບເວີນີ້ "
"ໃຫ້ທຳການລາຍງານຄວາມຜິດພາດໄປຍັງເຂົາໂດຍຕົງ"

#: kio/kio/global.cpp:1054
msgid "Timeout Error"
msgstr "ຂໍ້ຜິດພາດຈາກການຫມົດເວລາ"

#: kio/kio/global.cpp:1055
msgid ""
"Although contact was made with the server, a response was not received "
"within the amount of time allocated for the request as "
"follows:"
"<ul>"
"<li>Timeout for establishing a connection: %1 seconds</li>"
"<li>Timeout for receiving a response: %2 seconds</li>"
"<li>Timeout for accessing proxy servers: %3 seconds</li></ul>Please note "
"that you can alter these timeout settings in the KDE Control Center, by "
"selecting Network -> Preferences."
msgstr ""
"ແມ້ວ່າຈະມີການສ້າງການເຊື່ອມຕໍ່ກັບເຊີບເວີແລ້ວ "
"ແຕ່ກໍບໍ່ໄດ້ຮັບການຕອບຮັບພາຍໃນຊ່ວງເວລາທີ່ກຳນົດສຳລັບການຮ້ອງຂໍດັ່ງຕໍ່ໄປນີ້:"
"<ul>"
"<li>ໝົດເວລາໃນການເລີ່ມທຳການເຊື່ອມຕໍ່: %1 "
"ວິນາທີ</li>"
"<li>"
"ໝົດເວລາໃນການຄອຍການຕອບຮັບ: %2 "
"ວິນາທີ</li>"
"<li>ໝົດເວລາໃນການເຂົ້າໃຊ້ງານເຊີບເວີພອກຊີ: %3 "
"วินาที</li></ul> ເຄັດລັບ: "
"ທ່ານສາມາດຕັ້ງຄ່າຊວ່ງເວລາເຫລົ່ານີ້ໄດ້ທີ ສູນຄວບຄຸມ KDE ໂດຍເລືອກ "
"ລະບົບເຄືອຂ່າຍ-> "
"ປັບແຕ່ງ"

#: kio/kio/global.cpp:1066
msgid "The server was too busy responding to other requests to respond."
msgstr "ເຊີບເວີບໍ່ວ່າງທີ່ຈະຕອບກັບມາຍັງສ່ວນທີ່ຣ້ອງຂໍເຂົ້່າມາ"

#: kio/kio/global.cpp:1072
msgid "Unknown Error"
msgstr "ຄວາມຜິດພາດທີ່ບໍ່ຮູ້ຈັກ"

#: kio/kio/global.cpp:1073
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has reported an unknown error: %2."
msgstr ""
"ໂປຣແກຣມຄອມພິວເຕີຂອງທ່ານຊື່ງໃຊ້ງານໂປຣໂຕຄອນ "
"<strong>%1</strong> "
"ໄດ້ເກີດຄວາມຜິດພາດທີ່ບໍຮູ້ຈັກ: %2"

#: kio/kio/global.cpp:1081
msgid "Unknown Interruption"
msgstr "ບໍ່ຮູ້ຈັກການອີນເຕີເນັດທີ່ເກີດຂື້ນ"

#: kio/kio/global.cpp:1082
msgid ""
"The program on your computer which provides access to the "
"<strong>%1</strong> protocol has reported an interruption of an unknown "
"type: %2."
msgstr ""
"ໂປຣແກຣມເທີງອິນເຕີເນັດຂອງທ່ານຊື່ງໃຊ້ງານໂປຣໂຕຄອນ "
"<strong>%1</strong> "
"ໄດ້ລາຍງານຄວາມຜິດພາດຂອງການອິນເຕີລັບທີ່ບໍ່ຮູ້ຈັກ: %2"

#: kio/kio/global.cpp:1090
msgid "Could Not Delete Original File"
msgstr ""
"ບໍ່ສາມາດລືບແຟ້ມດັ່ງເດີມໄດ້"
"้"

#: kio/kio/global.cpp:1091
msgid ""
"The requested operation required the deleting of the original file, most "
"likely at the end of a file move operation. The original file "
"<strong>%1</strong> could not be deleted."
msgstr ""
"ປະຕິບັດການທີ່ຮ້ອງຂໍມາຕ້ອງການຈະລືບແຟ້ມດັ່ງເດີມຄືກັບເມືອສິ້ນສຸດການຍ້າຍແຟ້ມ "
"ແຕ່ບໍ່ສາມາດລືບແຟ້ມດັ່ງເດີມ<strong>%1</strong> ໄດ້"

#: kio/kio/global.cpp:1100
msgid "Could Not Delete Temporary File"
msgstr ""
"ບໍ່ສາມາດລືບແຟ້ມຊົ່ວຄາວໄດ້"
"้"

#: kio/kio/global.cpp:1101
msgid ""
"The requested operation required the creation of a temporary file in which "
"to save the new file while being downloaded. This temporary file "
"<strong>%1</strong> could not be deleted."
msgstr ""
