#: _translatorinfo.cpp:1
msgid ""
"_: NAME OF TRANSLATORS\n"
"Your names"
msgstr "VANHXAY KHOUNNAVONG"

#: _translatorinfo.cpp:3
msgid ""
"_: EMAIL OF TRANSLATORS\n"
"Your emails"
msgstr "Air_newstar2002@yahoo.com"

#: rc.cpp:1
msgid "Socks"
msgstr "ເຊິເວີຣທ Socks"

#: rc.cpp:2
msgid "&Enable SOCKS support"
msgstr "ເປີດໃຊ້ສ່ວນສະຫນັບສະຫນູນ SOCKS"

#: rc.cpp:3
msgid ""
"Check this to enable SOCKS4 and SOCKS5 support in KDE applications and I/O "
"subsystems."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພື່ອເປີດໃຊ້ສ່ວນສະຫນັບສະຫນູນSOCKS4 ແລະ SOCKS5 ໃນອັບພິເຄເຊີນ KDE "
"ແລະ I/O ຂອງລະບົບຍ່ອຍ"

#: rc.cpp:4
msgid "SOCKS Implementation"
msgstr "ການກຳນົດ SOCKS"

#: rc.cpp:5
msgid "A&uto detect"
msgstr "ກວດກາອັດຕະໂນມັດ"

#: rc.cpp:6
msgid ""
"If you select Autodetect, then KDE will automatically search for an "
"implementation of SOCKS on your computer."
msgstr ""
"ຫາກເຈົ້າເລືອກໃຫ້ກວດກາອັດຕະ ໂນມັດແລ້ວ KDE ຈະເຮັດການຄົ້ນຫາ SOCKS "
"ເທິງຄອມພິວເຕີຂອງເຈົ້າໂດຍອັດຕະໂນມັດ"

#: rc.cpp:7
msgid "&NEC SOCKS"
msgstr "ໃຊ้ &NEC SOCKS"

#: rc.cpp:8
msgid "This will force KDE to use NEC SOCKS if it can be found."
msgstr "ບັງຄັບໃຫ้ KDE ໃຊ้ NEC SOCKS ຖ້າມັນສາມາດຄົ້ນພົບ"

#: rc.cpp:9
msgid "Use &custom library"
msgstr "ໃຊ້ໄຊ້ໄລບຼາລີທີ່ກຳນົດເອງ "

#: rc.cpp:10
msgid ""
"Select custom if you wish to use an unlisted SOCKS library. Please note that "
"this may not always work as it depends on the API of the library which you "
"specify (below)."
msgstr ""
"ເລືອກກຳນົດເອງຖ້າເຮົາຕ້ອງການໄຊ້ໄລບຼາ ี SOCKS ที่ไม่ปรากฎในรายการ โปรดจำไว้ว่า "
"มันอาจจะไม่ทำงานทุกครั้งเสมอไป ขึ้นอยู่กับ API ของไลบรารีที่คุณกำหนด "
"(ด้านล่างนี้)"

#: rc.cpp:11
msgid "&Path:"
msgstr "พาธ:"

#: rc.cpp:12
msgid "Enter the path to an unsupported SOCKS library."
msgstr "เติมตำแหน่งที่อยู่ของไลบรารี SOCKS ที่ไม่สนับสนุน"

#: rc.cpp:13
msgid "&Dante"
msgstr "ใช้ &Dante"

#: rc.cpp:14
msgid "This will force KDE to use Dante if it can be found."
msgstr "บังคับให้ KDE ใช้ Dante ถ้ามันสามารถค้นพบ"

#: rc.cpp:15
msgid "Additional Library Search Paths"
msgstr "เส้นทางที่ใช้ค้นหาไลบรารีเพิ่มเติม"

#: rc.cpp:16
msgid ""
"Here you can specify additional directories to search for the SOCKS libraries. "
"/usr/lib, /usr/local/lib, /usr/local/socks5/lib and /opt/socks5/lib are already "
"searched by default."
msgstr ""
"คุณสามารถกำหนดไดเรกทอรีที่ใช้ค้นหาไลบรารี SOCKS เพิ่มเติมได้ที่นี่ "
"ซึ่งค่าที่กำหนดไว้แล้วมี /usr/lib, /usr/local/lib, /usr/local/socks5/lib และ "
"/opt/socks5/lib"

#: rc.cpp:17
msgid "Path"
msgstr "พาธ"

#: rc.cpp:18
msgid "This is the list of additional paths that will be searched."
msgstr "แสดงรายการของพาธที่จะใช้ค้นหาไลบรารีเพิ่มเติม"

#: rc.cpp:19
msgid "&Add"
msgstr "เพิ่ม"

#: rc.cpp:21
msgid "&Test"
msgstr "ทดสอบ"

#: rc.cpp:22
msgid "Click here to test SOCKS support."
msgstr "คลิกที่นี่ เพื่อทดสอบส่วนสนับสนุน SOCKS"

#: socks.cpp:88
msgid "These changes will only apply to newly started applications."
msgstr "การเปลี่ยนแปลงจะมีผลกับแอพพลิเคชันที่เริ่มทำงานใหม่เท่านั้น"

#: socks.cpp:90 socks.cpp:123 socks.cpp:128
msgid "SOCKS Support"
msgstr "สนับสนุน SOCKS"

#: socks.cpp:122
msgid "Success! SOCKS was found and initialized."
msgstr "สำเร็จแล้ว! ค้นพบ SOCKS และเริ่มการทำงานแล้ว"

#: socks.cpp:127
msgid "SOCKS could not be loaded."
msgstr "ไม่สามารถเรียกใช้งาน SOCKS ได้"

#: socks.cpp:266
msgid ""
"<h1>SOCKS</h1>"
"<p>This module allows you to configure KDE support for a SOCKS server or "
"proxy.</p>"
"<p>SOCKS is a protocol to traverse firewalls as described in <a "
"href=\"http://rfc.net/rfc1928.html\">RFC 1928</a>. "
"<p>If you have no idea what this is and if your system administrator doesn't "
"tell you to use it, leave it disabled.</p>"
msgstr ""
"<h1>SOCKS</h1>"
"<p>โมดูลนี้ ให้คุณได้ปรับแต่งการสนับสนุนเซิร์ฟเวอร์ SOCKS หรือพรอกซีของ KDE</p>"
"<p>SOCKS คือ โปรโตคอลที่ทำหน้าที่เหมือนไฟร์วอลล์ โดยมีข้อกำหนดตาม <a "
"href=\"http://rfc.net/rfc1928.html\">RFC 1928</a> "
"<p>หากคุณไม่แน่ใจในส่วนนี้ และผู้ดูแลระบบไม่ได้แจ้งให้คุณทราบ "
"ก็ควรปล่อยว่างไว้</p>"

#: socks.cpp:277
msgid "kcmsocks"
msgstr "ปรับแต่ง SOCKS"

#: socks.cpp:277
msgid "KDE SOCKS Control Module"
msgstr "โมดูลควบคุม SOCKS ของ KDE"

