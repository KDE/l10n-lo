#: pop3.cc:262
msgid "PASS <your password>"
msgstr "PASS <ລະຫັດຜ່ານຂອງທ່ານ>"

#: pop3.cc:265
msgid "The server said: \"%1\""
msgstr "ເຊີບເວີແຈ້ງວ່າ: \"%1\""

#: pop3.cc:287
msgid "The server terminated the connection."
msgstr "ເຊີບເວີຕັດການເຊື່ອມຕໍ່"

#: pop3.cc:289
msgid ""
"Invalid response from server:\n"
"\"%1\""
msgstr ""
"ການຕອບກັບມາຈາກເຊີບເວີບໍ່ຖືກຕ້ອງ:\n"
"\"%1\""

#: pop3.cc:318
msgid ""
"Could not send to server.\n"
msgstr ""
"ບໍ່ສາມາດສົ່ງໄປເຖິງເຊີບເວີ\n"

#: pop3.cc:373 pop3.cc:432 pop3.cc:629
msgid "No authentication details supplied."
msgstr ""

#: pop3.cc:410
#, fuzzy
msgid ""
"Login via APOP failed. The server %1 may not support APOP, although it claims "
"to support it, or the password may be wrong.\n"
"\n"
"%2"
msgstr ""
"ການລັອກອິນດ້ວຍ APOP ລົ້ມເຫຼວ ຊື່ງເຊີບເວີ ອາດຈະບໍ່ສະນັບສະຫນຸນການໃຊ้້ APOP "
"ຫຼືລະຫັດຜ່ານອາດຈະບໍ່ຖືກຕ້ອງ\n"
"\n"
"%1"

#: pop3.cc:598
msgid ""
"Login via SASL (%1) failed. The server may not support %2, or the password may "
"be wrong.\n"
"\n"
"%3"
msgstr ""
"ການລັອກອິນດ້ວຍ SASL (%1) ລມົ້ເຫຼວ ຊື່ງເຊີບເວີ ອາດຈະບໍ່ສະນັບສະຫນຸນການໃຊ้້ %2 "
"ຫຼືລະຫັດຜ່ານອາດຈະບໍ່ຖືກຕ້ອງ\n"
"\n"
"%3"

#: pop3.cc:607
msgid ""
"Your POP3 server does not support SASL.\n"
"Choose a different authentication method."
msgstr ""
"ເຊີບເວີ POP3 ຂອງທ່ານ ບໍ່ສະນັບສະຫນຸນ SASL\n"
"ກາລຸນາກວດສອບສິດດ້ວຍວິທີອື່ນ"

#: pop3.cc:615
msgid "SASL authentication is not compiled into kio_pop3."
msgstr ""

#: pop3.cc:647 pop3.cc:696
msgid ""
"Could not login to %1.\n"
"\n"
msgstr ""
"ບໍ່ສາມາດເຮັດລັອກອິນໄປເຖິງ %1\n"
"\n"

#: pop3.cc:661
msgid ""
"Could not login to %1. The password may be wrong.\n"
"\n"
"%2"
msgstr ""
"ບໍ່ສາມາດທຳການລັອກອິນໄປເຖິງ %1 ໄດ้້ ລະຫັດຜ່ານອາດຈະບໍ່ຖືກຕ້ອງ\n"
"\n"
"%2"

#: pop3.cc:699
msgid "The server terminated the connection immediately."
msgstr "ເຊີບເວີຕັດການເຊື່ອມຕໍ່ໃນທັກທີี"

#: pop3.cc:700
msgid ""
"Server does not respond properly:\n"
"%1\n"
msgstr ""
"ເບິ່ງຄືວ່າເຊິບເວີຈະບໍ່ມີການຕອບຮັບ:\n"
"%1\n"

#: pop3.cc:728
msgid ""
"Your POP3 server does not support APOP.\n"
"Choose a different authentication method."
msgstr ""
"ເຊີບເວີ POP3 ຂອງທ່ານບໍ່ສະນັບສະຫນຸນຄຳສັ່ງ APOP\n"
"ກາລຸນາເລືອກກວດສອບສິດວິທີອື່ນ"

#: pop3.cc:748
msgid ""
"Your POP3 server claims to support TLS but negotiation was unsuccessful. You "
"can disable TLS in KDE using the crypto settings module."
msgstr ""
"ເຊີບເວີ POP3 ຂອງທ່ານ ອ້າງວ່າສະນັດສະຫນຸນ TLS "
"ແຕ່ຕອນນີ້ຍັງບໍ່ສຳເລັດສົມບູນທ່ານສາມາດປິດການໃຊ້ງານ TLS ໃນ KDE ໄດ້ "
"ໂດຍໃຊ້ໂມດູນຕັ້ງຄ່າການເຂົ້າລະຫັດ"

#: pop3.cc:759
msgid ""
"Your POP3 server does not support TLS. Disable TLS, if you want to connect "
"without encryption."
msgstr ""
"ເຊິບເວີ POP3 ຂອງທ່ານ ບໍ່ສະນັບສະຫນຸນ TLS\n"
"ປິດການໃຊ້ງານ TLS ຫາກທ່ານຕ້ອງການເຊື່ອມຕໍ່ແບບບໍ່ເຂົ້າລະຫັດ"

#: pop3.cc:768
#, fuzzy
msgid "Username and password for your POP3 account:"
msgstr "ຊື່ຜູ້ໃຊ້ແລະລະຫັດຜ່ານສຳລັບບັນຊີຜູ້ໃຊ້ງານ POP3 ຂອງທ່ານ:"

#: pop3.cc:968 pop3.cc:977 pop3.cc:1116
msgid "Unexpected response from POP3 server."
msgstr "ີມີການຕອບມາຈາກເຊີບເວີ POP3 ທີ່ບໍ່ຄາດຫວັງ"
