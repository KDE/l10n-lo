msgstr "ພອຍເຕີ້"

#: fonts.cpp:217
msgid " to "
msgstr "ເຖິງ"

#: fonts.cpp:223
msgid "&Use sub-pixel hinting:"
msgstr "ใ້&ຊ้ຄຳແນະນຳໃນການແຕ້ມພິກເຊວ ຮິນທິງ:"

#: fonts.cpp:226
msgid ""
"If you have a TFT or LCD screen you can further improve the quality of "
"displayed fonts by selecting this option."
"<br>Sub-pixel hinting is also known as ClearType(tm)."
"<br>"
"<br><b>This will not work with CRT monitors.</b>"
msgstr ""

#: fonts.cpp:234
msgid ""
"In order for sub-pixel hinting to work correctly you need to know how the "
"sub-pixels of your display are aligned."
"<br> On TFT or LCD displays a single pixel is actually composed of three "
"sub-pixels, red, green and blue. Most displays have a linear ordering of RGB "
"sub-pixel, some have BGR."
msgstr ""

#: fonts.cpp:245
msgid "Hinting style: "
msgstr ""

#: fonts.cpp:252
msgid ""
"Hinting is a process used to enhance the quality of fonts at small sizes."
msgstr ""

#: fonts.cpp:492
msgid "General"
msgstr "ທົ່ວໄປ"

#: fonts.cpp:493
msgid "Fixed width"
msgstr "ຕົອອກສອນກ້ວາງຄົງທີ່"

#: fonts.cpp:494
msgid "Toolbar"
msgstr "ແຖບເຄື່ອງມື"

#: fonts.cpp:495
msgid "Menu"
msgstr "ເມນูູ"

#: fonts.cpp:496
msgid "Window title"
msgstr "ແຖບຫົວເລືອງຫນ້າຕ່າງ"

#: fonts.cpp:497
msgid "Taskbar"
msgstr "ທາສຄ໌ບາ"

#: fonts.cpp:498
msgid "Desktop"
msgstr "ຫນ້າຕ່າງຈໍ"

#: fonts.cpp:532
msgid "Used for normal text (e.g. button labels, list items)."
msgstr "ໃຊ້ສຳລັບຂໍ້ຄວາມປົກກະຕິ (ເຊັ່ນວ່າ ລະດັບປຸ່ມ,ລາຍການໃນລິດສທ໌ ເປັນຕົ້ນ)."

#: fonts.cpp:533
msgid "A non-proportional font (i.e. typewriter font)."
msgstr "ຕົວອັກສອນທີ່ມີສັດສ່ວນບໍ່ຄົງທີ່ (ເຊັ່ນ ຕົວອັກສອນແບບເຄື່ອງພິມດີດ)."

#: fonts.cpp:534
msgid "Used to display text beside toolbar icons."
msgstr "ໃຊ້ເພື່ອສະແດງຂໍ້ຄວາມໃຫ້ດ້ານຂ້າງຂອງ ໄອຄອນ ແຖບເຄື່ອງມື."

#: fonts.cpp:535
msgid "Used by menu bars and popup menus."
msgstr "ຖືກໃຊ້ດ້ອຍ ແຖບເມນູແລະເມນູພ໊ອບອັບພ໌"

#: fonts.cpp:536
msgid "Used by the window titlebar."
msgstr "ຖືກໃຊ້ດ້ອຍແຖບຫົວຂໍ້ຫນ້າຕ່າງ."

#: fonts.cpp:537
msgid "Used by the taskbar."
msgstr "ຖືກໃຊ້ດ້ອຍປຸ່ມທາດສຄ໌ບາ์"

#: fonts.cpp:538
msgid "Used for desktop icons."
msgstr "ຖືກໃຊ້ສຳລັບ ໄອຄອນບົນຫນ້າຈໍ."

#: fonts.cpp:589
#, fuzzy
msgid "Ad&just All Fonts..."
msgstr "ປັບທຸກໂຕອັກສອນ..."

#: fonts.cpp:590
msgid "Click to change all fonts"
msgstr "ຄີ້ລກເພື່ອປ່ງນທຸກໂຕອັກສອນ."

#: fonts.cpp:597
msgid "Use a&nti-aliasing for fonts"
msgstr "ປັບການສະແດງຜົນຕົວອັກສອນແບບໄຮ້ຊື່ອື່ນ"

#: fonts.cpp:598
msgid ""
"If this option is selected, KDE will smooth the edges of curves in fonts."
msgstr ""
"ເລືອກຕົວເລືອກນີ້ເພືອໃຫ້ KDE ສະແດງຜົນຕົວອັກສອນແລະພາບບິດແມພບາງສ່ວນ "
"ໃນແບບໄຮ້ຊື່ອື່ນ"

#: fonts.cpp:601
msgid "Configure..."
msgstr ""

#: fonts.cpp:677
msgid ""
"<p>You have changed anti-aliasing related settings. This change will only "
"affect newly started applications.</p>"
msgstr ""
"ທ່ານເລືອກຕົວເລືອກປັບການສະແດງຜົນແບບໄຮ້ຊື່ອື່ນ\n"
"ການປ່ງນແປງນີ້ຈະບໍເກີດຂື້ນຈົນກ່ວາທ່ານ ຈະເລີ່ມການທຳງານ KDE ອີກຄັ້ງ"

#: fonts.cpp:678
msgid "Anti-Aliasing Settings Changed"
msgstr "ປັບໃຊ້ການສະແດງຜົນແບບໄຮ້ຊື່ອື່ນແລ້ວ"

