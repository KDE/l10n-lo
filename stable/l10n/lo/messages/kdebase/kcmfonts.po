#: fonts.cpp:206
#, fuzzy
msgid "Configure Anti-Alias Settings"
msgstr "ປັບໃຊ້ການສະແດງຜົນແບບໄຮ້ຊື່ອື່ນແລ້ວ"

#: fonts.cpp:212
msgid "E&xclude range:"
msgstr "ບໍ່&xລອມຊ่ວງ:"

#: fonts.cpp:215 fonts.cpp:220
