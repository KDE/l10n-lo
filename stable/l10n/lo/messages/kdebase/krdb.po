#: krdb.cpp:340
msgid ""
"# created by KDE, %1\n"
"#\n"
"# If you do not want KDE to override your GTK settings, select\n"
"# Appearance & Themes -> Colors in the Control Center and disable the checkbox\n"
"# \"Apply colors to non-KDE applications\"\n"
"#\n"
"#\n"
msgstr ""
"# ສ້າງໂດຍ ເຄດີອີ, %1\n"
"#\n"
"# ຖ້າຫາກວ່າທ່ານບໍ່ຕ້ອງການໃຫ້ເຄດີອີທຳການຢຸດຢັ້ງການຕັ້ງຄ່າຈີທີເຄຂອງທ່ານ,ໃຫ້ເລືອກ\n"
"# ແອັບພງຍແຣນສ໌ແລະເທມສ໌ -> ເຮັດໃຫ້ສີທີ່ສູນຄວບຄຸມໃຊ້ງານບໍ່ໄດ້\n"
"# \"ກົດແອັບໄພລຄາເລີ ເພື່ອເຮັດໃຫ້ແອັບພລິເຄຊັນຂອງເຄດີອີບໍ່ມີສີ\"\n"
"#\n"
"#\n"
